<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseSharedCompilation>false</UseSharedCompilation>
    <PackageId>Vibe.UI.CSS</PackageId>
    <Version>1.0.0-beta</Version>
    <Title>Vibe.UI.CSS - .NET-Native CSS Framework</Title>
    <Authors>Narcoleptic Fox</Authors>
    <Description>A .NET-native CSS utility framework with JIT generation. No Node.js required.

    Features:
    - Tree-shaking: Only includes CSS for classes you actually use
    - JIT colors: Use any Tailwind-style color (bg-red-500) on demand
    - MSBuild integration: Generates CSS at build time
    - Hot reload compatible: Works with dotnet watch</Description>
    <PackageTags>css;tailwind;blazor;dotnet;utility-css;jit</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/Narcoleptic-Fox/Vibe.UI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Narcoleptic-Fox/Vibe.UI</PackageProjectUrl>
    <PackageReadmeFile>README.css.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Include MSBuild targets in package -->
    <BuildOutputTargetFolder>tools</BuildOutputTargetFolder>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <!-- Embed the component library's canonical base stylesheet. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Vibe.UI\wwwroot\css\vibe-base.css"
                      LogicalName="Vibe.UI.CSS.vibe-base.css"
                      Link="Data\vibe-base.css" />
  </ItemGroup>

  <!-- Include MSBuild targets -->
  <ItemGroup>
    <None Include="Build\Vibe.UI.CSS.targets" Pack="true" PackagePath="build" />
    <None Include="Build\Vibe.UI.CSS.targets" Pack="true" PackagePath="buildTransitive" />
    <None Include="README.css.md" Pack="true" PackagePath="" />
    <None Include="../../icon.png" Pack="true" PackagePath="" Condition="Exists('../../icon.png')" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="" Condition="!Exists('../../icon.png') And Exists('../../assets/icon.png')" />
  </ItemGroup>

</Project>

