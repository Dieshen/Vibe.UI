@namespace Vibe.UI.Components
@inherits Base.VibeComponent

<nav class="@CombinedClass" aria-label="@EffectiveAriaLabel" @attributes="AdditionalAttributes">
    <div class="navigation-menu-list" role="list">
        @if (ChildContent != null)
        {
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        }

        @if (IsViewportIndicatorVisible)
        {
            <div class="navigation-menu-viewport-indicator" style="@ViewportIndicatorStyle"></div>
        }
    </div>

    @if (ViewportContent != null)
    {
        <div class="navigation-menu-viewport" role="region" aria-label="@EffectiveViewportAriaLabel">
            @ViewportContent
        </div>
    }
</nav>

@code {
    private readonly List<NavigationMenuItem> _keyboardItems = [];

    /// <summary>
    /// Gets or sets the content of the navigation menu.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the content to display in the viewport.
    /// </summary>
    [Parameter]
    public RenderFragment? ViewportContent { get; set; }

    /// <summary>
    /// Gets or sets the accessible label for the navigation menu.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; } = "Navigation menu";

    /// <summary>
    /// Gets or sets the accessible label for the optional viewport region.
    /// </summary>
    [Parameter]
    public string? ViewportAriaLabel { get; set; } = "Navigation menu viewport";

    /// <summary>
    /// Dictionary tracking the position and size of menu items.
    /// </summary>
    private Dictionary<string, (double Left, double Width)> ItemPositions { get; set; } = new();

    /// <summary>
    /// Gets or sets the active menu item's ID.
    /// </summary>
    private string? ActiveItemId { get; set; }

    /// <summary>
    /// Gets whether the viewport indicator should be visible.
    /// </summary>
    private bool IsViewportIndicatorVisible => !string.IsNullOrEmpty(ActiveItemId) &&
    ItemPositions.ContainsKey(ActiveItemId);

    private string EffectiveAriaLabel => string.IsNullOrWhiteSpace(AriaLabel)
        ? "Navigation menu"
        : AriaLabel.Trim();

    private string EffectiveViewportAriaLabel => string.IsNullOrWhiteSpace(ViewportAriaLabel)
        ? "Navigation menu viewport"
        : ViewportAriaLabel.Trim();

    /// <summary>
    /// Gets the style for the viewport indicator.
    /// </summary>
    private string ViewportIndicatorStyle
    {
        get
        {
            if (!string.IsNullOrEmpty(ActiveItemId) && ItemPositions.TryGetValue(ActiveItemId, out var position))
            {
                return FormattableString.Invariant($"left: {position.Left}px; width: {position.Width}px");
            }

            return string.Empty;
        }
    }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-navigation-menu";

    /// <summary>
    /// Registers a menu item's position and dimensions.
    /// </summary>
    /// <param name="id">The menu item's ID.</param>
    /// <param name="left">The menu item's left position.</param>
    /// <param name="width">The menu item's width.</param>
    public void RegisterItem(string id, double left, double width)
    {
        var itemId = NormalizeItemId(id);
        if (itemId == null)
        {
            return;
        }

        if (!double.IsFinite(left) || !double.IsFinite(width) || width <= 0)
        {
            if (ItemPositions.Remove(itemId) && ActiveItemId == itemId)
            {
                ActiveItemId = null;
            }

            StateHasChanged();
            return;
        }

        ItemPositions[itemId] = (Math.Max(0, left), width);
        StateHasChanged();
    }

    /// <summary>
    /// Activates a menu item.
    /// </summary>
    /// <param name="id">The menu item's ID.</param>
    public void ActivateItem(string id)
    {
        ActiveItemId = NormalizeItemId(id);
        StateHasChanged();
    }

    /// <summary>
    /// Deactivates the current active menu item.
    /// </summary>
    public void DeactivateItem()
    {
        if (ActiveItemId == null)
        {
            return;
        }

        ActiveItemId = null;
        StateHasChanged();
    }

    internal void RegisterKeyboardItem(NavigationMenuItem item)
    {
        if (!_keyboardItems.Contains(item))
        {
            _keyboardItems.Add(item);
        }
    }

    internal void UnregisterKeyboardItem(NavigationMenuItem item)
    {
        _keyboardItems.Remove(item);
    }

    internal Task FocusRelativeItemAsync(NavigationMenuItem currentItem, int offset)
    {
        var enabledItems = _keyboardItems.Where(item => !item.Disabled).ToList();
        if (enabledItems.Count == 0)
        {
            return Task.CompletedTask;
        }

        var currentIndex = enabledItems.IndexOf(currentItem);
        if (currentIndex < 0)
        {
            currentIndex = offset > 0 ? -1 : 0;
        }

        var nextIndex = (currentIndex + offset + enabledItems.Count) % enabledItems.Count;
        return enabledItems[nextIndex].FocusTriggerAsync();
    }

    internal Task FocusBoundaryItemAsync(bool last)
    {
        var enabledItems = _keyboardItems.Where(item => !item.Disabled).ToList();
        if (enabledItems.Count == 0)
        {
            return Task.CompletedTask;
        }

        return enabledItems[last ? enabledItems.Count - 1 : 0].FocusTriggerAsync();
    }

    private static string? NormalizeItemId(string? id)
    {
        var normalizedId = id?.Trim();
        return string.IsNullOrEmpty(normalizedId) ? null : normalizedId;
    }
}
