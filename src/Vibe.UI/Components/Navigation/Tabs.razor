@namespace Vibe.UI.Components
@inherits Vibe.UI.Base.VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="@CombinedClass" @attributes="AdditionalAttributes">
    <CascadingValue Value="this">
        <div class="vibe-tabs-registration" hidden aria-hidden="true">
            @ChildContent
        </div>
    </CascadingValue>

    <div class="vibe-tabs-list" role="tablist" aria-orientation="horizontal">
        @foreach (var tab in _tabs)
        {
            var isActive = tab.Id == ActiveTabId;
            <button @key="tab.Id"
                type="button"
                class="@GetTabTriggerClass(isActive)"
                id="@GetTabTriggerId(tab.Id)"
                role="tab"
                aria-selected="@(isActive ? "true" : "false")"
                aria-disabled="@(tab.Disabled ? "true" : "false")"
                aria-controls="@GetTabPanelId(tab.Id)"
                tabindex="@(isActive ? 0 : -1)"
                disabled="@(tab.Disabled)"
                @onclick="() => ActivateTab(tab.Id)"
                @onkeydown="(e) => OnTriggerKeyDown(e, tab.Id)">
                @tab.Title
            </button>
        }
    </div>
    <div class="vibe-tabs-content">
        @foreach (var tab in _tabs)
        {
            var isActive = tab.Id == ActiveTabId;
            <div @key="tab.Id"
                @attributes="tab.AdditionalAttributes"
                class="@GetTabPanelClass(tab, isActive)"
                role="tabpanel"
                id="@GetTabPanelId(tab.Id)"
                aria-labelledby="@GetTabTriggerId(tab.Id)"
                hidden="@(!isActive)"
                tabindex="@(isActive ? 0 : -1)">
                @tab.Content
            </div>
        }
    </div>
</div>

@code {
    private List<TabItem> _tabs = new();
    private IJSObjectReference? _domModule;
    private bool _isDisposed;
    private bool _activeTabWasAutoSelected;
    private static readonly RenderFragment EmptyContent = _ => { };

    /// <summary>
    /// Gets or sets the active tab ID
    /// </summary>
    [Parameter]
    public string? ActiveTabId { get; set; }

    /// <summary>
    /// Gets or sets the callback for when the active tab changes
    /// </summary>
    [Parameter]
    public EventCallback<string?> ActiveTabIdChanged { get; set; }

    /// <summary>
    /// Gets or sets the callback for when a tab is activated
    /// </summary>
    [Parameter]
    public EventCallback<TabActivatedEventArgs> OnTabActivated { get; set; }

    /// <summary>
    /// Gets or sets the tab items
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc/>
    protected override string ComponentClass => "vibe-tabs";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        EnsureActiveTab();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _domModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Vibe.UI/js/vibe-dom.js");
        }
    }

    /// <summary>
    /// Adds a tab to the collection
    /// </summary>
    /// <param name="tab">The tab to add</param>
    internal void AddTab(TabItem tab)
    {
        if (_isDisposed)
            return;

        var shouldRender = UpsertTab(tab);

        if (tab.DefaultActive && !tab.Disabled && _activeTabWasAutoSelected && ActiveTabId != tab.Id)
        {
            ActiveTabId = tab.Id;
            shouldRender = true;
        }

        shouldRender = EnsureActiveTab() || shouldRender;

        if (shouldRender)
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// Adds a declarative tab item to the collection
    /// </summary>
    /// <param name="tab">The declarative tab item to add</param>
    internal void AddTab(global::Vibe.UI.Components.TabItem tab)
    {
        var title = tab.HeaderContent;
        var content = tab.ChildContent ?? EmptyContent;
        AddTab(new TabItem(
            tab.ResolvedId,
            title,
            content,
            tab.Disabled,
            tab.DefaultActive,
            tab.PanelClass,
            tab.AdditionalAttributes));
    }

    /// <summary>
    /// Removes a tab from the collection
    /// </summary>
    /// <param name="tabId">The ID of the tab to remove</param>
    internal void RemoveTab(string tabId)
    {
        if (_isDisposed)
            return;

        var tab = _tabs.FirstOrDefault(t => t.Id == tabId);
        if (tab != null)
        {
            _tabs.Remove(tab);

            // If the removed tab was the active tab, activate the first tab that's not disabled
            if (tabId == ActiveTabId)
            {
                ActiveTabId = _tabs.FirstOrDefault(t => !t.Disabled)?.Id;
                _activeTabWasAutoSelected = ActiveTabId != null;
            }

            StateHasChanged();
        }
    }

    /// <summary>
    /// Activates a tab
    /// </summary>
    /// <param name="tabId">The ID of the tab to activate</param>
    private async Task ActivateTab(string tabId)
    {
        var tab = _tabs.FirstOrDefault(t => t.Id == tabId);
        if (tab != null && !tab.Disabled && tabId != ActiveTabId)
        {
            ActiveTabId = tabId;
            _activeTabWasAutoSelected = false;

            if (ActiveTabIdChanged.HasDelegate)
            {
                await ActiveTabIdChanged.InvokeAsync(tabId);
            }

            if (OnTabActivated.HasDelegate)
            {
                await OnTabActivated.InvokeAsync(new TabActivatedEventArgs(tabId, tab.Title));
            }
        }
    }

    private async Task OnTriggerKeyDown(KeyboardEventArgs e, string currentTabId)
    {
        if (_tabs.Count == 0)
            return;

        var currentIndex = _tabs.FindIndex(t => t.Id == currentTabId);
        if (currentIndex < 0)
            return;

        string? nextId = e.Key switch
        {
            "ArrowRight" => FindNextEnabledTabId(currentIndex, forward: true),
            "ArrowDown" => FindNextEnabledTabId(currentIndex, forward: true),
            "ArrowLeft" => FindNextEnabledTabId(currentIndex, forward: false),
            "ArrowUp" => FindNextEnabledTabId(currentIndex, forward: false),
            "Home" => FindNextEnabledTabId(startIndex: -1, forward: true),
            "End" => FindNextEnabledTabId(startIndex: _tabs.Count, forward: false),
            "Enter" => currentTabId,
            " " => currentTabId,
            _ => null
        };

        if (nextId == null)
            return;

        await ActivateTab(nextId);
        await FocusTriggerAsync(nextId);
    }

    private string? FindNextEnabledTabId(int startIndex, bool forward)
    {
        if (_tabs.Count == 0)
            return null;

        var index = startIndex;
        for (var i = 0; i < _tabs.Count; i++)
        {
            index = forward ? (index + 1) % _tabs.Count : (index - 1 + _tabs.Count) % _tabs.Count;
            if (!_tabs[index].Disabled)
                return _tabs[index].Id;
        }

        return null;
    }

    private async Task FocusTriggerAsync(string tabId)
    {
        if (_domModule == null)
            return;

        await _domModule.InvokeVoidAsync("focusElement", GetTabTriggerId(tabId));
    }

    private bool UpsertTab(TabItem tab)
    {
        var existingIndex = _tabs.FindIndex(t => t.Id == tab.Id);
        if (existingIndex < 0)
        {
            _tabs.Add(tab);
            return true;
        }

        var existing = _tabs[existingIndex];
        _tabs[existingIndex] = tab;
        return existing.HasDifferentMetadata(tab);
    }

    private bool EnsureActiveTab()
    {
        if (_tabs.Count == 0)
            return false;

        var activeTab = _tabs.FirstOrDefault(t => t.Id == ActiveTabId);
        if (activeTab != null && !activeTab.Disabled)
            return false;

        var nextActiveTab = _tabs.FirstOrDefault(t => t.DefaultActive && !t.Disabled)
            ?? _tabs.FirstOrDefault(t => !t.Disabled);
        var nextActiveTabId = nextActiveTab?.Id;

        if (ActiveTabId == nextActiveTabId)
            return false;

        ActiveTabId = nextActiveTabId;
        _activeTabWasAutoSelected = nextActiveTabId != null;
        return true;
    }

    private static string GetTabTriggerClass(bool isActive) =>
        CombineClasses("vibe-tabs-trigger", isActive ? "vibe-tabs-trigger-active" : null);

    private static string GetTabPanelClass(TabItem tab, bool isActive) =>
        CombineClasses(
            "vibe-tabs-panel",
            isActive ? "vibe-tabs-panel-active" : null,
            tab.PanelClass);

    private static string GetTabPanelId(string tabId) => $"vibe-tabpanel-{tabId}";
    private static string GetTabTriggerId(string tabId) => $"vibe-tab-{tabId}";

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;

        if (_domModule != null)
        {
            await _domModule.DisposeAsync();
        }
    }

    /// <summary>
    /// Tab item
    /// </summary>
    internal class TabItem
    {
        /// <summary>
        /// Gets the ID of the tab
        /// </summary>
        public string Id { get; }

        /// <summary>
        /// Gets the title of the tab
        /// </summary>
        public RenderFragment Title { get; }

        /// <summary>
        /// Gets the content of the tab
        /// </summary>
        public RenderFragment Content { get; }

        /// <summary>
        /// Gets whether the tab is disabled
        /// </summary>
        public bool Disabled { get; }

        /// <summary>
        /// Gets whether the tab should be active by default
        /// </summary>
        public bool DefaultActive { get; }

        /// <summary>
        /// Gets the classes to apply to the rendered panel
        /// </summary>
        public string? PanelClass { get; }

        /// <summary>
        /// Gets additional attributes to apply to the rendered panel
        /// </summary>
        public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; }

        /// <summary>
        /// Creates a new instance of <see cref="TabItem"/>
        /// </summary>
        /// <param name="id">The ID of the tab</param>
        /// <param name="title">The title of the tab</param>
        /// <param name="content">The content of the tab</param>
        /// <param name="disabled">Whether the tab is disabled</param>
        /// <param name="defaultActive">Whether the tab should be active by default</param>
        /// <param name="panelClass">The classes to apply to the rendered panel</param>
        /// <param name="additionalAttributes">Additional attributes to apply to the rendered panel</param>
        public TabItem(
            string id,
            RenderFragment title,
            RenderFragment content,
            bool disabled,
            bool defaultActive,
            string? panelClass = null,
            IReadOnlyDictionary<string, object>? additionalAttributes = null)
        {
            Id = id;
            Title = title;
            Content = content;
            Disabled = disabled;
            DefaultActive = defaultActive;
            PanelClass = panelClass;
            AdditionalAttributes = additionalAttributes;
        }

        internal bool HasDifferentMetadata(TabItem other)
        {
            return Disabled != other.Disabled
                || DefaultActive != other.DefaultActive
                || PanelClass != other.PanelClass
                || !AttributeDictionariesMatch(AdditionalAttributes, other.AdditionalAttributes);
        }

        private static bool AttributeDictionariesMatch(
            IReadOnlyDictionary<string, object>? first,
            IReadOnlyDictionary<string, object>? second)
        {
            if (ReferenceEquals(first, second))
                return true;

            if (first == null || second == null || first.Count != second.Count)
                return false;

            foreach (var (key, value) in first)
            {
                if (!second.TryGetValue(key, out var otherValue)
                    || !Equals(value, otherValue))
                {
                    return false;
                }
            }

            return true;
        }
    }

    /// <summary>
    /// Tab activated event arguments
    /// </summary>
    public class TabActivatedEventArgs
    {
        /// <summary>
        /// Gets the ID of the tab
        /// </summary>
        public string TabId { get; }

        /// <summary>
        /// Gets the title of the tab as a string (for convenience)
        /// </summary>
        public RenderFragment Title { get; }

        /// <summary>
        /// Creates a new instance of <see cref="TabActivatedEventArgs"/>
        /// </summary>
        /// <param name="tabId">The ID of the tab</param>
        /// <param name="title">The title of the tab</param>
        public TabActivatedEventArgs(string tabId, RenderFragment title)
        {
            TabId = tabId;
            Title = title;
        }
    }
}
