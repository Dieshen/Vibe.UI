@namespace Vibe.UI.Components
@inherits Base.VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div @attributes="AdditionalAttributes"
     class="@CombinedClass"
     id="@EffectiveId"
     role="none"
     data-state="@StateName"
     aria-disabled="@AriaBool(Disabled)"
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave"
     @ref="_elementReference">
    <button type="button"
            class="navigation-menu-item-trigger"
            disabled="@Disabled"
            aria-disabled="@AriaBool(Disabled)"
            aria-haspopup="@AriaHasPopup"
            aria-expanded="@AriaExpanded"
            aria-controls="@AriaControls"
            aria-label="@EffectiveTriggerAriaLabel"
            @onclick="HandleClick"
            @onkeydown="HandleTriggerKeyDown">
        @if (TriggerContent != null)
        {
            @TriggerContent
        }
        else
        {
            <span class="navigation-menu-item-trigger-fallback">@FallbackTriggerText</span>
        }
    </button>

    @if (Content != null && IsActive)
    {
        <div id="@ContentElementId"
             class="navigation-menu-item-content"
             role="region"
             aria-label="@EffectiveContentAriaLabel"
             data-state="open"
             @onkeydown="HandleContentKeyDown">
            @Content
        </div>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the ID of the menu item.
    /// </summary>
    [Parameter]
    public string Id { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the content of the trigger button.
    /// </summary>
    [Parameter]
    public RenderFragment? TriggerContent { get; set; }

    /// <summary>
    /// Gets or sets fallback trigger text rendered when <see cref="TriggerContent"/> is omitted.
    /// </summary>
    [Parameter]
    public string FallbackTriggerText { get; set; } = "Navigation item";

    /// <summary>
    /// Gets or sets the content to display when the item is active.
    /// </summary>
    [Parameter]
    public RenderFragment? Content { get; set; }

    /// <summary>
    /// Gets or sets whether the menu item is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether clicking the trigger opens or closes inline content.
    /// </summary>
    [Parameter]
    public bool OpenOnClick { get; set; } = true;

    /// <summary>
    /// Gets or sets an accessible label for the trigger button.
    /// </summary>
    [Parameter]
    public string? TriggerAriaLabel { get; set; }

    /// <summary>
    /// Gets or sets an accessible label for the disclosed content region.
    /// </summary>
    [Parameter]
    public string? ContentAriaLabel { get; set; }

    /// <summary>
    /// Gets or sets the callback when the menu item is clicked.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// Gets or sets whether viewport content should be shown when this item is active.
    /// </summary>
    [Parameter]
    public bool UseViewport { get; set; }

    /// <summary>
    /// Gets or sets the parent navigation menu.
    /// </summary>
    [CascadingParameter]
    public NavigationMenu? ParentMenu { get; set; }

    /// <summary>
    /// Gets whether the menu item is active.
    /// </summary>
    private bool IsActive { get; set; }

    private readonly string _generatedId = $"vibe-navigation-menu-item-{Guid.NewGuid():N}";

    private bool HasContent => Content != null;

    private string EffectiveId => string.IsNullOrWhiteSpace(Id) ? _generatedId : Id.Trim();

    private string ContentElementId => $"{EffectiveId}-content";

    private string StateName => IsActive ? "open" : "closed";

    private string? AriaHasPopup => HasContent ? "true" : null;

    private string? AriaExpanded => HasContent ? AriaBool(IsActive) : null;

    private string? AriaControls => HasContent ? ContentElementId : null;

    private string? EffectiveTriggerAriaLabel =>
        string.IsNullOrWhiteSpace(TriggerAriaLabel) ? null : TriggerAriaLabel.Trim();

    private string EffectiveContentAriaLabel =>
        string.IsNullOrWhiteSpace(ContentAriaLabel) ? "Navigation menu content" : ContentAriaLabel.Trim();

    /// <summary>
    /// Reference to the menu item element.
    /// </summary>
    private ElementReference _elementReference;

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-navigation-menu-item";

    /// <summary>
    /// Gets the combined CSS class.
    /// </summary>
    protected override string GetCombinedClass()
    {
        return CombineClasses(
            ComponentClass,
            IsActive ? "navigation-menu-item-open" : null,
            Disabled ? "navigation-menu-item-disabled" : null,
            HasContent ? "navigation-menu-item-has-content" : null,
            UseViewport ? "navigation-menu-item-viewport" : null,
            Class);
    }

    /// <summary>
    /// Updates the menu item position after rendering.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await UpdatePosition();
        }
    }

    private IJSObjectReference? _domModule;

    /// <summary>
    /// Updates the menu item position.
    /// </summary>
    private async Task UpdatePosition()
    {
        if (ParentMenu == null)
        {
            return;
        }

        try
        {
            // Import DOM utilities module if not already loaded
            _domModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Vibe.UI/js/vibe-dom.js");

            var boundingRect = await _domModule.InvokeAsync<DOMRect?>("getBoundingRect", EffectiveId);
            var parentRect = await _domModule.InvokeAsync<DOMRect?>("getParentBoundingRect", EffectiveId);

            if (boundingRect != null && parentRect != null)
            {
                var leftPosition = boundingRect.Left - parentRect.Left;
                ParentMenu.RegisterItem(EffectiveId, leftPosition, boundingRect.Width);
            }
        }
        catch
        {
            // Ignore errors when updating position
        }
    }

    /// <summary>
    /// Handles mouse enter events.
    /// </summary>
    private void HandleMouseEnter()
    {
        SetActive(true);
    }

    /// <summary>
    /// Handles mouse leave events.
    /// </summary>
    private void HandleMouseLeave()
    {
        SetActive(false);
    }

    /// <summary>
    /// Handles click events.
    /// </summary>
    private async Task HandleClick(MouseEventArgs args)
    {
        if (Disabled)
        {
            return;
        }

        if (OpenOnClick && HasContent)
        {
            SetActive(!IsActive);
        }

        await OnClick.InvokeAsync(args);
    }

    private void HandleTriggerKeyDown(KeyboardEventArgs args)
    {
        if (Disabled)
        {
            return;
        }

        if (HasContent && args.Key is "ArrowDown" or "ArrowUp")
        {
            SetActive(true);
        }
        else if (args.Key == "Escape")
        {
            SetActive(false);
        }
    }

    private void HandleContentKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            SetActive(false);
        }
    }

    private void SetActive(bool active)
    {
        if (Disabled || !HasContent || IsActive == active)
        {
            return;
        }

        IsActive = active;

        if (UseViewport)
        {
            if (active)
            {
                ParentMenu?.ActivateItem(EffectiveId);
            }
            else
            {
                ParentMenu?.DeactivateItem();
            }
        }

        StateHasChanged();
    }

    /// <summary>
    /// Disposes the component.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (_domModule != null)
        {
            try
            {
                await _domModule.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors
            }
        }
        GC.SuppressFinalize(this);
    }

    private static string AriaBool(bool value) => value ? "true" : "false";

    /// <summary>
    /// DOM rectangle structure for JS interop.
    /// </summary>
    private class DOMRect
    {
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
        public double Top { get; set; }
        public double Right { get; set; }
        public double Bottom { get; set; }
        public double Left { get; set; }
    }
}
