@namespace Vibe.UI.Components
@inherits Base.VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div @attributes="AdditionalAttributes"
     class="@CombinedClass"
     id="@EffectiveId"
     role="none"
     data-state="@StateName"
     aria-disabled="@AriaBool(Disabled)"
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave"
     @ref="_elementReference">
    <button type="button"
            class="navigation-menu-item-trigger"
            disabled="@Disabled"
            aria-disabled="@AriaBool(Disabled)"
            aria-haspopup="@AriaHasPopup"
            aria-expanded="@AriaExpanded"
            aria-controls="@AriaControls"
            aria-label="@EffectiveTriggerAriaLabel"
            @ref="_triggerReference"
            @onclick="HandleClick"
            @onkeydown="HandleTriggerKeyDown">
        @if (TriggerContent != null)
        {
            @TriggerContent
        }
        else
        {
            <span class="navigation-menu-item-trigger-fallback">@FallbackTriggerText</span>
        }
    </button>

    @if (Content != null && IsActive)
    {
        <div id="@ContentElementId"
             class="navigation-menu-item-content"
             role="region"
             tabindex="-1"
             aria-label="@EffectiveContentAriaLabel"
             data-state="open"
             @ref="_contentReference"
             @onkeydown="HandleContentKeyDown">
            @Content
        </div>
    }
</div>

@code {
    private const string KeyboardModulePath = "./_content/Vibe.UI/js/vibe-menu-keyboard.js";

    private readonly string _generatedId = $"vibe-navigation-menu-item-{Guid.NewGuid():N}";
    private ElementReference _elementReference;
    private ElementReference _triggerReference;
    private ElementReference _contentReference;
    private IJSObjectReference? _domModule;
    private IJSObjectReference? _keyboardModule;
    private NavigationMenu? _registeredParent;
    private PendingFocus _pendingContentFocus;
    private bool _restoreTriggerFocus;
    private bool _keyboardActivationPending;

    /// <summary>
    /// Gets or sets the ID of the menu item.
    /// </summary>
    [Parameter]
    public string Id { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the content of the trigger button.
    /// </summary>
    [Parameter]
    public RenderFragment? TriggerContent { get; set; }

    /// <summary>
    /// Gets or sets fallback trigger text rendered when <see cref="TriggerContent"/> is omitted.
    /// </summary>
    [Parameter]
    public string FallbackTriggerText { get; set; } = "Navigation item";

    /// <summary>
    /// Gets or sets the content to display when the item is active.
    /// </summary>
    [Parameter]
    public RenderFragment? Content { get; set; }

    /// <summary>
    /// Gets or sets whether the menu item is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether clicking the trigger opens or closes inline content.
    /// </summary>
    [Parameter]
    public bool OpenOnClick { get; set; } = true;

    /// <summary>
    /// Gets or sets an accessible label for the trigger button.
    /// </summary>
    [Parameter]
    public string? TriggerAriaLabel { get; set; }

    /// <summary>
    /// Gets or sets an accessible label for the disclosed content region.
    /// </summary>
    [Parameter]
    public string? ContentAriaLabel { get; set; }

    /// <summary>
    /// Gets or sets the callback when the menu item is clicked.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// Gets or sets whether viewport content should be shown when this item is active.
    /// </summary>
    [Parameter]
    public bool UseViewport { get; set; }

    /// <summary>
    /// Gets or sets the parent navigation menu.
    /// </summary>
    [CascadingParameter]
    public NavigationMenu? ParentMenu { get; set; }

    /// <summary>
    /// Gets whether the menu item is active.
    /// </summary>
    private bool IsActive { get; set; }

    private bool HasContent => Content != null;

    private string EffectiveId => string.IsNullOrWhiteSpace(Id) ? _generatedId : Id.Trim();

    private string ContentElementId => $"{EffectiveId}-content";

    private string StateName => IsActive ? "open" : "closed";

    private string? AriaHasPopup => HasContent ? "true" : null;

    private string? AriaExpanded => HasContent ? AriaBool(IsActive) : null;

    private string? AriaControls => HasContent ? ContentElementId : null;

    private string? EffectiveTriggerAriaLabel =>
        string.IsNullOrWhiteSpace(TriggerAriaLabel) ? null : TriggerAriaLabel.Trim();

    private string EffectiveContentAriaLabel =>
        string.IsNullOrWhiteSpace(ContentAriaLabel) ? "Navigation menu content" : ContentAriaLabel.Trim();

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-navigation-menu-item";

    protected override string GetCombinedClass()
    {
        return CombineClasses(
            ComponentClass,
            IsActive ? "navigation-menu-item-open" : null,
            Disabled ? "navigation-menu-item-disabled" : null,
            HasContent ? "navigation-menu-item-has-content" : null,
            UseViewport ? "navigation-menu-item-viewport" : null,
            Class);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (ReferenceEquals(_registeredParent, ParentMenu))
        {
            return;
        }

        _registeredParent?.UnregisterKeyboardItem(this);
        _registeredParent = ParentMenu;
        _registeredParent?.RegisterKeyboardItem(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await UpdatePosition();
        }

        try
        {
            var module = await GetKeyboardModuleAsync();
            await module.InvokeVoidAsync("initializeTrigger", _triggerReference, false, true);

            if (IsActive)
            {
                await module.InvokeVoidAsync("initializeContainer", _contentReference, "focusable");

                if (_pendingContentFocus == PendingFocus.First)
                {
                    await module.InvokeVoidAsync("focusFirstItem", _contentReference, "focusable");
                    _pendingContentFocus = PendingFocus.None;
                }
                else if (_pendingContentFocus == PendingFocus.Last)
                {
                    await module.InvokeVoidAsync("focusLastItem", _contentReference, "focusable");
                    _pendingContentFocus = PendingFocus.None;
                }
            }
            else if (_restoreTriggerFocus)
            {
                await FocusTriggerAsync();
                _restoreTriggerFocus = false;
            }
        }
        catch (Exception ex) when (IsRecoverableJsInteropException(ex))
        {
            // JS interop is unavailable (prerendering, circuit teardown, or navigation).
        }
    }

    private async Task UpdatePosition()
    {
        if (ParentMenu == null)
        {
            return;
        }

        try
        {
            _domModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Vibe.UI/js/vibe-dom.js");

            var boundingRect = await _domModule.InvokeAsync<DOMRect?>("getBoundingRect", EffectiveId);
            var parentRect = await _domModule.InvokeAsync<DOMRect?>("getParentBoundingRect", EffectiveId);

            if (boundingRect != null && parentRect != null)
            {
                var leftPosition = boundingRect.Left - parentRect.Left;
                ParentMenu.RegisterItem(EffectiveId, leftPosition, boundingRect.Width);
            }
        }
        catch
        {
            // Position measurement is decorative and should not block interaction.
        }
    }

    private void HandleMouseEnter()
    {
        SetActive(true);
    }

    private void HandleMouseLeave()
    {
        SetActive(false);
    }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (Disabled)
        {
            return;
        }

        var focusContent = _keyboardActivationPending;
        _keyboardActivationPending = false;

        if (OpenOnClick && HasContent)
        {
            var opening = !IsActive;
            SetActive(opening);

            if (opening && focusContent)
            {
                _pendingContentFocus = PendingFocus.First;
            }
        }

        await OnClick.InvokeAsync(args);
    }

    private async Task HandleTriggerKeyDown(KeyboardEventArgs args)
    {
        if (Disabled)
        {
            return;
        }

        switch (args.Key)
        {
            case "Enter":
            case " ":
            case "Spacebar":
                _keyboardActivationPending = HasContent && OpenOnClick;
                break;
            case "ArrowDown" when HasContent:
                OpenContent(PendingFocus.First);
                break;
            case "ArrowUp" when HasContent:
                OpenContent(PendingFocus.Last);
                break;
            case "ArrowRight" when ParentMenu != null:
                await ParentMenu.FocusRelativeItemAsync(this, 1);
                break;
            case "ArrowLeft" when ParentMenu != null:
                await ParentMenu.FocusRelativeItemAsync(this, -1);
                break;
            case "Home" when ParentMenu != null:
                await ParentMenu.FocusBoundaryItemAsync(last: false);
                break;
            case "End" when ParentMenu != null:
                await ParentMenu.FocusBoundaryItemAsync(last: true);
                break;
            case "Escape":
                SetActive(false);
                _restoreTriggerFocus = true;
                break;
        }
    }

    private async Task HandleContentKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            SetActive(false);
            _restoreTriggerFocus = true;
            return;
        }

        var module = await GetKeyboardModuleAsync();
        if (await module.InvokeAsync<bool>("isActiveElementEditable", _contentReference))
        {
            return;
        }

        switch (args.Key)
        {
            case "ArrowDown":
                await module.InvokeVoidAsync("moveFocus", _contentReference, "focusable", 1);
                break;
            case "ArrowUp":
                await module.InvokeVoidAsync("moveFocus", _contentReference, "focusable", -1);
                break;
            case "Home":
                await module.InvokeVoidAsync("focusFirstItem", _contentReference, "focusable");
                break;
            case "End":
                await module.InvokeVoidAsync("focusLastItem", _contentReference, "focusable");
                break;
            default:
                if (IsTypeaheadKey(args))
                {
                    await module.InvokeVoidAsync("focusByTypeahead", _contentReference, "focusable", args.Key);
                }
                break;
        }
    }

    private void OpenContent(PendingFocus pendingFocus)
    {
        SetActive(true);
        _pendingContentFocus = pendingFocus;
        _restoreTriggerFocus = false;
    }

    private void SetActive(bool active)
    {
        if (Disabled || !HasContent || IsActive == active)
        {
            return;
        }

        IsActive = active;
        if (!active)
        {
            _pendingContentFocus = PendingFocus.None;
        }

        if (UseViewport)
        {
            if (active)
            {
                ParentMenu?.ActivateItem(EffectiveId);
            }
            else
            {
                ParentMenu?.DeactivateItem();
            }
        }

        StateHasChanged();
    }

    internal async Task FocusTriggerAsync()
    {
        if (!Disabled)
        {
            await _triggerReference.FocusAsync();
        }
    }

    private async ValueTask<IJSObjectReference> GetKeyboardModuleAsync()
    {
        _keyboardModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", KeyboardModulePath);
        return _keyboardModule;
    }

    private static bool IsTypeaheadKey(KeyboardEventArgs e)
    {
        return e.Key.Length == 1 &&
               !char.IsWhiteSpace(e.Key[0]) &&
               !e.AltKey &&
               !e.CtrlKey &&
               !e.MetaKey;
    }

    public async ValueTask DisposeAsync()
    {
        _registeredParent?.UnregisterKeyboardItem(this);
        _registeredParent = null;

        if (_keyboardModule != null)
        {
            try
            {
                await _keyboardModule.DisposeAsync();
            }
            catch (Exception ex) when (IsRecoverableJsInteropException(ex))
            {
            }
        }

        if (_domModule != null)
        {
            try
            {
                await _domModule.DisposeAsync();
            }
            catch (Exception ex) when (IsRecoverableJsInteropException(ex))
            {
            }
        }

        GC.SuppressFinalize(this);
    }

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;

    private static string AriaBool(bool value) => value ? "true" : "false";

    private enum PendingFocus
    {
        None,
        First,
        Last
    }

    private sealed class DOMRect
    {
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
        public double Top { get; set; }
        public double Right { get; set; }
        public double Bottom { get; set; }
        public double Left { get; set; }
    }
}
