@namespace Vibe.UI.Components
@inherits VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<aside @attributes="AdditionalAttributes"
    @ref="_rootReference"
    id="@_sidebarId"
    class="@CombinedCssClass"
    style="@SidebarStyle"
    role="complementary"
    aria-label="@EffectiveAriaLabel"
    aria-disabled="@AriaBool(Disabled)"
    data-state="@CurrentState"
    @onkeydown="HandleKeyDown">

    @if (ShowHeader)
    {
        <div class="sidebar-header">
            <div class="sidebar-header-content" aria-hidden="@AriaBool(!IsOpen)" inert="@(!IsOpen)">
                @if (Header != null)
                {
                    @Header
                }
                else if (!string.IsNullOrEmpty(Title))
                {
                    <h2 class="sidebar-title">@Title</h2>
                }
            </div>

            @if (Collapsible)
            {
                <button type="button"
                    class="sidebar-toggle"
                    @onclick="Toggle"
                    disabled="@Disabled"
                    aria-label="@ToggleAriaLabel"
                    aria-controls="@_sidebarId"
                    aria-expanded="@AriaBool(IsOpen)"
                    aria-disabled="@AriaBool(Disabled)">
                    <Icon Name="@ToggleIconName" Size="16" CssClass="sidebar-toggle-icon" />
                </button>
            }
        </div>
    }

    <div class="sidebar-content"
         role="region"
         aria-label="@EffectiveContentAriaLabel"
         aria-hidden="@AriaBool(!IsOpen)"
         inert="@(!IsOpen)">
        @ChildContent
    </div>

    @if (Footer != null)
    {
        <div class="sidebar-footer" aria-hidden="@AriaBool(!IsOpen)" inert="@(!IsOpen)">
            @Footer
        </div>
    }

    @if (Resizable && IsOpen)
    {
        <div class="sidebar-resize-handle"
             @ref="_resizeHandleReference"
             role="separator"
             aria-orientation="vertical"
             aria-label="@ResizeHandleAriaLabel"
             aria-disabled="@AriaBool(Disabled)"
             aria-valuenow="@EffectiveWidth"
             aria-valuemin="@EffectiveMinWidth"
             aria-valuemax="@EffectiveMaxWidth"
             tabindex="@(Disabled ? -1 : 0)"
             @onkeydown="HandleResizeKeyDown">
            <Icon Name="grip-vertical" Size="16" />
        </div>
    }
</aside>

@code {
    private readonly string _sidebarId = $"vibe-sidebar-{Guid.NewGuid():N}";
    private ElementReference _rootReference;
    private ElementReference _resizeHandleReference;
    private IJSObjectReference? _resizeModule;
    private DotNetObjectReference<Sidebar>? _dotNetReference;
    private bool _resizeConnected;
    private SidebarPosition? _connectedPosition;
    private bool _disposed;
    private bool _hasInitializedWidth;
    private int _lastWidthParameter;
    private int _currentWidth = 280;
    private int EffectiveMinWidth => Math.Max(0, MinWidth);
    private int EffectiveMaxWidth => Math.Max(EffectiveMinWidth, MaxWidth);
    private int EffectiveWidth => Math.Clamp(_currentWidth, EffectiveMinWidth, EffectiveMaxWidth);
    private int EffectiveCollapsedWidth => Math.Clamp(CollapsedWidth, 0, EffectiveWidth);
    private string CurrentState => IsOpen ? "open" : "closed";
    private string ToggleAriaLabel => IsOpen ? "Collapse sidebar" : "Expand sidebar";
    private string ToggleIconName => (Position, IsOpen) switch
    {
        (SidebarPosition.Right, true) => "chevron-right",
        (SidebarPosition.Right, false) => "chevron-left",
        (_, true) => "chevron-left",
        _ => "chevron-right"
    };
    private string EffectiveAriaLabel => string.IsNullOrWhiteSpace(AriaLabel)
        ? (!string.IsNullOrWhiteSpace(Title) ? Title! : "Sidebar")
        : AriaLabel!;
    private string EffectiveContentAriaLabel => string.IsNullOrWhiteSpace(ContentAriaLabel)
        ? "Sidebar content"
        : ContentAriaLabel;
    private static string AriaBool(bool value) => value ? "true" : "false";

    [Parameter]
    public bool IsOpen { get; set; } = true;

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Header { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public bool ShowHeader { get; set; } = true;

    [Parameter]
    public bool Collapsible { get; set; } = true;

    [Parameter]
    public bool Resizable { get; set; } = false;

    [Parameter]
    public SidebarPosition Position { get; set; } = SidebarPosition.Left;

    [Parameter]
    public int Width { get; set; } = 280;

    [Parameter]
    public EventCallback<int> WidthChanged { get; set; }

    [Parameter]
    public int CollapsedWidth { get; set; } = 60;

    [Parameter]
    public int MinWidth { get; set; } = 200;

    [Parameter]
    public int MaxWidth { get; set; } = 600;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string ContentAriaLabel { get; set; } = "Sidebar content";

    [Parameter]
    public string ResizeHandleAriaLabel { get; set; } = "Resize sidebar";

    [Parameter]
    public bool PersistState { get; set; } = true;

    [Parameter]
    public string? PersistenceKey { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    private string CombinedCssClass => CombineClasses(
    "vibe-sidebar",
    $"sidebar-{Position.ToString().ToLower()}",
    IsOpen ? "sidebar-open" : "sidebar-closed",
    Resizable ? "sidebar-resizable" : null,
    Disabled ? "sidebar-disabled" : null,
    CssClass,
    Class
    );

    protected override string ComponentClass => CombinedCssClass;

    private string SidebarStyle => IsOpen
    ? $"width: {EffectiveWidth}px;"
    : $"width: {EffectiveCollapsedWidth}px;";

    private string? EffectivePersistenceKey
    {
        get
        {
            if (!PersistState)
            {
                return null;
            }

            var key = string.IsNullOrWhiteSpace(PersistenceKey)
                ? $"{EffectiveAriaLabel}:{Position}"
                : PersistenceKey.Trim();
            return $"vibe-sidebar:{key}";
        }
    }

    protected override void OnParametersSet()
    {
        var incomingWidth = Width;
        if (!_hasInitializedWidth || incomingWidth != _lastWidthParameter)
        {
            _currentWidth = Math.Clamp(incomingWidth, EffectiveMinWidth, EffectiveMaxWidth);
        }
        else
        {
            _currentWidth = Math.Clamp(_currentWidth, EffectiveMinWidth, EffectiveMaxWidth);
        }

        _lastWidthParameter = incomingWidth;
        _hasInitializedWidth = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        var shouldConnect = Resizable && IsOpen && !Disabled;
        if (!shouldConnect)
        {
            await DisconnectResizeAsync();
            return;
        }

        try
        {
            _resizeModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Vibe.UI/js/sidebar.js");
            _dotNetReference ??= DotNetObjectReference.Create(this);

            if (!_resizeConnected || _connectedPosition != Position)
            {
                await DisconnectResizeAsync();
                var restoredWidth = await _resizeModule.InvokeAsync<double?>(
                    "connect",
                    _rootReference,
                    _resizeHandleReference,
                    _dotNetReference,
                    Position == SidebarPosition.Left,
                    EffectivePersistenceKey);
                _resizeConnected = true;
                _connectedPosition = Position;

                if (restoredWidth is double storedWidth)
                {
                    _currentWidth = Math.Clamp((int)Math.Round(storedWidth), EffectiveMinWidth, EffectiveMaxWidth);
                    Width = _currentWidth;
                    _lastWidthParameter = _currentWidth;
                    StateHasChanged();
                }
            }
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }
    }

    public Task Toggle()
    {
        if (!Collapsible || Disabled)
        {
            return Task.CompletedTask;
        }

        return SetIsOpenAsync(!IsOpen);
    }

    public Task Open() => SetIsOpenAsync(true);
    public Task Close() => SetIsOpenAsync(false);

    private async Task SetIsOpenAsync(bool isOpen)
    {
        if (Disabled || IsOpen == isOpen)
        {
            return;
        }

        IsOpen = isOpen;
        await IsOpenChanged.InvokeAsync(isOpen);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && Collapsible && IsOpen)
        {
            await Close();
        }
    }

    [JSInvokable]
    public Task HandleResize(double width)
    {
        return SetWidth((int)Math.Round(width));
    }

    public async Task SetWidth(int width)
    {
        if (Disabled)
        {
            return;
        }

        var nextWidth = Math.Clamp(width, EffectiveMinWidth, EffectiveMaxWidth);
        if (nextWidth == _currentWidth)
        {
            return;
        }

        _currentWidth = nextWidth;
        Width = nextWidth;
        _lastWidthParameter = nextWidth;
        await WidthChanged.InvokeAsync(nextWidth);

        if (_resizeModule is not null && EffectivePersistenceKey is string key)
        {
            try
            {
                await _resizeModule.InvokeVoidAsync("save", key, nextWidth);
            }
            catch (Exception exception) when (IsRecoverableJsInteropException(exception))
            {
            }
        }

        StateHasChanged();
    }

    private async Task HandleResizeKeyDown(KeyboardEventArgs e)
    {
        var delta = (Position, e.Key) switch
        {
            (SidebarPosition.Left, "ArrowLeft") => -10,
            (SidebarPosition.Left, "ArrowRight") => 10,
            (SidebarPosition.Right, "ArrowLeft") => 10,
            (SidebarPosition.Right, "ArrowRight") => -10,
            _ => 0
        };

        if (delta != 0)
        {
            await SetWidth(_currentWidth + delta);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        await DisconnectResizeAsync();
        if (_resizeModule is not null)
        {
            try
            {
                await _resizeModule.DisposeAsync();
            }
            catch (Exception exception) when (IsRecoverableJsInteropException(exception))
            {
            }
        }

        _dotNetReference?.Dispose();
    }

    private async Task DisconnectResizeAsync()
    {
        if (!_resizeConnected || _resizeModule is null)
        {
            return;
        }

        try
        {
            await _resizeModule.InvokeVoidAsync("disconnect", _rootReference);
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }

        _resizeConnected = false;
        _connectedPosition = null;
    }

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;

    public enum SidebarPosition
    {
        Left,
        Right
    }
}
