@namespace Vibe.UI.Components
@inherits Vibe.UI.Base.VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="@CombinedClass" data-state="@CurrentState" @attributes="AdditionalAttributes">
    <button type="button"
         class="@EffectiveTriggerClass"
         disabled="@Disabled"
         aria-label="@TriggerAriaLabel"
         aria-haspopup="menu"
         aria-expanded="@AriaExpanded"
         aria-controls="@ContentId"
         aria-disabled="@AriaDisabled"
         data-state="@CurrentState"
         @ref="_triggerReference"
         @onclick="ToggleMenu"
         @onkeydown="HandleTriggerKeyDown">
        @if (Trigger != null)
        {
            @Trigger
        }
        else
        {
            <span class="vibe-menu-default-trigger">Menu</span>
            <Icon Name="chevron-down" Size="16" />
        }
    </button>

    @if (_isOpen)
    {
        <div id="@ContentId"
             class="vibe-menu-content"
             role="menu"
             tabindex="-1"
             aria-label="@EffectiveMenuAriaLabel"
             aria-orientation="vertical"
             data-state="open"
             style="@PlacementStyle"
             @ref="_contentReference"
             @onclick="HandleMenuContentClick"
             @onkeydown="HandleMenuKeyDown">
            @ChildContent
        </div>
        @if (CloseOnClickOutside)
        {
            <div class="menu-backdrop" aria-hidden="true" @onclick="HandleBackdropClick"></div>
        }
    }
</div>

@code {
    private const string KeyboardModulePath = "./_content/Vibe.UI/js/vibe-menu-keyboard.js";

    private readonly string ContentId = $"vibe-menu-content-{Guid.NewGuid():N}";
    private bool _hasAppliedInitialIsOpen;
    private bool _isOpen;
    private bool _lastIsOpenParameter;
    private ElementReference _triggerReference;
    private ElementReference _contentReference;
    private PendingFocus _pendingFocus;
    private bool _restoreTriggerFocus;
    private IJSObjectReference? _keyboardModule;

    /// <summary>
    /// Gets or sets the menu content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the trigger content
    /// </summary>
    [Parameter]
    public RenderFragment? Trigger { get; set; }

    /// <summary>
    /// Gets or sets additional classes applied to the trigger button.
    /// </summary>
    [Parameter]
    public string? TriggerClass { get; set; }

    /// <summary>
    /// Gets or sets an accessible name for triggers without visible text.
    /// </summary>
    [Parameter]
    public string? TriggerAriaLabel { get; set; }

    /// <summary>
    /// Gets or sets whether the menu is open
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Gets or sets the callback when menu open state changes
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>
    /// Gets or sets whether the menu trigger is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the menu placement
    /// </summary>
    [Parameter]
    public MenuPlacement Placement { get; set; } = MenuPlacement.BottomStart;

    /// <summary>
    /// Gets or sets whether to close menu after item selection
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = true;

    /// <summary>
    /// Gets or sets whether to close menu when clicking outside
    /// </summary>
    [Parameter]
    public bool CloseOnClickOutside { get; set; } = true;

    /// <summary>
    /// Gets or sets the accessible label for the menu content.
    /// </summary>
    [Parameter]
    public string? MenuAriaLabel { get; set; } = "Menu";

    /// <inheritdoc/>
    protected override string ComponentClass => "vibe-menu";

    /// <inheritdoc/>
    protected override string GetCombinedClass()
    {
        return CombineClasses(
            ComponentClass,
            _isOpen ? "vibe-menu-open" : null,
            Disabled ? "vibe-menu-disabled" : null,
            Class);
    }

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        if (!_hasAppliedInitialIsOpen || IsOpen != _lastIsOpenParameter)
        {
            _isOpen = IsOpen;
            _lastIsOpenParameter = IsOpen;
            _hasAppliedInitialIsOpen = true;
        }

        if (Disabled && _isOpen)
        {
            _isOpen = false;
            _lastIsOpenParameter = false;
            _pendingFocus = PendingFocus.None;
            _restoreTriggerFocus = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        try
        {
            var module = await GetKeyboardModuleAsync();
            await module.InvokeVoidAsync("initializeTrigger", _triggerReference, false, false);

            if (_isOpen)
            {
                await module.InvokeVoidAsync("initializeContainer", _contentReference, "menu");

                if (_pendingFocus == PendingFocus.First)
                {
                    await module.InvokeVoidAsync("focusFirstItem", _contentReference, "menu");
                    _pendingFocus = PendingFocus.None;
                }
                else if (_pendingFocus == PendingFocus.Last)
                {
                    await module.InvokeVoidAsync("focusLastItem", _contentReference, "menu");
                    _pendingFocus = PendingFocus.None;
                }
            }
            else if (_restoreTriggerFocus)
            {
                await _triggerReference.FocusAsync();
                _restoreTriggerFocus = false;
            }
        }
        catch (Exception ex) when (IsRecoverableJsInteropException(ex))
        {
            // JS interop is unavailable (prerendering, circuit teardown, or navigation).
        }
    }

    private string EffectiveTriggerClass => CombineClasses(
        "vibe-menu-trigger",
        Disabled ? "vibe-menu-trigger-disabled" : null,
        TriggerClass);

    private string AriaExpanded => _isOpen ? "true" : "false";

    private string AriaDisabled => Disabled ? "true" : "false";

    private string CurrentState => _isOpen ? "open" : "closed";

    private string EffectiveMenuAriaLabel => string.IsNullOrWhiteSpace(MenuAriaLabel)
        ? "Menu"
        : MenuAriaLabel;

    private string PlacementStyle => Placement switch
    {
        MenuPlacement.BottomStart => "top: 100%; left: 0; margin-top: 0.25rem;",
        MenuPlacement.BottomEnd => "top: 100%; right: 0; margin-top: 0.25rem;",
        MenuPlacement.TopStart => "bottom: 100%; left: 0; margin-bottom: 0.25rem;",
        MenuPlacement.TopEnd => "bottom: 100%; right: 0; margin-bottom: 0.25rem;",
        _ => "top: 100%; left: 0; margin-top: 0.25rem;"
    };

    private Task ToggleMenu()
    {
        if (Disabled)
        {
            return Task.CompletedTask;
        }

        return _isOpen ? CloseMenu() : OpenMenu(PendingFocus.First);
    }

    private async Task HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                await OpenMenu(PendingFocus.First);
                break;
            case "ArrowUp":
                await OpenMenu(PendingFocus.Last);
                break;
            case "Escape":
                await CloseMenu(restoreTriggerFocus: true);
                break;
        }
    }

    private async Task HandleMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Tab")
        {
            await CloseMenu();
            return;
        }

        if (e.Key == "Escape")
        {
            await CloseMenu(restoreTriggerFocus: true);
            return;
        }

        var module = await GetKeyboardModuleAsync();
        switch (e.Key)
        {
            case "ArrowDown":
                await module.InvokeVoidAsync("moveFocus", _contentReference, "menu", 1);
                break;
            case "ArrowUp":
                await module.InvokeVoidAsync("moveFocus", _contentReference, "menu", -1);
                break;
            case "Home":
                await module.InvokeVoidAsync("focusFirstItem", _contentReference, "menu");
                break;
            case "End":
                await module.InvokeVoidAsync("focusLastItem", _contentReference, "menu");
                break;
            default:
                if (IsTypeaheadKey(e))
                {
                    await module.InvokeVoidAsync("focusByTypeahead", _contentReference, "menu", e.Key);
                }
                break;
        }
    }

    private Task HandleMenuContentClick()
    {
        return CloseOnSelect ? CloseMenu(restoreTriggerFocus: true) : Task.CompletedTask;
    }

    private Task HandleBackdropClick()
    {
        return CloseMenu();
    }

    private Task OpenMenu(PendingFocus pendingFocus)
    {
        if (_isOpen)
        {
            // Already open (e.g. Arrow key repeated on the trigger) - avoid re-queuing
            // a stale pending-focus request that would yank focus on the next render.
            return Task.CompletedTask;
        }

        _pendingFocus = pendingFocus;
        _restoreTriggerFocus = false;
        return SetOpenStateAsync(true);
    }

    private Task CloseMenu(bool restoreTriggerFocus = false)
    {
        _pendingFocus = PendingFocus.None;
        _restoreTriggerFocus = restoreTriggerFocus;
        return SetOpenStateAsync(false);
    }

    private async Task SetOpenStateAsync(bool isOpen)
    {
        if (Disabled && isOpen)
        {
            return;
        }

        if (_isOpen == isOpen)
        {
            return;
        }

        _isOpen = isOpen;
        await IsOpenChanged.InvokeAsync(isOpen);
    }

    private async ValueTask<IJSObjectReference> GetKeyboardModuleAsync()
    {
        _keyboardModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", KeyboardModulePath);
        return _keyboardModule;
    }

    private static bool IsTypeaheadKey(KeyboardEventArgs e)
    {
        return e.Key.Length == 1 &&
               !char.IsWhiteSpace(e.Key[0]) &&
               !e.AltKey &&
               !e.CtrlKey &&
               !e.MetaKey;
    }

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;

    public async ValueTask DisposeAsync()
    {
        if (_keyboardModule != null)
        {
            try
            {
                await _keyboardModule.DisposeAsync();
            }
            catch (Exception ex) when (IsRecoverableJsInteropException(ex))
            {
            }
        }

        GC.SuppressFinalize(this);
    }

    private enum PendingFocus
    {
        None,
        First,
        Last
    }

    public enum MenuPlacement
    {
        BottomStart,
        BottomEnd,
        TopStart,
        TopEnd
    }
}
