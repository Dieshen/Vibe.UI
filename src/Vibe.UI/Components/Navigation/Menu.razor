@namespace Vibe.UI.Components
@inherits Vibe.UI.Base.VibeComponent

<div class="@CombinedClass" data-state="@CurrentState" @attributes="AdditionalAttributes">
    <div class="@TriggerClass"
         role="button"
         tabindex="@TriggerTabIndex"
         aria-haspopup="menu"
         aria-expanded="@AriaExpanded"
         aria-controls="@ContentId"
         aria-disabled="@AriaDisabled"
         data-state="@CurrentState"
         @onclick="ToggleMenu"
         @onkeydown="HandleTriggerKeyDown">
        @if (Trigger != null)
        {
            @Trigger
        }
        else
        {
            <span class="vibe-button vibe-menu-default-trigger">
                Menu
            </span>
        }
    </div>

    @if (_isOpen)
    {
        <div id="@ContentId"
             class="vibe-menu-content"
             role="menu"
             tabindex="-1"
             aria-label="@EffectiveMenuAriaLabel"
             aria-orientation="vertical"
             data-state="open"
             style="@PlacementStyle"
             @onclick="HandleMenuContentClick"
             @onkeydown="HandleMenuKeyDown">
            @ChildContent
        </div>
        @if (CloseOnClickOutside)
        {
            <div class="menu-backdrop" aria-hidden="true" @onclick="CloseMenu"></div>
        }
    }
</div>

@code {
    private readonly string ContentId = $"vibe-menu-content-{Guid.NewGuid():N}";
    private bool _hasAppliedInitialIsOpen;
    private bool _isOpen;
    private bool _lastIsOpenParameter;

    /// <summary>
    /// Gets or sets the menu content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the trigger content
    /// </summary>
    [Parameter]
    public RenderFragment? Trigger { get; set; }

    /// <summary>
    /// Gets or sets whether the menu is open
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Gets or sets the callback when menu open state changes
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>
    /// Gets or sets whether the menu trigger is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the menu placement
    /// </summary>
    [Parameter]
    public MenuPlacement Placement { get; set; } = MenuPlacement.BottomStart;

    /// <summary>
    /// Gets or sets whether to close menu after item selection
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = true;

    /// <summary>
    /// Gets or sets whether to close menu when clicking outside
    /// </summary>
    [Parameter]
    public bool CloseOnClickOutside { get; set; } = true;

    /// <summary>
    /// Gets or sets the accessible label for the menu content.
    /// </summary>
    [Parameter]
    public string? MenuAriaLabel { get; set; } = "Menu";

    /// <inheritdoc/>
    protected override string ComponentClass => "vibe-menu";

    /// <inheritdoc/>
    protected override string GetCombinedClass()
    {
        return CombineClasses(
            ComponentClass,
            _isOpen ? "vibe-menu-open" : null,
            Disabled ? "vibe-menu-disabled" : null,
            Class);
    }

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        if (!_hasAppliedInitialIsOpen || IsOpen != _lastIsOpenParameter)
        {
            _isOpen = IsOpen;
            _lastIsOpenParameter = IsOpen;
            _hasAppliedInitialIsOpen = true;
        }

        if (Disabled && _isOpen)
        {
            _isOpen = false;
            _lastIsOpenParameter = false;
        }
    }

    private string TriggerClass => CombineClasses(
        "vibe-menu-trigger",
        Disabled ? "vibe-menu-trigger-disabled" : null);

    private string AriaExpanded => _isOpen ? "true" : "false";

    private string AriaDisabled => Disabled ? "true" : "false";

    private string CurrentState => _isOpen ? "open" : "closed";

    private string TriggerTabIndex => Disabled ? "-1" : "0";

    private string EffectiveMenuAriaLabel => string.IsNullOrWhiteSpace(MenuAriaLabel)
        ? "Menu"
        : MenuAriaLabel;

    private string PlacementStyle => Placement switch
    {
        MenuPlacement.BottomStart => "top: 100%; left: 0; margin-top: 0.25rem;",
        MenuPlacement.BottomEnd => "top: 100%; right: 0; margin-top: 0.25rem;",
        MenuPlacement.TopStart => "bottom: 100%; left: 0; margin-bottom: 0.25rem;",
        MenuPlacement.TopEnd => "bottom: 100%; right: 0; margin-bottom: 0.25rem;",
        _ => "top: 100%; left: 0; margin-top: 0.25rem;"
    };

    private async Task ToggleMenu()
    {
        if (Disabled)
        {
            return;
        }

        await SetOpenStateAsync(!_isOpen);
    }

    private async Task HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        if (e.Key is "Enter" or " " or "Spacebar")
        {
            await ToggleMenu();
        }
        else if (e.Key is "ArrowDown" or "ArrowUp")
        {
            await OpenMenu();
        }
        else if (e.Key == "Escape")
        {
            await CloseMenu();
        }
    }

    private async Task HandleMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseMenu();
        }
    }

    private async Task HandleMenuContentClick()
    {
        if (CloseOnSelect)
        {
            await CloseMenu();
        }
    }

    private Task OpenMenu()
    {
        return SetOpenStateAsync(true);
    }

    private async Task CloseMenu()
    {
        await SetOpenStateAsync(false);
    }

    private async Task SetOpenStateAsync(bool isOpen)
    {
        if (Disabled && isOpen)
        {
            return;
        }

        if (_isOpen == isOpen)
        {
            return;
        }

        _isOpen = isOpen;
        _lastIsOpenParameter = isOpen;
        await IsOpenChanged.InvokeAsync(isOpen);
    }

    public enum MenuPlacement
    {
        BottomStart,
        BottomEnd,
        TopStart,
        TopEnd
    }
}
