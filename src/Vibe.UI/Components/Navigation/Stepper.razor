@namespace Vibe.UI.Components
@inherits Vibe.UI.Base.VibeComponent

<nav class="@CombinedClass @OrientationClass" aria-label="@AriaLabel" aria-orientation="@OrientationAttribute" @attributes="AdditionalAttributes">
    @if (Steps != null && Steps.Any())
    {
        <ol class="vibe-stepper-list" role="list">
            @for (int i = 0; i < Steps.Count; i++)
            {
                var step = Steps[i];
                var index = i;
                var status = GetStepStatus(i);
                var isStepDisabled = IsStepDisabled(step);
                var statusClass = status switch
                {
                    StepStatus.Completed => "vibe-stepper-item-completed",
                    StepStatus.Active => "vibe-stepper-item-active",
                    StepStatus.Error => "vibe-stepper-item-error",
                    _ => ""
                };

                <li class="vibe-stepper-item @statusClass @(isStepDisabled ? "vibe-stepper-item-disabled" : "")"
                    role="listitem"
                    aria-current="@GetAriaCurrent(status)"
                    aria-invalid="@GetAriaInvalid(status)"
                    aria-disabled="@GetAriaDisabled(isStepDisabled)"
                    aria-posinset="@(index + 1)"
                    aria-setsize="@Steps.Count">
                    @if (Orientation == StepperOrientation.Horizontal && i > 0)
                    {
                        <div class="vibe-stepper-connector" aria-hidden="true"></div>
                    }

                    <div class="vibe-stepper-indicator-wrapper">
                        <button type="button"
                                class="vibe-stepper-indicator"
                                disabled="@(!CanActivateStep(step))"
                                aria-label="@GetStepAriaLabel(step, index, status)"
                                aria-describedby="@GetDescriptionId(index, step)"
                                aria-disabled="@AriaBool(!CanActivateStep(step))"
                                @onclick="() => HandleStepClick(index)"
                                @onkeydown="e => HandleStepKeyDown(e, index)"
                                style="@(CanActivateStep(step) ? "cursor: pointer;" : "")">
                            @if (!string.IsNullOrEmpty(step.Icon))
                            {
                                <span aria-hidden="true">@step.Icon</span>
                            }
                            else if (status == StepStatus.Completed)
                            {
                                <span aria-hidden="true">✓</span>
                            }
                            else if (status == StepStatus.Error)
                            {
                                <span aria-hidden="true">!</span>
                            }
                            else
                            {
                                <span aria-hidden="true">@(index + 1)</span>
                            }
                        </button>

                        <div class="vibe-stepper-content">
                            <div class="vibe-stepper-label" id="@GetLabelId(index)">@step.Label</div>
                            @if (!string.IsNullOrEmpty(step.Description))
                            {
                                <div class="vibe-stepper-description" id="@GetDescriptionId(index, step)">@step.Description</div>
                            }
                        </div>
                    </div>

                    @if (Orientation == StepperOrientation.Vertical && i < Steps.Count - 1)
                    {
                        <div class="vibe-stepper-connector" aria-hidden="true"></div>
                    }
                </li>
            }
        </ol>
    }
</nav>

@code {
    /// <summary>
    /// Gets or sets the current active step (0-indexed)
    /// </summary>
    [Parameter]
    public int CurrentStep { get; set; }

    /// <summary>
    /// Gets or sets the callback when current step changes
    /// </summary>
    [Parameter]
    public EventCallback<int> CurrentStepChanged { get; set; }

    /// <summary>
    /// Gets or sets the list of steps
    /// </summary>
    [Parameter]
    public List<StepItem>? Steps { get; set; }

    /// <summary>
    /// Gets or sets the stepper orientation
    /// </summary>
    [Parameter]
    public StepperOrientation Orientation { get; set; } = StepperOrientation.Horizontal;

    /// <summary>
    /// Gets or sets whether steps are clickable
    /// </summary>
    [Parameter]
    public bool Clickable { get; set; }

    /// <summary>
    /// Gets or sets the callback when a step is clicked
    /// </summary>
    [Parameter]
    public EventCallback<int> OnStepClick { get; set; }

    /// <summary>
    /// Gets or sets the accessible label for the progress navigation.
    /// </summary>
    [Parameter]
    public string AriaLabel { get; set; } = "Progress";

    /// <inheritdoc/>
    protected override string ComponentClass => "vibe-stepper";

    private readonly string _componentId = $"vibe-stepper-{Guid.NewGuid():N}";

    private string OrientationClass => Orientation switch
    {
        StepperOrientation.Vertical => "vibe-stepper-vertical",
        StepperOrientation.Horizontal => "vibe-stepper-horizontal",
        _ => "vibe-stepper-horizontal"
    };

    private string OrientationAttribute => Orientation == StepperOrientation.Vertical ? "vertical" : "horizontal";

    private StepStatus GetStepStatus(int index)
    {
        if (Steps == null || index >= Steps.Count)
            return StepStatus.Pending;

        var step = Steps[index];

        // If step has explicit status, use it
        if (step.Status != StepStatus.Auto)
            return step.Status;

        // Otherwise, determine based on current step
        if (index < CurrentStep)
            return StepStatus.Completed;
        else if (index == CurrentStep)
            return StepStatus.Active;
        else
            return StepStatus.Pending;
    }

    private async Task HandleStepClick(int stepIndex)
    {
        if (Steps == null || stepIndex < 0 || stepIndex >= Steps.Count || !CanActivateStep(Steps[stepIndex]))
            return;

        if (OnStepClick.HasDelegate)
        {
            await OnStepClick.InvokeAsync(stepIndex);
        }

        if (CurrentStepChanged.HasDelegate)
        {
            await CurrentStepChanged.InvokeAsync(stepIndex);
        }
        else
        {
            CurrentStep = stepIndex;
        }
    }

    private async Task HandleStepKeyDown(KeyboardEventArgs e, int stepIndex)
    {
        if (e.Key is "Enter" or " ")
        {
            await HandleStepClick(stepIndex);
        }
    }

    private bool CanActivateStep(StepItem step)
    {
        return Clickable && !IsStepDisabled(step);
    }

    private static bool IsStepDisabled(StepItem step)
    {
        return step.Disabled;
    }

    private string GetStepAriaLabel(StepItem step, int index, StepStatus status)
    {
        var label = string.IsNullOrWhiteSpace(step.Label) ? $"Step {index + 1}" : step.Label;
        return $"{label}, step {index + 1} of {Steps?.Count ?? 0}, {GetStatusText(status)}";
    }

    private static string GetStatusText(StepStatus status)
    {
        return status switch
        {
            StepStatus.Active => "current",
            StepStatus.Completed => "completed",
            StepStatus.Error => "error",
            _ => "pending"
        };
    }

    private static string? GetAriaCurrent(StepStatus status)
    {
        return status == StepStatus.Active ? "step" : null;
    }

    private static string? GetAriaInvalid(StepStatus status)
    {
        return status == StepStatus.Error ? "true" : null;
    }

    private static string? GetAriaDisabled(bool disabled)
    {
        return disabled ? "true" : null;
    }

    private static string AriaBool(bool value)
    {
        return value ? "true" : "false";
    }

    private string GetLabelId(int index)
    {
        return $"{_componentId}-label-{index}";
    }

    private string? GetDescriptionId(int index, StepItem step)
    {
        return string.IsNullOrEmpty(step.Description) ? null : $"{_componentId}-description-{index}";
    }

    public enum StepperOrientation
    {
        Horizontal,
        Vertical
    }

    public enum StepStatus
    {
        Auto,
        Pending,
        Active,
        Completed,
        Error
    }

    public class StepItem
    {
        public string Label { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? Icon { get; set; }
        public StepStatus Status { get; set; } = StepStatus.Auto;
        public bool Disabled { get; set; }
    }
}
