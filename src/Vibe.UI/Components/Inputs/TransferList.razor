@namespace Vibe.UI.Components
@inherits VibeComponent
@typeparam TItem

<div @attributes="AdditionalAttributes" class="@CombinedCssClass" role="group" aria-label="@AriaLabel">
    <div class="transfer-panel">
        <div class="transfer-panel-header">
            <h4 id="@_sourceTitleId" class="panel-title">@SourceTitle</h4>
            <span class="panel-count">@SourceItems.Count</span>
        </div>
        @if (ShowSearch)
        {
            <div class="transfer-search">
                <input type="text" class="search-input" placeholder="@SearchPlaceholder" @bind="_sourceSearch"
                    @bind:event="oninput" aria-label="@($"{SourceTitle} search")" />
            </div>
        }
        <div class="transfer-list" role="listbox" aria-multiselectable="true" aria-labelledby="@_sourceTitleId">
            @{
                var filteredSourceItems = GetFilteredSourceItems().ToList();
            }
            @if (filteredSourceItems.Count == 0)
            {
                <div class="transfer-empty" role="status">No @SourceTitle.ToLowerInvariant() items found</div>
            }
            @foreach (var item in filteredSourceItems)
            {
                var isSelected = _selectedSource.Contains(item);
                <div class="transfer-item @(isSelected ? "selected" : "")" @key="GetItemKey(item)"
                    role="option"
                    tabindex="0"
                    aria-selected="@isSelected.ToString().ToLowerInvariant()"
                    @onclick="() => ToggleSourceSelection(item)"
                    @onkeydown="(e) => HandleSourceItemKeyDown(e, item)">
                    @if (ShowCheckboxes)
                    {
                        <input type="checkbox" checked="@isSelected" class="item-checkbox" tabindex="-1" aria-hidden="true" />
                    }
                    <div class="item-content">
                        @if (ItemTemplate != null)
                        {
                            @ItemTemplate(item)
                        }
                        else
                        {
                            <span>@GetItemText(item)</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="transfer-controls">
        <button type="button" class="transfer-btn" @onclick="MoveAllToTarget" disabled="@(!SourceItems.Any())"
            aria-label="@($"Move all {SourceTitle} items to {TargetTitle}")"
            title="Move all to target">
            ≫
        </button>
        <button type="button" class="transfer-btn" @onclick="MoveToTarget" disabled="@(!_selectedSource.Any())"
            aria-label="@($"Move selected {SourceTitle} items to {TargetTitle}")"
            title="Move selected to target">
            &gt;
        </button>
        <button type="button" class="transfer-btn" @onclick="MoveToSource" disabled="@(!_selectedTarget.Any())"
            aria-label="@($"Move selected {TargetTitle} items to {SourceTitle}")"
            title="Move selected to source">
            &lt;
        </button>
        <button type="button" class="transfer-btn" @onclick="MoveAllToSource" disabled="@(!TargetItems.Any())"
            aria-label="@($"Move all {TargetTitle} items to {SourceTitle}")"
            title="Move all to source">
            ≪
        </button>
    </div>

    <div class="transfer-panel">
        <div class="transfer-panel-header">
            <h4 id="@_targetTitleId" class="panel-title">@TargetTitle</h4>
            <span class="panel-count">@TargetItems.Count</span>
        </div>
        @if (ShowSearch)
        {
            <div class="transfer-search">
                <input type="text" class="search-input" placeholder="@SearchPlaceholder" @bind="_targetSearch"
                    @bind:event="oninput" aria-label="@($"{TargetTitle} search")" />
            </div>
        }
        <div class="transfer-list" role="listbox" aria-multiselectable="true" aria-labelledby="@_targetTitleId">
            @{
                var filteredTargetItems = GetFilteredTargetItems().ToList();
            }
            @if (filteredTargetItems.Count == 0)
            {
                <div class="transfer-empty" role="status">No @TargetTitle.ToLowerInvariant() items found</div>
            }
            @foreach (var item in filteredTargetItems)
            {
                var isSelected = _selectedTarget.Contains(item);
                <div class="transfer-item @(isSelected ? "selected" : "")" @key="GetItemKey(item)"
                    role="option"
                    tabindex="0"
                    aria-selected="@isSelected.ToString().ToLowerInvariant()"
                    @onclick="() => ToggleTargetSelection(item)"
                    @onkeydown="(e) => HandleTargetItemKeyDown(e, item)">
                    @if (ShowCheckboxes)
                    {
                        <input type="checkbox" checked="@isSelected" class="item-checkbox" tabindex="-1" aria-hidden="true" />
                    }
                    <div class="item-content">
                        @if (ItemTemplate != null)
                        {
                            @ItemTemplate(item)
                        }
                        else
                        {
                            <span>@GetItemText(item)</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private HashSet<TItem> _selectedSource = new();
    private HashSet<TItem> _selectedTarget = new();
    private string _sourceSearch = string.Empty;
    private string _targetSearch = string.Empty;
    private readonly string _sourceTitleId = $"transfer-source-title-{Guid.NewGuid():N}";
    private readonly string _targetTitleId = $"transfer-target-title-{Guid.NewGuid():N}";

    [Parameter]
    public List<TItem> SourceItems { get; set; } = new();

    [Parameter]
    public List<TItem> TargetItems { get; set; } = new();

    [Parameter]
    public EventCallback<List<TItem>> SourceItemsChanged { get; set; }

    [Parameter]
    public EventCallback<List<TItem>> TargetItemsChanged { get; set; }

    [Parameter]
    public RenderFragment<TItem>? ItemTemplate { get; set; }

    [Parameter]
    public Func<TItem, string>? TextSelector { get; set; }

    [Parameter]
    public Func<TItem, string>? KeySelector { get; set; }

    [Parameter]
    public string SourceTitle { get; set; } = "Available";

    [Parameter]
    public string TargetTitle { get; set; } = "Selected";

    [Parameter]
    public bool ShowSearch { get; set; } = true;

    [Parameter]
    public bool ShowCheckboxes { get; set; } = true;

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search...";

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Transfer items";

    private string CombinedCssClass => CombineClasses(
    "vibe-transfer",
    CssClass
    );

    protected override string ComponentClass => CombinedCssClass;

    protected override void OnParametersSet()
    {
        PruneSelections();
    }

    private string GetItemKey(TItem item)
    {
        if (KeySelector != null && item != null)
            return KeySelector(item);
        return item?.GetHashCode().ToString() ?? Guid.NewGuid().ToString();
    }

    private string GetItemText(TItem item)
    {
        if (TextSelector != null && item != null)
            return TextSelector(item);
        return item?.ToString() ?? string.Empty;
    }

    private IEnumerable<TItem> GetFilteredSourceItems()
    {
        if (string.IsNullOrWhiteSpace(_sourceSearch))
            return SourceItems;

        return SourceItems.Where(item =>
        GetItemText(item).Contains(_sourceSearch, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<TItem> GetFilteredTargetItems()
    {
        if (string.IsNullOrWhiteSpace(_targetSearch))
            return TargetItems;

        return TargetItems.Where(item =>
        GetItemText(item).Contains(_targetSearch, StringComparison.OrdinalIgnoreCase));
    }

    private void ToggleSourceSelection(TItem item)
    {
        if (_selectedSource.Contains(item))
            _selectedSource.Remove(item);
        else
            _selectedSource.Add(item);
    }

    private void ToggleTargetSelection(TItem item)
    {
        if (_selectedTarget.Contains(item))
            _selectedTarget.Remove(item);
        else
            _selectedTarget.Add(item);
    }

    private void HandleSourceItemKeyDown(KeyboardEventArgs e, TItem item)
    {
        if (IsSelectionKey(e.Key))
            ToggleSourceSelection(item);
    }

    private void HandleTargetItemKeyDown(KeyboardEventArgs e, TItem item)
    {
        if (IsSelectionKey(e.Key))
            ToggleTargetSelection(item);
    }

    private static bool IsSelectionKey(string key)
    {
        return key is "Enter" or " " or "Spacebar";
    }

    private async Task MoveToTarget()
    {
        var selectedItems = SourceItems.Where(item => _selectedSource.Contains(item)).ToList();
        if (selectedItems.Count == 0)
            return;

        foreach (var item in selectedItems)
        {
            SourceItems.Remove(item);
            TargetItems.Add(item);
        }

        _selectedSource.Clear();
        await SourceItemsChanged.InvokeAsync(SourceItems);
        await TargetItemsChanged.InvokeAsync(TargetItems);
    }

    private async Task MoveToSource()
    {
        var selectedItems = TargetItems.Where(item => _selectedTarget.Contains(item)).ToList();
        if (selectedItems.Count == 0)
            return;

        foreach (var item in selectedItems)
        {
            TargetItems.Remove(item);
            SourceItems.Add(item);
        }

        _selectedTarget.Clear();
        await SourceItemsChanged.InvokeAsync(SourceItems);
        await TargetItemsChanged.InvokeAsync(TargetItems);
    }

    private async Task MoveAllToTarget()
    {
        if (!SourceItems.Any())
            return;

        TargetItems.AddRange(SourceItems);
        SourceItems.Clear();
        _selectedSource.Clear();
        await SourceItemsChanged.InvokeAsync(SourceItems);
        await TargetItemsChanged.InvokeAsync(TargetItems);
    }

    private async Task MoveAllToSource()
    {
        if (!TargetItems.Any())
            return;

        SourceItems.AddRange(TargetItems);
        TargetItems.Clear();
        _selectedTarget.Clear();
        await SourceItemsChanged.InvokeAsync(SourceItems);
        await TargetItemsChanged.InvokeAsync(TargetItems);
    }

    private void PruneSelections()
    {
        _selectedSource.RemoveWhere(item => !SourceItems.Contains(item));
        _selectedTarget.RemoveWhere(item => !TargetItems.Contains(item));
    }
}
