@namespace Vibe.UI.Components
@inherits VibeComponent

<div @attributes="AdditionalAttributes" class="@CombinedCssClass" role="group" aria-label="@AriaLabel"
    aria-disabled="@DisabledAriaValue" aria-describedby="@EffectiveDescribedBy" aria-invalid="@AriaInvalidValue"
    aria-errormessage="@EffectiveErrorMessageId">
    @for (int i = 0; i < _length; i++)
    {
        var index = i;
        <input @key="index" id="@(index == 0 ? EffectiveId : null)" type="@InputType" @ref="_inputs[index]" class="@GetSlotClass(index)" maxlength="@GetMaxLength(index)"
            value="@GetCharAt(index)" @oninput="@(e => HandleInput(index, e))"
            @onkeydown="@(e => HandleKeyDown(index, e))" disabled="@Disabled" readonly="@ReadOnly"
            inputmode="@InputMode" autocomplete="@GetAutocomplete(index)" aria-label="@GetSlotAriaLabel(index)"
            aria-invalid="@AriaInvalidValue" required="@EffectiveRequired" aria-required="@(EffectiveRequired ? "true" : null)" />

        @if (ShouldRenderSeparator(index))
        {
            <span class="input-otp-separator" aria-hidden="true">@Separator</span>
        }
    }
</div>

@code {
    private ElementReference[] _inputs = [];
    private char?[] _slots = [];
    private string _currentValue = string.Empty;
    private string? _lastCompletedValue;
    private int _length;

    /// <summary>
    /// Gets the relationships cascaded by an ancestor <see cref="FormField{TValue}"/>, if any.
    /// </summary>
    [CascadingParameter]
    private FormFieldContext? FieldContext { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public int Length { get; set; } = 6;

    [Parameter]
    public OTPPattern Pattern { get; set; } = OTPPattern.Numeric;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; } = "One-time password input";

    [Parameter]
    public string Separator { get; set; } = "-";

    [Parameter]
    public List<int>? SeparatorIndices { get; set; } = new();

    [Parameter]
    public EventCallback<string> OnComplete { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    private string InputType => Pattern == OTPPattern.Numeric ? "tel" : "text";

    private string InputMode => Pattern == OTPPattern.Numeric ? "numeric" : "text";

    private string? DisabledAriaValue => Disabled ? "true" : null;

    private string? EffectiveId => FieldContext?.ControlId;

    private string? EffectiveDescribedBy => FieldContext?.DescribedBy;

    private bool EffectiveRequired => FieldContext?.IsRequired == true;

    private string? AriaInvalidValue => FieldContext?.IsInvalid == true ? "true" : null;

    private string? EffectiveErrorMessageId => FieldContext?.IsInvalid == true && !string.IsNullOrWhiteSpace(FieldContext.ErrorId)
        ? FieldContext.ErrorId
        : null;

    private bool IsComplete => _length > 0 && _slots.Length == _length && _slots.All(slot => slot.HasValue);

    private string CombinedCssClass => CombineClasses(
    "input-otp",
    IsComplete ? "input-otp-complete" : null,
    Disabled ? "input-otp-disabled" : null,
    ReadOnly ? "input-otp-readonly" : null,
    CssClass,
    Class
    );

    protected override string ComponentClass => CombinedCssClass;

    protected override void OnParametersSet()
    {
        _length = Math.Max(0, Length);
        if (_inputs.Length != _length)
        {
            _inputs = new ElementReference[_length];
        }

        if (_slots.Length != _length)
        {
            _slots = new char?[_length];
        }

        ApplyValue(Value);
        _lastCompletedValue = IsComplete ? BuildCompletedValue() : null;
    }

    private string GetCharAt(int index)
    {
        return IsValidIndex(index) && _slots[index].HasValue
            ? _slots[index]!.Value.ToString()
            : string.Empty;
    }

    private string GetSlotClass(int index)
    {
        return CombineClasses(
        "input-otp-slot",
        !string.IsNullOrEmpty(GetCharAt(index)) ? "input-otp-slot-filled" : null
        );
    }

    private string GetSlotAriaLabel(int index)
    {
        var label = Pattern == OTPPattern.Numeric ? "Digit" : "Character";
        return $"{label} {index + 1} of {_length}";
    }

    private int GetMaxLength(int index) => Math.Max(1, _length - index);

    private static string GetAutocomplete(int index) => index == 0 ? "one-time-code" : "off";

    private bool ShouldRenderSeparator(int index)
    {
        if (index >= _length - 1 || string.IsNullOrEmpty(Separator))
        {
            return false;
        }

        if ((SeparatorIndices is null || SeparatorIndices.Count == 0) && _length > 3)
        {
            return index == (_length / 2) - 1;
        }

        return SeparatorIndices?.Contains(index) == true;
    }

    private async Task HandleInput(int index, ChangeEventArgs e)
    {
        if (Disabled || ReadOnly || !IsValidIndex(index))
        {
            return;
        }

        var inputValue = e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrEmpty(inputValue))
        {
            if (_slots[index].HasValue)
            {
                _slots[index] = null;
                await CommitSlotsAsync();
            }

            return;
        }

        var nextIndex = index;
        var acceptedInput = false;

        foreach (var character in inputValue)
        {
            if (nextIndex >= _length)
            {
                break;
            }

            if (!IsValidChar(character))
            {
                continue;
            }

            _slots[nextIndex] = character;
            nextIndex++;
            acceptedInput = true;
        }

        if (!acceptedInput)
        {
            StateHasChanged();
            return;
        }

        await CommitSlotsAsync();

        if (nextIndex < _length)
        {
            await FocusInput(nextIndex);
        }
    }

    private async Task HandleKeyDown(int index, KeyboardEventArgs e)
    {
        if (Disabled || !IsValidIndex(index))
        {
            return;
        }

        if (e.Key == "ArrowLeft" && index > 0)
        {
            await FocusInput(index - 1);
            return;
        }

        if (e.Key == "ArrowRight" && index < _length - 1)
        {
            await FocusInput(index + 1);
            return;
        }

        if (e.Key == "Home")
        {
            await FocusInput(0);
            return;
        }

        if (e.Key == "End")
        {
            await FocusInput(_length - 1);
            return;
        }

        if (ReadOnly)
        {
            return;
        }

        if (e.Key is "Backspace" or "Delete")
        {
            if (_slots[index].HasValue)
            {
                _slots[index] = null;
                await CommitSlotsAsync();
            }
            else if (e.Key == "Backspace" && index > 0)
            {
                await FocusInput(index - 1);
            }
        }
    }

    private async Task FocusInput(int index)
    {
        if (Disabled || !IsValidIndex(index))
        {
            return;
        }

        await _inputs[index].FocusAsync();
    }

    private void ApplyValue(string? value)
    {
        Array.Clear(_slots);

        if (_length == 0 || string.IsNullOrEmpty(value))
        {
            _currentValue = string.Empty;
            return;
        }

        var count = Math.Min(value.Length, _length);
        for (var i = 0; i < count; i++)
        {
            var character = value[i];
            if (IsEmptySlotValue(character))
            {
                continue;
            }

            if (IsValidChar(character))
            {
                _slots[i] = character;
            }
        }

        _currentValue = BuildValue();
    }

    private async Task CommitSlotsAsync()
    {
        var newValue = BuildValue();
        if (string.Equals(newValue, _currentValue, StringComparison.Ordinal))
        {
            return;
        }

        _currentValue = newValue;
        await ValueChanged.InvokeAsync(newValue);

        if (IsComplete)
        {
            var completedValue = BuildCompletedValue();
            if (!string.Equals(_lastCompletedValue, completedValue, StringComparison.Ordinal))
            {
                _lastCompletedValue = completedValue;
                await OnComplete.InvokeAsync(completedValue);
            }
        }
        else
        {
            _lastCompletedValue = null;
        }

        StateHasChanged();
    }

    private string BuildValue()
    {
        if (_length == 0)
        {
            return string.Empty;
        }

        // Preserve positional gaps for callbacks without rendering literal spaces in empty slots.
        var characters = new char[_length];
        for (var i = 0; i < _length; i++)
        {
            characters[i] = _slots[i] ?? ' ';
        }

        return new string(characters).TrimEnd();
    }

    private string BuildCompletedValue()
    {
        var characters = new char[_length];
        for (var i = 0; i < _length; i++)
        {
            characters[i] = _slots[i]!.Value;
        }

        return new string(characters);
    }

    private bool IsValidIndex(int index)
    {
        return index >= 0 && index < _length;
    }

    private bool IsValidChar(char c)
    {
        if (IsEmptySlotValue(c) || char.IsControl(c))
        {
            return false;
        }

        return Pattern switch
        {
            OTPPattern.Numeric => char.IsDigit(c),
            OTPPattern.Alphanumeric => char.IsLetterOrDigit(c),
            OTPPattern.Alpha => char.IsLetter(c),
            _ => true
        };
    }

    private static bool IsEmptySlotValue(char c)
    {
        return char.IsWhiteSpace(c);
    }

    public enum OTPPattern
    {
        Numeric,
        Alphanumeric,
        Alpha,
        Any
    }
}
