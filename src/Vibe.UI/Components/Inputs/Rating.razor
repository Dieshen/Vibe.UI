@namespace Vibe.UI.Components
@inherits VibeComponent

<div @attributes="AdditionalAttributes" class="@CombinedCssClass" role="radiogroup" aria-label="@AriaLabel"
    aria-disabled="@AriaBool(Disabled)" aria-readonly="@AriaBool(ReadOnly)">
    @for (int i = 1; i <= EffectiveMaxRating; i++)
    {
        var index = i;
        var displayValue = DisplayValue;
        var isFilled = AllowHalf ? index <= displayValue : (int)Math.Ceiling(displayValue) >= index;
        var isHalfFilled = AllowHalf && displayValue >= index - 0.5 && displayValue < index;

        <button type="button" class="rating-star @(isFilled ? "star-filled" : "") @(isHalfFilled ? "star-half" : "")"
            @onclick="() => HandleClick(index)" @onmouseenter="() => HandleHover(index)" @onmouseleave="HandleHoverEnd"
            disabled="@(Disabled || ReadOnly)" role="radio" aria-checked="@AriaBool(isFilled || isHalfFilled)"
            aria-label="@($"{index} star{(index > 1 ? "s" : "")}")">
            @if (CustomIcon != null)
            {
                @CustomIcon
            }
            else
            {
                <span class="star-icon">@(isFilled || isHalfFilled ? "★" : "☆")</span>
            }
        </button>
    }

    @if (ShowValue)
    {
        <span class="rating-value">@Value.ToString("0.#") / @EffectiveMaxRating</span>
    }
</div>

@code {
    private double _hoverValue;

    [Parameter]
    public double Value { get; set; }

    [Parameter]
    public EventCallback<double> ValueChanged { get; set; }

    [Parameter]
    public int MaxRating { get; set; } = 5;

    [Parameter]
    public bool AllowHalf { get; set; } = false;

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ShowValue { get; set; }

    [Parameter]
    public RatingSize Size { get; set; } = RatingSize.Default;

    [Parameter]
    public RenderFragment? CustomIcon { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; } = "Rating";

    [Parameter]
    public string? CssClass { get; set; }

    private string CombinedCssClass => CombineClasses(
    "vibe-rating",
    $"rating-{EffectiveSize.ToString().ToLowerInvariant()}",
    ReadOnly ? "rating-readonly" : null,
    Disabled ? "rating-disabled" : null,
    Class,
    CssClass
    );

    protected override string ComponentClass => CombinedCssClass;

    private int EffectiveMaxRating => Math.Max(0, MaxRating);

    private RatingSize EffectiveSize => Enum.IsDefined(typeof(RatingSize), Size) ? Size : RatingSize.Default;

    private double DisplayValue => _hoverValue > 0 ? _hoverValue : Value;

    private static string AriaBool(bool value) => value ? "true" : "false";

    private async Task HandleClick(int rating)
    {
        if (ReadOnly || Disabled) return;

        var newValue = AllowHalf && Value == rating ? rating - 0.5 : rating;
        Value = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }

    private void HandleHover(int rating)
    {
        if (!ReadOnly && !Disabled)
        {
            _hoverValue = rating;
            StateHasChanged();
        }
    }

    private void HandleHoverEnd()
    {
        _hoverValue = 0;
        StateHasChanged();
    }

    public enum RatingSize
    {
        Small,
        Default,
        Large
    }
}
