@namespace Vibe.UI.Components
@using System.Globalization
@inherits Vibe.UI.Base.VibeComponent

<div @attributes="AdditionalAttributes" class="@CombinedClass">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="vibe-slider-label" for="@ElementId">@Label</label>
    }

    <div class="vibe-slider-row">
        <div class="vibe-slider-control">
            <div class="vibe-slider-track">
                <div class="vibe-slider-range" style="width: calc((@GetPercentage()% * (100% - 1rem) / 100%) + 0.5rem);"></div>
            </div>
            <input
                id="@ElementId"
                type="range"
                class="vibe-slider-thumb"
                min="@FormatNumber(Min)"
                max="@FormatNumber(Max)"
                step="@FormatNumber(Step)"
                value="@FormatNumber(Value)"
                disabled="@Disabled"
                aria-label="@EffectiveAriaLabel"
                aria-valuemin="@FormatNumber(Min)"
                aria-valuemax="@FormatNumber(Max)"
                aria-valuenow="@FormatNumber(Value)"
                aria-describedby="@EffectiveDescribedBy"
                aria-invalid="@AriaInvalidValue"
                aria-errormessage="@EffectiveErrorMessageId"
                required="@EffectiveRequired"
                aria-required="@(EffectiveRequired ? "true" : null)"
                @oninput="HandleInputEvent"
                @onchange="HandleChangeEvent" />
        </div>

        @if (ShowValue)
        {
            <output class="vibe-slider-value" for="@ElementId">@FormatDisplayValue(Value)</output>
        }
    </div>
</div>

@code {
    private string _id = Guid.NewGuid().ToString();

    /// <summary>
    /// Gets the relationships cascaded by an ancestor <see cref="FormField{TValue}"/>, if any.
    /// </summary>
    [CascadingParameter]
    private FormFieldContext? FieldContext { get; set; }

    /// <summary>
    /// Gets or sets the ID of the slider
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the label text
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Gets or sets an accessible name that takes precedence over <see cref="Label"/>.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>
    /// Gets or sets the minimum value of the slider
    /// </summary>
    [Parameter]
    public double Min { get; set; } = 0;

    /// <summary>
    /// Gets or sets the maximum value of the slider
    /// </summary>
    [Parameter]
    public double Max { get; set; } = 100;

    /// <summary>
    /// Gets or sets the step value of the slider
    /// </summary>
    [Parameter]
    public double Step { get; set; } = 1;

    /// <summary>
    /// Gets or sets the current value of the slider
    /// </summary>
    [Parameter]
    public double Value { get; set; } = 0;

    /// <summary>
    /// Gets or sets whether the slider is disabled
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether to show the current value
    /// </summary>
    [Parameter]
    public bool ShowValue { get; set; } = true;

    /// <summary>
    /// Gets or sets the format string for the displayed value
    /// </summary>
    [Parameter]
    public string ValueFormat { get; set; } = "0.##";

    /// <summary>
    /// Gets or sets the callback for when the slider value changes
    /// </summary>
    [Parameter]
    public EventCallback<double> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets the callback for when the input event occurs
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnInput { get; set; }

    /// <summary>
    /// Gets or sets the callback for when the change event occurs
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    /// <inheritdoc/>
    protected override string ComponentClass => new ClassBuilder()
        .Add("vibe-slider")
        .AddIf("vibe-slider-disabled", Disabled)
        .AddIf("vibe-slider-error", FieldContext?.IsInvalid == true)
        .Build();

    /// <summary>
    /// Gets the ID of the slider element
    /// </summary>
    private string ElementId => FieldContext?.ControlId
        ?? (string.IsNullOrEmpty(Id) ? _id : Id);

    private bool EffectiveRequired => FieldContext?.IsRequired == true;

    private string? EffectiveDescribedBy => FieldContext?.DescribedBy;

    private string? AriaInvalidValue => FieldContext?.IsInvalid == true ? "true" : null;

    private string? EffectiveErrorMessageId => FieldContext?.IsInvalid == true && !string.IsNullOrWhiteSpace(FieldContext.ErrorId)
        ? FieldContext.ErrorId
        : null;

    private string? EffectiveAriaLabel
    {
        get
        {
            var value = string.IsNullOrWhiteSpace(AriaLabel) ? Label : AriaLabel;
            return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        }
    }

    /// <summary>
    /// Gets the percentage of the slider from the min/max range
    /// </summary>
    private string GetPercentage()
    {
        if (Min >= Max) return "0";

        double percentage = ((Value - Min) / (Max - Min)) * 100;
        return Math.Clamp(percentage, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    /// <summary>
    /// Handles the slider input event (during drag)
    /// </summary>
    private async Task HandleInputEvent(ChangeEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        if (TryGetEventValue(e, out double newValue))
        {
            Value = ClampValue(newValue);

            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(Value);
            }

            if (OnInput.HasDelegate)
            {
                await OnInput.InvokeAsync(e);
            }
        }
    }

    /// <summary>
    /// Handles the slider change event (after drag completes)
    /// </summary>
    private async Task HandleChangeEvent(ChangeEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        if (TryGetEventValue(e, out double newValue))
        {
            Value = ClampValue(newValue);

            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(Value);
            }

            if (OnChange.HasDelegate)
            {
                await OnChange.InvokeAsync(e);
            }
        }
    }

    private double ClampValue(double value)
    {
        if (Min > Max)
        {
            return value;
        }

        return Math.Clamp(value, Min, Max);
    }

    private static bool TryGetEventValue(ChangeEventArgs e, out double value)
    {
        return double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out value)
            || double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.CurrentCulture, out value);
    }

    private static string FormatNumber(double value) => value.ToString("0.################", CultureInfo.InvariantCulture);

    private string FormatDisplayValue(double value)
    {
        if (string.IsNullOrWhiteSpace(ValueFormat))
        {
            return FormatNumber(value);
        }

        try
        {
            return value.ToString(ValueFormat, CultureInfo.InvariantCulture);
        }
        catch (FormatException)
        {
            return FormatNumber(value);
        }
    }
}
