@namespace Vibe.UI.Components
@inherits Vibe.UI.Base.VibeComponent

<label class="@CombinedClass" aria-disabled="@(Disabled ? "true" : null)" @attributes="AdditionalAttributes">
    <input type="checkbox"
        id="@EffectiveId"
        name="@Name"
        value="@Value"
        class="vibe-checkbox-input"
        checked="@currentChecked"
        disabled="@Disabled"
        required="@EffectiveRequired"
        aria-label="@EffectiveAriaLabel"
        aria-checked="@AriaCheckedValue"
        aria-invalid="@AriaInvalidValue"
        aria-errormessage="@EffectiveErrorMessageId"
        aria-describedby="@EffectiveDescribedBy"
        aria-required="@(EffectiveRequired ? "true" : null)"
        data-indeterminate="@IndeterminateValue"
        @onchange="OnCheckboxChange" />
    <span class="vibe-checkbox-control" aria-hidden="true">
        @if (currentIndeterminate)
        {
            <Icon Name="minus" Size="12" />
        }
        else if (currentChecked)
        {
            <Icon Name="check" Size="12" />
        }
    </span>
    @if (ChildContent != null || NormalizedLabel is not null)
    {
        <span class="vibe-checkbox-label">
            @if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                @NormalizedLabel
            }
        </span>
    }
</label>

@code {
    private bool currentChecked;
    private bool currentIndeterminate;

    /// <summary>
    /// Gets the relationships cascaded by an ancestor <see cref="FormField{TValue}"/>, if any.
    /// </summary>
    [CascadingParameter]
    private FormFieldContext? FieldContext { get; set; }

    /// <summary>
    /// Gets or sets the label content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets a plain-text label. ChildContent takes precedence when both are provided.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Gets or sets whether the checkbox is checked
    /// </summary>
    [Parameter]
    public bool Checked { get; set; }

    /// <summary>
    /// Gets or sets the callback for when the checkbox state changes
    /// </summary>
    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>
    /// Gets or sets whether the checkbox represents a mixed selection.
    /// </summary>
    [Parameter]
    public bool Indeterminate { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when user interaction clears the mixed state.
    /// </summary>
    [Parameter]
    public EventCallback<bool> IndeterminateChanged { get; set; }

    /// <summary>
    /// Gets or sets the native change callback.
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    /// <summary>
    /// Gets or sets the checkbox input ID.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the checkbox form field name.
    /// </summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>
    /// Gets or sets the submitted checkbox value.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets whether the checkbox is required.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Gets or sets whether the checkbox is disabled
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets an accessible name when no visible label is rendered.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>
    /// Gets or sets whether the checkbox is in an invalid state.
    /// </summary>
    [Parameter]
    public bool AriaInvalid { get; set; }

    /// <inheritdoc/>
    protected override string ComponentClass => new ClassBuilder()
        .Add("vibe-checkbox")
        .AddIf("vibe-checkbox-disabled", Disabled)
        .AddIf("vibe-checkbox-indeterminate", currentIndeterminate)
        .AddIf("vibe-checkbox-error", EffectiveAriaInvalid)
        .Build();

    protected override void OnParametersSet()
    {
        currentChecked = Checked;
        currentIndeterminate = Indeterminate;
    }

    /// <summary>
    /// Handles the checkbox change event
    /// </summary>
    /// <param name="e">The checkbox change event</param>
    private async Task OnCheckboxChange(ChangeEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        if (e.Value is bool value)
        {
            currentChecked = value;

            if (currentIndeterminate)
            {
                currentIndeterminate = false;
                if (IndeterminateChanged.HasDelegate)
                {
                    await IndeterminateChanged.InvokeAsync(false);
                }
            }

            if (CheckedChanged.HasDelegate)
            {
                await CheckedChanged.InvokeAsync(value);
            }

            if (OnChange.HasDelegate)
            {
                await OnChange.InvokeAsync(e);
            }
        }
    }

    private string? NormalizedLabel => string.IsNullOrWhiteSpace(Label) ? null : Label.Trim();

    private string? EffectiveAriaLabel => string.IsNullOrWhiteSpace(AriaLabel) ? null : AriaLabel.Trim();

    private string AriaCheckedValue => currentIndeterminate ? "mixed" : currentChecked ? "true" : "false";

    private string? EffectiveId => FieldContext?.ControlId ?? Id;

    private string? EffectiveDescribedBy => FieldContext?.DescribedBy;

    private bool EffectiveRequired => Required || FieldContext?.IsRequired == true;

    private bool EffectiveAriaInvalid => AriaInvalid || FieldContext?.IsInvalid == true;

    private string? AriaInvalidValue => EffectiveAriaInvalid ? "true" : null;

    private string? EffectiveErrorMessageId => EffectiveAriaInvalid && !string.IsNullOrWhiteSpace(FieldContext?.ErrorId)
        ? FieldContext?.ErrorId
        : null;

    private string IndeterminateValue => currentIndeterminate ? "true" : "false";
}
