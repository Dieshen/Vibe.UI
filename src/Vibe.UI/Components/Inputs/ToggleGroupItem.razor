@namespace Vibe.UI.Components
@inherits VibeComponent
@implements IDisposable

<button id="@ElementId" type="button" @attributes="AdditionalAttributes" class="@CombinedCssClass"
    disabled="@IsEffectivelyDisabled" aria-pressed="@AriaBool(IsPressed)"
    aria-disabled="@AriaBool(IsEffectivelyDisabled)" tabindex="@TabIndex"
    @onclick="HandleClick" @onfocus="HandleFocus" @onkeydown="HandleKeyDown">
    @ChildContent
</button>

@code {
    private readonly string _generatedId = $"vibe-toggle-item-{Guid.NewGuid():N}";
    private ToggleGroup? _registeredParent;
    private string? _registeredValue;
    private bool _registeredDisabled;
    private bool _hasRegisteredState;

    /// <summary>
    /// The content of the toggle item.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The value of this toggle item.
    /// </summary>
    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    /// <summary>
    /// Whether this item is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Additional CSS classes to apply.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    [CascadingParameter]
    private ToggleGroup? Parent { get; set; }

    internal string EffectiveValue => Value ?? string.Empty;
    internal string ElementId => GetAdditionalAttributeId() ?? _generatedId;

    private bool IsPressed => Parent?.IsSelected(EffectiveValue) ?? false;
    internal bool IsEffectivelyDisabled => Disabled || (Parent?.Disabled ?? false);
    private int TabIndex => Parent?.GetItemTabIndex(this) ?? (IsEffectivelyDisabled ? -1 : 0);

    private string CombinedCssClass => CombineClasses(
    "vibe-toggle-group-item",
    IsPressed ? "vibe-toggle-group-item-pressed" : null,
    IsEffectivelyDisabled ? "vibe-toggle-group-item-disabled" : null,
    Class,
    CssClass
    );

    protected override string ComponentClass => CombinedCssClass;

    private static string AriaBool(bool value) => value ? "true" : "false";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!ReferenceEquals(_registeredParent, Parent))
        {
            _registeredParent?.RemoveItem(this);
            _registeredParent = Parent;
            _registeredParent?.RegisterItem(this);
            _hasRegisteredState = false;
        }

        if (_hasRegisteredState
            && (_registeredValue != EffectiveValue || _registeredDisabled != Disabled))
        {
            _registeredParent?.NotifyItemChanged(this);
        }

        _registeredValue = EffectiveValue;
        _registeredDisabled = Disabled;
        _hasRegisteredState = true;
    }

    private async Task HandleClick()
    {
        if (Parent != null && !IsEffectivelyDisabled)
        {
            Parent.HandleItemFocus(this);
            await Parent.HandleItemToggle(EffectiveValue);
        }
    }

    private void HandleFocus() => Parent?.HandleItemFocus(this);

    private Task HandleKeyDown(KeyboardEventArgs args) =>
        Parent?.HandleItemKeyDown(this, args) ?? Task.CompletedTask;

    private string? GetAdditionalAttributeId()
    {
        if (AdditionalAttributes?.TryGetValue("id", out var id) == true
            && id is not null
            && !string.IsNullOrWhiteSpace(id.ToString()))
        {
            return id.ToString();
        }

        return null;
    }

    public void Dispose()
    {
        _registeredParent?.RemoveItem(this);
        _registeredParent = null;
    }
}
