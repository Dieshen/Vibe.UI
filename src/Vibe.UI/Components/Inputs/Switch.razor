@namespace Vibe.UI.Components
@inherits Base.VibeComponent

<label class="@CombinedClass @(Disabled ? "disabled" : string.Empty)">
    <input type="checkbox" id="@Id" name="@Name" value="@Value" class="switch-input" role="switch"
        checked="@currentChecked" aria-checked="@currentChecked.ToString().ToLowerInvariant()" @onchange="OnToggleChanged" disabled="@Disabled"
        required="@Required"
        @attributes="AdditionalAttributes" />
    <span class="switch-thumb"></span>
</label>

@code {
    private bool currentChecked;

    /// <summary>
    /// Gets or sets whether the switch is checked.
    /// </summary>
    [Parameter]
    public bool Checked { get; set; }

    /// <summary>
    /// Gets or sets whether the switch is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the switch input ID.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the switch form field name.
    /// </summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>
    /// Gets or sets the submitted switch value.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets whether the switch is required.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Gets or sets the callback for when the switch value changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-switch";

    protected override void OnParametersSet()
    {
        currentChecked = Checked;
    }

    /// <summary>
    /// Handles the toggle of the switch.
    /// </summary>
    private Task OnToggleChanged(ChangeEventArgs e)
    {
        if (Disabled)
            return Task.CompletedTask;

        if (e.Value is not bool value)
            return Task.CompletedTask;

        currentChecked = value;
        return CheckedChanged.InvokeAsync(value);
    }
}
