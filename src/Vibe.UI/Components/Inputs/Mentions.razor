@namespace Vibe.UI.Components
@inherits VibeComponent

<div @attributes="AdditionalAttributes" class="@CombinedCssClass"
    aria-disabled="@(Disabled ? "true" : null)" data-state="@InteractionState">
    <div class="mentions-input-container">
        @foreach (var item in _displayItems)
        {
            if (item.IsMention)
            {
                <span class="mention-tag" @key="item.Key">
                    @GetPrefix(item.Type)@item.Text
                    @if (IsInteractive)
                    {
                        <button type="button" class="mention-remove" @onclick="() => RemoveMention(item.Index)"
                            aria-label="@($"Remove {item.Text}")">
                            <Icon Name="x" Size="14" />
                        </button>
                    }
                </span>
            }
            else
            {
                <span>@item.Text</span>
            }
        }

        <span class="mentions-input-shell" @onkeydown="HandleKeyDown">
            <input id="@EffectiveId" type="text" class="mentions-input" value="@_inputValue" @oninput="HandleInput"
                @onfocus="HandleFocus" @onblur="HandleBlur" placeholder="@Placeholder" disabled="@Disabled"
                readonly="@ReadOnly" aria-label="@EffectiveAriaLabel" aria-autocomplete="list" aria-haspopup="listbox"
                aria-controls="@_suggestionsId" aria-expanded="@(_showSuggestions ? "true" : "false")"
                aria-activedescendant="@ActiveSuggestionId" aria-readonly="@(ReadOnly ? "true" : null)"
                aria-disabled="@(Disabled ? "true" : null)" aria-describedby="@EffectiveDescribedBy"
                aria-invalid="@AriaInvalidValue" aria-errormessage="@EffectiveErrorMessageId"
                required="@EffectiveRequired" aria-required="@(EffectiveRequired ? "true" : null)"
                autocomplete="off" role="combobox"
                onkeydown="if (this.getAttribute('aria-expanded') === 'true' && (event.key === 'Enter' || event.key === 'ArrowDown' || event.key === 'ArrowUp')) event.preventDefault();" />
        </span>
    </div>

    @if (_showSuggestions && VisibleSuggestions.Any())
    {
        var suggestions = VisibleSuggestions;
        <div class="mentions-suggestions" id="@_suggestionsId" role="listbox"
            aria-label="@($"{EffectiveAriaLabel} suggestions")">
            @for (var i = 0; i < suggestions.Count; i++)
            {
                var suggestion = suggestions[i];
                var isActive = i == _activeSuggestionIndex;
                <button type="button" class="mention-suggestion @(isActive ? "active" : "")" id="@GetSuggestionId(i)"
                    role="option" aria-selected="@(isActive ? "true" : "false")" tabindex="-1"
                    @onpointerdown:preventDefault="true" @onclick="() => SelectSuggestion(suggestion)"
                    @key="GetSuggestionKey(suggestion, i)">
                    @if (suggestion.Avatar != null)
                    {
                        <div class="suggestion-avatar">@suggestion.Avatar</div>
                    }
                    <div class="suggestion-info">
                        <div class="suggestion-name">@suggestion.Name</div>
                        @if (!string.IsNullOrEmpty(suggestion.Description))
                        {
                            <div class="suggestion-description">@suggestion.Description</div>
                        }
                    </div>
                </button>
            }
        </div>
    }
</div>

@code {
    private string _inputValue = string.Empty;
    private bool _showSuggestions;
    private List<DisplayItem> _displayItems = new();
    private string _searchQuery = string.Empty;
    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private readonly List<MentionItem> _items = new();
    private List<MentionItem>? _lastItemsReference;
    private string _lastItemsSignature = string.Empty;
    private bool _itemsInitialized;
    private int _activeSuggestionIndex = -1;
    private MentionType _activeMentionType = MentionType.User;
    private string _suggestionsId => $"vibe-mentions-suggestions-{_instanceId}";

    /// <summary>
    /// Gets the relationships cascaded by an ancestor <see cref="FormField{TValue}"/>, if any.
    /// </summary>
    [CascadingParameter]
    private FormFieldContext? FieldContext { get; set; }

    [Parameter]
    public List<MentionItem> Items { get; set; } = new();

    [Parameter]
    public EventCallback<List<MentionItem>> ItemsChanged { get; set; }

    [Parameter]
    public List<MentionSuggestion> Suggestions { get; set; } = new();

    [Parameter]
    public string MentionPrefix { get; set; } = "@";

    [Parameter]
    public string HashtagPrefix { get; set; } = "#";

    [Parameter]
    public bool AllowHashtags { get; set; } = true;

    [Parameter]
    public string Placeholder { get; set; } = "Type @ to mention...";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public int MaxSuggestions { get; set; } = 5;

    [Parameter]
    public EventCallback<MentionItem> OnMentionAdded { get; set; }

    [Parameter]
    public EventCallback<MentionItem> OnMentionRemoved { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; } = "Mention input";

    [Parameter]
    public string? CssClass { get; set; }

    private string CombinedCssClass => CombineClasses(
    "vibe-mentions",
    Disabled ? "mentions-disabled" : null,
    ReadOnly ? "mentions-readonly" : null,
    CssClass,
    Class
    );

    protected override string ComponentClass => CombinedCssClass;

    private bool IsInteractive => !Disabled && !ReadOnly;

    private string InteractionState => Disabled ? "disabled" : ReadOnly ? "readonly" : "enabled";

    private string EffectiveAriaLabel => string.IsNullOrWhiteSpace(AriaLabel) ? "Mention input" : AriaLabel;

    private string? EffectiveId => FieldContext?.ControlId;

    private string? EffectiveDescribedBy => FieldContext?.DescribedBy;

    private bool EffectiveRequired => FieldContext?.IsRequired == true;

    private string? AriaInvalidValue => FieldContext?.IsInvalid == true ? "true" : null;

    private string? EffectiveErrorMessageId => FieldContext?.IsInvalid == true && !string.IsNullOrWhiteSpace(FieldContext.ErrorId)
        ? FieldContext.ErrorId
        : null;

    private List<MentionSuggestion> FilteredSuggestions => string.IsNullOrWhiteSpace(_searchQuery)
    ? (Suggestions ?? new List<MentionSuggestion>()).ToList()
    : (Suggestions ?? new List<MentionSuggestion>())
        .Where(s => s.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private List<MentionSuggestion> VisibleSuggestions => MaxSuggestions <= 0
    ? new List<MentionSuggestion>()
    : FilteredSuggestions.Take(MaxSuggestions).ToList();

    private string? ActiveSuggestionId =>
    _showSuggestions && _activeSuggestionIndex >= 0 && _activeSuggestionIndex < VisibleSuggestions.Count
    ? GetSuggestionId(_activeSuggestionIndex)
    : null;

    protected override void OnParametersSet()
    {
        var currentItems = Items ?? new List<MentionItem>();
        var currentItemsSignature = GetItemsSignature(currentItems);
        if (!_itemsInitialized || !ReferenceEquals(Items, _lastItemsReference) ||
            currentItemsSignature != _lastItemsSignature)
        {
            _items.Clear();
            _items.AddRange(currentItems);
            _lastItemsReference = Items;
            _lastItemsSignature = currentItemsSignature;
            _itemsInitialized = true;
            UpdateDisplayItems();
        }

        if (!IsInteractive)
        {
            CloseSuggestions();
        }
        else
        {
            UpdateSuggestionState(resetActiveIndex: false);
        }
    }

    private void HandleInput(ChangeEventArgs e)
    {
        if (!IsInteractive)
        {
            return;
        }

        _inputValue = e.Value?.ToString() ?? string.Empty;
        UpdateSuggestionState(resetActiveIndex: true);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (!IsInteractive)
        {
            return;
        }

        switch (e.Key)
        {
            case "Backspace" when string.IsNullOrEmpty(_inputValue) && _items.Any():
                await RemoveMention(_items.Count - 1);
                break;

            case "ArrowDown":
                MoveActiveSuggestion(forward: true);
                break;

            case "ArrowUp":
                MoveActiveSuggestion(forward: false);
                break;

            case "Enter":
                if (_showSuggestions && _activeSuggestionIndex >= 0 && _activeSuggestionIndex < VisibleSuggestions.Count)
                {
                    await SelectSuggestion(VisibleSuggestions[_activeSuggestionIndex]);
                }
                break;

            case "Escape":
                CloseSuggestions();
                break;
        }
    }

    private void HandleFocus()
    {
        if (IsInteractive)
        {
            UpdateSuggestionState(resetActiveIndex: false);
        }
    }

    private void HandleBlur()
    {
        CloseSuggestions();
    }

    private async Task SelectSuggestion(MentionSuggestion suggestion)
    {
        if (!IsInteractive)
        {
            return;
        }

        var mention = new MentionItem
        {
            Id = suggestion.Id,
            Name = suggestion.Name,
            Type = _activeMentionType
        };

        var updatedItems = _items.Append(mention).ToList();
        SetItems(updatedItems);

        await ItemsChanged.InvokeAsync(updatedItems);
        await OnMentionAdded.InvokeAsync(mention);

        _inputValue = string.Empty;
        CloseSuggestions();
    }

    private async Task RemoveMention(int index)
    {
        if (!IsInteractive || index < 0 || index >= _items.Count)
        {
            return;
        }

        var updatedItems = _items.ToList();
        var mention = updatedItems[index];
        updatedItems.RemoveAt(index);
        SetItems(updatedItems);

        await ItemsChanged.InvokeAsync(updatedItems);
        await OnMentionRemoved.InvokeAsync(mention);
    }

    private void UpdateDisplayItems()
    {
        _displayItems = _items.Select((m, index) => new DisplayItem
        {
            Text = m.Name,
            Type = m.Type,
            IsMention = true,
            Index = index,
            Key = $"{m.Id}:{index}"
        }).ToList();
    }

    private void SetItems(List<MentionItem> items)
    {
        _items.Clear();
        _items.AddRange(items);
        UpdateDisplayItems();
    }

    private void UpdateSuggestionState(bool resetActiveIndex)
    {
        if (!TryGetSearchQuery(_inputValue, out var query, out var mentionType))
        {
            CloseSuggestions();
            return;
        }

        _searchQuery = query;
        _activeMentionType = mentionType;
        var suggestions = VisibleSuggestions;
        _showSuggestions = suggestions.Any();

        if (!_showSuggestions)
        {
            _activeSuggestionIndex = -1;
            return;
        }

        if (resetActiveIndex || _activeSuggestionIndex < 0 || _activeSuggestionIndex >= suggestions.Count)
        {
            _activeSuggestionIndex = 0;
        }
    }

    private void MoveActiveSuggestion(bool forward)
    {
        if (!TryGetSearchQuery(_inputValue, out var query, out var mentionType))
        {
            CloseSuggestions();
            return;
        }

        _searchQuery = query;
        _activeMentionType = mentionType;
        var suggestions = VisibleSuggestions;
        if (!suggestions.Any())
        {
            CloseSuggestions();
            return;
        }

        _showSuggestions = true;
        _activeSuggestionIndex = _activeSuggestionIndex < 0
        ? (forward ? 0 : suggestions.Count - 1)
        : (forward
            ? (_activeSuggestionIndex + 1) % suggestions.Count
            : (_activeSuggestionIndex - 1 + suggestions.Count) % suggestions.Count);
    }

    private void CloseSuggestions()
    {
        _showSuggestions = false;
        _searchQuery = string.Empty;
        _activeSuggestionIndex = -1;
    }

    private bool TryGetSearchQuery(string value, out string query, out MentionType mentionType)
    {
        query = string.Empty;
        mentionType = MentionType.User;

        if (!string.IsNullOrEmpty(MentionPrefix) && value.StartsWith(MentionPrefix, StringComparison.Ordinal))
        {
            query = value[MentionPrefix.Length..];
            return true;
        }

        if (AllowHashtags && !string.IsNullOrEmpty(HashtagPrefix) &&
            value.StartsWith(HashtagPrefix, StringComparison.Ordinal))
        {
            query = value[HashtagPrefix.Length..];
            mentionType = MentionType.Hashtag;
            return true;
        }

        return false;
    }

    private string GetPrefix(MentionType type) => type == MentionType.Hashtag ? HashtagPrefix : MentionPrefix;

    private string GetSuggestionId(int index) => $"vibe-mentions-suggestion-{_instanceId}-{index}";

    private static string GetSuggestionKey(MentionSuggestion suggestion, int index) => $"{suggestion.Id}:{index}";

    private static string GetItemsSignature(List<MentionItem> items)
    {
        return string.Join("|", items.Select(item => $"{item.Id}:{item.Name}:{item.Type}"));
    }

    private class DisplayItem
    {
        public string Key { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
        public MentionType Type { get; set; }
        public int Index { get; set; }
        public bool IsMention { get; set; }
    }

    public class MentionItem
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Name { get; set; } = string.Empty;
        public MentionType Type { get; set; } = MentionType.User;
    }

    public class MentionSuggestion
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public RenderFragment? Avatar { get; set; }
    }

    public enum MentionType
    {
        User,
        Hashtag
    }
}
