@namespace Vibe.UI.Components
@inherits VibeComponent

<div @attributes="AdditionalAttributes" class="@CombinedCssClass" role="group" aria-disabled="@AriaBool(Disabled)">
    <div class="tag-input-container">
        @foreach (var tag in CurrentTags)
        {
            <div class="tag-item" @key="tag">
                <span class="tag-text">@tag</span>
                @if (!Disabled)
                {
                    <button type="button" class="tag-remove" @onclick="() => RemoveTag(tag)"
                        aria-label="@GetRemoveAriaLabel(tag)">×</button>
                }
            </div>
        }

        <input type="text" class="tag-input" placeholder="@(CurrentTags.Count == 0 ? Placeholder : "")"
            value="@_inputValue" @oninput="HandleInput" @onfocus="ShowSuggestions" @onkeydown="HandleKeyDown"
            disabled="@Disabled" aria-label="@AriaLabel" role="combobox" aria-autocomplete="list"
            aria-expanded="@AriaBool(ShouldShowSuggestions)" aria-controls="@SuggestionsId" />
    </div>

    @if (ShouldShowSuggestions)
    {
        <div id="@SuggestionsId" class="tag-suggestions" role="listbox">
            @foreach (var suggestion in VisibleSuggestions)
            {
                <button type="button" class="tag-suggestion" role="option" @onclick="() => AddTag(suggestion)" @key="suggestion">
                    @suggestion
                </button>
            }
        </div>
    }
</div>

@code {
    private readonly string _suggestionsId = $"tag-input-suggestions-{Guid.NewGuid():N}";
    private List<string> _tags = new();
    private string _inputValue = string.Empty;
    private bool _showSuggestions;

    [Parameter]
    public List<string> Tags { get; set; } = new();

    [Parameter]
    public EventCallback<List<string>> TagsChanged { get; set; }

    [Parameter]
    public List<string>? Suggestions { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Add tags...";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public int MaxTags { get; set; } = int.MaxValue;

    [Parameter]
    public string Separator { get; set; } = ",";

    [Parameter]
    public bool AllowDuplicates { get; set; } = false;

    [Parameter]
    public EventCallback<string> OnTagAdded { get; set; }

    [Parameter]
    public EventCallback<string> OnTagRemoved { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; } = "Tag input";

    [Parameter]
    public string? CssClass { get; set; }

    private string CombinedCssClass => CombineClasses(
    "vibe-tag-input",
    Disabled ? "tag-input-disabled" : null,
    CssClass
    );

    protected override string ComponentClass => CombinedCssClass;

    private List<string> CurrentTags => _tags;

    private string SuggestionsId => _suggestionsId;

    private List<string> VisibleSuggestions => Suggestions?
        .Where(suggestion => !string.IsNullOrWhiteSpace(suggestion) && !CurrentTags.Contains(suggestion))
        .ToList() ?? new List<string>();

    private bool ShouldShowSuggestions => !Disabled && _showSuggestions && VisibleSuggestions.Any();

    protected override void OnParametersSet()
    {
        _tags = Tags?.Where(tag => tag is not null).Select(tag => tag!).ToList() ?? new List<string>();

        if (Disabled)
        {
            _showSuggestions = false;
        }
    }

    private static string AriaBool(bool value) => value ? "true" : "false";

    private static string GetRemoveAriaLabel(string tag)
        => string.IsNullOrWhiteSpace(tag) ? "Remove tag" : $"Remove {tag}";

    private void HandleInput(ChangeEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        _inputValue = e.Value?.ToString() ?? string.Empty;
        _showSuggestions = true;
    }

    private void ShowSuggestions()
    {
        if (!Disabled)
        {
            _showSuggestions = true;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        if (IsCommitKey(e.Key))
        {
            await AddTag(_inputValue.Trim());
            _inputValue = string.Empty;
        }
        else if (e.Key == "Backspace" && string.IsNullOrEmpty(_inputValue) && CurrentTags.Any())
        {
            await RemoveTag(CurrentTags.Last());
        }
    }

    private async Task AddTag(string tag)
    {
        if (Disabled) return;

        var normalizedTag = tag.Trim();
        if (string.IsNullOrWhiteSpace(normalizedTag)) return;
        if (CurrentTags.Count >= MaxTags) return;
        if (!AllowDuplicates && CurrentTags.Contains(normalizedTag)) return;

        var updatedTags = CurrentTags.ToList();
        updatedTags.Add(normalizedTag);
        _tags = updatedTags;

        await TagsChanged.InvokeAsync(updatedTags);
        await OnTagAdded.InvokeAsync(normalizedTag);
        _showSuggestions = false;
    }

    private async Task RemoveTag(string tag)
    {
        if (Disabled) return;

        var updatedTags = CurrentTags.ToList();
        if (!updatedTags.Remove(tag))
        {
            return;
        }

        _tags = updatedTags;
        await TagsChanged.InvokeAsync(updatedTags);
        await OnTagRemoved.InvokeAsync(tag);
    }

    private bool IsCommitKey(string key)
    {
        return key == "Enter"
            || (!string.IsNullOrEmpty(Separator) && key == Separator);
    }
}
