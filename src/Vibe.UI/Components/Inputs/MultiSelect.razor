@namespace Vibe.UI.Components
@typeparam TItem
@inherits Base.VibeComponent

<div @attributes="AdditionalAttributes" class="@CombinedClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@LabelId" class="multiselect-label" for="@EffectiveId">@Label</label>
    }

    <div class="multiselect-container" @onclick="ToggleDropdown">
        <div class="multiselect-values">
            @if (CurrentSelectedItems.Any())
            {
                @foreach (var item in CurrentSelectedItems)
                {
                    <div class="multiselect-tag" @key="item">
                        <span class="multiselect-tag-label">@GetItemText(item)</span>
                        <button type="button" class="multiselect-tag-remove" @onclick="() => RemoveItem(item)"
                            @onclick:stopPropagation="true" aria-label="@($"Remove {GetItemText(item)}")" disabled="@Disabled">
                            <Icon Name="x" Size="12" />
                        </button>
                    </div>
                }
            }
            <input id="@EffectiveId" type="text" class="multiselect-input" @bind-value="SearchText" @bind-value:event="oninput"
                @onfocus="OpenDropdown" @onclick:stopPropagation="true" @onkeydown="OnKeyDown"
                placeholder="@(CurrentSelectedItems.Any() ? "" : Placeholder)" disabled="@Disabled"
                role="combobox" aria-expanded="@AriaBool(IsOpen)" aria-haspopup="listbox" aria-controls="@DropdownId"
                aria-autocomplete="list" aria-activedescendant="@ActiveDescendantId" aria-describedby="@InputDescribedBy"
                aria-invalid="@AriaInvalidValue" aria-errormessage="@EffectiveErrorMessageId"
                required="@EffectiveRequired" aria-required="@(EffectiveRequired ? "true" : null)"
                aria-disabled="@AriaBool(Disabled)" />
        </div>

        <div class="multiselect-indicators">
            @if (!string.IsNullOrEmpty(SearchText) && AllowClear)
            {
                <button type="button" class="multiselect-clear" @onclick="ClearSearch"
                    @onclick:stopPropagation="true" aria-label="Clear search" disabled="@Disabled">
                    <Icon Name="x" Size="12" />
                </button>
            }

            <div class="multiselect-chevron">
                <Icon Name="chevron-down" Size="16" />
            </div>
        </div>
    </div>

    @if (IsOpen)
    {
        var filteredItems = FilteredItems;
        <div id="@DropdownId" class="multiselect-dropdown" role="listbox" aria-multiselectable="true"
            aria-labelledby="@LabelId">
            @if (filteredItems.Any())
            {
                <div class="multiselect-options">
                    @for (var optionIndex = 0; optionIndex < filteredItems.Count; optionIndex++)
                    {
                        var index = optionIndex;
                        var item = filteredItems[index];
                        bool isSelected = IsItemSelected(item);
                        <div id="@GetOptionId(index)" class="multiselect-option @(isSelected ? "selected" : "") @(HighlightedIndex == index ? "highlighted" : "")"
                            role="option" aria-selected="@AriaBool(isSelected)" @key="item"
                            @onclick="() => ToggleItem(item)" @onmouseover="() => HighlightedIndex = index">

                            <div class="multiselect-checkbox">
                                @if (isSelected)
                                {
                                    <Icon Name="check" Size="12" />
                                }
                            </div>

                            <div class="multiselect-option-content">
                                @GetItemText(item)
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="multiselect-no-options">No options available</div>
            }
        </div>

        <div class="multiselect-backdrop" @onclick="CloseDropdown"></div>
    }

    @if (!string.IsNullOrEmpty(HelperText))
    {
        <div id="@HelperTextId" class="multiselect-helper-text">@HelperText</div>
    }
</div>

@code {
    private readonly string _dropdownId = $"multiselect-listbox-{Guid.NewGuid():N}";
    private readonly string _labelId = $"multiselect-label-{Guid.NewGuid():N}";
    private readonly string _helperTextId = $"multiselect-helper-{Guid.NewGuid():N}";
    private List<TItem> _selectedItems = new();

    /// <summary>
    /// Gets the relationships cascaded by an ancestor <see cref="FormField{TValue}"/>, if any.
    /// </summary>
    [CascadingParameter]
    private FormFieldContext? FieldContext { get; set; }

    /// <summary>
    /// Gets or sets the collection of items to choose from.
    /// </summary>
    [Parameter]
    public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();

    /// <summary>
    /// Gets or sets the template to display each item.
    /// </summary>
    [Parameter]
    public Func<TItem, string>? ItemTemplate { get; set; }

    /// <summary>
    /// Gets or sets the collection of selected items.
    /// </summary>
    [Parameter]
    public List<TItem> SelectedItems { get; set; } = new List<TItem>();

    /// <summary>
    /// Gets or sets the callback when selected items change.
    /// </summary>
    [Parameter]
    public EventCallback<List<TItem>> SelectedItemsChanged { get; set; }

    /// <summary>
    /// Gets or sets the maximum number of items that can be selected.
    /// </summary>
    [Parameter]
    public int? MaxSelectedItems { get; set; }

    /// <summary>
    /// Gets or sets the label for the multiselect.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Gets or sets the placeholder text when no items are selected.
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; } = "Select items...";

    /// <summary>
    /// Gets or sets the helper text displayed below the control.
    /// </summary>
    [Parameter]
    public string? HelperText { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the control is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether to allow clearing the search.
    /// </summary>
    [Parameter]
    public bool AllowClear { get; set; } = true;

    /// <summary>
    /// Gets or sets a value indicating whether to filter items as the user types.
    /// </summary>
    [Parameter]
    public bool EnableFiltering { get; set; } = true;

    /// <summary>
    /// Gets or sets a function to filter items based on search text.
    /// </summary>
    [Parameter]
    public Func<TItem, string, bool>? FilterFunc { get; set; }

    /// <summary>
    /// Gets or sets the function to compare items for equality.
    /// </summary>
    [Parameter]
    public Func<TItem, TItem, bool>? CompareItems { get; set; }

    /// <summary>
    /// Gets or sets a unique identifier for the control.
    /// </summary>
    [Parameter]
    public string Id { get; set; } = $"multiselect-{Guid.NewGuid()}";

    /// <summary>
    /// Gets or sets the currently highlighted item index.
    /// </summary>
    private int HighlightedIndex { get; set; } = -1;

    /// <summary>
    /// Gets or sets the search text for filtering.
    /// </summary>
    private string SearchText { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets a value indicating whether the dropdown is open.
    /// </summary>
    private bool IsOpen { get; set; }

    /// <summary>
    /// Gets the component CSS class.
    /// </summary>
    protected override string ComponentClass => "vibe-multiselect";

    private List<TItem> CurrentSelectedItems => _selectedItems;

    private string DropdownId => _dropdownId;

    private string EffectiveId => FieldContext?.ControlId ?? Id;

    private string? LabelId => string.IsNullOrEmpty(Label) ? null : _labelId;

    private string? HelperTextId => string.IsNullOrEmpty(HelperText) ? null : _helperTextId;

    private string? InputDescribedBy => CombineIds(HelperTextId, FieldContext?.DescribedBy);

    private bool EffectiveRequired => FieldContext?.IsRequired == true;

    private string? AriaInvalidValue => FieldContext?.IsInvalid == true ? "true" : null;

    private string? EffectiveErrorMessageId => FieldContext?.IsInvalid == true && !string.IsNullOrWhiteSpace(FieldContext.ErrorId)
        ? FieldContext.ErrorId
        : null;

    private string? ActiveDescendantId
        => IsOpen && HighlightedIndex >= 0 && HighlightedIndex < FilteredItems.Count
            ? GetOptionId(HighlightedIndex)
            : null;

    protected override void OnParametersSet()
    {
        _selectedItems = SelectedItems?.ToList() ?? new List<TItem>();
    }

    /// <summary>
    /// Gets the filtered list of items based on the search text.
    /// </summary>
    private IList<TItem> FilteredItems
    {
        get
        {
            var items = Items?.ToList() ?? new List<TItem>();

            if (!EnableFiltering || string.IsNullOrEmpty(SearchText))
                return items;

            if (FilterFunc != null)
                return items.Where(item => FilterFunc(item, SearchText)).ToList();

            return items
            .Where(item =>
            item?.ToString()?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false)
            .ToList();
        }
    }

    private static string AriaBool(bool value) => value ? "true" : "false";

    private static string? CombineIds(params string?[] ids)
    {
        var combined = ids
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Select(id => id!.Trim())
            .ToList();

        return combined.Count == 0 ? null : string.Join(" ", combined);
    }

    private string GetOptionId(int index) => $"{DropdownId}-option-{index}";

    private string GetItemText(TItem item) => ItemTemplate != null ? ItemTemplate(item) : item?.ToString() ?? string.Empty;

    private void OpenDropdown()
    {
        if (!Disabled)
        {
            IsOpen = true;
        }
    }

    /// <summary>
    /// Toggles the dropdown open/closed state.
    /// </summary>
    private void ToggleDropdown()
    {
        if (Disabled)
            return;

        IsOpen = !IsOpen;
        if (IsOpen)
            HighlightedIndex = -1;
    }

    /// <summary>
    /// Closes the dropdown.
    /// </summary>
    private void CloseDropdown()
    {
        IsOpen = false;
    }

    /// <summary>
    /// Clears the search text.
    /// </summary>
    private void ClearSearch(MouseEventArgs args)
    {
        if (Disabled)
            return;

        SearchText = string.Empty;
    }

    /// <summary>
    /// Checks if an item is currently selected.
    /// </summary>
    /// <param name="item">The item to check.</param>
    /// <returns>True if the item is selected; otherwise, false.</returns>
    private bool IsItemSelected(TItem item)
    {
        return CompareItems != null
        ? CurrentSelectedItems.Any(selectedItem => CompareItems(selectedItem, item))
        : CurrentSelectedItems.Contains(item);
    }

    /// <summary>
    /// Toggles selection of an item.
    /// </summary>
    /// <param name="item">The item to toggle.</param>
    private async Task ToggleItem(TItem item)
    {
        if (Disabled)
            return;

        bool isSelected = IsItemSelected(item);
        var updatedItems = CurrentSelectedItems.ToList();

        if (isSelected)
        {
            if (CompareItems != null)
            {
                var indexToRemove = updatedItems.FindIndex(selectedItem => CompareItems(selectedItem, item));
                if (indexToRemove >= 0)
                    updatedItems.RemoveAt(indexToRemove);
            }
            else
            {
                updatedItems.Remove(item);
            }
        }
        else
        {
            if (MaxSelectedItems.HasValue && updatedItems.Count >= MaxSelectedItems.Value)
                return;

            updatedItems.Add(item);
        }

        _selectedItems = updatedItems;
        await SelectedItemsChanged.InvokeAsync(updatedItems);
    }

    /// <summary>
    /// Removes an item from the selection.
    /// </summary>
    /// <param name="item">The item to remove.</param>
    private async Task RemoveItem(TItem item)
    {
        if (Disabled)
            return;

        var updatedItems = CurrentSelectedItems.ToList();

        if (CompareItems != null)
        {
            var indexToRemove = updatedItems.FindIndex(selectedItem => CompareItems(selectedItem, item));
            if (indexToRemove >= 0)
                updatedItems.RemoveAt(indexToRemove);
        }
        else
        {
            updatedItems.Remove(item);
        }

        _selectedItems = updatedItems;
        await SelectedItemsChanged.InvokeAsync(updatedItems);
    }

    /// <summary>
    /// Handles keyboard navigation in the dropdown.
    /// </summary>
    /// <param name="e">The keyboard event args.</param>
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
            return;

        switch (e.Key)
        {
            case "Escape":
                CloseDropdown();
                break;

            case "Enter":
                var filteredItems = FilteredItems;
                if (IsOpen && HighlightedIndex >= 0 && HighlightedIndex < filteredItems.Count)
                {
                    await ToggleItem(filteredItems[HighlightedIndex]);
                }
                else if (!IsOpen)
                {
                    IsOpen = true;
                }
                break;

            case "ArrowDown":
                filteredItems = FilteredItems;
                if (!IsOpen)
                {
                    IsOpen = true;
                }
                else if (filteredItems.Any())
                {
                    HighlightedIndex = (HighlightedIndex + 1) % filteredItems.Count;
                }
                break;

            case "ArrowUp":
                filteredItems = FilteredItems;
                if (IsOpen && filteredItems.Any())
                {
                    HighlightedIndex = (HighlightedIndex - 1 + filteredItems.Count) % filteredItems.Count;
                }
                break;
        }
    }
}
