@namespace Vibe.UI.Components
@inherits Vibe.UI.Base.VibeComponent

<textarea @attributes="GetTextAreaAttributes()" id="@EffectiveId" class="@CombinedClass" placeholder="@Placeholder" disabled="@Disabled" readonly="@ReadOnly" rows="@Rows"
    aria-disabled="@(Disabled ? "true" : null)" @oninput="OnInputHandler" @onchange="OnChangeHandler">@currentValue</textarea>

@code {
    private readonly string _generatedId = Guid.NewGuid().ToString("N");
    private string currentValue = string.Empty;

    [CascadingParameter]
    private FormFieldContext? FieldContext { get; set; }

    /// <summary>
    /// Gets or sets the textarea ID.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the textarea value
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets the placeholder text
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Gets or sets whether the textarea is disabled
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether the textarea is read-only
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>
    /// Gets or sets the number of rows for the textarea
    /// </summary>
    [Parameter]
    public int Rows { get; set; } = 4;

    /// <summary>
    /// Gets or sets the callback for when the textarea value changes
    /// </summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets the callback for when the input event occurs
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnInput { get; set; }

    /// <summary>
    /// Gets or sets the callback for when the change event occurs
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    /// <inheritdoc/>
    protected override string ComponentClass => CombineClasses(
        "vibe-textarea",
        FieldContext?.IsInvalid == true ? "vibe-textarea-error" : null);

    private string EffectiveId => FieldContext?.ControlId
        ?? (string.IsNullOrWhiteSpace(Id) ? _generatedId : Id);

    protected override void OnParametersSet()
    {
        currentValue = Value ?? string.Empty;
    }

    private async Task OnInputHandler(ChangeEventArgs args)
    {
        if (Disabled || ReadOnly)
        {
            return;
        }

        if (OnInput.HasDelegate)
        {
            await OnInput.InvokeAsync(args);
        }

        if (args.Value is string value)
        {
            currentValue = value;

            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(value);
            }
        }
    }

    private async Task OnChangeHandler(ChangeEventArgs args)
    {
        if (Disabled || ReadOnly)
        {
            return;
        }

        if (OnChange.HasDelegate)
        {
            await OnChange.InvokeAsync(args);
        }
    }

    private Dictionary<string, object>? GetTextAreaAttributes()
    {
        var attributes = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);

        if (AdditionalAttributes is not null)
        {
            foreach (var attribute in AdditionalAttributes)
            {
                if (!IsReservedAttribute(attribute.Key))
                {
                    attributes[attribute.Key] = attribute.Value;
                }
            }
        }

        if (!string.IsNullOrWhiteSpace(FieldContext?.DescribedBy))
        {
            MergeSpaceSeparatedAttribute(attributes, "aria-describedby", FieldContext.DescribedBy);
        }

        if (FieldContext?.IsInvalid == true)
        {
            attributes["aria-invalid"] = "true";
            if (!string.IsNullOrWhiteSpace(FieldContext.ErrorId))
            {
                attributes["aria-errormessage"] = FieldContext.ErrorId;
            }
        }

        if (FieldContext?.IsRequired == true)
        {
            attributes["required"] = "required";
            attributes["aria-required"] = "true";
        }

        return attributes.Count == 0 ? null : attributes;
    }

    private static bool IsReservedAttribute(string name)
        => name.Equals("class", StringComparison.OrdinalIgnoreCase)
            || name.Equals("id", StringComparison.OrdinalIgnoreCase)
            || name.Equals("placeholder", StringComparison.OrdinalIgnoreCase)
            || name.Equals("disabled", StringComparison.OrdinalIgnoreCase)
            || name.Equals("readonly", StringComparison.OrdinalIgnoreCase)
            || name.Equals("rows", StringComparison.OrdinalIgnoreCase);

    private static void MergeSpaceSeparatedAttribute(Dictionary<string, object> target, string key, string value)
    {
        var values = target.TryGetValue(key, out var existing) && existing is not null
            ? existing.ToString()!.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            : Array.Empty<string>();

        target[key] = string.Join(" ", values
            .Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries))
            .Distinct(StringComparer.Ordinal));
    }
}
