@namespace Vibe.UI.Components
@inherits Base.VibeComponent

<button type="button" @attributes="AdditionalAttributes" class="@CombinedClass @(currentPressed ? "pressed" : "") @VariantClass @SizeClass"
    @onclick="OnTogglePressed" disabled="@Disabled" aria-pressed="@AriaBool(currentPressed)" aria-disabled="@AriaBool(Disabled)">
    @ChildContent
</button>

@code {
    private bool currentPressed;
    private static readonly HashSet<string> SupportedVariants = new(StringComparer.OrdinalIgnoreCase) { "default", "outline" };
    private static readonly HashSet<string> SupportedSizes = new(StringComparer.OrdinalIgnoreCase) { "default", "sm", "lg" };

    /// <summary>
    /// Gets or sets the content of the toggle.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets whether the toggle is pressed.
    /// </summary>
    [Parameter]
    public bool Pressed { get; set; }

    /// <summary>
    /// Gets or sets whether the toggle is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the size of the toggle.
    /// </summary>
    [Parameter]
    public string Size { get; set; } = "default";

    /// <summary>
    /// Gets or sets the variant of the toggle.
    /// </summary>
    [Parameter]
    public string Variant { get; set; } = "default";

    /// <summary>
    /// Gets or sets the callback when the toggle state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> PressedChanged { get; set; }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-toggle";

    /// <summary>
    /// Gets the CSS class for the variant.
    /// </summary>
    private string VariantClass => $"toggle-{NormalizedVariant}";

    /// <summary>
    /// Gets the CSS class for the size.
    /// </summary>
    private string SizeClass => $"toggle-{NormalizedSize}";

    private string NormalizedVariant => NormalizeToken(Variant, SupportedVariants, "default");

    private string NormalizedSize => NormalizeToken(Size, SupportedSizes, "default");

    protected override void OnParametersSet()
    {
        currentPressed = Pressed;
    }

    private static string AriaBool(bool value) => value ? "true" : "false";

    private static string NormalizeToken(string? value, HashSet<string> supportedValues, string fallback)
    {
        var normalizedValue = value?.Trim().ToLowerInvariant();
        return !string.IsNullOrEmpty(normalizedValue) && supportedValues.Contains(normalizedValue)
            ? normalizedValue
            : fallback;
    }

    /// <summary>
    /// Handles the toggle press event.
    /// </summary>
    private async Task OnTogglePressed()
    {
        if (!Disabled)
        {
            currentPressed = !currentPressed;
            await PressedChanged.InvokeAsync(currentPressed);
        }
    }
}
