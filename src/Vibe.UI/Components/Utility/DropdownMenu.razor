@namespace Vibe.UI.Components
@inherits Base.VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="@CombinedClass" @attributes="AdditionalAttributes">
    <button id="@_triggerId"
            type="button"
            class="@CombineClasses("dropdown-trigger", TriggerClass)"
            disabled="@Disabled"
            aria-label="@TriggerAriaLabel"
            aria-haspopup="menu"
            aria-expanded="@_isOpen.ToString().ToLowerInvariant()"
            aria-controls="@_contentId"
            @ref="_triggerReference"
            @onclick="ToggleDropdown"
            @onkeydown="HandleTriggerKeyDown">
        @TriggerContent
    </button>

    @if (_isOpen)
    {
        <div id="@_contentId"
             class="@CombineClasses("dropdown-content", PositionClass, ContentClass)"
             style="@ContentStyle"
             role="menu"
             tabindex="-1"
             aria-labelledby="@_triggerId"
             @ref="_contentReference"
             @onclick="HandleContentClick"
             @onclick:stopPropagation="true"
             @onkeydown="HandleContentKeyDown">
            @Content
        </div>
        <div class="dropdown-backdrop" aria-hidden="true" @onclick="HandleBackdropClick"></div>
    }
</div>

@code {
    private const string KeyboardModulePath = "./_content/Vibe.UI/js/vibe-menu-keyboard.js";

    private readonly string _triggerId = $"dropdown-trigger-{Guid.NewGuid():N}";
    private readonly string _contentId = $"dropdown-content-{Guid.NewGuid():N}";
    private bool _isOpen;
    private ElementReference _triggerReference;
    private ElementReference _contentReference;
    private PendingFocus _pendingFocus;
    private bool _restoreTriggerFocus;
    private IJSObjectReference? _keyboardModule;

    /// <summary>
    /// Gets or sets the trigger content.
    /// </summary>
    [Parameter]
    public RenderFragment? TriggerContent { get; set; }

    /// <summary>
    /// Gets or sets the dropdown content.
    /// </summary>
    [Parameter]
    public RenderFragment? Content { get; set; }

    /// <summary>
    /// Gets or sets additional classes applied to the trigger button.
    /// </summary>
    [Parameter]
    public string? TriggerClass { get; set; }

    /// <summary>
    /// Gets or sets additional classes applied to the menu surface.
    /// </summary>
    [Parameter]
    public string? ContentClass { get; set; }

    /// <summary>
    /// Gets or sets additional inline styles applied to the menu surface.
    /// </summary>
    [Parameter]
    public string? ContentStyle { get; set; }

    /// <summary>
    /// Gets or sets an accessible name for triggers without visible text.
    /// </summary>
    [Parameter]
    public string? TriggerAriaLabel { get; set; }

    /// <summary>
    /// Gets or sets whether the trigger is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether selecting menu content closes the dropdown.
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = true;

    /// <summary>
    /// Gets or sets the position of the dropdown.
    /// </summary>
    [Parameter]
    public string Position { get; set; } = "bottom";

    /// <summary>
    /// Gets or sets the alignment of the dropdown.
    /// </summary>
    [Parameter]
    public string Align { get; set; } = "start";

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-dropdown";

    private string PositionClass => $"dropdown-{Position} dropdown-{Align}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        try
        {
            var module = await GetKeyboardModuleAsync();
            await module.InvokeVoidAsync("initializeTrigger", _triggerReference, false, false);

            if (_isOpen)
            {
                await module.InvokeVoidAsync("initializeContainer", _contentReference, "menu");

                if (_pendingFocus == PendingFocus.First)
                {
                    await module.InvokeVoidAsync("focusFirstItem", _contentReference, "menu");
                    _pendingFocus = PendingFocus.None;
                }
                else if (_pendingFocus == PendingFocus.Last)
                {
                    await module.InvokeVoidAsync("focusLastItem", _contentReference, "menu");
                    _pendingFocus = PendingFocus.None;
                }
            }
            else if (_restoreTriggerFocus)
            {
                await _triggerReference.FocusAsync();
                _restoreTriggerFocus = false;
            }
        }
        catch (Exception ex) when (IsRecoverableJsInteropException(ex))
        {
            // JS interop is unavailable (prerendering, circuit teardown, or navigation).
        }
    }

    private void ToggleDropdown()
    {
        if (Disabled)
        {
            return;
        }

        if (_isOpen)
        {
            CloseDropdown();
        }
        else
        {
            OpenDropdown(PendingFocus.First);
        }
    }

    private void HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                OpenDropdown(PendingFocus.First);
                break;
            case "ArrowUp":
                OpenDropdown(PendingFocus.Last);
                break;
            case "Escape":
                CloseDropdown(restoreTriggerFocus: true);
                break;
        }
    }

    private async Task HandleContentKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Tab")
        {
            CloseDropdown();
            return;
        }

        if (e.Key == "Escape")
        {
            CloseDropdown(restoreTriggerFocus: true);
            return;
        }

        var module = await GetKeyboardModuleAsync();
        switch (e.Key)
        {
            case "ArrowDown":
                await module.InvokeVoidAsync("moveFocus", _contentReference, "menu", 1);
                break;
            case "ArrowUp":
                await module.InvokeVoidAsync("moveFocus", _contentReference, "menu", -1);
                break;
            case "Home":
                await module.InvokeVoidAsync("focusFirstItem", _contentReference, "menu");
                break;
            case "End":
                await module.InvokeVoidAsync("focusLastItem", _contentReference, "menu");
                break;
            default:
                if (IsTypeaheadKey(e))
                {
                    await module.InvokeVoidAsync("focusByTypeahead", _contentReference, "menu", e.Key);
                }
                break;
        }
    }

    private void HandleContentClick()
    {
        if (CloseOnSelect)
        {
            CloseDropdown(restoreTriggerFocus: true);
        }
    }

    private void HandleBackdropClick()
    {
        CloseDropdown();
    }

    private void OpenDropdown(PendingFocus pendingFocus)
    {
        _isOpen = true;
        _pendingFocus = pendingFocus;
        _restoreTriggerFocus = false;
    }

    private void CloseDropdown(bool restoreTriggerFocus = false)
    {
        if (!_isOpen)
        {
            return;
        }

        _isOpen = false;
        _pendingFocus = PendingFocus.None;
        _restoreTriggerFocus = restoreTriggerFocus;
    }

    private async ValueTask<IJSObjectReference> GetKeyboardModuleAsync()
    {
        _keyboardModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", KeyboardModulePath);
        return _keyboardModule;
    }

    private static bool IsTypeaheadKey(KeyboardEventArgs e)
    {
        return e.Key.Length == 1 &&
               !char.IsWhiteSpace(e.Key[0]) &&
               !e.AltKey &&
               !e.CtrlKey &&
               !e.MetaKey;
    }

    public async ValueTask DisposeAsync()
    {
        if (_keyboardModule != null)
        {
            try
            {
                await _keyboardModule.DisposeAsync();
            }
            catch (Exception ex) when (IsRecoverableJsInteropException(ex))
            {
            }
        }

        GC.SuppressFinalize(this);
    }

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;

    private enum PendingFocus
    {
        None,
        First,
        Last
    }
}
