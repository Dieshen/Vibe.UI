@namespace Vibe.UI.Components
@inherits Base.VibeComponent

<div class="@CombinedClass" @ref="DropdownRef" @attributes="AdditionalAttributes">
    <button type="button"
         class="@CombineClasses("dropdown-trigger", TriggerClass)"
         disabled="@Disabled"
         aria-label="@TriggerAriaLabel"
         aria-haspopup="menu"
         aria-expanded="@IsOpen.ToString().ToLowerInvariant()"
         aria-controls="@_contentId"
         @onclick="ToggleDropdown"
         @onkeydown="HandleTriggerKeyDown">
        @TriggerContent
    </button>

    @if (IsOpen)
    {
        <div id="@_contentId"
             class="@CombineClasses("dropdown-content", PositionClass, ContentClass)"
             style="@ContentStyle"
             role="menu"
             @onclick="HandleContentClick"
             @onclick:stopPropagation="true">
            @Content
        </div>
        @* Backdrop handles click-outside without JS *@
        <div class="dropdown-backdrop" @onclick="CloseDropdown"></div>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the trigger content.
    /// </summary>
    [Parameter]
    public RenderFragment? TriggerContent { get; set; }

    /// <summary>
    /// Gets or sets the dropdown content.
    /// </summary>
    [Parameter]
    public RenderFragment? Content { get; set; }

    /// <summary>
    /// Gets or sets additional classes applied to the trigger button.
    /// </summary>
    [Parameter]
    public string? TriggerClass { get; set; }

    /// <summary>
    /// Gets or sets additional classes applied to the menu surface.
    /// </summary>
    [Parameter]
    public string? ContentClass { get; set; }

    /// <summary>
    /// Gets or sets additional inline styles applied to the menu surface.
    /// </summary>
    [Parameter]
    public string? ContentStyle { get; set; }

    /// <summary>
    /// Gets or sets an accessible name for triggers without visible text.
    /// </summary>
    [Parameter]
    public string? TriggerAriaLabel { get; set; }

    /// <summary>
    /// Gets or sets whether the trigger is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether selecting menu content closes the dropdown.
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = true;

    /// <summary>
    /// Gets or sets the position of the dropdown.
    /// </summary>
    [Parameter]
    public string Position { get; set; } = "bottom";

    /// <summary>
    /// Gets or sets the alignment of the dropdown.
    /// </summary>
    [Parameter]
    public string Align { get; set; } = "start";

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-dropdown";

    /// <summary>
    /// Gets the CSS class for the dropdown position/alignment.
    /// </summary>
    private string PositionClass => $"dropdown-{Position} dropdown-{Align}";

    /// <summary>
    /// Flag to track if the dropdown is open.
    /// </summary>
    private bool IsOpen = false;

    /// <summary>
    /// Reference to the dropdown element.
    /// </summary>
    private ElementReference DropdownRef;

    private readonly string _contentId = $"dropdown-content-{Guid.NewGuid():N}";

    /// <summary>
    /// Toggles the dropdown state.
    /// </summary>
    private void ToggleDropdown()
    {
        if (Disabled)
        {
            return;
        }

        IsOpen = !IsOpen;
    }

    private void HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                CloseDropdown();
                break;
        }
    }

    private void HandleContentClick()
    {
        if (CloseOnSelect)
        {
            CloseDropdown();
        }
    }

    /// <summary>
    /// Closes the dropdown.
    /// </summary>
    private void CloseDropdown()
    {
        IsOpen = false;
    }

}
