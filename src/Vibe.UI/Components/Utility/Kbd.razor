@namespace Vibe.UI.Components
@inherits VibeComponent

<kbd @attributes="AdditionalAttributes" class="@CombinedClass">
    @ChildContent
</kbd>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public KbdSize Size { get; set; } = KbdSize.Default;

    [Parameter]
    public string? CssClass { get; set; }

    private string CombinedCssClass => CombineClasses(
        "vibe-kbd",
        $"kbd-{GetSizeClass(Size)}",
        CssClass
    );

    protected override string ComponentClass => CombinedCssClass;

    private static string GetSizeClass(KbdSize size) =>
        Enum.IsDefined(size) ? size.ToString().ToLowerInvariant() : KbdSize.Default.ToString().ToLowerInvariant();

    public enum KbdSize
    {
        Small,
        Default,
        Large
    }
}
