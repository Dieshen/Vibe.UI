@using System.Globalization
@namespace Vibe.UI.Components
@inherits Base.VibeComponent
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="@CombinedClass" @attributes="AdditionalAttributes">
    <div class="daterange-input-wrapper">
        <div class="daterange-inputs">
            <Input
                Id="@_startInputId"
                class="daterange-start-input"
                type="text"
                Value="@FormattedStartDate"
                ReadOnly="true"
                Placeholder="@StartDatePlaceholder"
                Disabled="@Disabled"
                aria-label="@StartDatePlaceholder"
                aria-haspopup="dialog"
                aria-expanded="@AriaBool(IsOpen)"
                aria-controls="@_popupId"
                @onclick="() => ToggleCalendar(true, _startInputId)"
                @onkeydown="e => HandleInputKeyDown(e, true, _startInputId)" />

            <div class="daterange-separator" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path></svg>
            </div>

            <Input
                Id="@_endInputId"
                class="daterange-end-input"
                type="text"
                Value="@FormattedEndDate"
                ReadOnly="true"
                Placeholder="@EndDatePlaceholder"
                Disabled="@Disabled"
                aria-label="@EndDatePlaceholder"
                aria-haspopup="dialog"
                aria-expanded="@AriaBool(IsOpen)"
                aria-controls="@_popupId"
                @onclick="() => ToggleCalendar(false, _endInputId)"
                @onkeydown="e => HandleInputKeyDown(e, false, _endInputId)" />
        </div>

        <button id="@_triggerId"
                type="button"
                class="daterange-icon"
                disabled="@Disabled"
                aria-label="Open date range calendar"
                aria-haspopup="dialog"
                aria-expanded="@AriaBool(IsOpen)"
                aria-controls="@_popupId"
                @onclick="() => ToggleCalendar(null, _triggerId)"
                @onkeydown="HandleTriggerKeyDown">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
        </button>
    </div>

    @if (IsOpen)
    {
        <div id="@_popupId"
             class="daterange-popup"
             role="dialog"
             aria-label="Choose date range"
             @onkeydown="HandlePopupKeyDown">
            <div class="daterange-header">
                <div class="daterange-header-section">
                    <button type="button"
                            class="daterange-nav-btn"
                            aria-label="Previous month"
                            disabled="@IsPreviousMonthDisabled"
                            @onclick="PreviousMonth">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"></path></svg>
                    </button>
                    <div class="daterange-header-label">
                        <select class="daterange-month-select" value="@CurrentStartMonth" aria-label="Start month" @onchange="HandleStartMonthChange">
                            @for (var i = 0; i < 12; i++)
                            {
                                <option value="@i">@DateTimeFormatInfo.CurrentInfo.GetMonthName(i + 1)</option>
                            }
                        </select>
                        <select class="daterange-year-select" value="@CurrentStartYear" aria-label="Start year" @onchange="HandleStartYearChange">
                            @for (var i = EffectiveMinYear; i <= EffectiveMaxYear; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="daterange-header-section">
                    <div class="daterange-header-label">
                        <select class="daterange-month-select" value="@CurrentEndMonth" aria-label="End month" @onchange="HandleEndMonthChange">
                            @for (var i = 0; i < 12; i++)
                            {
                                <option value="@i">@DateTimeFormatInfo.CurrentInfo.GetMonthName(i + 1)</option>
                            }
                        </select>
                        <select class="daterange-year-select" value="@CurrentEndYear" aria-label="End year" @onchange="HandleEndYearChange">
                            @for (var i = EffectiveMinYear; i <= EffectiveMaxYear; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                    <button type="button"
                            class="daterange-nav-btn"
                            aria-label="Next month"
                            disabled="@IsNextMonthDisabled"
                            @onclick="NextMonth">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"></path></svg>
                    </button>
                </div>
            </div>

            <div class="daterange-calendars">
                <div class="daterange-calendar">
                    <div class="daterange-grid"
                         role="grid"
                         aria-label="@StartCalendarLabel"
                         @ref="_startGridReference">
                        <div class="daterange-day-names" role="row">
                            @foreach (var day in DayNames)
                            {
                                <div class="daterange-day-name" role="columnheader">@day</div>
                            }
                        </div>

                        @foreach (var week in StartCalendarDays)
                        {
                            <div class="daterange-week" role="row">
                                @foreach (var day in week)
                                {
                                    <button
                                        @key="day.Date"
                                        id="@GetDayId(day.Date, true)"
                                        type="button"
                                        class="@GetStartDayClass(day)"
                                        role="gridcell"
                                        tabindex="@GetDayTabIndex(day, true)"
                                        disabled="@(!IsStartDaySelectable(day))"
                                        aria-label="@GetStartDayAriaLabel(day)"
                                        aria-current="@(day.IsToday ? "date" : null)"
                                        aria-selected="@AriaBool(IsStartSelected(day))"
                                        @onfocus="() => HandleDayFocus(day.Date, true)"
                                        @onkeydown="e => HandleDayKeyDown(e, day.Date, true)"
                                        @onclick="() => SelectStartDate(day.Date)">
                                        @day.DayNumber
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="daterange-calendar">
                    <div class="daterange-grid"
                         role="grid"
                         aria-label="@EndCalendarLabel"
                         @ref="_endGridReference">
                        <div class="daterange-day-names" role="row">
                            @foreach (var day in DayNames)
                            {
                                <div class="daterange-day-name" role="columnheader">@day</div>
                            }
                        </div>

                        @foreach (var week in EndCalendarDays)
                        {
                            <div class="daterange-week" role="row">
                                @foreach (var day in week)
                                {
                                    <button
                                        @key="day.Date"
                                        id="@GetDayId(day.Date, false)"
                                        type="button"
                                        class="@GetEndDayClass(day)"
                                        role="gridcell"
                                        tabindex="@GetDayTabIndex(day, false)"
                                        disabled="@(!IsEndDaySelectable(day))"
                                        aria-label="@GetEndDayAriaLabel(day)"
                                        aria-current="@(day.IsToday ? "date" : null)"
                                        aria-selected="@AriaBool(IsEndSelected(day))"
                                        @onfocus="() => HandleDayFocus(day.Date, false)"
                                        @onkeydown="e => HandleDayKeyDown(e, day.Date, false)"
                                        @onclick="() => SelectEndDate(day.Date)">
                                        @day.DayNumber
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="daterange-footer">
                <div class="daterange-presets" aria-label="Date range presets">
                    <button type="button" class="daterange-preset-btn" @onclick="SelectToday">Today</button>
                    <button type="button" class="daterange-preset-btn" @onclick="SelectLastWeek">Last 7 days</button>
                    <button type="button" class="daterange-preset-btn" @onclick="SelectLastMonth">Last 30 days</button>
                    <button type="button" class="daterange-preset-btn" @onclick="SelectLastQuarter">Last 90 days</button>
                </div>
                <button type="button" class="daterange-apply-btn" @onclick="ApplySelection">Apply</button>
            </div>
        </div>

        <div class="daterange-backdrop" aria-hidden="true" @onclick="CloseCalendar"></div>
    }
</div>

@code {
    private sealed class CalendarDay
    {
        public DateTime Date { get; init; }
        public int DayNumber { get; init; }
        public bool IsCurrentMonth { get; init; }
        public bool IsToday { get; init; }
    }

    private readonly string _componentId = $"daterangepicker-{Guid.NewGuid():N}";
    private IJSObjectReference? _domModule;
    private ElementReference _startGridReference;
    private ElementReference _endGridReference;
    private DateTime? _focusedDate;
    private DateTime? _previousStartDate;
    private DateTime? _previousEndDate;
    private string? _pendingFocusElementId;
    private string? _restoreFocusElementId;

    private string _popupId => $"{_componentId}-popup";
    private string _startInputId => $"{_componentId}-start-input";
    private string _endInputId => $"{_componentId}-end-input";
    private string _triggerId => $"{_componentId}-trigger";

    [Parameter]
    public DateTime? StartDate { get; set; }

    [Parameter]
    public EventCallback<DateTime?> StartDateChanged { get; set; }

    [Parameter]
    public DateTime? EndDate { get; set; }

    [Parameter]
    public EventCallback<DateTime?> EndDateChanged { get; set; }

    /// <summary>
    /// Gets or sets the compatibility callback invoked when the range is applied.
    /// </summary>
    [Parameter]
    public EventCallback<(DateTime? StartDate, DateTime? EndDate)> OnChange { get; set; }

    [Parameter]
    public string Format { get; set; } = "MM/dd/yyyy";

    [Parameter]
    public string StartDatePlaceholder { get; set; } = "Start Date";

    [Parameter]
    public string EndDatePlaceholder { get; set; } = "End Date";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public DateTime? MinDate { get; set; }

    [Parameter]
    public DateTime? MaxDate { get; set; }

    [Parameter]
    public int FirstDayOfWeek { get; set; }

    [Parameter]
    public int MinYear { get; set; } = DateTime.Today.Year - 100;

    [Parameter]
    public int MaxYear { get; set; } = DateTime.Today.Year + 100;

    protected override string ComponentClass => "vibe-daterange-picker";

    private bool IsOpen { get; set; }
    private int CurrentStartMonth { get; set; }
    private int CurrentStartYear { get; set; }
    private int CurrentEndMonth { get; set; }
    private int CurrentEndYear { get; set; }
    private DateTime? TempStartDate { get; set; }
    private DateTime? TempEndDate { get; set; }
    private bool StartDateFocused { get; set; } = true;
    private int EffectiveMinYear => Math.Clamp(Math.Min(MinYear, MaxYear), 1, 9999);
    private int EffectiveMaxYear => Math.Clamp(Math.Max(MinYear, MaxYear), 1, 9999);
    private bool IsPreviousMonthDisabled => !CanShiftPairedCalendars(-1);
    private bool IsNextMonthDisabled => !CanShiftPairedCalendars(1);
    private string FormattedStartDate => StartDate.HasValue ? StartDate.Value.ToString(Format, CultureInfo.CurrentCulture) : string.Empty;
    private string FormattedEndDate => EndDate.HasValue ? EndDate.Value.ToString(Format, CultureInfo.CurrentCulture) : string.Empty;
    private string[] DayNames => GetDayNames();
    private List<List<CalendarDay>> StartCalendarDays => GenerateCalendar(CurrentStartYear, CurrentStartMonth);
    private List<List<CalendarDay>> EndCalendarDays => GenerateCalendar(CurrentEndYear, CurrentEndMonth);
    private string StartCalendarLabel => $"Start date, {new DateTime(CurrentStartYear, CurrentStartMonth + 1, 1).ToString("Y", CultureInfo.CurrentCulture)}";
    private string EndCalendarLabel => $"End date, {new DateTime(CurrentEndYear, CurrentEndMonth + 1, 1).ToString("Y", CultureInfo.CurrentCulture)}";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        TempStartDate = StartDate;
        TempEndDate = EndDate;
        InitializeCalendars();
        _previousStartDate = StartDate;
        _previousEndDate = EndDate;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var parametersChanged = StartDate != _previousStartDate || EndDate != _previousEndDate;
        if (!IsOpen || parametersChanged)
        {
            TempStartDate = StartDate;
            TempEndDate = EndDate;
        }

        if (!IsOpen && parametersChanged)
        {
            InitializeCalendars();
        }

        _previousStartDate = StartDate;
        _previousEndDate = EndDate;
    }

    private void InitializeCalendars()
    {
        var today = DateTime.Today;
        var startView = StartDate ?? today;
        var endView = EndDate ?? startView.AddMonths(1);

        SetCalendarMonth(startView, true);
        SetCalendarMonth(endView, false);
    }

    private void ToggleCalendar(bool? focusStartDate, string restoreFocusElementId)
    {
        if (Disabled)
        {
            return;
        }

        if (IsOpen)
        {
            CloseCalendar();
            return;
        }

        OpenCalendar(focusStartDate ?? StartDateFocused, restoreFocusElementId);
    }

    private void OpenCalendar(bool focusStartDate, string restoreFocusElementId)
    {
        _restoreFocusElementId = restoreFocusElementId;
        TempStartDate = StartDate;
        TempEndDate = EndDate;
        InitializeCalendars();
        StartDateFocused = focusStartDate;
        _focusedDate = GetInitialFocusDate(focusStartDate);
        SetCalendarMonth(_focusedDate.Value, focusStartDate);
        IsOpen = true;
        QueueFocus(GetDayId(_focusedDate.Value, focusStartDate));
    }

    private void CloseCalendar()
    {
        if (!IsOpen)
        {
            return;
        }

        IsOpen = false;
        QueueFocus(_restoreFocusElementId ?? _triggerId);
    }

    private void HandleInputKeyDown(KeyboardEventArgs args, bool focusStartDate, string restoreFocusElementId)
    {
        if (args.Key is "Enter" or " " or "ArrowDown")
        {
            if (!IsOpen)
            {
                OpenCalendar(focusStartDate, restoreFocusElementId);
            }
        }
        else if (args.Key == "Escape")
        {
            CloseCalendar();
        }
    }

    private void HandleTriggerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowDown" && !IsOpen)
        {
            OpenCalendar(StartDateFocused, _triggerId);
        }
        else if (args.Key == "Escape")
        {
            CloseCalendar();
        }
    }

    private void HandlePopupKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseCalendar();
        }
    }

    private void PreviousMonth()
    {
        if (IsPreviousMonthDisabled)
        {
            return;
        }

        SetCalendarMonth(new DateTime(CurrentStartYear, CurrentStartMonth + 1, 1).AddMonths(-1), true);
        SetCalendarMonth(new DateTime(CurrentEndYear, CurrentEndMonth + 1, 1).AddMonths(-1), false);
        FocusFirstSelectableDay(StartDateFocused);
    }

    private void NextMonth()
    {
        if (IsNextMonthDisabled)
        {
            return;
        }

        SetCalendarMonth(new DateTime(CurrentStartYear, CurrentStartMonth + 1, 1).AddMonths(1), true);
        SetCalendarMonth(new DateTime(CurrentEndYear, CurrentEndMonth + 1, 1).AddMonths(1), false);
        FocusFirstSelectableDay(StartDateFocused);
    }

    private void HandleStartMonthChange(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var month) && month is >= 0 and <= 11)
        {
            CurrentStartMonth = month;
            FocusFirstSelectableDay(true);
        }
    }

    private void HandleStartYearChange(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var year) && year >= EffectiveMinYear && year <= EffectiveMaxYear)
        {
            CurrentStartYear = year;
            FocusFirstSelectableDay(true);
        }
    }

    private void HandleEndMonthChange(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var month) && month is >= 0 and <= 11)
        {
            CurrentEndMonth = month;
            FocusFirstSelectableDay(false);
        }
    }

    private void HandleEndYearChange(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var year) && year >= EffectiveMinYear && year <= EffectiveMaxYear)
        {
            CurrentEndYear = year;
            FocusFirstSelectableDay(false);
        }
    }

    private bool CanShiftPairedCalendars(int monthOffset) =>
        CanShiftCalendar(CurrentStartYear, CurrentStartMonth, monthOffset) &&
        CanShiftCalendar(CurrentEndYear, CurrentEndMonth, monthOffset);

    private bool CanShiftCalendar(int year, int month, int monthOffset)
    {
        var targetMonthIndex = year * 12 + month + monthOffset;
        var minimumMonthIndex = EffectiveMinYear * 12;
        var maximumMonthIndex = EffectiveMaxYear * 12 + 11;
        return targetMonthIndex >= minimumMonthIndex && targetMonthIndex <= maximumMonthIndex;
    }

    private void HandleDayFocus(DateTime date, bool isStartCalendar)
    {
        StartDateFocused = isStartCalendar;
        _focusedDate = date.Date;
    }

    private void HandleDayKeyDown(KeyboardEventArgs args, DateTime date, bool isStartCalendar)
    {
        var dayOffset = args.Key switch
        {
            "ArrowLeft" => -1,
            "ArrowRight" => 1,
            "ArrowUp" => -7,
            "ArrowDown" => 7,
            _ => 0
        };

        if (dayOffset != 0)
        {
            MoveDayFocus(date, dayOffset, isStartCalendar);
        }
    }

    private void MoveDayFocus(DateTime currentDate, int dayOffset, bool isStartCalendar)
    {
        var targetDate = currentDate.Date.AddDays(dayOffset);
        var isNavigable = isStartCalendar
            ? IsDateNavigable(targetDate)
            : IsDateNavigable(targetDate) && !IsBeforeStartDate(targetDate);

        if (!isNavigable)
        {
            return;
        }

        StartDateFocused = isStartCalendar;
        _focusedDate = targetDate;
        SetCalendarMonth(targetDate, isStartCalendar);
        QueueFocus(GetDayId(targetDate, isStartCalendar));
    }

    private void SelectStartDate(DateTime date)
    {
        if (!IsDateNavigable(date))
        {
            return;
        }

        TempStartDate = date.Date;
        if (TempEndDate.HasValue && TempEndDate.Value.Date < TempStartDate.Value.Date)
        {
            TempEndDate = null;
        }

        StartDateFocused = false;
        var endFocusDate = GetInitialFocusDate(false);
        _focusedDate = endFocusDate;
        SetCalendarMonth(endFocusDate, false);
        QueueFocus(GetDayId(endFocusDate, false));
    }

    private void SelectEndDate(DateTime date)
    {
        if (!IsDateNavigable(date) || IsBeforeStartDate(date))
        {
            return;
        }

        TempEndDate = date.Date;
        StartDateFocused = false;
        _focusedDate = date.Date;
    }

    private async Task ApplySelection()
    {
        var selectedStartDate = TempStartDate?.Date;
        var selectedEndDate = TempEndDate?.Date;

        StartDate = selectedStartDate;
        EndDate = selectedEndDate;
        CloseCalendar();

        await StartDateChanged.InvokeAsync(selectedStartDate);
        await EndDateChanged.InvokeAsync(selectedEndDate);
        await OnChange.InvokeAsync((selectedStartDate, selectedEndDate));
    }

    private void SelectToday() => SetPresetRange(DateTime.Today, DateTime.Today);

    private void SelectLastWeek() => SetPresetRange(DateTime.Today.AddDays(-6), DateTime.Today);

    private void SelectLastMonth() => SetPresetRange(DateTime.Today.AddDays(-29), DateTime.Today);

    private void SelectLastQuarter() => SetPresetRange(DateTime.Today.AddDays(-89), DateTime.Today);

    private void SetPresetRange(DateTime startDate, DateTime endDate)
    {
        if (!IsDateNavigable(startDate) || !IsDateNavigable(endDate))
        {
            return;
        }

        TempStartDate = startDate.Date;
        TempEndDate = endDate.Date;
    }

    private string GetStartDayClass(CalendarDay day)
    {
        var classes = new List<string> { "daterange-day" };

        if (!day.IsCurrentMonth) classes.Add("outside-month");
        if (day.IsToday) classes.Add("today");
        if (IsStartSelected(day))
        {
            classes.Add("selected");
            classes.Add("range-start");
        }

        if (IsInSelectedRange(day.Date)) classes.Add("in-range");
        return string.Join(" ", classes);
    }

    private string GetEndDayClass(CalendarDay day)
    {
        var classes = new List<string> { "daterange-day" };

        if (!day.IsCurrentMonth) classes.Add("outside-month");
        if (day.IsToday) classes.Add("today");
        if (IsEndSelected(day))
        {
            classes.Add("selected");
            classes.Add("range-end");
        }

        if (IsInSelectedRange(day.Date)) classes.Add("in-range");
        if (TempStartDate.HasValue && day.Date.Date == TempStartDate.Value.Date) classes.Add("range-start");
        return string.Join(" ", classes);
    }

    private bool IsInSelectedRange(DateTime date) =>
        TempStartDate.HasValue && TempEndDate.HasValue &&
        date.Date >= TempStartDate.Value.Date && date.Date <= TempEndDate.Value.Date;

    private bool IsStartSelected(CalendarDay day) => TempStartDate.HasValue && day.Date.Date == TempStartDate.Value.Date;

    private bool IsEndSelected(CalendarDay day) => TempEndDate.HasValue && day.Date.Date == TempEndDate.Value.Date;

    private bool IsStartDaySelectable(CalendarDay day) => day.IsCurrentMonth && IsDateNavigable(day.Date) && !Disabled;

    private bool IsEndDaySelectable(CalendarDay day) =>
        day.IsCurrentMonth && IsDateNavigable(day.Date) && !IsBeforeStartDate(day.Date) && !Disabled;

    private int GetDayTabIndex(CalendarDay day, bool isStartCalendar)
    {
        var isSelectable = isStartCalendar ? IsStartDaySelectable(day) : IsEndDaySelectable(day);
        return isSelectable && StartDateFocused == isStartCalendar && _focusedDate.HasValue &&
            day.Date.Date == _focusedDate.Value.Date ? 0 : -1;
    }

    private string GetDayId(DateTime date, bool isStartCalendar) =>
        $"{_componentId}-{(isStartCalendar ? "start" : "end")}-day-{date:yyyyMMdd}";

    private static string GetStartDayAriaLabel(CalendarDay day) =>
        $"Start date {day.Date.ToString("D", CultureInfo.CurrentCulture)}";

    private static string GetEndDayAriaLabel(CalendarDay day) =>
        $"End date {day.Date.ToString("D", CultureInfo.CurrentCulture)}";

    private string[] GetDayNames()
    {
        var dayNames = new string[7];
        var culture = CultureInfo.CurrentCulture;
        var daysOfWeek = culture.DateTimeFormat.AbbreviatedDayNames;

        for (var i = 0; i < 7; i++)
        {
            var dayIndex = (i + NormalizeFirstDayOfWeek()) % 7;
            dayNames[i] = daysOfWeek[dayIndex];
        }

        return dayNames;
    }

    private List<List<CalendarDay>> GenerateCalendar(int year, int month)
    {
        var today = DateTime.Today;
        var firstDay = new DateTime(year, month + 1, 1);
        var calendar = new List<List<CalendarDay>>();
        var currentWeek = new List<CalendarDay>();
        var diff = ((int)firstDay.DayOfWeek - NormalizeFirstDayOfWeek() + 7) % 7;
        var start = firstDay.AddDays(-diff);

        for (var i = 0; i < 42; i++)
        {
            var currentDate = start.AddDays(i);
            var isCurrentMonth = currentDate.Month == month + 1 && currentDate.Year == year;
            currentWeek.Add(new CalendarDay
            {
                Date = currentDate,
                DayNumber = currentDate.Day,
                IsCurrentMonth = isCurrentMonth,
                IsToday = currentDate.Date == today.Date
            });

            if (currentWeek.Count == 7)
            {
                calendar.Add(currentWeek);
                currentWeek = new List<CalendarDay>();

                if (calendar.Count >= 4 && !isCurrentMonth)
                {
                    break;
                }
            }
        }

        return calendar;
    }

    private int NormalizeFirstDayOfWeek() => ((FirstDayOfWeek % 7) + 7) % 7;

    private DateTime GetInitialFocusDate(bool isStartCalendar)
    {
        var candidate = isStartCalendar
            ? TempStartDate ?? StartDate ?? DateTime.Today
            : TempEndDate ?? EndDate ?? TempStartDate ?? StartDate ?? DateTime.Today;
        var minDate = GetEffectiveMinDate();
        var maxDate = GetEffectiveMaxDate();

        if (!isStartCalendar && TempStartDate.HasValue && candidate.Date < TempStartDate.Value.Date)
        {
            candidate = TempStartDate.Value.Date;
        }

        if (candidate.Date < minDate) return minDate;
        if (candidate.Date > maxDate) return maxDate;
        return candidate.Date;
    }

    private void FocusFirstSelectableDay(bool isStartCalendar)
    {
        var year = isStartCalendar ? CurrentStartYear : CurrentEndYear;
        var month = isStartCalendar ? CurrentStartMonth : CurrentEndMonth;
        var firstOfMonth = new DateTime(year, month + 1, 1);
        var lastOfMonth = firstOfMonth.AddMonths(1).AddDays(-1);
        var targetDate = _focusedDate?.Date ?? firstOfMonth;

        if (targetDate < firstOfMonth || targetDate > lastOfMonth)
        {
            targetDate = firstOfMonth;
        }

        if (!isStartCalendar && TempStartDate.HasValue && targetDate < TempStartDate.Value.Date)
        {
            targetDate = TempStartDate.Value.Date;
        }

        targetDate = targetDate < GetEffectiveMinDate() ? GetEffectiveMinDate() : targetDate;
        targetDate = targetDate > GetEffectiveMaxDate() ? GetEffectiveMaxDate() : targetDate;

        if (targetDate.Month != month + 1 || targetDate.Year != year)
        {
            return;
        }

        StartDateFocused = isStartCalendar;
        _focusedDate = targetDate;
        QueueFocus(GetDayId(targetDate, isStartCalendar));
    }

    private void SetCalendarMonth(DateTime date, bool isStartCalendar)
    {
        if (isStartCalendar)
        {
            CurrentStartMonth = date.Month - 1;
            CurrentStartYear = date.Year;
        }
        else
        {
            CurrentEndMonth = date.Month - 1;
            CurrentEndYear = date.Year;
        }
    }

    private bool IsDateNavigable(DateTime date)
    {
        var normalizedDate = date.Date;
        return normalizedDate >= GetEffectiveMinDate() && normalizedDate <= GetEffectiveMaxDate();
    }

    private bool IsBeforeStartDate(DateTime date) =>
        TempStartDate.HasValue && date.Date < TempStartDate.Value.Date;

    private DateTime GetEffectiveMinDate()
    {
        var yearBoundary = new DateTime(EffectiveMinYear, 1, 1);
        return MinDate.HasValue && MinDate.Value.Date > yearBoundary ? MinDate.Value.Date : yearBoundary;
    }

    private DateTime GetEffectiveMaxDate()
    {
        var yearBoundary = new DateTime(EffectiveMaxYear, 12, 31);
        return MaxDate.HasValue && MaxDate.Value.Date < yearBoundary ? MaxDate.Value.Date : yearBoundary;
    }

    private static string AriaBool(bool value) => value ? "true" : "false";

    private void QueueFocus(string elementId)
    {
        _pendingFocusElementId = elementId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        var elementId = _pendingFocusElementId;
        _pendingFocusElementId = null;

        if (!IsOpen && elementId is null)
        {
            return;
        }

        try
        {
            _domModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Vibe.UI/js/vibe-dom.js");

            if (IsOpen)
            {
                await _domModule.InvokeVoidAsync("initializeGridNavigationGuard", _startGridReference);
                await _domModule.InvokeVoidAsync("initializeGridNavigationGuard", _endGridReference);
            }

            if (elementId is not null)
            {
                await _domModule.InvokeVoidAsync("focusElement", elementId);
            }
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_domModule is null)
        {
            return;
        }

        try
        {
            await _domModule.DisposeAsync();
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }
    }

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;
}
