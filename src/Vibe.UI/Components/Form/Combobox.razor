@namespace Vibe.UI.Components
@inherits Base.VibeComponent

<div @attributes="AdditionalAttributes" class="@CombinedClass">
    <div class="combobox-trigger" @onclick="ToggleDropdown">
        <input id="@InputId" type="text" class="combobox-input" placeholder="@Placeholder" value="@InputValue"
            @oninput="OnInputChanged" @onfocus="OnInputFocus" @onclick:stopPropagation="true" @onkeydown="OnKeyDown" disabled="@Disabled"
            readonly="@ReadOnly" autocomplete="off" role="combobox" aria-label="@AriaLabel"
            aria-labelledby="@AriaLabelledBy" aria-autocomplete="list" aria-haspopup="listbox"
            aria-expanded="@AriaBool(IsOpen)" aria-controls="@ListboxId" aria-activedescendant="@ActiveDescendantId"
            aria-describedby="@InputDescribedBy" aria-invalid="@AriaInvalid" aria-errormessage="@AriaErrorMessageId"
            aria-readonly="@AriaReadonly" required="@EffectiveRequired" aria-required="@(EffectiveRequired ? "true" : null)" />
        <div class="combobox-chevron" aria-hidden="true">
            <Icon Name="chevron-down" Size="16" />
        </div>
    </div>

    @if (IsOpen)
    {
        <div class="combobox-content" id="@ListboxId" role="listbox">
            @if (FilteredOptions.Any())
            {
                @for (var i = 0; i < FilteredOptions.Count; i++)
                {
                    var option = FilteredOptions[i];
                    <div id="@GetOptionId(i)" @key="option" role="option"
                        class="combobox-option @(IsSelectedOption(option) ? "selected" : "") @(IsHighlightedOption(option) ? "highlighted" : "")"
                        aria-selected="@AriaBool(IsSelectedOption(option))" @onclick="() => SelectOption(option)"
                        @onmouseenter="() => HighlightOption(option)">
                        <span>@GetOptionLabel(option)</span>
                        @if (IsSelectedOption(option))
                        {
                            <Icon Name="check" Size="16" CssClass="combobox-check" />
                        }
                    </div>
                }
            }
            else
            {
                <div class="combobox-empty" role="status">@EmptyText</div>
            }
        </div>

        <div class="combobox-backdrop" @onclick="CloseDropdown"></div>
    }

    @if (HasHelperText)
    {
        <div class="combobox-helper" id="@HelperTextId">@HelperText</div>
    }

    @if (HasError)
    {
        <div class="combobox-error" id="@ErrorTextId" role="alert">@ErrorMessage</div>
    }
</div>

@code {
    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private string? _lastValue;
    private List<ComboboxOption>? _lastOptions;
    private bool _hasSyncedParameters;
    private string? _currentValue;

    /// <summary>
    /// Gets the relationships cascaded by an ancestor <see cref="FormField{TValue}"/>, if any.
    /// </summary>
    [CascadingParameter]
    private FormFieldContext? FieldContext { get; set; }

    /// <summary>
    /// Represents an option in the combobox.
    /// </summary>
    public class ComboboxOption
    {
        /// <summary>
        /// Gets or sets the option's label.
        /// </summary>
        public string Label { get; set; } = string.Empty;

        /// <summary>
        /// Gets or sets the option's value.
        /// </summary>
        public string Value { get; set; } = string.Empty;

        /// <summary>
        /// Gets or sets whether the option is disabled.
        /// </summary>
        public bool Disabled { get; set; }
    }

    /// <summary>
    /// Gets or sets the placeholder text.
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; } = "Select an option...";

    /// <summary>
    /// Gets or sets the input element ID.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the available options.
    /// </summary>
    [Parameter]
    public List<ComboboxOption> Options { get; set; } = new List<ComboboxOption>();

    /// <summary>
    /// Gets or sets the selected value.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets the callback when the value changes.
    /// </summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets whether to allow free text input.
    /// </summary>
    [Parameter]
    public bool AllowFreeText { get; set; }

    /// <summary>
    /// Gets or sets whether the combobox is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether the combobox is read-only.
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>
    /// Gets or sets whether the combobox value is required.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Gets or sets helper text displayed when there is no error message.
    /// </summary>
    [Parameter]
    public string? HelperText { get; set; }

    /// <summary>
    /// Gets or sets an error message for the combobox.
    /// </summary>
    [Parameter]
    public string? ErrorMessage { get; set; }

    /// <summary>
    /// Gets or sets the text displayed when no options match.
    /// </summary>
    [Parameter]
    public string EmptyText { get; set; } = "No results found.";

    /// <summary>
    /// Gets or sets an accessible label for the input.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>
    /// Gets or sets the ID of an element that labels the input.
    /// </summary>
    [Parameter]
    public string? AriaLabelledBy { get; set; }

    /// <summary>
    /// Gets or sets additional IDs that describe the input.
    /// </summary>
    [Parameter]
    public string? AriaDescribedBy { get; set; }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-combobox";

    /// <inheritdoc />
    protected override string GetCombinedClass()
    {
        return CombineClasses(
            ComponentClass,
            Disabled ? "disabled" : null,
            ReadOnly ? "readonly" : null,
            EffectiveHasError ? "has-error" : null,
            Class);
    }

    /// <summary>
    /// The current input value.
    /// </summary>
    private string InputValue
    {
        get => _inputValue;
        set
        {
            _inputValue = value;
            FilterOptions();
        }
    }
    private string _inputValue = string.Empty;

    /// <summary>
    /// Flag to track if the dropdown is open.
    /// </summary>
    private bool IsOpen = false;

    /// <summary>
    /// The filtered options based on the input value.
    /// </summary>
    private List<ComboboxOption> FilteredOptions = new List<ComboboxOption>();

    /// <summary>
    /// The currently highlighted option.
    /// </summary>
    private ComboboxOption? HighlightedOption;

    private string InputId => FieldContext?.ControlId
        ?? (string.IsNullOrWhiteSpace(Id) ? $"vibe-combobox-input-{_instanceId}" : Id!);

    private string ListboxId => $"{InputId}-listbox";

    private string HelperTextId => $"{InputId}-helper";

    private string ErrorTextId => $"{InputId}-error";

    private bool IsInteractive => !Disabled && !ReadOnly;

    private bool HasError => !string.IsNullOrWhiteSpace(ErrorMessage);

    private bool HasHelperText => !HasError && !string.IsNullOrWhiteSpace(HelperText);

    private bool EffectiveHasError => HasError || FieldContext?.IsInvalid == true;

    private bool EffectiveRequired => Required || FieldContext?.IsRequired == true;

    private string? AriaInvalid => EffectiveHasError ? "true" : null;

    private string? AriaErrorMessageId => EffectiveHasError
        ? (HasError ? ErrorTextId : FieldContext?.ErrorId)
        : null;

    private string? AriaReadonly => ReadOnly ? "true" : null;

    private string? InputDescribedBy => CombineIds(
        AriaDescribedBy,
        FieldContext?.DescribedBy,
        HasError ? ErrorTextId : null,
        HasHelperText ? HelperTextId : null);

    private string? ActiveDescendantId
    {
        get
        {
            var index = HighlightedOption == null ? -1 : FilteredOptions.IndexOf(HighlightedOption);
            return index >= 0 ? GetOptionId(index) : null;
        }
    }

    /// <summary>
    /// Updates parameters when they change.
    /// </summary>
    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var valueChanged = !_hasSyncedParameters || !string.Equals(Value, _lastValue, StringComparison.Ordinal);
        var optionsChanged = !_hasSyncedParameters || !ReferenceEquals(Options, _lastOptions);

        if (valueChanged || optionsChanged)
        {
            _currentValue = Value;
            UpdateInputFromValue();
        }

        _lastValue = Value;
        _lastOptions = Options;
        _hasSyncedParameters = true;

        if (!IsInteractive)
        {
            CloseDropdown();
        }

        FilterOptions();
    }

    /// <summary>
    /// Updates the input value from the selected value.
    /// </summary>
    private void UpdateInputFromValue()
    {
        if (string.IsNullOrEmpty(Value))
        {
            _inputValue = string.Empty;
            return;
        }

        var selectedOption = GetOptions().FirstOrDefault(o => string.Equals(o.Value, Value, StringComparison.Ordinal));
        _inputValue = selectedOption != null
            ? GetOptionLabel(selectedOption)
            : AllowFreeText ? Value : string.Empty;
    }

    /// <summary>
    /// Filters the options based on the input value.
    /// </summary>
    private void FilterOptions()
    {
        FilteredOptions = string.IsNullOrWhiteSpace(InputValue)
            ? GetOptions().Where(o => !o.Disabled).ToList()
            : GetOptions()
                .Where(o => !o.Disabled &&
                    GetOptionLabel(o).Contains(InputValue, StringComparison.OrdinalIgnoreCase))
                .ToList();

        HighlightedOption = FilteredOptions.FirstOrDefault();
    }

    private void OnInputChanged(ChangeEventArgs e)
    {
        if (!IsInteractive)
        {
            return;
        }

        InputValue = e.Value?.ToString() ?? string.Empty;
        IsOpen = true;
    }

    /// <summary>
    /// Toggles the dropdown state.
    /// </summary>
    private void ToggleDropdown()
    {
        if (!IsInteractive)
        {
            return;
        }

        IsOpen = !IsOpen;
        if (IsOpen)
        {
            FilterOptions();
        }
    }

    /// <summary>
    /// Closes the dropdown.
    /// </summary>
    private void CloseDropdown()
    {
        IsOpen = false;
    }

    /// <summary>
    /// Handles input focus.
    /// </summary>
    private void OnInputFocus()
    {
        if (!IsInteractive)
        {
            return;
        }

        IsOpen = true;
        FilterOptions();
    }

    /// <summary>
    /// Handles keyboard navigation.
    /// </summary>
    /// <param name="e">The keyboard event args.</param>
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!IsInteractive)
        {
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                if (!IsOpen)
                {
                    IsOpen = true;
                    FilterOptions();
                }
                else
                {
                    MoveHighlight(1);
                }
                break;

            case "ArrowUp":
                if (IsOpen)
                {
                    MoveHighlight(-1);
                }
                break;

            case "Enter":
                if (IsOpen && HighlightedOption != null)
                {
                    await SelectOption(HighlightedOption);
                }
                else if (AllowFreeText && !string.IsNullOrWhiteSpace(InputValue))
                {
                    await ValueChanged.InvokeAsync(InputValue);
                    CloseDropdown();
                }
                break;

            case "Escape":
                CloseDropdown();
                break;
        }
    }

    /// <summary>
    /// Moves the highlight to the next or previous option.
    /// </summary>
    /// <param name="step">The direction to move (1 for down, -1 for up).</param>
    private void MoveHighlight(int step)
    {
        if (!FilteredOptions.Any())
        {
            return;
        }

        var currentIndex = HighlightedOption == null ? -1 : FilteredOptions.IndexOf(HighlightedOption);
        if (currentIndex == -1)
        {
            HighlightedOption = FilteredOptions.FirstOrDefault();
        }
        else
        {
            var newIndex = (currentIndex + step + FilteredOptions.Count) % FilteredOptions.Count;
            HighlightedOption = FilteredOptions[newIndex];
        }
    }

    /// <summary>
    /// Highlights an option.
    /// </summary>
    /// <param name="option">The option to highlight.</param>
    private void HighlightOption(ComboboxOption option)
    {
        HighlightedOption = option;
    }

    /// <summary>
    /// Checks if an option is the currently selected one.
    /// </summary>
    /// <param name="option">The option to check.</param>
    private bool IsSelectedOption(ComboboxOption option)
    {
        return string.Equals(option.Value, _currentValue, StringComparison.Ordinal);
    }

    private bool IsHighlightedOption(ComboboxOption option) => ReferenceEquals(HighlightedOption, option);

    /// <summary>
    /// Selects an option.
    /// </summary>
    /// <param name="option">The option to select.</param>
    private async Task SelectOption(ComboboxOption? option)
    {
        if (!IsInteractive || option == null || option.Disabled)
        {
            return;
        }

        InputValue = GetOptionLabel(option);
        _currentValue = option.Value;
        await ValueChanged.InvokeAsync(option.Value ?? string.Empty);
        CloseDropdown();
    }

    private IEnumerable<ComboboxOption> GetOptions()
    {
        return Options ?? Enumerable.Empty<ComboboxOption>();
    }

    private string GetOptionLabel(ComboboxOption option)
    {
        return option.Label ?? string.Empty;
    }

    private string GetOptionId(int index)
    {
        return $"{InputId}-option-{index}";
    }

    private static string AriaBool(bool value)
    {
        return value ? "true" : "false";
    }

    private static string? CombineIds(params string?[] ids)
    {
        var combined = ids
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Select(id => id!.Trim())
            .ToList();

        return combined.Count == 0 ? null : string.Join(" ", combined);
    }
}
