@namespace Vibe.UI.Components
@inherits Base.VibeComponent

<label @attributes="LabelAttributes" class="@CombinedClass" for="@EffectiveFor">
    @ChildContent
    @if (Required)
    {
        <span class="required-indicator" aria-hidden="true">*</span>
    }
</label>

@code {
    /// <summary>
    /// Gets or sets the ID of the associated form control.
    /// </summary>
    [Parameter]
    public string? For { get; set; }

    /// <summary>
    /// Gets or sets the label content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets whether the associated field is required.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Gets or sets whether the associated field is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-form-label";

    /// <inheritdoc />
    protected override string GetCombinedClass()
    {
        return CombineClasses(
            ComponentClass,
            Required ? "required" : null,
            Disabled ? "disabled" : null,
            Class);
    }

    private string? EffectiveFor => string.IsNullOrWhiteSpace(For) ? null : For!;

    private Dictionary<string, object>? LabelAttributes => BuildLabelAttributes();

    private Dictionary<string, object>? BuildLabelAttributes()
    {
        var attributes = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);

        if (AdditionalAttributes != null)
        {
            foreach (var attribute in AdditionalAttributes)
            {
                if (!attribute.Key.Equals("class", StringComparison.OrdinalIgnoreCase))
                {
                    attributes[attribute.Key] = attribute.Value;
                }
            }
        }

        if (Disabled && !attributes.ContainsKey("aria-disabled"))
        {
            attributes["aria-disabled"] = "true";
        }

        return attributes.Count == 0 ? null : attributes;
    }
}
