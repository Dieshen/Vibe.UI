@namespace Vibe.UI.Components
@inherits VibeComponent

<label @attributes="LabelAttributes" class="@CombinedCssClass" for="@EffectiveFor">
    @ChildContent
    @if (Required)
    {
        <span class="required-indicator" aria-hidden="true">*</span>
    }
</label>

@code {
    /// <summary>
    /// The ID of the form control this label is associated with.
    /// </summary>
    [Parameter]
    public string? For { get; set; }

    /// <summary>
    /// The content to display in the label.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the label.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Whether the label is for a required field.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Whether the label is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    private string CombinedCssClass => CombineClasses(
        ComponentClass,
        Required ? "vibe-label-required" : null,
        Disabled ? "vibe-label-disabled" : null,
        CssClass,
        Class,
        AdditionalClass);

    protected override string ComponentClass => "vibe-label";

    private string? EffectiveFor => string.IsNullOrWhiteSpace(For) ? null : For;

    private Dictionary<string, object>? LabelAttributes => BuildLabelAttributes();

    private string? AdditionalClass =>
        AdditionalAttributes != null && AdditionalAttributes.TryGetValue("class", out var classValue)
            ? classValue?.ToString()
            : null;

    private Dictionary<string, object>? BuildLabelAttributes()
    {
        var attributes = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);

        if (AdditionalAttributes != null)
        {
            foreach (var attribute in AdditionalAttributes)
            {
                if (!attribute.Key.Equals("class", StringComparison.OrdinalIgnoreCase))
                {
                    attributes[attribute.Key] = attribute.Value;
                }
            }
        }

        if (Disabled)
        {
            attributes.TryAdd("aria-disabled", "true");
        }

        return attributes.Count == 0 ? null : attributes;
    }
}
