@namespace Vibe.UI.Components
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@typeparam TValue
@inherits Base.VibeComponent
@implements IDisposable

<div @attributes="RootAttributes" class="@CombinedClass">
    <div class="form-field-container @ValidationClass">
        @if (HasLabel)
        {
            <label class="form-field-label" id="@LabelId" for="@EffectiveId">
                <span>@Label</span>
                @if (Required)
                {
                    <span class="form-field-required" aria-hidden="true">*</span>
                }
            </label>
        }

        <CascadingValue Value="@FieldContext">
            <div class="form-field-input">
                @ChildContent
            </div>
        </CascadingValue>

        @if (HasDescription)
        {
            <div class="form-field-description" id="@DescriptionId">@Description</div>
        }

        @if (HasExplicitError)
        {
            <div class="form-validation-message" id="@ErrorId" role="alert">@ErrorMessage</div>
        }
        else if (ValidationMessages.Count > 0)
        {
            <div class="form-validation-message" id="@ErrorId" role="alert">
                @foreach (var message in ValidationMessages)
                {
                    <div>@message</div>
                }
            </div>
        }
        else if (ValidationFor != null && CurrentEditContext != null)
        {
            <ValidationMessage For="@ValidationFor" class="form-validation-message" />
        }
    </div>
</div>

@code {
    private readonly string _generatedId = "form-field-" + Guid.NewGuid().ToString("N");
    private EditContext? _previousEditContext;
    private FieldIdentifier? _fieldIdentifier;

    [CascadingParameter]
    private EditContext? CurrentEditContext { get; set; }

    /// <summary>
    /// Gets or sets the field label.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Gets or sets the field description.
    /// </summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>
    /// Gets or sets an explicit error message.
    /// </summary>
    [Parameter]
    public string? ErrorMessage { get; set; }

    /// <summary>
    /// Gets or sets the field validation expression.
    /// </summary>
    [Parameter]
    public Expression<Func<TValue>>? ValidationFor { get; set; }

    /// <summary>
    /// Gets or sets the field content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the field ID.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets whether the field has validation errors.
    /// </summary>
    [Parameter]
    public bool HasError { get; set; }

    /// <summary>
    /// Gets or sets whether the field is required.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-form-field";

    /// <summary>
    /// Gets the validation CSS class.
    /// </summary>
    private string ValidationClass => EffectiveHasError ? "has-error" : "";

    private string EffectiveId => string.IsNullOrWhiteSpace(Id) ? _generatedId : Id!;

    private string LabelId => $"{EffectiveId}-label";

    private string DescriptionId => $"{EffectiveId}-description";

    private string ErrorId => $"{EffectiveId}-error";

    private bool HasLabel => !string.IsNullOrWhiteSpace(Label);

    private bool HasDescription => !string.IsNullOrWhiteSpace(Description);

    private bool HasExplicitError => !string.IsNullOrWhiteSpace(ErrorMessage);

    private bool EffectiveHasError => HasError || HasExplicitError || ValidationMessages.Count > 0;

    private string? EffectiveErrorId => EffectiveHasError && (HasExplicitError || ValidationMessages.Count > 0)
        ? ErrorId
        : null;

    private string? ControlDescribedBy => CombineIds(
        HasDescription ? DescriptionId : null,
        EffectiveErrorId);

    private FormFieldContext FieldContext => new(
        EffectiveId,
        ControlDescribedBy,
        EffectiveErrorId,
        EffectiveHasError,
        Required);

    private IReadOnlyList<string> ValidationMessages => GetValidationMessages();

    private Dictionary<string, object>? RootAttributes => BuildRootAttributes();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!ReferenceEquals(_previousEditContext, CurrentEditContext))
        {
            if (_previousEditContext != null)
            {
                _previousEditContext.OnValidationStateChanged -= HandleValidationStateChanged;
            }

            if (CurrentEditContext != null)
            {
                CurrentEditContext.OnValidationStateChanged += HandleValidationStateChanged;
            }

            _previousEditContext = CurrentEditContext;
        }

        _fieldIdentifier = ValidationFor == null ? null : FieldIdentifier.Create(ValidationFor);
    }

    /// <inheritdoc />
    public void Dispose()
    {
        if (_previousEditContext != null)
        {
            _previousEditContext.OnValidationStateChanged -= HandleValidationStateChanged;
        }
    }

    private async void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    private IReadOnlyList<string> GetValidationMessages()
    {
        if (CurrentEditContext == null || _fieldIdentifier == null)
        {
            return Array.Empty<string>();
        }

        return CurrentEditContext.GetValidationMessages(_fieldIdentifier.Value).ToArray();
    }

    private Dictionary<string, object>? BuildRootAttributes()
    {
        var attributes = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);

        if (AdditionalAttributes != null)
        {
            foreach (var attribute in AdditionalAttributes)
            {
                if (!attribute.Key.Equals("class", StringComparison.OrdinalIgnoreCase))
                {
                    attributes[attribute.Key] = attribute.Value;
                }
            }
        }

        return attributes.Count == 0 ? null : attributes;
    }

    private static string? CombineIds(params string?[] ids)
    {
        var combined = ids
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Select(id => id!.Trim())
            .ToList();

        return combined.Count == 0 ? null : string.Join(" ", combined);
    }
}
