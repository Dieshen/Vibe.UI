@namespace Vibe.UI.Components
@inherits Base.VibeComponent

<div class="@CombinedClass">
    <div class="collapsible-trigger-wrapper"
         role="button"
         tabindex="0"
         aria-expanded="@(IsOpen ? "true" : "false")"
         aria-controls="@ContentId"
         @onclick="ToggleAsync"
         @onkeydown="HandleTriggerKeyDown">
        @TriggerContent(IsOpen)
    </div>

    <div id="@ContentId" class="vibe-collapsible-content collapsible-content @(IsOpen ? "expanded" : "")">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>
    /// Gets or sets the content of the collapsible.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the trigger content with expanded state parameter.
    /// </summary>
    [Parameter]
    public RenderFragment<bool> TriggerContent { get; set; } = default!;

    /// <summary>
    /// Gets or sets whether the collapsible is open.
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Gets or sets the callback when the open state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-collapsible";

    private readonly string ContentId = $"vibe-collapsible-content-{Guid.NewGuid():N}";

    /// <summary>
    /// Toggles the collapsible state.
    /// </summary>
    public async Task ToggleAsync()
    {
        IsOpen = !IsOpen;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private async Task HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            await ToggleAsync();
        }
    }
}
