@namespace Vibe.UI.Components
@inherits Base.VibeComponent

<div class="@CombinedClass" @attributes="AdditionalAttributes">
    <div id="@_triggerId"
         class="collapsible-trigger-wrapper"
         role="button"
         tabindex="0"
         aria-expanded="@AriaBool(_isOpen)"
         aria-controls="@_contentId"
         aria-label="@FallbackTriggerAriaLabel"
         @onclick="ToggleAsync"
         @onkeydown="HandleTriggerKeyDown">
        @if (TriggerContent is not null)
        {
            @TriggerContent(_isOpen)
        }
    </div>

    <div id="@_contentId"
         class="@ContentClass"
         role="region"
         aria-labelledby="@_triggerId"
         aria-hidden="@AriaHiddenValue"
         hidden="@(!_isOpen)">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>
    /// Gets or sets the content of the collapsible.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the trigger content with expanded state parameter.
    /// </summary>
    [Parameter]
    public RenderFragment<bool>? TriggerContent { get; set; }

    /// <summary>
    /// Gets or sets whether the collapsible is open.
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Gets or sets the callback when the open state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-collapsible";

    private readonly string _triggerId = $"vibe-collapsible-trigger-{Guid.NewGuid():N}";
    private readonly string _contentId = $"vibe-collapsible-content-{Guid.NewGuid():N}";
    private bool _hasSeenIsOpenParameter;
    private bool _isOpen;
    private bool _lastIsOpenParameter;

    private string ContentClass => CombineClasses(
        "vibe-collapsible-content",
        "collapsible-content",
        _isOpen ? "expanded" : null);
    private string? AriaHiddenValue => _isOpen ? null : "true";
    private string? FallbackTriggerAriaLabel => TriggerContent is null ? "Toggle collapsible" : null;

    protected override void OnParametersSet()
    {
        if (!_hasSeenIsOpenParameter || IsOpen != _lastIsOpenParameter)
        {
            _isOpen = IsOpen;
            _lastIsOpenParameter = IsOpen;
            _hasSeenIsOpenParameter = true;
        }
    }

    /// <summary>
    /// Toggles the collapsible state.
    /// </summary>
    public async Task ToggleAsync()
    {
        _isOpen = !_isOpen;
        await IsOpenChanged.InvokeAsync(_isOpen);
        StateHasChanged();
    }

    private async Task HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            await ToggleAsync();
        }
    }

    private static string AriaBool(bool value) => value ? "true" : "false";
}
