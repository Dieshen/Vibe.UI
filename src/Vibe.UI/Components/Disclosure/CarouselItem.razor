@namespace Vibe.UI.Components
@inherits Base.VibeComponent
@implements IDisposable

<div class="@CombinedClass"
     role="group"
     aria-roledescription="slide"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>
    /// Gets or sets the content of the carousel item.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "carousel-item";

    [CascadingParameter]
    private Carousel? ParentCarousel { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ParentCarousel?.AddItem(this);
    }

    public void Dispose() => ParentCarousel?.RemoveItem(this);
}
