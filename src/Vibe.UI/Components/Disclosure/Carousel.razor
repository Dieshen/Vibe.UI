@namespace Vibe.UI.Components
@implements IAsyncDisposable
@inherits Base.VibeComponent

<div class="@CombinedClass"
     role="region"
     aria-roledescription="carousel"
     aria-label="@EffectiveAriaLabel"
     aria-disabled="@DisabledAriaValue"
     data-orientation="@OrientationValue"
     tabindex="@RootTabIndex"
     @onkeydown="HandleKeyDown"
     @onmouseenter="PauseForInteraction"
     @onmouseleave="ResumeAfterInteraction"
     @onfocusin="PauseForInteraction"
     @onfocusout="ResumeAfterInteraction"
     @attributes="AdditionalAttributes">
    <div class="carousel-viewport"
        role="group"
        aria-label="@ViewportAriaLabel"
        aria-live="@ViewportLiveValue"
        @ref="ViewportRef"
        @onpointerdown="OnPointerDown"
        @onpointermove="OnPointerMove"
        @onpointerup="OnPointerUp"
        @onpointercancel="OnPointerCancel"
        @ondragstart:preventDefault="EnableDrag">
        <div class="carousel-container" style="@ContainerStyle">
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </div>

        @if (ShowNavigation)
        {
            <div class="carousel-navigation" aria-label="Carousel controls">
                <button type="button" class="carousel-button carousel-prev-button" @onclick="PrevSlide"
                    disabled="@IsPreviousDisabled" aria-label="@PreviousButtonLabel" aria-disabled="@PreviousDisabledAriaValue">
                    <Icon Name="chevron-left" Size="20" CssClass="carousel-button-icon" />
                </button>
                <button type="button" class="carousel-button carousel-next-button" @onclick="NextSlide"
                    disabled="@IsNextDisabled" aria-label="@NextButtonLabel" aria-disabled="@NextDisabledAriaValue">
                    <Icon Name="chevron-right" Size="20" CssClass="carousel-button-icon" />
                </button>
            </div>
        }

    </div>

    @if (ShowIndicators || AutoPlay)
    {
        <div class="carousel-controls">
            @if (ShowIndicators)
            {
                <div class="carousel-indicators" role="group" aria-label="Choose slide">
                    @for (int i = 0; i < Items.Count; i++)
                    {
                        var index = i;
                        <button type="button"
                            class="carousel-indicator @(i == _activeIndex ? "active" : "")"
                            aria-label="@GetIndicatorLabel(i)"
                            aria-current="@(i == _activeIndex ? "true" : null)"
                            disabled="@Disabled"
                            @onclick="() => GoToSlide(index)"></button>
                    }
                </div>
            }

            @if (AutoPlay)
            {
                <button type="button"
                        class="carousel-autoplay-button"
                        aria-label="@(_isUserPaused ? "Resume automatic slide rotation" : "Pause automatic slide rotation")"
                        aria-pressed="@(_isUserPaused ? "true" : "false")"
                        disabled="@Disabled"
                        @onclick="ToggleAutoPlayPause">
                    <Icon Name="@(_isUserPaused ? "play" : "pause")" Size="16" />
                </button>
            }
        </div>
    }
</div>

@code {
    private const int MinimumAutoPlayInterval = 250;
    private const double DragThreshold = 50;

    /// <summary>
    /// Gets or sets the content of the carousel.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether to show navigation arrows.
    /// </summary>
    [Parameter]
    public bool ShowNavigation { get; set; } = true;

    /// <summary>
    /// Gets or sets a value indicating whether to show indicator dots.
    /// </summary>
    [Parameter]
    public bool ShowIndicators { get; set; } = true;

    /// <summary>
    /// Gets or sets a value indicating whether slides should wrap around when reaching the end.
    /// </summary>
    [Parameter]
    public bool Loop { get; set; } = true;

    /// <summary>
    /// Gets or sets a value indicating whether the carousel should automatically advance slides.
    /// </summary>
    [Parameter]
    public bool AutoPlay { get; set; } = false;

    /// <summary>
    /// Gets or sets the interval in milliseconds for auto-advancing slides.
    /// </summary>
    [Parameter]
    public int AutoPlayInterval { get; set; } = 3000;

    /// <summary>
    /// Gets or sets a value indicating whether dragging is enabled.
    /// </summary>
    [Parameter]
    public bool EnableDrag { get; set; } = true;

    /// <summary>
    /// Gets or sets whether carousel interaction is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the active slide index.
    /// </summary>
    [Parameter]
    public int ActiveIndex { get; set; } = 0;

    /// <summary>
    /// Gets or sets the callback for when the active slide changes.
    /// </summary>
    [Parameter]
    public EventCallback<int> ActiveIndexChanged { get; set; }

    /// <summary>
    /// Gets or sets the orientation of the carousel.
    /// </summary>
    [Parameter]
    public CarouselOrientation Orientation { get; set; } = CarouselOrientation.Horizontal;

    /// <summary>
    /// Gets or sets the accessible name for the carousel region.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; } = "Carousel";

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => CombineClasses(
        "vibe-carousel",
        Disabled ? "vibe-carousel-disabled" : null,
        _isDragging ? "vibe-carousel-dragging" : null);

    /// <summary>
    /// Gets or sets the list of carousel items.
    /// </summary>
    public List<CarouselItem> Items { get; set; } = new();

    /// <summary>
    /// Gets or sets the viewport element reference.
    /// </summary>
    private ElementReference ViewportRef;

    private CancellationTokenSource? _autoPlayCancellationTokenSource;
    private Task? _autoPlayTask;
    private int _activeIndex;
    private int _requestedActiveIndex;
    private int _lastActiveIndexParameter;
    private int _autoPlayInterval;
    private bool _hasSeenActiveIndexParameter;
    private bool _isDragging;
    private double _dragStartX;
    private double _dragStartY;
    private double _dragCurrentOffset;
    private bool _isSwiping;
    private long? _activePointerId;
    private bool _isInteractionPaused;
    private bool _isUserPaused;
    private string EffectiveAriaLabel => string.IsNullOrWhiteSpace(AriaLabel) ? "Carousel" : AriaLabel!;
    private string ViewportAriaLabel => Items.Count == 0
        ? "Carousel slides"
        : $"Slide {_activeIndex + 1} of {Items.Count}";
    private string ViewportLiveValue => AutoPlay && !Disabled && !_isUserPaused && !_isInteractionPaused ? "off" : "polite";
    private string? DisabledAriaValue => Disabled ? "true" : null;
    private string OrientationValue => Orientation == CarouselOrientation.Vertical ? "vertical" : "horizontal";
    private int RootTabIndex => Disabled ? -1 : 0;
    private int EffectiveAutoPlayInterval => Math.Max(MinimumAutoPlayInterval, AutoPlayInterval);
    private bool CanNavigate => !Disabled && Items.Count > 1;
    private bool IsPreviousDisabled => Disabled || Items.Count <= 1 || (!Loop && _activeIndex <= 0);
    private bool IsNextDisabled => Disabled || Items.Count <= 1 || (!Loop && _activeIndex >= Items.Count - 1);
    private string? PreviousDisabledAriaValue => IsPreviousDisabled ? "true" : null;
    private string? NextDisabledAriaValue => IsNextDisabled ? "true" : null;
    private string PreviousButtonLabel => Loop && Items.Count > 1 && _activeIndex == 0
        ? $"Previous slide, slide {Items.Count}"
        : $"Previous slide, slide {Math.Max(1, _activeIndex)}";
    private string NextButtonLabel => Loop && Items.Count > 1 && _activeIndex == Items.Count - 1
        ? "Next slide, slide 1"
        : $"Next slide, slide {Math.Min(Items.Count, _activeIndex + 2)}";

    /// <summary>
    /// Gets the container style based on orientation and active index.
    /// </summary>
    private string ContainerStyle
    {
        get
        {
            if (Orientation == CarouselOrientation.Horizontal)
            {
                double translateX = -100 * _activeIndex + _dragCurrentOffset;
                return $"transform: translateX({translateX}%)";
            }
            else
            {
                double translateY = -100 * _activeIndex + _dragCurrentOffset;
                return $"flex-direction: column; transform: translateY({translateY}%)";
            }
        }
    }

    /// <summary>
    /// Applies parameter changes.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (!_hasSeenActiveIndexParameter || ActiveIndex != _lastActiveIndexParameter)
        {
            _requestedActiveIndex = Math.Max(0, ActiveIndex);
            _activeIndex = NormalizeActiveIndex(_requestedActiveIndex);
            _lastActiveIndexParameter = ActiveIndex;
            _hasSeenActiveIndexParameter = true;
        }

        RefreshAutoPlay();
    }

    /// <summary>
    /// Starts or stops auto play based on current state.
    /// </summary>
    private void RefreshAutoPlay()
    {
        if (!AutoPlay || Disabled || Items.Count <= 1)
        {
            StopAutoPlay();
            return;
        }

        var interval = EffectiveAutoPlayInterval;
        if (_autoPlayTask is not null && _autoPlayInterval == interval)
        {
            return;
        }

        StopAutoPlay();
        _autoPlayInterval = interval;
        _autoPlayCancellationTokenSource = new CancellationTokenSource();
        _autoPlayTask = RunAutoPlayAsync(_autoPlayCancellationTokenSource.Token, interval);
    }

    private async Task RunAutoPlayAsync(CancellationToken cancellationToken, int interval)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(interval, cancellationToken);
                await InvokeAsync(async () =>
                {
                    if (AutoPlay && !Disabled && !_isUserPaused && !_isInteractionPaused && !_isDragging && Items.Count > 1)
                    {
                        await NextSlide();
                    }
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    /// <summary>
    /// Adds a carousel item to the collection.
    /// </summary>
    /// <param name="item">The carousel item to add.</param>
    internal void AddItem(CarouselItem item)
    {
        if (Items.Contains(item))
        {
            return;
        }

        Items.Add(item);
        _activeIndex = NormalizeActiveIndex(_requestedActiveIndex);
        StateHasChanged();
        RefreshAutoPlay();
    }

    internal void RemoveItem(CarouselItem item)
    {
        if (!Items.Remove(item))
        {
            return;
        }

        _activeIndex = NormalizeActiveIndex(_activeIndex);
        _requestedActiveIndex = _activeIndex;
        RefreshAutoPlay();
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Navigates to the previous slide.
    /// </summary>
    private async Task PrevSlide()
    {
        if (!CanNavigate)
        {
            return;
        }

        if (_activeIndex > 0)
        {
            await GoToSlide(_activeIndex - 1);
        }
        else if (Loop)
        {
            await GoToSlide(Items.Count - 1);
        }
    }

    /// <summary>
    /// Navigates to the next slide.
    /// </summary>
    private async Task NextSlide()
    {
        if (!CanNavigate)
        {
            return;
        }

        if (_activeIndex < Items.Count - 1)
        {
            await GoToSlide(_activeIndex + 1);
        }
        else if (Loop)
        {
            await GoToSlide(0);
        }
    }

    /// <summary>
    /// Goes to a specific slide.
    /// </summary>
    /// <param name="index">The index of the slide to go to.</param>
    private async Task GoToSlide(int index)
    {
        if (Disabled || Items.Count == 0)
        {
            return;
        }

        var targetIndex = NormalizeActiveIndex(index);
        if (targetIndex != _activeIndex)
        {
            _activeIndex = targetIndex;
            _requestedActiveIndex = targetIndex;
            await ActiveIndexChanged.InvokeAsync(_activeIndex);
        }
    }

    /// <summary>
    /// Handles mouse down event for dragging.
    /// </summary>
    private void OnPointerDown(PointerEventArgs args)
    {
        if (!EnableDrag || !CanNavigate || args.Button != 0)
        {
            return;
        }

        _activePointerId = args.PointerId;
        _isDragging = true;
        _dragStartX = args.ClientX;
        _dragStartY = args.ClientY;
        _isSwiping = false;
    }

    /// <summary>
    /// Handles mouse move event for dragging.
    /// </summary>
    private void OnPointerMove(PointerEventArgs args)
    {
        if (!_isDragging || _activePointerId != args.PointerId)
        {
            return;
        }

        double diffX = args.ClientX - _dragStartX;
        double diffY = args.ClientY - _dragStartY;

        // Determine if we're swiping horizontally or vertically
        if (!_isSwiping && (Math.Abs(diffX) > 5 || Math.Abs(diffY) > 5))
        {
            _isSwiping = true;
        }

        if (_isSwiping)
        {
            double delta = Orientation == CarouselOrientation.Horizontal ? diffX : diffY;
            double percentage = (delta / 300) * 100; // Convert to percentage
            _dragCurrentOffset = percentage;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Handles mouse up event for dragging.
    /// </summary>
    private async Task OnPointerUp(PointerEventArgs args)
    {
        if (!_isDragging || _activePointerId != args.PointerId)
        {
            return;
        }

        _isDragging = false;
        _activePointerId = null;

        if (_isSwiping)
        {
            double diffX = args.ClientX - _dragStartX;
            double diffY = args.ClientY - _dragStartY;
            if (Orientation == CarouselOrientation.Horizontal)
            {
                if (diffX > DragThreshold)
                {
                    await PrevSlide();
                }
                else if (diffX < -DragThreshold)
                {
                    await NextSlide();
                }
            }
            else
            {
                if (diffY > DragThreshold)
                {
                    await PrevSlide();
                }
                else if (diffY < -DragThreshold)
                {
                    await NextSlide();
                }
            }
        }

        _dragCurrentOffset = 0;
        StateHasChanged();
    }

    /// <summary>
    /// Handles mouse leave event for dragging.
    /// </summary>
    private Task OnPointerCancel(PointerEventArgs args)
    {
        if (_activePointerId == args.PointerId)
        {
            _isDragging = false;
            _activePointerId = null;
            _dragCurrentOffset = 0;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private void PauseForInteraction() => _isInteractionPaused = true;

    private void ResumeAfterInteraction() => _isInteractionPaused = false;

    private void ToggleAutoPlayPause()
    {
        _isUserPaused = !_isUserPaused;
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (!CanNavigate)
        {
            return;
        }

        switch (args.Key)
        {
            case "ArrowLeft" when Orientation == CarouselOrientation.Horizontal:
            case "ArrowUp" when Orientation == CarouselOrientation.Vertical:
                await PrevSlide();
                break;
            case "ArrowRight" when Orientation == CarouselOrientation.Horizontal:
            case "ArrowDown" when Orientation == CarouselOrientation.Vertical:
                await NextSlide();
                break;
            case "Home":
                await GoToSlide(0);
                break;
            case "End":
                await GoToSlide(Items.Count - 1);
                break;
        }
    }

    private int NormalizeActiveIndex(int index)
    {
        if (Items.Count == 0)
        {
            return 0;
        }

        return Math.Clamp(index, 0, Items.Count - 1);
    }

    private string GetIndicatorLabel(int index)
    {
        var label = $"Go to slide {index + 1} of {Items.Count}";
        return index == _activeIndex ? $"{label}, current slide" : label;
    }

    private void StopAutoPlay()
    {
        if (_autoPlayCancellationTokenSource is null)
        {
            return;
        }

        _autoPlayCancellationTokenSource.Cancel();
        _autoPlayCancellationTokenSource.Dispose();
        _autoPlayCancellationTokenSource = null;
        _autoPlayTask = null;
    }

    /// <summary>
    /// Disposes the component.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (_autoPlayCancellationTokenSource is null)
        {
            return;
        }

        _autoPlayCancellationTokenSource.Cancel();

        if (_autoPlayTask is not null)
        {
            try
            {
                await _autoPlayTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _autoPlayCancellationTokenSource.Dispose();
        _autoPlayCancellationTokenSource = null;
        _autoPlayTask = null;
    }

    /// <summary>
    /// Defines the orientation of the carousel.
    /// </summary>
    public enum CarouselOrientation
    {
        /// <summary>
        /// Slides move horizontally.
        /// </summary>
        Horizontal,

        /// <summary>
        /// Slides move vertically.
        /// </summary>
        Vertical
    }
}
