@namespace Vibe.UI.Components

@if (Item is not null)
{
    <div class="@NodeCssClass"
         role="treeitem"
         aria-expanded="@AriaExpanded"
         aria-selected="@AriaBool(IsSelected)"
         aria-disabled="@AriaBool(IsDisabled)"
         aria-level="@NormalizedLevel"
         aria-posinset="@NormalizedPositionInSet"
         aria-setsize="@NormalizedSetSize"
         tabindex="@TabIndex"
         @onkeydown="HandleKeyDown">
        <div class="@ContentCssClass" @onclick="HandleClick">
            @if (HasChildren)
            {
                <button type="button"
                        class="@ToggleCssClass"
                        disabled="@IsDisabled"
                        aria-disabled="@AriaBool(IsDisabled)"
                        aria-label="@ToggleAriaLabel"
                        @onclick="HandleToggle"
                        @onclick:stopPropagation="true"
                        @onkeydown:stopPropagation="true">
                    <Icon Name="chevron-right" Size="16" CssClass="tree-node-chevron" />
                </button>
            }
            else
            {
                <span class="tree-node-spacer" aria-hidden="true"></span>
            }

            @if (ShowCheckboxes)
            {
                <input type="checkbox"
                       checked="@IsSelected"
                       disabled="@IsDisabled"
                       aria-label="@CheckboxAriaLabel"
                       @onchange="HandleCheckboxChange"
                       @onclick:stopPropagation="true"
                       @onkeydown:stopPropagation="true"
                       class="tree-node-checkbox" />
            }

            @if (!string.IsNullOrWhiteSpace(Item.IconName))
            {
                <span class="tree-node-icon" aria-hidden="true">
                    <Icon Name="@Item.IconName" Size="16" />
                </span>
            }
            else if (Item.Icon != null)
            {
                <span class="tree-node-icon" aria-hidden="true">@Item.Icon</span>
            }

            <span class="@LabelCssClass">
                @Item.Label
            </span>
        </div>

        @if (HasChildren)
        {
            <div class="@ChildrenCssClass" role="group" hidden="@(!IsExpanded)">
                @for (var index = 0; index < ChildItems.Count; index++)
                {
                    var child = ChildItems[index];

                    <TreeViewNode @key="child"
                                  Item="child"
                                  SelectedValue="@SelectedValue"
                                  OnNodeClick="@OnNodeClick"
                                  OnNodeExpand="@OnNodeExpand"
                                  ShowCheckboxes="@ShowCheckboxes"
                                  MultiSelect="@MultiSelect"
                                  ExpandedNodes="@ExpandedNodes"
                                  SelectedNodes="@SelectedNodes"
                                  Level="@(NormalizedLevel + 1)"
                                  PositionInSet="@(index + 1)"
                                  SetSize="@ChildItems.Count" />
                }
            </div>
        }
    </div>
}

@code {
    private static readonly IReadOnlyList<TreeView.TreeNode> EmptyNodes = Array.Empty<TreeView.TreeNode>();

    [Parameter]
    public TreeView.TreeNode? Item { get; set; }

    [Parameter]
    public string? SelectedValue { get; set; }

    [Parameter]
    public EventCallback<TreeView.TreeNode> OnNodeClick { get; set; }

    [Parameter]
    public EventCallback<TreeView.TreeNode> OnNodeExpand { get; set; }

    [Parameter]
    public bool ShowCheckboxes { get; set; }

    [Parameter]
    public bool MultiSelect { get; set; }

    [Parameter]
    public HashSet<string>? ExpandedNodes { get; set; } = new();

    [Parameter]
    public HashSet<string>? SelectedNodes { get; set; } = new();

    [Parameter]
    public int Level { get; set; } = 1;

    [Parameter]
    public int PositionInSet { get; set; } = 1;

    [Parameter]
    public int SetSize { get; set; } = 1;

    private IReadOnlyList<TreeView.TreeNode> ChildItems => Item?.Children ?? EmptyNodes;
    private bool HasChildren => ChildItems.Count > 0;
    private bool IsDisabled => Item?.IsDisabled == true;
    private bool IsExpanded => Item != null && ExpandedNodes?.Contains(Item.Id) == true;
    private bool IsSelected => Item != null && (SelectedNodes?.Contains(Item.Id) == true || SelectedValue == Item.Id);
    private int NormalizedLevel => Math.Max(1, Level);
    private int NormalizedSetSize => Math.Max(1, SetSize);
    private int NormalizedPositionInSet => Math.Clamp(PositionInSet, 1, NormalizedSetSize);
    private int TabIndex => IsDisabled ? -1 : 0;
    private string? AriaExpanded => HasChildren ? AriaBool(IsExpanded) : null;
    private string NodeLabel => Item?.Label ?? string.Empty;
    private string ToggleAriaLabel => $"{(IsExpanded ? "Collapse" : "Expand")} {NodeLabel}".Trim();
    private string CheckboxAriaLabel => $"Select {NodeLabel}".Trim();
    private string NodeCssClass => CombineClasses("tree-view-node", IsSelected ? "selected" : null, IsDisabled ? "disabled" : null);
    private string ContentCssClass => CombineClasses("tree-node-content", IsSelected ? "selected" : null, IsDisabled ? "disabled" : null);
    private string ToggleCssClass => CombineClasses("tree-node-toggle", IsExpanded ? "expanded" : null);
    private string LabelCssClass => CombineClasses("tree-node-label", IsSelected ? "selected" : null, IsDisabled ? "disabled" : null);
    private string ChildrenCssClass => CombineClasses("tree-node-children", IsExpanded ? "expanded" : "collapsed");

    private async Task HandleClick()
    {
        if (Item != null && !IsDisabled && OnNodeClick.HasDelegate)
        {
            await OnNodeClick.InvokeAsync(Item);
        }
    }

    private async Task HandleToggle()
    {
        if (Item != null && HasChildren && !IsDisabled && OnNodeExpand.HasDelegate)
        {
            await OnNodeExpand.InvokeAsync(Item);
        }
    }

    private async Task HandleCheckboxChange(ChangeEventArgs e)
    {
        if (Item != null && !IsDisabled && OnNodeClick.HasDelegate)
        {
            await OnNodeClick.InvokeAsync(Item);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Item == null || IsDisabled)
            return;

        switch (e.Key)
        {
            case "Enter":
            case " ":
            case "Spacebar":
                await HandleClick();
                break;
            case "ArrowRight":
                if (HasChildren && !IsExpanded)
                {
                    await HandleToggle();
                }
                break;
            case "ArrowLeft":
                if (HasChildren && IsExpanded)
                {
                    await HandleToggle();
                }
                break;
        }
    }

    private static string AriaBool(bool value) => value ? "true" : "false";

    private static string CombineClasses(params string?[] classes)
    {
        return string.Join(" ", classes.Where(c => !string.IsNullOrWhiteSpace(c)));
    }
}
