@namespace Vibe.UI.Components
@inherits VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div @attributes="AdditionalAttributes"
     @ref="_rootElement"
     class="@CombinedCssClass"
     role="region"
     aria-label="@EffectiveAriaLabel"
     aria-disabled="@AriaBool(Disabled)"
     data-readonly="@AriaBool(ReadOnly)">
    @if (VisibleColumns.Count > 0)
    {
        <div class="kanban-columns" role="list" aria-label="Kanban columns">
            @foreach (var column in VisibleColumns)
            {
                var cards = GetCards(column);

                <div class="@GetColumnCssClass(column)"
                     role="listitem"
                     aria-label="@GetColumnAriaLabel(column, cards.Count)"
                     aria-disabled="@AriaBool(IsColumnInteractionBlocked(column))"
                     @key="column">
                    <div class="kanban-column-header">
                        @if (ColumnHeaderTemplate != null)
                        {
                            @ColumnHeaderTemplate(column)
                        }
                        else
                        {
                            <h3 class="column-title">@GetColumnTitle(column)</h3>
                            @if (column.Badge != null)
                            {
                                <span class="column-badge">@column.Badge</span>
                            }
                            else
                            {
                                <span class="column-count" aria-label="@GetColumnCountLabel(cards.Count)">@cards.Count</span>
                            }
                            @if (AllowAddCard)
                            {
                                <button type="button"
                                        class="column-add-btn"
                                        disabled="@(!CanRequestAddCard(column))"
                                        @onclick="() => HandleAddCardRequested(column)"
                                        title="@GetAddCardLabel(column)"
                                        aria-label="@GetAddCardLabel(column)">
                                    <Icon Name="plus" Size="16" />
                                </button>
                            }
                        }
                    </div>

                    <div class="kanban-cards"
                         role="list"
                         aria-label="@GetCardListLabel(column)"
                         @ondragover="() => HandleDragOver(column)"
                         @ondragover:preventDefault="true"
                         @ondrop="() => HandleDrop(column)"
                         @ondrop:preventDefault="@CanReceiveDrop(column)">
                        @if (cards.Count == 0)
                        {
                            <div class="kanban-column-empty" role="status">@EmptyColumnText</div>
                        }
                        else
                        {
                            @foreach (var card in cards)
                            {
                                var tags = GetTags(card);

                                <div class="kanban-card-shell" role="listitem" @key="card">
                                    <div class="@GetCardCssClass(card)"
                                         role="@GetCardRole(card)"
                                         tabindex="@GetCardTabIndex(card)"
                                         aria-label="@GetCardAriaLabel(card)"
                                         aria-disabled="@GetCardAriaDisabled(card)"
                                         aria-keyshortcuts="@GetCardKeyboardShortcuts(card, column)"
                                         data-kanban-card-id="@card.Id"
                                         draggable="@AriaBool(CanDragCard(card, column))"
                                         @ondragstart="() => HandleDragStart(card, column)"
                                         @ondragend="HandleDragEnd"
                                         @onclick="() => HandleCardClick(card)"
                                         @onkeydown="args => HandleCardKeyDown(args, card, column)">
                                        @if (CardTemplate != null)
                                        {
                                            @CardTemplate(card)
                                        }
                                        else
                                        {
                                            <div class="card-content">
                                                @if (!string.IsNullOrWhiteSpace(card.Title))
                                                {
                                                    <h4 class="card-title">@card.Title</h4>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(card.Description))
                                                {
                                                    <p class="card-description">@card.Description</p>
                                                }
                                                @if (tags.Count > 0)
                                                {
                                                    <div class="card-tags" aria-label="Card tags">
                                                        @foreach (var tag in tags)
                                                        {
                                                            <span class="card-tag">@tag</span>
                                                        }
                                                    </div>
                                                }
                                                @if (card.Footer != null)
                                                {
                                                    <div class="card-footer">@card.Footer</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @if (column.Footer != null)
                    {
                        <div class="kanban-column-footer">
                            @column.Footer
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="kanban-empty" role="status">
            @if (EmptyContent != null)
            {
                @EmptyContent
            }
            else
            {
                <span>@EmptyText</span>
            }
        </div>
    }
</div>

@code {
    private const string DefaultAriaLabel = "Kanban board";
    private const string UntitledColumn = "Untitled column";
    private const string UntitledCard = "Untitled card";
    private KanbanCard? _draggedCard;
    private KanbanColumn? _sourceColumn;
    private string? _dragOverColumnId;
    private ElementReference _rootElement;
    private IJSObjectReference? _module;
    private string? _pendingFocusCardId;
    private bool _disposed;

    [Parameter]
    public List<KanbanColumn>? Columns { get; set; }

    [Parameter]
    public RenderFragment<KanbanCard>? CardTemplate { get; set; }

    [Parameter]
    public RenderFragment<KanbanColumn>? ColumnHeaderTemplate { get; set; }

    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    [Parameter]
    public bool AllowDragDrop { get; set; } = true;

    [Parameter]
    public bool AllowAddCard { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = DefaultAriaLabel;

    [Parameter]
    public string EmptyText { get; set; } = "No columns";

    [Parameter]
    public string EmptyColumnText { get; set; } = "No cards";

    [Parameter]
    public EventCallback<KanbanCard> OnCardClicked { get; set; }

    [Parameter]
    public EventCallback<string> OnAddCardRequested { get; set; }

    [Parameter]
    public EventCallback<CardMovedEventArgs> OnCardMoved { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    private string CombinedCssClass => CombineClasses(
        "vibe-kanban",
        Disabled ? "vibe-kanban-disabled" : null,
        ReadOnly ? "vibe-kanban-readonly" : null,
        CssClass,
        Class
    );

    protected override string ComponentClass => CombinedCssClass;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            if (firstRender && _module is null)
            {
                var importedModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./_content/Vibe.UI/js/kanbanBoard.js");

                if (_disposed)
                {
                    // Disposal landed while the import was in flight; the component
                    // never gets to see this reference, so we own cleaning it up.
                    await DisposeModuleSafelyAsync(importedModule);
                    return;
                }

                _module = importedModule;
            }

            if (_module is not null && _pendingFocusCardId is string cardId)
            {
                _pendingFocusCardId = null;
                await _module.InvokeVoidAsync("focusCard", _rootElement, cardId);
            }
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }
    }

    private IReadOnlyList<KanbanColumn> VisibleColumns =>
        Columns?.OfType<KanbanColumn>().ToList() ?? [];

    private string EffectiveAriaLabel =>
        string.IsNullOrWhiteSpace(AriaLabel) ? DefaultAriaLabel : AriaLabel.Trim();

    private bool InteractionsBlocked => Disabled || ReadOnly;

    private async Task HandleCardClick(KanbanCard card)
    {
        if (!CanClickCard(card))
        {
            return;
        }

        await OnCardClicked.InvokeAsync(card);
    }

    private async Task HandleCardKeyDown(KeyboardEventArgs args, KanbanCard card, KanbanColumn column)
    {
        if (args.CtrlKey && args.Key is "ArrowLeft" or "ArrowRight" && CanDragCard(card, column))
        {
            await MoveCardToAdjacentColumn(card, column, args.Key == "ArrowRight" ? 1 : -1);
            return;
        }

        if (!CanClickCard(card) || !IsActivationKey(args.Key))
        {
            return;
        }

        await OnCardClicked.InvokeAsync(card);
    }

    private async Task MoveCardToAdjacentColumn(KanbanCard card, KanbanColumn column, int direction)
    {
        var columns = VisibleColumns.ToList();
        var currentIndex = columns.IndexOf(column);
        var targetIndex = currentIndex + direction;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= columns.Count)
        {
            return;
        }

        var targetColumn = columns[targetIndex];
        if (IsColumnInteractionBlocked(targetColumn))
        {
            return;
        }

        _pendingFocusCardId = card.Id;
        await MoveCard(card.Id, column.Id, targetColumn.Id);
    }

    private async Task HandleAddCardRequested(KanbanColumn column)
    {
        if (!CanRequestAddCard(column))
        {
            return;
        }

        await OnAddCardRequested.InvokeAsync(column.Id);
    }

    private void HandleDragStart(KanbanCard card, KanbanColumn column)
    {
        if (!CanDragCard(card, column))
        {
            ClearDragState();
            return;
        }

        _draggedCard = card;
        _sourceColumn = column;
        _dragOverColumnId = null;
    }

    private void HandleDragOver(KanbanColumn column)
    {
        var nextColumnId = CanReceiveDrop(column) ? column.Id : null;
        if (!string.Equals(_dragOverColumnId, nextColumnId, StringComparison.Ordinal))
        {
            _dragOverColumnId = nextColumnId;
            StateHasChanged();
        }
    }

    private async Task HandleDrop(KanbanColumn column)
    {
        if (!CanReceiveDrop(column) || _draggedCard is null || _sourceColumn is null)
        {
            ClearDragState();
            return;
        }

        var cardId = _draggedCard.Id;
        var fromColumnId = _sourceColumn.Id;
        var toColumnId = column.Id;
        ClearDragState();
        await MoveCard(cardId, fromColumnId, toColumnId);
    }

    private void HandleDragEnd(DragEventArgs _) => ClearDragState();

    private void ClearDragState()
    {
        _draggedCard = null;
        _sourceColumn = null;
        _dragOverColumnId = null;
    }

    public async Task MoveCard(string cardId, string fromColumnId, string toColumnId)
    {
        if (InteractionsBlocked ||
            string.IsNullOrWhiteSpace(cardId) ||
            string.IsNullOrWhiteSpace(fromColumnId) ||
            string.IsNullOrWhiteSpace(toColumnId) ||
            string.Equals(fromColumnId, toColumnId, StringComparison.Ordinal))
        {
            return;
        }

        var fromColumn = FindColumn(fromColumnId);
        var toColumn = FindColumn(toColumnId);

        if (fromColumn == null ||
            toColumn == null ||
            IsColumnInteractionBlocked(fromColumn) ||
            IsColumnInteractionBlocked(toColumn) ||
            fromColumn.Cards == null)
        {
            return;
        }

        var card = fromColumn.Cards
            .OfType<KanbanCard>()
            .FirstOrDefault(candidate => string.Equals(candidate.Id, cardId, StringComparison.Ordinal));

        if (card == null || IsCardInteractionBlocked(card))
        {
            return;
        }

        toColumn.Cards ??= [];

        if (!fromColumn.Cards.Remove(card))
        {
            return;
        }

        toColumn.Cards.Add(card);

        await OnCardMoved.InvokeAsync(new CardMovedEventArgs
        {
            Card = card,
            FromColumnId = fromColumnId,
            ToColumnId = toColumnId
        });

        StateHasChanged();
    }

    private KanbanColumn? FindColumn(string columnId) =>
        VisibleColumns.FirstOrDefault(column => string.Equals(column.Id, columnId, StringComparison.Ordinal));

    private static IReadOnlyList<KanbanCard> GetCards(KanbanColumn column) =>
        column.Cards?.OfType<KanbanCard>().ToList() ?? [];

    private static IReadOnlyList<string> GetTags(KanbanCard card) =>
        card.Tags?
            .Where(tag => !string.IsNullOrWhiteSpace(tag))
            .Select(tag => tag.Trim())
            .ToList() ?? [];

    private static string GetColumnTitle(KanbanColumn column) =>
        string.IsNullOrWhiteSpace(column.Title) ? UntitledColumn : column.Title.Trim();

    private static string GetCardTitle(KanbanCard card) =>
        string.IsNullOrWhiteSpace(card.Title) ? UntitledCard : card.Title.Trim();

    private static string GetColumnCountLabel(int count) =>
        count == 1 ? "1 card" : $"{count} cards";

    private static string GetColumnAriaLabel(KanbanColumn column, int count) =>
        $"{GetColumnTitle(column)}, {GetColumnCountLabel(count)}";

    private static string GetCardListLabel(KanbanColumn column) =>
        $"{GetColumnTitle(column)} cards";

    private static string GetAddCardLabel(KanbanColumn column) =>
        $"Add card to {GetColumnTitle(column)}";

    private static string GetCardAriaLabel(KanbanCard card) =>
        GetCardTitle(card);

    private string GetColumnCssClass(KanbanColumn column) =>
        CombineClasses(
            "kanban-column",
            IsColumnInteractionBlocked(column) ? "kanban-column-disabled" : null,
            string.Equals(_dragOverColumnId, column.Id, StringComparison.Ordinal) ? "kanban-column-drop-target" : null
        );

    private string GetCardCssClass(KanbanCard card) =>
        CombineClasses(
            "kanban-card",
            IsCardInteractionBlocked(card) ? "kanban-card-disabled" : null,
            CanClickCard(card) ? "kanban-card-clickable" : null,
            ReferenceEquals(_draggedCard, card) ? "kanban-card-dragging" : null
        );

    private string GetCardRole(KanbanCard card) =>
        OnCardClicked.HasDelegate ? "button" : "group";

    private string? GetCardTabIndex(KanbanCard card) =>
        (CanClickCard(card) || CanDragCardInAnyColumn(card)) ? "0" : null;

    private string? GetCardAriaDisabled(KanbanCard card) =>
        OnCardClicked.HasDelegate || AllowDragDrop ? AriaBool(IsCardInteractionBlocked(card)) : null;

    private string? GetCardKeyboardShortcuts(KanbanCard card, KanbanColumn column) =>
        CanDragCard(card, column) ? "Control+ArrowLeft Control+ArrowRight" : null;

    private bool CanClickCard(KanbanCard card) =>
        OnCardClicked.HasDelegate && !IsCardInteractionBlocked(card);

    private bool CanDragCard(KanbanCard card, KanbanColumn column) =>
        AllowDragDrop &&
        !string.IsNullOrWhiteSpace(card.Id) &&
        !string.IsNullOrWhiteSpace(column.Id) &&
        !IsColumnInteractionBlocked(column) &&
        !IsCardInteractionBlocked(card);

    private bool CanDragCardInAnyColumn(KanbanCard card) =>
        VisibleColumns.Any(column => GetCards(column).Contains(card) && CanDragCard(card, column));

    private bool CanReceiveDrop(KanbanColumn column) =>
        _draggedCard is not null &&
        _sourceColumn is not null &&
        !IsColumnInteractionBlocked(column) &&
        !string.Equals(_sourceColumn.Id, column.Id, StringComparison.Ordinal);

    private bool CanRequestAddCard(KanbanColumn column) =>
        AllowAddCard &&
        OnAddCardRequested.HasDelegate &&
        !IsColumnInteractionBlocked(column) &&
        !string.IsNullOrWhiteSpace(column.Id);

    private bool IsColumnInteractionBlocked(KanbanColumn column) =>
        InteractionsBlocked || column.IsDisabled;

    private bool IsCardInteractionBlocked(KanbanCard card) =>
        InteractionsBlocked || card.IsDisabled;

    private static bool IsActivationKey(string? key) =>
        key is "Enter" or " ";

    private static string AriaBool(bool value) =>
        value ? "true" : "false";

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        if (_module is null)
        {
            return;
        }

        await DisposeModuleSafelyAsync(_module);
    }

    private static async Task DisposeModuleSafelyAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }
    }

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;

    public class KanbanColumn
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Title { get; set; } = string.Empty;
        public List<KanbanCard> Cards { get; set; } = new();
        public RenderFragment? Badge { get; set; }
        public RenderFragment? Footer { get; set; }
        public bool IsDisabled { get; set; }
        public string? Color { get; set; }
    }

    public class KanbanCard
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string? Title { get; set; }
        public string? Description { get; set; }
        public List<string>? Tags { get; set; }
        public RenderFragment? Footer { get; set; }
        public bool IsDisabled { get; set; }
        public object? Data { get; set; }
    }

    public class CardMovedEventArgs
    {
        public KanbanCard Card { get; set; } = new();
        public string FromColumnId { get; set; } = string.Empty;
        public string ToColumnId { get; set; } = string.Empty;
    }
}
