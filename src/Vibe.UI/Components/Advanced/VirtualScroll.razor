@namespace Vibe.UI.Components
@inherits VibeComponent
@typeparam TItem

<div @attributes="AdditionalAttributes"
     class="@CombinedClass"
     style="@ContainerStyle"
     role="list"
     aria-label="@EffectiveAriaLabel"
     aria-rowcount="@ItemCount"
     @ref="_containerRef">
    <div class="virtual-scroll-spacer" style="@SpacerStyle" aria-hidden="@AriaBool(ItemCount == 0)">
        @if (ItemCount > 0)
        {
            var visibleItems = GetVisibleItems();
            @for (var index = 0; index < visibleItems.Count; index++)
            {
                var visibleItem = visibleItems[index];
                <div class="virtual-scroll-item"
                     role="listitem"
                     aria-setsize="@ItemCount"
                     aria-posinset="@(visibleItem.Index + 1)"
                     @key="GetItemKey(visibleItem.Item, visibleItem.Index)">
                    @if (ItemTemplate != null)
                    {
                        @ItemTemplate(visibleItem.Item)
                    }
                    else
                    {
                        @GetFallbackText(visibleItem.Item)
                    }
                </div>
            }
        }
        else
        {
            <div class="virtual-scroll-empty" role="status">
                @if (EmptyContent != null)
                {
                    @EmptyContent
                }
                else
                {
                    @EmptyText
                }
            </div>
        }
    </div>
</div>

@code {
    private ElementReference _containerRef;
    private int _startIndex = 0;
    private int _endIndex = 0;
    [Parameter]
    public List<TItem>? Items { get; set; }

    [Parameter]
    public RenderFragment<TItem>? ItemTemplate { get; set; }

    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "No items";

    [Parameter]
    public int ItemHeight { get; set; } = 50;

    [Parameter]
    public int BufferSize { get; set; } = 5;

    [Parameter]
    public int Height { get; set; } = 400;

    [Parameter]
    public Func<TItem, string?>? KeySelector { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; } = "Virtualized list";

    [Parameter]
    public string? CssClass { get; set; }

    private string ComponentCssClass => CombineClasses(
        "vibe-virtual-scroll",
        ItemCount == 0 ? "vibe-virtual-scroll-empty" : null,
        CssClass);

    protected override string ComponentClass => ComponentCssClass;

    private int EffectiveItemHeight => Math.Max(1, ItemHeight);

    private int EffectiveBufferSize => Math.Max(0, BufferSize);

    private int EffectiveHeight => Math.Max(1, Height);

    private int ItemCount => Items?.Count ?? 0;

    private string EffectiveAriaLabel => string.IsNullOrWhiteSpace(AriaLabel)
        ? "Virtualized list"
        : AriaLabel.Trim();

    private string ContainerStyle => $"height: {EffectiveHeight}px; overflow-y: auto;";

    private string SpacerStyle
    {
        get
        {
            var totalHeight = ItemCount * EffectiveItemHeight;
            var offsetTop = _startIndex * EffectiveItemHeight;
            return $"height: {totalHeight}px; padding-top: {offsetTop}px;";
        }
    }

    protected override void OnParametersSet()
    {
        CalculateVisibleRange();
    }

    private void CalculateVisibleRange()
    {
        if (ItemCount == 0)
        {
            _startIndex = 0;
            _endIndex = 0;
            return;
        }

        var visibleCount = (int)Math.Ceiling((double)EffectiveHeight / EffectiveItemHeight);
        _startIndex = Math.Clamp(_startIndex - EffectiveBufferSize, 0, ItemCount);
        _endIndex = Math.Min(ItemCount, _startIndex + visibleCount + EffectiveBufferSize * 2);
    }

    private IReadOnlyList<VisibleVirtualItem> GetVisibleItems()
    {
        if (Items == null || ItemCount == 0 || _endIndex <= _startIndex)
        {
            return [];
        }

        var visibleItems = new List<VisibleVirtualItem>(_endIndex - _startIndex);
        for (var index = _startIndex; index < _endIndex; index++)
        {
            visibleItems.Add(new VisibleVirtualItem(index, Items[index]));
        }

        return visibleItems;
    }

    private string GetItemKey(TItem item, int index)
    {
        if (KeySelector != null && item != null)
        {
            var key = KeySelector(item);
            if (!string.IsNullOrWhiteSpace(key))
            {
                return key;
            }
        }

        return item?.GetHashCode().ToString() ?? $"null-{index}";
    }

    // Method to handle scroll event - would need JS interop for full implementation
    public void HandleScroll(int scrollTop)
    {
        if (ItemCount == 0)
        {
            return;
        }

        var newStartIndex = Math.Clamp(
            (int)Math.Floor((double)Math.Max(0, scrollTop) / EffectiveItemHeight),
            0,
            ItemCount - 1);

        if (newStartIndex != _startIndex)
        {
            _startIndex = newStartIndex;
            CalculateVisibleRange();
            StateHasChanged();
        }
    }

    public void ScrollToIndex(int index)
    {
        if (Items == null || index < 0 || index >= ItemCount)
        {
            return;
        }

        _startIndex = index;
        CalculateVisibleRange();
        StateHasChanged();

        // Would need JS interop: _containerRef.scrollTop = index * ItemHeight
    }

    private static string GetFallbackText(TItem item) => item?.ToString() ?? string.Empty;

    private static string AriaBool(bool value) => value ? "true" : "false";

    private sealed record VisibleVirtualItem(int Index, TItem Item);
}
