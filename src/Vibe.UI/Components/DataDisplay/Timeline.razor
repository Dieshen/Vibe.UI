@namespace Vibe.UI.Components
@inherits VibeComponent

<div @attributes="AdditionalAttributes" class="@CombinedClass" role="@EffectiveRole" aria-label="@EffectiveAriaLabel">
    @if (_items.Count > 0)
    {
        @for (var index = 0; index < _items.Count; index++)
        {
            var item = _items[index];
            var isLast = index == _items.Count - 1;
            var title = GetItemTitle(item);
            var description = GetItemDescription(item);

            <div class="timeline-item" role="@TimelineItemRole" @key="GetItemKey(item, index)">
                <div class="timeline-marker-container">
                    <div class="@GetMarkerClass(item)" aria-hidden="true">
                        @if (item.Icon != null)
                        {
                            @item.Icon
                        }
                    </div>
                    @if (!isLast)
                    {
                        <div class="timeline-connector" aria-hidden="true"></div>
                    }
                </div>

                <div class="timeline-content">
                    @if (title is not null)
                    {
                        <h4 class="timeline-title">@title</h4>
                    }

                    @if (description is not null)
                    {
                        <p class="timeline-description">@description</p>
                    }

                    @if (item.Content != null)
                    {
                        <div class="timeline-body">@item.Content</div>
                    }

                    @if (item.Timestamp.HasValue)
                    {
                        <time class="timeline-time" datetime="@item.Timestamp.Value.ToString("o")">
                            @FormatTimestamp(item.Timestamp.Value)
                        </time>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<TimelineItem> _items = Array.Empty<TimelineItem>();
    private TimelinePosition _effectivePosition = TimelinePosition.Left;

    [Parameter]
    public List<TimelineItem>? Items { get; set; }

    [Parameter]
    public TimelinePosition Position { get; set; } = TimelinePosition.Left;

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    private string CombinedCssClass => CombineClasses(
        "vibe-timeline",
        $"timeline-{GetPositionClass(_effectivePosition)}",
        CssClass
    );

    protected override string ComponentClass => CombinedCssClass;

    private string? EffectiveRole => HasAdditionalAttribute("role") ? null : "list";

    private string? EffectiveAriaLabel =>
        HasAdditionalAttribute("aria-label") || HasAdditionalAttribute("aria-labelledby") || string.IsNullOrWhiteSpace(AriaLabel)
            ? null
            : AriaLabel.Trim();

    private string? TimelineItemRole => EffectiveRole == "list" ? "listitem" : null;

    protected override void OnParametersSet()
    {
        _effectivePosition = Enum.IsDefined(Position) ? Position : TimelinePosition.Left;
        _items = NormalizeItems(Items);
    }

    private string FormatTimestamp(DateTime timestamp)
    {
        var diff = DateTime.Now - timestamp;

        if (diff < TimeSpan.Zero) return timestamp.ToString("MMM d, yyyy");
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";

        return timestamp.ToString("MMM d, yyyy");
    }

    private static IReadOnlyList<TimelineItem> NormalizeItems(List<TimelineItem>? items)
    {
        if (items is null)
        {
            return Array.Empty<TimelineItem>();
        }

        return items
            .Where(item => item is not null)
            .ToArray()!;
    }

    private static string? GetItemTitle(TimelineItem item) => NormalizeOptionalText(item.Title);

    private static string? GetItemDescription(TimelineItem item) => NormalizeOptionalText(item.Description);

    private static object GetItemKey(TimelineItem item, int index) =>
        $"{index}:{NormalizeOptionalText(item.Id) ?? "timeline-item"}";

    private static string GetMarkerClass(TimelineItem item) =>
        CombineClasses("timeline-marker", $"marker-{GetStatusClass(item.Status)}");

    private static string GetStatusClass(TimelineStatus status) =>
        Enum.IsDefined(status) ? status.ToString().ToLowerInvariant() : TimelineStatus.Default.ToString().ToLowerInvariant();

    private static string GetPositionClass(TimelinePosition position) =>
        Enum.IsDefined(position) ? position.ToString().ToLowerInvariant() : TimelinePosition.Left.ToString().ToLowerInvariant();

    private static string? NormalizeOptionalText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private bool HasAdditionalAttribute(string attributeName) =>
        AdditionalAttributes?.Keys.Any(key => string.Equals(key, attributeName, StringComparison.OrdinalIgnoreCase)) == true;

    public class TimelineItem
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string? Title { get; set; }
        public string? Description { get; set; }
        public RenderFragment? Content { get; set; }
        public RenderFragment? Icon { get; set; }
        public DateTime? Timestamp { get; set; }
        public TimelineStatus Status { get; set; } = TimelineStatus.Default;
    }

    public enum TimelineStatus
    {
        Default,
        Success,
        Error,
        Warning,
        Info
    }

    public enum TimelinePosition
    {
        Left,
        Right,
        Alternate
    }
}
