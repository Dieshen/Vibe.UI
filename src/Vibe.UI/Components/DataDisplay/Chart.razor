@namespace Vibe.UI.Components
@inherits VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@using System.Globalization

<div @attributes="AdditionalAttributes" class="@CombinedClass">
    @if (NormalizedTitle is not null || NormalizedDescription is not null)
    {
        <div class="vibe-chart-header">
            @if (NormalizedTitle is not null)
            {
                <h3 id="@_titleId" class="vibe-chart-title">@NormalizedTitle</h3>
            }

            @if (NormalizedDescription is not null)
            {
                <p id="@_descriptionId" class="vibe-chart-description">@NormalizedDescription</p>
            }
        </div>
    }

    <div class="vibe-chart-container" style="height: @EffectiveHeightStyle;">
        @if (HasRenderableData)
        {
            <canvas @ref="_canvasRef"
                    id="@_canvasId"
                    class="vibe-chart-canvas"
                    role="img"
                    aria-label="@CanvasAriaLabel"
                    aria-labelledby="@CanvasLabelledBy"
                    aria-describedby="@CanvasDescribedBy"></canvas>
        }
        else
        {
            <div class="vibe-chart-empty" role="status">@EffectiveEmptyMessage</div>
        }
    </div>

    @if (HasRenderableData)
    {
        <div class="vibe-chart-accessible-data">
            <p id="@_dataSummaryId">@DataSummary</p>
            <table>
                <caption>Data table for @AccessibleChartName</caption>
                <thead>
                    <tr>
                        <th scope="col">Category</th>
                        @for (var datasetIndex = 0; datasetIndex < _datasets.Count; datasetIndex++)
                        {
                            <th scope="col">@GetAccessibleDatasetLabel(_datasets[datasetIndex], datasetIndex)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var dataPointIndex = 0; dataPointIndex < DataPointCount; dataPointIndex++)
                    {
                        <tr>
                            <th scope="row">@GetDataPointLabel(dataPointIndex)</th>
                            @foreach (var dataset in _datasets)
                            {
                                <td>@GetFormattedDataPointValue(dataset, dataPointIndex)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (ShowLegend && HasRenderableData)
    {
        <div class="@LegendCssClass" role="list" aria-label="@LegendAriaLabel">
            @foreach (var entry in GetLegendEntries())
            {
                <div class="vibe-chart-legend-item" role="listitem" @key="entry">
                    <span class="vibe-chart-legend-color" style="background-color: @entry.Color;" aria-hidden="true"></span>
                    <span class="vibe-chart-legend-label">@entry.Label</span>
                    @if (entry.Value is not null)
                    {
                        <span class="vibe-chart-legend-value">@entry.Value</span>
                    }
                </div>
            }
        </div>
    }

    @if (FooterContent != null)
    {
        <div class="vibe-chart-footer">
            @FooterContent
        </div>
    }
</div>

@code {
    private const string CreateChartMethod = "vibeChart.createChart";
    private const string UpdateChartMethod = "vibeChart.updateChart";
    private const string DestroyChartMethod = "vibeChart.destroyChart";
    private const string ExportChartMethod = "vibeChart.toBase64Image";
    private const int DefaultHeight = 300;
    private const int MaxHeight = 4000;
    private const int MaxBorderWidth = 100;
    private const int MaxAnimationDuration = 60000;
    private const string DefaultDatasetColor = "#3b82f6";
    private const string DefaultEmptyMessage = "No chart data available";

    private ElementReference _canvasRef;
    private readonly string _canvasId = $"chart-{Guid.NewGuid():N}";
    private readonly string _titleId = $"chart-title-{Guid.NewGuid():N}";
    private readonly string _descriptionId = $"chart-description-{Guid.NewGuid():N}";
    private readonly string _dataSummaryId = $"chart-summary-{Guid.NewGuid():N}";
    private IReadOnlyList<string> _labels = Array.Empty<string>();
    private IReadOnlyList<ChartDataset> _datasets = Array.Empty<ChartDataset>();
    private ChartType _effectiveType = ChartType.Line;
    private bool _chartCreated;
    private bool _chartUpdatePending;

    /// <summary>
    /// The chart data to display.
    /// </summary>
    [Parameter, EditorRequired]
    public ChartData? Data { get; set; }

    /// <summary>
    /// The type of chart to render.
    /// </summary>
    [Parameter]
    public ChartType Type { get; set; } = ChartType.Line;

    /// <summary>
    /// The title of the chart.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// The description of the chart.
    /// </summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>
    /// Whether to show the legend.
    /// </summary>
    [Parameter]
    public bool ShowLegend { get; set; } = true;

    /// <summary>
    /// Use Chart.js built-in legend instead of custom HTML legend.
    /// </summary>
    [Parameter]
    public bool UseBuiltInLegend { get; set; } = false;

    /// <summary>
    /// Whether to show grid lines.
    /// </summary>
    [Parameter]
    public bool ShowGrid { get; set; } = true;

    /// <summary>
    /// The height of the chart in pixels.
    /// </summary>
    [Parameter]
    public int Height { get; set; } = DefaultHeight;

    /// <summary>
    /// Accessible label used when the chart has no visible title.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>
    /// Message displayed when no chart data is available.
    /// </summary>
    [Parameter]
    public string? EmptyMessage { get; set; } = DefaultEmptyMessage;

    /// <summary>
    /// Chart configuration options.
    /// </summary>
    [Parameter]
    public ChartOptions? Options { get; set; }

    /// <summary>
    /// Footer content for the chart.
    /// </summary>
    [Parameter]
    public RenderFragment? FooterContent { get; set; }

    /// <summary>
    /// Additional CSS classes to apply.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    private string CombinedCssClass => CombineClasses(
        "vibe-chart",
        $"vibe-chart-{GetChartClassType(_effectiveType)}",
        CssClass
    );

    protected override string ComponentClass => CombinedCssClass;

    private bool HasRenderableData => _datasets.Count > 0;

    private string EffectiveHeightStyle => $"{Math.Clamp(Height, 0, MaxHeight)}px";

    private string? NormalizedTitle => NormalizeOptionalText(Title);

    private string? NormalizedDescription => NormalizeOptionalText(Description);

    private string EffectiveEmptyMessage => NormalizeOptionalText(EmptyMessage) ?? DefaultEmptyMessage;

    private string LegendAriaLabel => NormalizedTitle is null ? "Chart legend" : $"{NormalizedTitle} legend";

    private string LegendCssClass => UseBuiltInLegend
        ? "vibe-chart-legend vibe-chart-legend--screen-reader-only"
        : "vibe-chart-legend";

    private string? CanvasLabelledBy => NormalizedTitle is null ? null : _titleId;

    private string CanvasDescribedBy => NormalizedDescription is null
        ? _dataSummaryId
        : $"{_descriptionId} {_dataSummaryId}";

    private string? CanvasAriaLabel => CanvasLabelledBy is null
        ? NormalizeOptionalText(AriaLabel) ?? AccessibleChartName
        : null;

    private bool IsCircularChart => _effectiveType is ChartType.Pie or ChartType.Doughnut or ChartType.PolarArea;

    private int DataPointCount => Math.Max(
        _labels.Count,
        _datasets.Select(dataset => dataset.Data?.Count ?? 0).DefaultIfEmpty(0).Max());

    private string AccessibleChartName => NormalizedTitle
        ?? NormalizeOptionalText(AriaLabel)
        ?? $"{GetChartDisplayName(_effectiveType)} chart";

    private string DataSummary
    {
        get
        {
            var pointNoun = DataPointCount == 1 ? "data point" : "data points";
            var seriesNoun = _datasets.Count == 1 ? "series" : "series";
            return $"{AccessibleChartName} has {DataPointCount} {pointNoun} across {_datasets.Count} {seriesNoun}.";
        }
    }

    protected override void OnParametersSet()
    {
        _effectiveType = Enum.IsDefined(Type) ? Type : ChartType.Line;
        _labels = NormalizeLabels(Data?.Labels);
        _datasets = NormalizeDatasets(Data?.Datasets);
        _chartUpdatePending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_chartUpdatePending && !firstRender)
        {
            return;
        }

        _chartUpdatePending = false;

        if (HasRenderableData)
        {
            if (_chartCreated)
            {
                await UpdateChart();
            }
            else
            {
                await RenderChart();
            }
        }
        else if (_chartCreated)
        {
            await DestroyChart();
        }
    }

    private async Task RenderChart()
    {
        try
        {
            var config = BuildChartConfig();
            _chartCreated = await JSRuntime.InvokeAsync<bool>(CreateChartMethod, _canvasId, config);
        }
        catch (Exception ex) when (IsRecoverableJsInteropException(ex))
        {
            _chartCreated = false;
        }
    }

    private async Task UpdateChart()
    {
        try
        {
            var config = BuildChartConfig();
            _chartCreated = await JSRuntime.InvokeAsync<bool>(UpdateChartMethod, _canvasId, config);
        }
        catch (Exception ex) when (IsRecoverableJsInteropException(ex))
        {
            _chartCreated = false;
        }
    }

    private object BuildChartConfig()
    {
        var options = Options ?? new ChartOptions();

        var chartOptions = new
        {
            responsive = options.Responsive,
            maintainAspectRatio = options.MaintainAspectRatio,
            plugins = new
            {
                legend = new
                {
                    display = ShowLegend && UseBuiltInLegend,
                    position = "top"
                },
                tooltip = new
                {
                    enabled = options.Tooltip?.Enabled ?? true,
                    mode = NormalizeOptionalText(options.Tooltip?.Mode) ?? "index",
                    intersect = options.Tooltip?.Intersect ?? false
                }
            },
            scales = BuildScales(),
            animation = new
            {
                duration = Math.Clamp(options.Animation?.Duration ?? 400, 0, MaxAnimationDuration),
                easing = NormalizeOptionalText(options.Animation?.Easing) ?? "easeInOutQuart"
            }
        };

        return new
        {
            type = GetChartJsType(_effectiveType),
            data = new
            {
                labels = _labels,
                datasets = _datasets.Select(ds => new
                {
                    label = GetDatasetLabel(ds),
                    data = ds.Data ?? new List<double>(),
                    backgroundColor = GetDatasetBackgroundColors(ds),
                    borderColor = GetDatasetBorderColors(ds),
                    borderWidth = Math.Clamp(ds.BorderWidth, 0, MaxBorderWidth),
                    fill = ds.Fill || _effectiveType == ChartType.Area,
                    tension = _effectiveType == ChartType.Line || _effectiveType == ChartType.Area ? 0.4 : 0,
                    pointRadius = _effectiveType == ChartType.Line || _effectiveType == ChartType.Area ? 3 : 0,
                    pointHoverRadius = _effectiveType == ChartType.Line || _effectiveType == ChartType.Area ? 5 : 0
                }).ToArray()
            },
            options = chartOptions
        };
    }

    private object? BuildScales()
    {
        // Don't show scales for pie, doughnut, radar, or polarArea charts
        if (_effectiveType == ChartType.Pie || _effectiveType == ChartType.Doughnut ||
            _effectiveType == ChartType.Radar || _effectiveType == ChartType.PolarArea)
        {
            return null;
        }

        return new
        {
            y = new
            {
                beginAtZero = true,
                grid = new
                {
                    display = ShowGrid
                }
            },
            x = new
            {
                grid = new
                {
                    display = ShowGrid
                }
            }
        };
    }

    /// <summary>
    /// Manually refresh the chart.
    /// </summary>
    public async Task RefreshAsync()
    {
        if (!HasRenderableData)
        {
            if (_chartCreated)
            {
                await DestroyChart();
            }

            return;
        }

        if (_chartCreated)
        {
            await UpdateChart();
        }
        else
        {
            await RenderChart();
        }
    }

    /// <summary>
    /// Export chart as base64 image.
    /// </summary>
    public async Task<string?> ExportAsImageAsync()
    {
        if (!_chartCreated)
        {
            return null;
        }

        try
        {
            return await JSRuntime.InvokeAsync<string>(ExportChartMethod, _canvasId);
        }
        catch (Exception ex) when (IsRecoverableJsInteropException(ex))
        {
            return null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_chartCreated)
        {
            try
            {
                await DestroyChart();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task DestroyChart()
    {
        try
        {
            await JSRuntime.InvokeAsync<bool>(DestroyChartMethod, _canvasId);
        }
        catch (Exception ex) when (IsRecoverableJsInteropException(ex))
        {
        }
        finally
        {
            _chartCreated = false;
        }
    }

    private static IReadOnlyList<string> NormalizeLabels(List<string>? labels)
    {
        if (labels is null)
        {
            return Array.Empty<string>();
        }

        return labels.Select(label => label ?? string.Empty).ToArray();
    }

    private static IReadOnlyList<ChartDataset> NormalizeDatasets(List<ChartDataset>? datasets)
    {
        if (datasets is null)
        {
            return Array.Empty<ChartDataset>();
        }

        return datasets
            .Where(dataset => dataset is not null && dataset.Data?.Count > 0)
            .ToArray()!;
    }

    private static string GetDatasetLabel(ChartDataset dataset) =>
        NormalizeOptionalText(dataset.Label) ?? string.Empty;

    private static string GetDatasetColor(ChartDataset dataset) =>
        NormalizeOptionalText(dataset.Color) ?? DefaultDatasetColor;

    private string GetDatasetBackgroundColor(ChartDataset dataset) =>
        NormalizeOptionalText(dataset.BackgroundColor)
        ?? (_effectiveType == ChartType.Line ? "transparent" : GetDatasetColor(dataset));

    private object GetDatasetBackgroundColors(ChartDataset dataset) =>
        NormalizeColorValues(dataset.BackgroundColors) is { Count: > 0 } colors
            ? colors.ToArray()
            : GetDatasetBackgroundColor(dataset);

    private static string GetDatasetBorderColor(ChartDataset dataset) =>
        NormalizeOptionalText(dataset.BorderColor) ?? GetDatasetColor(dataset);

    private object GetDatasetBorderColors(ChartDataset dataset) =>
        NormalizeColorValues(dataset.BorderColors) is { Count: > 0 } colors
            ? colors.ToArray()
            : GetDatasetBorderColor(dataset);

    private IEnumerable<ChartLegendEntry> GetLegendEntries()
    {
        if (IsCircularChart)
        {
            for (var datasetIndex = 0; datasetIndex < _datasets.Count; datasetIndex++)
            {
                var dataset = _datasets[datasetIndex];
                var values = dataset.Data;
                if (values is null)
                {
                    continue;
                }

                for (var dataPointIndex = 0; dataPointIndex < values.Count; dataPointIndex++)
                {
                    var category = GetDataPointLabel(dataPointIndex);
                    var label = _datasets.Count > 1
                        ? $"{GetAccessibleDatasetLabel(dataset, datasetIndex)}: {category}"
                        : category;

                    yield return new ChartLegendEntry(
                        label,
                        GetLegendColor(dataset, dataPointIndex),
                        FormatDataValue(values[dataPointIndex]));
                }
            }

            yield break;
        }

        for (var datasetIndex = 0; datasetIndex < _datasets.Count; datasetIndex++)
        {
            var dataset = _datasets[datasetIndex];
            yield return new ChartLegendEntry(
                GetAccessibleDatasetLabel(dataset, datasetIndex),
                GetLegendColor(dataset),
                null);
        }
    }

    private static string GetLegendColor(ChartDataset dataset, int? dataPointIndex = null)
    {
        var colors = NormalizeColorValues(dataset.BackgroundColors);
        if (dataPointIndex is { } index && colors is { Count: > 0 } && index < colors.Count)
        {
            return colors[index];
        }

        return colors?.FirstOrDefault()
            ?? NormalizeOptionalText(dataset.BackgroundColor)
            ?? GetDatasetColor(dataset);
    }

    private string GetDataPointLabel(int index) => index < _labels.Count && !string.IsNullOrWhiteSpace(_labels[index])
        ? _labels[index]
        : $"Data point {index + 1}";

    private static string GetAccessibleDatasetLabel(ChartDataset dataset, int datasetIndex) =>
        NormalizeOptionalText(dataset.Label) ?? $"Series {datasetIndex + 1}";

    private static string GetFormattedDataPointValue(ChartDataset dataset, int index) =>
        dataset.Data is { } data && index < data.Count
            ? FormatDataValue(data[index])
            : "No value";

    private static string FormatDataValue(double value) => value.ToString("G", CultureInfo.CurrentCulture);

    private static string GetChartClassType(ChartType type) =>
        Enum.IsDefined(type) ? type.ToString().ToLowerInvariant() : ChartType.Line.ToString().ToLowerInvariant();

    private static string GetChartJsType(ChartType type) => type switch
    {
        ChartType.Bar => "bar",
        ChartType.Pie => "pie",
        ChartType.Doughnut => "doughnut",
        ChartType.Radar => "radar",
        ChartType.PolarArea => "polarArea",
        ChartType.Area => "line",
        _ => "line"
    };

    private static string GetChartDisplayName(ChartType type) => type switch
    {
        ChartType.PolarArea => "Polar area",
        _ => type.ToString()
    };

    private static string? NormalizeOptionalText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static List<string>? NormalizeColorValues(List<string>? values)
    {
        if (values is null)
        {
            return null;
        }

        return values
            .Select(NormalizeOptionalText)
            .Where(value => value is not null)
            .Cast<string>()
            .ToList();
    }

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;

    public class ChartData
    {
        public List<string> Labels { get; set; } = new();
        public List<ChartDataset> Datasets { get; set; } = new();
    }

    public class ChartDataset
    {
        public string Label { get; set; } = string.Empty;
        public List<double> Data { get; set; } = new();
        public string Color { get; set; } = "#3b82f6";
        public string? BackgroundColor { get; set; }
        public List<string>? BackgroundColors { get; set; }
        public string? BorderColor { get; set; }
        public List<string>? BorderColors { get; set; }
        public int BorderWidth { get; set; } = 2;
        public bool Fill { get; set; }
    }

    public class ChartOptions
    {
        public bool Responsive { get; set; } = true;
        public bool MaintainAspectRatio { get; set; } = false;
        public ChartAnimation? Animation { get; set; }
        public ChartTooltip? Tooltip { get; set; }
    }

    public class ChartAnimation
    {
        public int Duration { get; set; } = 400;
        public string Easing { get; set; } = "easeInOutQuart";
    }

    public class ChartTooltip
    {
        public bool Enabled { get; set; } = true;
        public string Mode { get; set; } = "index";
        public bool Intersect { get; set; } = false;
    }

    private sealed record ChartLegendEntry(string Label, string Color, string? Value);

    public enum ChartType
    {
        Line,
        Bar,
        Pie,
        Doughnut,
        Radar,
        PolarArea,
        Area
    }
}
