@namespace Vibe.UI.Components
@inherits Base.VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="@CombinedClass" data-state="@CurrentState" @attributes="AdditionalAttributes">
    <div id="@_triggerId"
         class="context-trigger"
         role="button"
         tabindex="@TriggerTabIndex"
         aria-haspopup="menu"
         aria-expanded="@AriaExpanded"
         aria-controls="@_contentId"
         aria-disabled="@AriaDisabled"
         data-state="@CurrentState"
         @ref="_triggerReference"
         @oncontextmenu="HandleContextMenu"
         @oncontextmenu:preventDefault="@(!Disabled)"
         @onmousedown="HandleTriggerMouseDown"
         @onkeydown="HandleTriggerKeyDown">
        @TriggerContent
    </div>

    @if (_isOpen)
    {
        <div id="@_contentId"
             class="context-content"
             style="@ContentStyle"
             role="menu"
             tabindex="-1"
             aria-label="@MenuAriaLabel"
             data-state="open"
             @ref="_contentReference"
             @onclick="HandleContentClick"
             @onclick:stopPropagation="true"
             @onkeydown="HandleMenuKeyDown">
            <CascadingValue Name="VibeContextMenuSelection" Value="ItemSelectedCallback">
                @Content
            </CascadingValue>
        </div>

        @if (CloseOnClickOutside)
        {
            <div class="context-backdrop" aria-hidden="true" @onclick="HandleBackdropClick"></div>
        }
    }
</div>

@code {
    private const string KeyboardModulePath = "./_content/Vibe.UI/js/vibe-menu-keyboard.js";
    private const string DomModulePath = "./_content/Vibe.UI/js/vibe-dom.js";

    private readonly string _triggerId = $"vibe-context-menu-trigger-{Guid.NewGuid():N}";
    private readonly string _contentId = $"vibe-context-menu-content-{Guid.NewGuid():N}";
    private bool _isOpen;
    private string _positionX = "0px";
    private string _positionY = "0px";
    private ElementReference _triggerReference;
    private ElementReference _contentReference;
    private PendingFocus _pendingFocus;
    private bool _restoreTriggerFocus;
    private IJSObjectReference? _keyboardModule;
    private IJSObjectReference? _domModule;

    /// <summary>
    /// Gets or sets the trigger content.
    /// </summary>
    [Parameter]
    public RenderFragment? TriggerContent { get; set; }

    /// <summary>
    /// Gets or sets the context menu content.
    /// </summary>
    [Parameter]
    public RenderFragment? Content { get; set; }

    /// <summary>
    /// Gets or sets whether the context menu is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether the context menu closes when the backdrop is clicked.
    /// </summary>
    [Parameter]
    public bool CloseOnClickOutside { get; set; } = true;

    /// <summary>
    /// Gets or sets whether selecting menu content closes the context menu.
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = true;

    /// <summary>
    /// Gets or sets the accessible label for the menu content.
    /// </summary>
    [Parameter]
    public string MenuAriaLabel { get; set; } = "Context menu";

    /// <summary>
    /// Gets or sets the callback when the context menu opens.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnOpen { get; set; }

    /// <summary>
    /// Gets or sets the callback when the context menu closes.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-context-menu";

    protected override string GetCombinedClass()
    {
        return CombineClasses(
            ComponentClass,
            _isOpen ? "context-open" : null,
            Disabled ? "context-disabled" : null,
            Class);
    }

    private string AriaExpanded => _isOpen ? "true" : "false";

    private string AriaDisabled => Disabled ? "true" : "false";

    private string CurrentState => _isOpen ? "open" : "closed";

    private string TriggerTabIndex => Disabled ? "-1" : "0";

    private string ContentStyle => $"left: {_positionX}; top: {_positionY};";

    private Func<Task> ItemSelectedCallback => HandleContentClick;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        try
        {
            var module = await GetKeyboardModuleAsync();
            await module.InvokeVoidAsync("initializeTrigger", _triggerReference, true, false);

            if (_isOpen)
            {
                await module.InvokeVoidAsync("initializeContainer", _contentReference, "menu");

                if (_pendingFocus == PendingFocus.First)
                {
                    await module.InvokeVoidAsync("focusFirstItem", _contentReference, "menu");
                    _pendingFocus = PendingFocus.None;
                }
                else if (_pendingFocus == PendingFocus.Last)
                {
                    await module.InvokeVoidAsync("focusLastItem", _contentReference, "menu");
                    _pendingFocus = PendingFocus.None;
                }
            }
            else if (_restoreTriggerFocus)
            {
                await _triggerReference.FocusAsync();
                _restoreTriggerFocus = false;
            }
        }
        catch (InvalidOperationException)
        {
            // JS interop is unavailable during static prerendering.
        }
        catch (JSDisconnectedException)
        {
            // The server-side circuit disconnected before focus could be updated.
        }
        catch (TaskCanceledException)
        {
            // The browser disconnected while focus work was pending.
        }
    }

    private async Task HandleContextMenu(MouseEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        _positionX = FormatPixelValue(e.ClientX);
        _positionY = FormatPixelValue(e.ClientY);
        await OpenMenu(e, PendingFocus.First);
    }

    private async Task HandleTriggerMouseDown(MouseEventArgs e)
    {
        if (e.Button != 2)
        {
            await CloseMenu();
        }
    }

    private async Task HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        if (e.Key is "Enter" or " " or "Spacebar" or "ContextMenu" or "ArrowDown" or "ArrowUp" ||
            e.Key == "F10" && e.ShiftKey)
        {
            await PositionAtTriggerAsync();
            await OpenMenu(new MouseEventArgs(), e.Key == "ArrowUp" ? PendingFocus.Last : PendingFocus.First);
        }
        else if (e.Key == "Escape")
        {
            await CloseMenu(restoreTriggerFocus: true);
        }
    }

    private async Task HandleMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Tab")
        {
            await CloseMenu();
            return;
        }

        if (e.Key == "Escape")
        {
            await CloseMenu(restoreTriggerFocus: true);
            return;
        }

        var module = await GetKeyboardModuleAsync();
        switch (e.Key)
        {
            case "ArrowDown":
                await module.InvokeVoidAsync("moveFocus", _contentReference, "menu", 1);
                break;
            case "ArrowUp":
                await module.InvokeVoidAsync("moveFocus", _contentReference, "menu", -1);
                break;
            case "Home":
                await module.InvokeVoidAsync("focusFirstItem", _contentReference, "menu");
                break;
            case "End":
                await module.InvokeVoidAsync("focusLastItem", _contentReference, "menu");
                break;
            default:
                if (IsTypeaheadKey(e))
                {
                    await module.InvokeVoidAsync("focusByTypeahead", _contentReference, "menu", e.Key);
                }
                break;
        }
    }

    private Task HandleContentClick()
    {
        return CloseOnSelect ? CloseMenu(restoreTriggerFocus: true) : Task.CompletedTask;
    }

    private Task HandleBackdropClick()
    {
        return CloseMenu();
    }

    private async Task OpenMenu(MouseEventArgs e, PendingFocus pendingFocus)
    {
        var wasOpen = _isOpen;
        _isOpen = true;
        _pendingFocus = pendingFocus;
        _restoreTriggerFocus = false;

        if (!wasOpen)
        {
            await OnOpen.InvokeAsync(e);
        }
    }

    private async Task CloseMenu(bool restoreTriggerFocus = false)
    {
        if (!_isOpen)
        {
            return;
        }

        _isOpen = false;
        _pendingFocus = PendingFocus.None;
        _restoreTriggerFocus = restoreTriggerFocus;
        await OnClose.InvokeAsync();
    }

    private async ValueTask<IJSObjectReference> GetKeyboardModuleAsync()
    {
        _keyboardModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", KeyboardModulePath);
        return _keyboardModule;
    }

    private async Task PositionAtTriggerAsync()
    {
        try
        {
            _domModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", DomModulePath);
            var bounds = await _domModule.InvokeAsync<DOMRect?>("getBoundingRect", _triggerId);
            if (bounds is not null)
            {
                _positionX = FormatPixelValue(bounds.X);
                _positionY = FormatPixelValue(bounds.Y + bounds.Height);
            }
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
            _positionX = "0px";
            _positionY = "0px";
        }
    }

    private static bool IsTypeaheadKey(KeyboardEventArgs e)
    {
        return e.Key.Length == 1 &&
               !char.IsWhiteSpace(e.Key[0]) &&
               !e.AltKey &&
               !e.CtrlKey &&
               !e.MetaKey;
    }

    private static string FormatPixelValue(double value)
    {
        if (double.IsNaN(value) || double.IsInfinity(value) || value < 0)
        {
            return "0px";
        }

        return string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{value:0.##}px");
    }

    public async ValueTask DisposeAsync()
    {
        if (_keyboardModule != null)
        {
            try
            {
                await _keyboardModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (TaskCanceledException)
            {
            }
        }

        if (_domModule != null)
        {
            try
            {
                await _domModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (TaskCanceledException)
            {
            }
        }

        GC.SuppressFinalize(this);
    }

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;

    private sealed class DOMRect
    {
        public double X { get; init; }
        public double Y { get; init; }
        public double Height { get; init; }
    }

    private enum PendingFocus
    {
        None,
        First,
        Last
    }
}
