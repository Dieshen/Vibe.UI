@namespace Vibe.UI.Components
@inherits Base.VibeComponent
@implements IAsyncDisposable

<div @attributes="RootAttributes"
    @onmouseenter="OnMouseEnterAsync" @onmouseleave="OnMouseLeave"
    @onfocusin="OnFocusInAsync" @onfocusout="OnFocusOut">
    <div class="trigger"
         tabindex="@TriggerTabIndex"
         aria-describedby="@TooltipId"
         aria-disabled="@AriaDisabled"
         data-state="@CurrentState"
         @onkeydown="OnKeyDown">
        @TriggerContent
    </div>
    <div class="tooltip-content @(_isVisible ? "visible" : "")"
         id="@TooltipId"
         role="tooltip"
         aria-hidden="@AriaHidden"
         data-state="@CurrentState">
        @Content
    </div>
</div>

@code {
    private readonly string TooltipId = $"vibe-tooltip-{Guid.NewGuid():N}";
    private bool _isDisposed;
    private bool _isVisible;
    private CancellationTokenSource? _showDelayCts;

    /// <summary>
    /// Gets or sets the trigger content.
    /// </summary>
    [Parameter]
    public RenderFragment? TriggerContent { get; set; }

    /// <summary>
    /// Gets or sets the tooltip content.
    /// </summary>
    [Parameter]
    public RenderFragment? Content { get; set; }

    /// <summary>
    /// Gets or sets the placement of the tooltip.
    /// </summary>
    [Parameter]
    public string Placement { get; set; } = "top";

    /// <summary>
    /// Gets or sets the delay before showing the tooltip (in milliseconds).
    /// </summary>
    [Parameter]
    public int DelayMS { get; set; } = 200;

    /// <summary>
    /// Gets or sets whether the tooltip is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => $"vibe-tooltip vibe-tooltip-{NormalizedPlacement}";

    /// <summary>
    /// Gets attributes for the root element while preserving required class/state values.
    /// </summary>
    private Dictionary<string, object?> RootAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);

            if (AdditionalAttributes is not null)
            {
                foreach (var attribute in AdditionalAttributes)
                {
                    attributes[attribute.Key] = attribute.Value;
                }
            }

            attributes["class"] = RootClass;
            attributes["data-state"] = CurrentState;

            if (Disabled)
            {
                attributes["data-disabled"] = string.Empty;
            }

            return attributes;
        }
    }

    private string RootClass => CombineClasses(
        ComponentClass,
        _isVisible ? "tooltip-open" : null,
        Disabled ? "tooltip-disabled" : null,
        Class);

    private string CurrentState => _isVisible ? "open" : "closed";

    private string AriaHidden => _isVisible ? "false" : "true";

    private string AriaDisabled => Disabled ? "true" : "false";

    private string TriggerTabIndex => Disabled ? "-1" : "0";

    private string NormalizedPlacement => Placement?.Trim().ToLowerInvariant() switch
    {
        "bottom" => "bottom",
        "left" => "left",
        "right" => "right",
        _ => "top"
    };

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        if (Disabled && _isVisible)
        {
            HideTooltip();
        }
    }

    /// <summary>
    /// Handles when the mouse enters the tooltip trigger.
    /// </summary>
    private async Task OnMouseEnterAsync()
    {
        await ShowTooltipAfterDelayAsync();
    }

    private async Task OnFocusInAsync(FocusEventArgs e)
    {
        await ShowTooltipAfterDelayAsync();
    }

    /// <summary>
    /// Handles when the mouse leaves the tooltip trigger.
    /// </summary>
    private void OnMouseLeave()
    {
        HideTooltip();
    }

    private void OnFocusOut(FocusEventArgs e)
    {
        HideTooltip();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            HideTooltip();
        }
    }

    private async Task ShowTooltipAfterDelayAsync()
    {
        if (Disabled || _isDisposed)
        {
            return;
        }

        var showDelayCts = ResetShowDelay();

        try
        {
            await Task.Delay(NormalizeDelay(DelayMS), showDelayCts.Token);
        }
        catch (OperationCanceledException) when (showDelayCts.IsCancellationRequested)
        {
            return;
        }

        if (Disabled || _isDisposed)
        {
            return;
        }

        _isVisible = true;
        StateHasChanged();
    }

    private void HideTooltip()
    {
        CancelShowDelay();

        if (!_isVisible)
        {
            return;
        }

        _isVisible = false;

        if (!_isDisposed)
        {
            StateHasChanged();
        }
    }

    public ValueTask DisposeAsync()
    {
        _isDisposed = true;
        CancelShowDelay();
        return ValueTask.CompletedTask;
    }

    private CancellationTokenSource ResetShowDelay()
    {
        CancelShowDelay();
        _showDelayCts = new CancellationTokenSource();
        return _showDelayCts;
    }

    private void CancelShowDelay()
    {
        if (_showDelayCts is null)
        {
            return;
        }

        _showDelayCts.Cancel();
        _showDelayCts.Dispose();
        _showDelayCts = null;
    }

    private static int NormalizeDelay(int delay) => Math.Max(0, delay);
}
