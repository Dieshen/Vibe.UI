@namespace Vibe.UI.Components
@inherits Base.VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (_isOpen || _isClosing)
{
    <div @attributes="RootAttributes" @onkeydown="HandleKeyDown">
        <div class="drawer-overlay" aria-hidden="true" @onclick="OnOverlayClick"></div>
        <div class="drawer-content"
             @ref="_drawerRef"
             role="dialog"
             aria-modal="true"
             aria-label="@EffectiveAriaLabel"
             aria-labelledby="@NormalizedAriaLabelledBy"
             aria-describedby="@NormalizedAriaDescribedBy"
             tabindex="-1">
            @if (ShowCloseButton)
            {
                <button type="button" class="drawer-close" @onclick="CloseAsync" aria-label="Close" disabled="@_isClosing">
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                        <path
                            d="M11.7816 4.03157C12.0062 3.80702 12.0062 3.44295 11.7816 3.2184C11.5571 2.99385 11.193 2.99385 10.9685 3.2184L7.50005 6.68682L4.03164 3.2184C3.80708 2.99385 3.44301 2.99385 3.21846 3.2184C2.99391 3.44295 2.99391 3.80702 3.21846 4.03157L6.68688 7.49999L3.21846 10.9684C2.99391 11.193 2.99391 11.557 3.21846 11.7816C3.44301 12.0061 3.80708 12.0061 4.03164 11.7816L7.50005 8.31316L10.9685 11.7816C11.193 12.0061 11.5571 12.0061 11.7816 11.7816C12.0062 11.557 12.0062 11.193 11.7816 10.9684L8.31322 7.49999L11.7816 4.03157Z"
                            fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path>
                    </svg>
                </button>
            }
            <div class="drawer-body">
                @ChildContent
            </div>
        </div>
    </div>
}

@code {
    private IJSObjectReference? _dialogModule;
    private bool _focusTrapActive;
    private ElementReference _drawerRef;
    private readonly string _drawerKey = $"vibe-drawer-{Guid.NewGuid():N}";
    private bool _hasSeenIsOpenParameter;
    private bool _isClosing;
    private bool _isDisposed;
    private bool _isOpen;
    private bool _lastIsOpenParameter;
    private CancellationTokenSource? _closeDelayCts;

    /// <summary>
    /// Gets or sets the content of the drawer.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets whether the drawer is open.
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Gets or sets the callback when the drawer is opened.
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>
    /// Gets or sets the side from which the drawer appears.
    /// </summary>
    [Parameter]
    public string Side { get; set; } = "right";

    /// <summary>
    /// Gets or sets whether to show the close button.
    /// </summary>
    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    /// <summary>
    /// Gets or sets whether to close the drawer when clicking the overlay.
    /// </summary>
    [Parameter]
    public bool CloseOnOverlayClick { get; set; } = true;

    /// <summary>
    /// Gets or sets whether pressing Escape should close the drawer.
    /// </summary>
    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// Gets or sets the accessible label used when no labelled-by element is provided.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>
    /// Gets or sets the id of the element that labels the drawer dialog.
    /// </summary>
    [Parameter]
    public string? AriaLabelledBy { get; set; }

    /// <summary>
    /// Gets or sets the id of the element that describes the drawer dialog.
    /// </summary>
    [Parameter]
    public string? AriaDescribedBy { get; set; }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-drawer";

    /// <summary>
    /// Gets the CSS class for the drawer side.
    /// </summary>
    private string SideClass => $"drawer-{NormalizedSide}";

    /// <summary>
    /// Gets the combined root class including state and side classes.
    /// </summary>
    private string RootClass => CombineClasses(
        CombinedClass,
        _isClosing ? "closing" : null,
        SideClass);

    /// <summary>
    /// Gets the current drawer state for data attributes.
    /// </summary>
    private string CurrentState => _isClosing ? "closing" : _isOpen ? "open" : "closed";

    /// <summary>
    /// Gets attributes for the root element while preserving required class/state values.
    /// </summary>
    private Dictionary<string, object?> RootAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);

            if (AdditionalAttributes is not null)
            {
                foreach (var attribute in AdditionalAttributes)
                {
                    attributes[attribute.Key] = attribute.Value;
                }
            }

            attributes["class"] = RootClass;
            attributes["data-state"] = CurrentState;
            attributes["tabindex"] = "-1";

            return attributes;
        }
    }

    private string NormalizedSide => Side?.Trim().ToLowerInvariant() switch
    {
        "left" => "left",
        "top" => "top",
        "bottom" => "bottom",
        _ => "right"
    };

    private string? NormalizedAriaLabelledBy => NormalizeOptionalText(AriaLabelledBy);

    private string? NormalizedAriaDescribedBy => NormalizeOptionalText(AriaDescribedBy);

    private string? EffectiveAriaLabel => NormalizedAriaLabelledBy is null
        ? NormalizeOptionalText(AriaLabel) ?? "Drawer"
        : null;

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        if (!_hasSeenIsOpenParameter || IsOpen != _lastIsOpenParameter)
        {
            CancelCloseDelay();
            _isOpen = IsOpen;
            _isClosing = false;
            _lastIsOpenParameter = IsOpen;
            _hasSeenIsOpenParameter = true;
        }
    }

    /// <summary>
    /// Handles the click on the overlay.
    /// </summary>
    private async Task OnOverlayClick()
    {
        if (CloseOnOverlayClick)
        {
            await CloseAsync();
        }
    }

    /// <summary>
    /// Closes the drawer.
    /// </summary>
    private async Task CloseAsync()
    {
        if (!_isOpen || _isClosing || _isDisposed)
        {
            return;
        }

        _isClosing = true;
        StateHasChanged();

        var closeDelayCts = ResetCloseDelay();

        try
        {
            await Task.Delay(300, closeDelayCts.Token);
        }
        catch (OperationCanceledException) when (closeDelayCts.IsCancellationRequested)
        {
            return;
        }

        if (_isDisposed)
        {
            return;
        }

        _isClosing = false;
        _isOpen = false;
        await IsOpenChanged.InvokeAsync(false);
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if ((_isOpen || _isClosing) && !_focusTrapActive)
        {
            try
            {
                _dialogModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Vibe.UI/js/vibe-dialog.js");

                await _dialogModule.InvokeVoidAsync("activate", _drawerKey, _drawerRef);
            }
            catch (Exception ex) when (IsRecoverableJsInteropException(ex))
            {
                return;
            }

            _focusTrapActive = true;
        }
        else if (!_isOpen && !_isClosing && _focusTrapActive)
        {
            await DeactivateFocusTrapAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && CloseOnEscape)
        {
            await CloseAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        CancelCloseDelay();

        await DeactivateFocusTrapAsync();

        if (_dialogModule != null)
        {
            try
            {
                await _dialogModule.DisposeAsync();
            }
            catch (Exception ex) when (IsRecoverableJsInteropException(ex))
            {
            }
        }

        _closeDelayCts?.Dispose();
    }

    private CancellationTokenSource ResetCloseDelay()
    {
        CancelCloseDelay();
        _closeDelayCts = new CancellationTokenSource();
        return _closeDelayCts;
    }

    private void CancelCloseDelay()
    {
        if (_closeDelayCts is null)
        {
            return;
        }

        _closeDelayCts.Cancel();
        _closeDelayCts.Dispose();
        _closeDelayCts = null;
    }

    private async Task DeactivateFocusTrapAsync()
    {
        if (_dialogModule != null)
        {
            try
            {
                await _dialogModule.InvokeVoidAsync("deactivate", _drawerKey);
            }
            catch (Exception ex) when (IsRecoverableJsInteropException(ex))
            {
            }
        }

        _focusTrapActive = false;
    }

    private static string? NormalizeOptionalText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;
}
