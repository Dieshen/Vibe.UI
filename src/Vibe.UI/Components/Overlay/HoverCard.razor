@namespace Vibe.UI.Components
@inherits Base.VibeComponent
@implements IAsyncDisposable

<div @attributes="RootAttributes"
     @onmouseenter="OnMouseEnterAsync"
     @onmouseleave="OnMouseLeaveAsync"
     @onfocusin="OnFocusInAsync"
     @onfocusout="OnFocusOutAsync">
    <div class="hovercard-trigger"
         role="button"
         tabindex="@TriggerTabIndex"
         aria-expanded="@AriaExpanded"
         aria-haspopup="dialog"
         aria-controls="@_contentId"
         aria-disabled="@AriaDisabled"
         data-state="@CurrentState"
         @onkeydown="OnKeyDownAsync">
        @TriggerContent
    </div>

    @if (_isOpen)
    {
        <div id="@_contentId"
             class="hovercard-content @PositionClass"
             role="dialog"
             aria-label="@EffectiveAriaLabel"
             aria-labelledby="@NormalizedAriaLabelledBy"
             aria-describedby="@NormalizedAriaDescribedBy"
             data-state="open">
            @Content
        </div>
    }
</div>

@code {
    private readonly string _contentId = $"vibe-hovercard-content-{Guid.NewGuid():N}";
    private bool _hasSeenIsOpenParameter;
    private bool _isDisposed;
    private bool _isOpen;
    private bool _lastIsOpenParameter;
    private CancellationTokenSource? _delayCts;

    /// <summary>
    /// Gets or sets the trigger content.
    /// </summary>
    [Parameter]
    public RenderFragment? TriggerContent { get; set; }

    /// <summary>
    /// Gets or sets the content of the hover card.
    /// </summary>
    [Parameter]
    public RenderFragment? Content { get; set; }

    /// <summary>
    /// Gets or sets the position of the hover card.
    /// </summary>
    [Parameter]
    public string Position { get; set; } = "bottom";

    /// <summary>
    /// Gets or sets the delay before showing the hover card (in milliseconds).
    /// </summary>
    [Parameter]
    public int OpenDelay { get; set; } = 300;

    /// <summary>
    /// Gets or sets the delay before hiding the hover card (in milliseconds).
    /// </summary>
    [Parameter]
    public int CloseDelay { get; set; } = 200;

    /// <summary>
    /// Gets or sets whether the hover card is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether the hover card is open.
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Gets or sets the callback for when the hover card open state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>
    /// Gets or sets the accessible label used when no labelled-by element is provided.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>
    /// Gets or sets the id of the element that labels the hover card dialog.
    /// </summary>
    [Parameter]
    public string? AriaLabelledBy { get; set; }

    /// <summary>
    /// Gets or sets the id of the element that describes the hover card dialog.
    /// </summary>
    [Parameter]
    public string? AriaDescribedBy { get; set; }

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-hovercard";

    /// <summary>
    /// Gets the CSS class for positioning the hover card.
    /// </summary>
    private string PositionClass => $"hovercard-{NormalizedPosition}";

    /// <summary>
    /// Gets attributes for the root element while preserving required class/state values.
    /// </summary>
    private Dictionary<string, object?> RootAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);

            if (AdditionalAttributes is not null)
            {
                foreach (var attribute in AdditionalAttributes)
                {
                    attributes[attribute.Key] = attribute.Value;
                }
            }

            attributes["class"] = RootClass;
            attributes["data-state"] = CurrentState;

            if (Disabled)
            {
                attributes["data-disabled"] = string.Empty;
            }

            return attributes;
        }
    }

    private string RootClass => CombineClasses(
        ComponentClass,
        _isOpen ? "hovercard-open" : null,
        Disabled ? "hovercard-disabled" : null,
        Class);

    private string AriaExpanded => _isOpen ? "true" : "false";

    private string AriaDisabled => Disabled ? "true" : "false";

    private string CurrentState => _isOpen ? "open" : "closed";

    private string TriggerTabIndex => Disabled ? "-1" : "0";

    private string NormalizedPosition => Position?.Trim().ToLowerInvariant() switch
    {
        "top" => "top",
        "left" => "left",
        "right" => "right",
        _ => "bottom"
    };

    private string? NormalizedAriaLabelledBy => NormalizeOptionalText(AriaLabelledBy);

    private string? NormalizedAriaDescribedBy => NormalizeOptionalText(AriaDescribedBy);

    private string? EffectiveAriaLabel => NormalizedAriaLabelledBy is null
        ? NormalizeOptionalText(AriaLabel) ?? "Hover card"
        : null;

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        if (!_hasSeenIsOpenParameter || IsOpen != _lastIsOpenParameter)
        {
            _isOpen = IsOpen;
            _lastIsOpenParameter = IsOpen;
            _hasSeenIsOpenParameter = true;
        }
    }

    /// <summary>
    /// Handles when the mouse enters the trigger.
    /// </summary>
    private async Task OnMouseEnterAsync()
    {
        await OpenAfterDelayAsync();
    }

    private async Task OnFocusInAsync(FocusEventArgs e)
    {
        await OpenAfterDelayAsync();
    }

    /// <summary>
    /// Handles when the mouse leaves the hover card.
    /// </summary>
    private async Task OnMouseLeaveAsync()
    {
        await CloseAfterDelayAsync();
    }

    private async Task OnFocusOutAsync(FocusEventArgs e)
    {
        await CloseAfterDelayAsync();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CancelDelay();
            await SetOpenAsync(false);
        }
        else if (!Disabled && e.Key is "Enter" or " " or "Spacebar")
        {
            CancelDelay();
            await SetOpenAsync(true);
        }
    }

    private async Task OpenAfterDelayAsync()
    {
        if (Disabled || _isDisposed)
        {
            return;
        }

        var delayCts = ResetDelay();

        try
        {
            await Task.Delay(NormalizeDelay(OpenDelay), delayCts.Token);
        }
        catch (OperationCanceledException) when (delayCts.IsCancellationRequested)
        {
            return;
        }

        if (!Disabled && !_isDisposed)
        {
            await SetOpenAsync(true);
        }
    }

    private async Task CloseAfterDelayAsync()
    {
        if (_isDisposed)
        {
            return;
        }

        var delayCts = ResetDelay();

        try
        {
            await Task.Delay(NormalizeDelay(CloseDelay), delayCts.Token);
        }
        catch (OperationCanceledException) when (delayCts.IsCancellationRequested)
        {
            return;
        }

        if (!_isDisposed)
        {
            await SetOpenAsync(false);
        }
    }

    private async Task SetOpenAsync(bool open)
    {
        if (_isOpen == open)
        {
            return;
        }

        _isOpen = open;
        await IsOpenChanged.InvokeAsync(open);

        if (!_isDisposed)
        {
            StateHasChanged();
        }
    }

    public ValueTask DisposeAsync()
    {
        _isDisposed = true;
        CancelDelay();
        return ValueTask.CompletedTask;
    }

    private CancellationTokenSource ResetDelay()
    {
        CancelDelay();
        _delayCts = new CancellationTokenSource();
        return _delayCts;
    }

    private void CancelDelay()
    {
        if (_delayCts is null)
        {
            return;
        }

        _delayCts.Cancel();
        _delayCts.Dispose();
        _delayCts = null;
    }

    private static int NormalizeDelay(int delay) => Math.Max(0, delay);

    private static string? NormalizeOptionalText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
