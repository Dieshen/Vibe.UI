@namespace Vibe.UI.Components
@inherits Vibe.UI.Base.VibeComponent

@if (!IsParentDialogOpen)
{
    <span class="@TriggerClass"
          role="button"
          tabindex="@TriggerTabIndex"
          aria-haspopup="dialog"
          aria-expanded="@AriaExpanded"
          aria-disabled="@AriaDisabled"
          aria-label="@EffectiveAriaLabel"
          @onclick="OnTriggerClick"
          @onkeydown="HandleKeyDown"
          @attributes="AdditionalAttributes">
        @ChildContent
    </span>
}

@code {
    /// <summary>
    /// Gets or sets the content that will trigger the dialog when clicked.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets an optional callback that is invoked when the trigger is clicked.
    /// </summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>
    /// Gets or sets whether the trigger is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets an accessible label for icon-only trigger content.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>
    /// Gets the cascading DialogContext from a parent component.
    /// </summary>
    [CascadingParameter]
    private DialogContext? Context { get; set; }

    /// <inheritdoc/>
    protected override string ComponentClass => "vibe-dialog-trigger";

    private bool IsParentDialogOpen => Context?.IsOpen == true;

    private string TriggerClass => CombineClasses(
        CombinedClass,
        Disabled ? "vibe-dialog-trigger-disabled" : null);

    private string TriggerTabIndex => Disabled ? "-1" : "0";

    private string AriaDisabled => Disabled ? "true" : "false";

    private string? AriaExpanded => Context is null ? null : (Context.IsOpen ? "true" : "false");

    private string? EffectiveAriaLabel =>
        !string.IsNullOrWhiteSpace(AriaLabel)
            ? AriaLabel.Trim()
            : ChildContent is null ? "Open dialog" : null;

    /// <summary>
    /// Handles the trigger click event, opening the dialog through the cascading context.
    /// </summary>
    private async Task OnTriggerClick()
    {
        if (Disabled)
        {
            return;
        }

        if (Context != null)
        {
            await Context.Open();
        }

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (!Disabled && (e.Key == "Enter" || e.Key == " "))
        {
            await OnTriggerClick();
        }
    }
}
