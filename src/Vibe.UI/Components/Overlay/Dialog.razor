@namespace Vibe.UI.Components
@inherits Vibe.UI.Base.VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (_isOpen)
{
    <div class="vibe-dialog-overlay" @onclick="OnOutsideClick" @onkeydown="HandleKeyDown" tabindex="-1">
        <div class="@CombinedClass"
            @ref="_dialogRef"
            role="dialog"
            aria-modal="true"
            aria-labelledby="@DialogLabelledBy"
            aria-label="@DialogAriaLabel"
            aria-describedby="@_bodyId"
            @onclick:stopPropagation="true"
            @attributes="AdditionalAttributes">
            @if (Header != null)
            {
                <div class="vibe-dialog-header" id="@_titleId">
                    @Header
                </div>
            }

            <div class="vibe-dialog-body" id="@_bodyId">
                @ChildContent
            </div>

            @if (Footer != null)
            {
                <div class="vibe-dialog-footer">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    private IJSObjectReference? _dialogModule;
    private DotNetObjectReference<Dialog>? _dotNetReference;
    private bool _focusTrapActive;
    private ElementReference _dialogRef;
    private readonly string _dialogKey = $"vibe-dialog-{Guid.NewGuid():N}";
    private readonly string _titleId = $"vibe-dialog-title-{Guid.NewGuid():N}";
    private readonly string _bodyId = $"vibe-dialog-body-{Guid.NewGuid():N}";
    private bool _hasSeenIsOpenParameter;
    private bool _isOpen;
    private bool _lastIsOpenParameter;

    /// <summary>
    /// Gets or sets the dialog content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the dialog header
    /// </summary>
    [Parameter]
    public RenderFragment? Header { get; set; }

    /// <summary>
    /// Gets or sets the dialog footer
    /// </summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>
    /// Gets or sets whether the dialog is open
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Gets or sets the callback for when the dialog state changes
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>
    /// Gets or sets whether clicking outside the dialog should close it
    /// </summary>
    [Parameter]
    public bool CloseOnOutsideClick { get; set; } = true;

    /// <summary>
    /// Gets or sets whether pressing Escape should close the dialog
    /// </summary>
    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// Gets or sets the accessible label used when no header labels the dialog.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <inheritdoc/>
    protected override string ComponentClass => "vibe-dialog";

    private string? DialogLabelledBy => Header is null ? null : _titleId;

    private string? DialogAriaLabel => Header is null ? NormalizeOptionalText(AriaLabel) ?? "Dialog" : null;

    protected override void OnParametersSet()
    {
        if (!_hasSeenIsOpenParameter || IsOpen != _lastIsOpenParameter)
        {
            _isOpen = IsOpen;
            _lastIsOpenParameter = IsOpen;
            _hasSeenIsOpenParameter = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isOpen && !_focusTrapActive)
        {
            try
            {
                _dialogModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Vibe.UI/js/vibe-dialog.js");
                _dotNetReference ??= DotNetObjectReference.Create(this);

                await _dialogModule.InvokeVoidAsync(
                    "activate",
                    _dialogKey,
                    _dialogRef,
                    _dotNetReference,
                    CloseOnEscape);
            }
            catch (Exception ex) when (IsRecoverableJsInteropException(ex))
            {
                return;
            }

            _focusTrapActive = true;
        }
        else if (!_isOpen && _focusTrapActive)
        {
            await DeactivateFocusTrapAsync();
        }
    }

    /// <summary>
    /// Handles key down events to close the dialog when Escape is pressed
    /// </summary>
    /// <param name="e">Keyboard event args</param>
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && CloseOnEscape)
        {
            await CloseDialog();
        }
    }

    [JSInvokable]
    public Task HandleDialogEscape() => CloseOnEscape ? CloseDialog() : Task.CompletedTask;

    /// <summary>
    /// Handles click events outside the dialog to close it when configured
    /// </summary>
    private async Task OnOutsideClick()
    {
        if (CloseOnOutsideClick)
        {
            await CloseDialog();
        }
    }

    /// <summary>
    /// Closes the dialog
    /// </summary>
    private async Task CloseDialog()
    {
        if (_isOpen)
        {
            _isOpen = false;

            if (IsOpenChanged.HasDelegate)
            {
                await IsOpenChanged.InvokeAsync(false);
            }

            StateHasChanged();
        }
    }

    /// <summary>
    /// Opens the dialog
    /// </summary>
    public async Task OpenDialog()
    {
        if (!_isOpen)
        {
            _isOpen = true;

            if (IsOpenChanged.HasDelegate)
            {
                await IsOpenChanged.InvokeAsync(true);
            }

            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DeactivateFocusTrapAsync();

        if (_dialogModule != null)
        {
            try
            {
                await _dialogModule.DisposeAsync();
            }
            catch (Exception ex) when (IsRecoverableJsInteropException(ex))
            {
            }
        }


        _dotNetReference?.Dispose();
        _dotNetReference = null;
    }

    private async Task DeactivateFocusTrapAsync()
    {
        if (_dialogModule != null)
        {
            try
            {
                await _dialogModule.InvokeVoidAsync("deactivate", _dialogKey);
            }
            catch (Exception ex) when (IsRecoverableJsInteropException(ex))
            {
            }
        }

        _focusTrapActive = false;
    }

    private static string? NormalizeOptionalText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;
}
