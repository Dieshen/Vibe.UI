@namespace Vibe.UI.Components
@inherits Vibe.UI.Base.VibeComponent
@implements IDisposable

<h2 class="@CombinedClass" id="@EffectiveId" @attributes="AdditionalAttributes">
    @ChildContent
</h2>

@code {
    private readonly string _generatedId = $"vibe-dialog-title-{Guid.NewGuid():N}";
    private string? _registeredId;

    /// <summary>
    /// Gets or sets the title text or content for the dialog.
    /// Rendered as an h2 element for semantic structure.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [CascadingParameter]
    private DialogContext? Context { get; set; }

    /// <inheritdoc/>
    protected override string ComponentClass => "vibe-dialog-title";

    private string EffectiveId => string.IsNullOrWhiteSpace(Id) ? _generatedId : Id.Trim();

    protected override void OnParametersSet()
    {
        _registeredId = EffectiveId;
        Context?.SetTitleId(_registeredId);
    }

    public void Dispose()
    {
        if (_registeredId is not null)
        {
            Context?.ClearTitleId(_registeredId);
        }
    }
}
