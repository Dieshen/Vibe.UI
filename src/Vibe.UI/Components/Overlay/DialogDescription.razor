@namespace Vibe.UI.Components
@inherits Vibe.UI.Base.VibeComponent
@implements IDisposable

<p class="@CombinedClass" id="@EffectiveId" @attributes="AdditionalAttributes">
    @ChildContent
</p>

@code {
    private readonly string _generatedId = $"vibe-dialog-description-{Guid.NewGuid():N}";
    private string? _registeredId;

    /// <summary>
    /// Gets or sets the description text or content for the dialog.
    /// Provides additional context or instructions to the user.
    /// Rendered as a paragraph element.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [CascadingParameter]
    private DialogContext? Context { get; set; }

    /// <inheritdoc/>
    protected override string ComponentClass => "vibe-dialog-description";

    private string EffectiveId => string.IsNullOrWhiteSpace(Id) ? _generatedId : Id.Trim();

    protected override void OnParametersSet()
    {
        _registeredId = EffectiveId;
        Context?.SetDescriptionId(_registeredId);
    }

    public void Dispose()
    {
        if (_registeredId is not null)
        {
            Context?.ClearDescriptionId(_registeredId);
        }
    }
}
