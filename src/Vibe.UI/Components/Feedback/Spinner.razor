@namespace Vibe.UI.Components
@inherits VibeComponent

<div @attributes="AdditionalAttributes"
     class="@CombinedClass"
     role="@EffectiveRole"
     aria-label="@EffectiveAssistiveTextAttribute"
     aria-live="@EffectiveAriaLive"
     aria-atomic="@AriaAtomicValue"
     aria-busy="@AriaBusyValue"
     aria-disabled="@AriaDisabledValue"
     aria-hidden="@AriaHiddenValue">
    <span class="spinner" aria-hidden="true"></span>
    @if (ShowLabel && HasVisibleLabel)
    {
        <span class="spinner-label">@Label!.Trim()</span>
    }
    @if (!Decorative)
    {
        <span class="sr-only">@EffectiveAssistiveText</span>
    }
</div>

@code {
    [Parameter]
    public SpinnerSize Size { get; set; } = SpinnerSize.Default;

    [Parameter]
    public string Color { get; set; } = "primary";

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? Role { get; set; } = "status";

    [Parameter]
    public string? AriaLive { get; set; } = "polite";

    [Parameter]
    public bool AriaAtomic { get; set; } = true;

    [Parameter]
    public bool ShowLabel { get; set; } = false;

    [Parameter]
    public bool Decorative { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    private string ComponentCssClass => CombineClasses(
        "vibe-spinner",
        $"spinner-{Size.ToString().ToLowerInvariant()}",
        $"spinner-{EffectiveColor}",
        Disabled ? "spinner-disabled" : null,
        CssClass
    );

    protected override string ComponentClass => ComponentCssClass;

    private bool HasVisibleLabel => !string.IsNullOrWhiteSpace(Label);

    private string EffectiveAssistiveText => FirstNonEmpty(AriaLabel, Label, "Loading...");

    private string? EffectiveRole => Decorative ? null : string.IsNullOrWhiteSpace(Role) ? "status" : Role.Trim();

    private string? EffectiveAssistiveTextAttribute => Decorative ? null : EffectiveAssistiveText;

    private string? EffectiveAriaLive => Decorative ? null : string.IsNullOrWhiteSpace(AriaLive) ? "polite" : AriaLive.Trim();

    private string? AriaAtomicValue => Decorative ? null : AriaBool(AriaAtomic);

    private string? AriaBusyValue => Decorative ? null : AriaBool(!Disabled);

    private string? AriaDisabledValue => Decorative ? null : AriaBool(Disabled);

    private string? AriaHiddenValue => Decorative ? "true" : null;

    private string EffectiveColor => NormalizeCssToken(Color, "primary");

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return "Loading...";
    }

    private static string NormalizeCssToken(string? value, string fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        var trimmed = value.Trim();
        if (trimmed.Any(c => !char.IsLetterOrDigit(c) && c != '-' && c != '_'))
        {
            return fallback;
        }

        var normalized = trimmed.ToLowerInvariant();
        return string.IsNullOrWhiteSpace(normalized) ? fallback : normalized;
    }

    private static string AriaBool(bool value) => value ? "true" : "false";

    public enum SpinnerSize
    {
        Small,
        Default,
        Medium,
        Large
    }
}
