@namespace Vibe.UI.Components
@inherits VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div @attributes="AdditionalAttributes"
     @ref="_rootElement"
     class="@CombinedClass"
     aria-hidden="@AriaHiddenValue"
     role="@StatusRole"
     aria-live="@AriaLiveValue"
     aria-label="@EffectiveAriaLabel"
     data-state="@StateName"
     data-particle-count="@ParticleCountText"
     data-origin="@OriginName"
     data-pattern="@PatternName">
</div>

@code {
    private const int MaxParticleCount = 500;
    private const string DefaultAriaLabel = "Celebration";

    private static readonly string[] DefaultColors =
    [
        "#FF6B6B",
        "#4ECDC4",
        "#45B7D1",
        "#FFA07A",
        "#98D8C8",
        "#F7DC6F",
        "#BB8FCE",
        "#85C1E2"
    ];

    private List<string> _effectiveColors = DefaultColors.ToList();
    private ElementReference _rootElement;
    private IJSObjectReference? _module;
    private bool _isActive;
    private bool _hasRendered;
    private bool _pendingTrigger;
    private bool _lastActiveParameter;
    private bool _disposed;
    private long _triggerVersion;
    private Task _activeTriggerTask = Task.CompletedTask;
    private int _effectiveParticleCount = 50;
    private int _effectiveDuration = 3000;
    private ConfettiOrigin _effectiveOrigin = ConfettiOrigin.Center;
    private ConfettiPattern _effectivePattern = ConfettiPattern.Explosion;

    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public int ParticleCount { get; set; } = 50;

    [Parameter]
    public int Duration { get; set; } = 3000;

    [Parameter]
    public List<string> Colors { get; set; } = DefaultColors.ToList();

    [Parameter]
    public ConfettiOrigin Origin { get; set; } = ConfettiOrigin.Center;

    [Parameter]
    public ConfettiPattern Pattern { get; set; } = ConfettiPattern.Explosion;

    [Parameter]
    public EventCallback OnComplete { get; set; }

    [Parameter]
    public bool Announce { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; } = DefaultAriaLabel;

    [Parameter]
    public string? CssClass { get; set; }

    protected override string ComponentClass => CombineClasses(
        "vibe-confetti",
        _isActive ? "active" : null,
        CssClass);

    private string StateName => _isActive ? "active" : "idle";

    private string ParticleCountText => _effectiveParticleCount.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private string OriginName => _effectiveOrigin.ToString().ToLowerInvariant();

    private string PatternName => _effectivePattern.ToString().ToLowerInvariant();

    private string AriaHiddenValue => AriaBool(!Announce);

    private string? StatusRole => Announce ? "status" : null;

    private string? AriaLiveValue => Announce ? "polite" : null;

    private string? EffectiveAriaLabel =>
        Announce
            ? (string.IsNullOrWhiteSpace(AriaLabel) ? DefaultAriaLabel : AriaLabel.Trim())
            : null;

    protected override void OnParametersSet()
    {
        _effectiveParticleCount = Math.Clamp(ParticleCount, 0, MaxParticleCount);
        _effectiveDuration = Math.Max(0, Duration);
        _effectiveColors = NormalizeColors(Colors);
        _effectiveOrigin = NormalizeOrigin(Origin);
        _effectivePattern = NormalizePattern(Pattern);

        if (_disposed)
        {
            return;
        }

        if (Active && !_lastActiveParameter)
        {
            RequestTrigger();
        }
        else if (!Active && _lastActiveParameter)
        {
            CancelTrigger();
        }

        _lastActiveParameter = Active;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        _hasRendered = true;
        if (_pendingTrigger && !_disposed)
        {
            _pendingTrigger = false;
            StartTrigger();
        }

        return Task.CompletedTask;
    }

    public Task Trigger()
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        RequestTrigger();
        return _activeTriggerTask;
    }

    private void RequestTrigger()
    {
        _triggerVersion++;
        _isActive = true;
        if (!_hasRendered)
        {
            _pendingTrigger = true;
            return;
        }

        StartTrigger();
        _ = InvokeAsync(StateHasChanged);
    }

    private void StartTrigger()
    {
        _activeTriggerTask = RunTriggerAsync(_triggerVersion);
        if (!_activeTriggerTask.IsCompletedSuccessfully)
        {
            _ = ObserveTriggerAsync(_activeTriggerTask);
        }
    }

    private async Task RunTriggerAsync(long version)
    {
        if (_module is null)
        {
            var importedModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Vibe.UI/js/vibe-confetti.js");

            if (_disposed || version != _triggerVersion)
            {
                // Disposal (or a newer trigger/cancel) landed while the import was in
                // flight; the component never gets to see this reference, so we own it.
                await DisposeModuleSafelyAsync(importedModule);
                return;
            }

            _module = importedModule;
        }
        else if (_disposed || version != _triggerVersion)
        {
            return;
        }

        var animationTask = _module.InvokeVoidAsync(
            "trigger",
            _rootElement,
            new ConfettiOptions(
                _effectiveParticleCount,
                _effectiveDuration,
                _effectiveColors,
                OriginName,
                PatternName)).AsTask();

        if (_effectiveDuration > 0)
        {
            await Task.WhenAll(animationTask, Task.Delay(_effectiveDuration));
        }
        else
        {
            await animationTask;
        }

        if (_disposed || version != _triggerVersion)
        {
            return;
        }

        _isActive = false;
        await OnComplete.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ObserveTriggerAsync(Task triggerTask)
    {
        try
        {
            await triggerTask;
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
            _isActive = false;
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception exception) when (!_disposed)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    private void CancelTrigger()
    {
        _triggerVersion++;
        _pendingTrigger = false;
        _isActive = false;
        if (_module is not null && _hasRendered)
        {
            _ = StopAsync();
        }
    }

    private async Task StopAsync()
    {
        try
        {
            await _module!.InvokeVoidAsync("stop", _rootElement);
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        CancelTrigger();

        if (_module is not null)
        {
            await StopAsync();
            await DisposeModuleSafelyAsync(_module);
        }
    }

    private static async Task DisposeModuleSafelyAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }
    }

    private static List<string> NormalizeColors(IEnumerable<string>? colors)
    {
        var normalizedColors = colors?
            .Where(static color => !string.IsNullOrWhiteSpace(color))
            .Select(static color => color.Trim())
            .Where(IsSafeCssColorValue)
            .Distinct(StringComparer.Ordinal)
            .ToList();

        return normalizedColors is { Count: > 0 }
            ? normalizedColors
            : DefaultColors.ToList();
    }

    private static bool IsSafeCssColorValue(string value)
    {
        if (value.Length is 0 or > 64)
        {
            return false;
        }

        return value.All(static character =>
            char.IsAsciiLetterOrDigit(character) ||
            character is '#' or ' ' or ',' or '.' or '%' or '(' or ')' or '-' or '_' or '/');
    }

    private static ConfettiOrigin NormalizeOrigin(ConfettiOrigin origin) =>
        Enum.IsDefined(typeof(ConfettiOrigin), origin) ? origin : ConfettiOrigin.Center;

    private static ConfettiPattern NormalizePattern(ConfettiPattern pattern) =>
        Enum.IsDefined(typeof(ConfettiPattern), pattern) ? pattern : ConfettiPattern.Explosion;

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;

    private static string AriaBool(bool value) => value ? "true" : "false";

    private sealed record ConfettiOptions(
        int ParticleCount,
        int Duration,
        IReadOnlyList<string> Colors,
        string Origin,
        string Pattern);

    public enum ConfettiOrigin
    {
        Center,
        Top,
        Bottom,
        Left,
        Right,
        TopLeft,
        TopRight,
        BottomLeft,
        BottomRight
    }

    public enum ConfettiPattern
    {
        Explosion,
        Fountain,
        Rain,
        Fireworks
    }
}
