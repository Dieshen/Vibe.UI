@namespace Vibe.UI.Components
@inherits VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="@RootClass" style="@RootStyle" @attributes="RootAttributes" @ref="_rootReference">
    <div class="splitter-pane splitter-pane-first" style="@FirstPaneStyle">
        @FirstPane
    </div>

    <div class="splitter-divider"
         style="@DividerStyle"
         role="separator"
         aria-orientation="@DividerAriaOrientation"
         aria-valuenow="@CurrentSizeValue"
         aria-valuemin="@MinSizeValue"
         aria-valuemax="@MaxSizeValue"
         aria-label="Resize panes"
         tabindex="0"
         @onkeydown="HandleDividerKeyDown"
         @ref="_dividerReference">
        <div class="divider-handle">
            @if (NormalizedOrientation == SplitterOrientation.Horizontal)
            {
                <Icon Name="grip-vertical" Size="16" />
            }
            else
            {
                <Icon Name="more-horizontal" Size="16" />
            }
        </div>
    </div>

    <div class="splitter-pane splitter-pane-second" style="@SecondPaneStyle">
        @SecondPane
    </div>
</div>

@code {
    private const double DefaultInitialSize = 50;
    private const double DefaultMinSize = 10;
    private const double DefaultMaxSize = 90;
    private const int DefaultDividerSize = 4;
    private const double KeyboardStep = 1;

    private double _currentSize = 50;
    private bool _hasInitializedParameters;
    private double _lastInitialSize;
    private ElementReference _rootReference;
    private ElementReference _dividerReference;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Splitter>? _dotNetReference;
    private SplitterOrientation? _connectedOrientation;
    private bool _disposed;

    [Parameter]
    public RenderFragment? FirstPane { get; set; }

    [Parameter]
    public RenderFragment? SecondPane { get; set; }

    [Parameter]
    public SplitterOrientation Orientation { get; set; } = SplitterOrientation.Horizontal;

    [Parameter]
    public double InitialSize { get; set; } = 50;

    [Parameter]
    public double MinSize { get; set; } = 10;

    [Parameter]
    public double MaxSize { get; set; } = 90;

    [Parameter]
    public int DividerSize { get; set; } = 4;

    [Parameter]
    public EventCallback<double> OnSizeChanged { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    protected override string ComponentClass => "vibe-splitter";

    private string RootClass => CombineClasses(
        ComponentClass,
        OrientationClass,
        Class?.Trim(),
        CssClass?.Trim(),
        AdditionalClass);

    private string? RootStyle => AdditionalStyle;

    private Dictionary<string, object>? RootAttributes => GetUnhandledAttributes();

    private string OrientationClass => NormalizedOrientation == SplitterOrientation.Vertical
        ? "splitter-vertical"
        : "splitter-horizontal";

    private SplitterOrientation NormalizedOrientation =>
        Enum.IsDefined(typeof(SplitterOrientation), Orientation)
            ? Orientation
            : SplitterOrientation.Horizontal;

    private string FirstPaneStyle
    {
        get
        {
            if (NormalizedOrientation == SplitterOrientation.Horizontal)
                return $"width: {FormatSize(_currentSize)}%;";
            else
                return $"height: {FormatSize(_currentSize)}%;";
        }
    }

    private string SecondPaneStyle
    {
        get
        {
            var remainingSize = 100 - _currentSize;
            if (NormalizedOrientation == SplitterOrientation.Horizontal)
                return $"width: {FormatSize(remainingSize)}%;";
            else
                return $"height: {FormatSize(remainingSize)}%;";
        }
    }

    private string DividerStyle
    {
        get
        {
            var halfDivider = FormatSize(EffectiveDividerSize / 2d);
            return NormalizedOrientation == SplitterOrientation.Horizontal
                ? $"width: {EffectiveDividerSize}px; margin-inline: -{halfDivider}px;"
                : $"height: {EffectiveDividerSize}px; margin-block: -{halfDivider}px;";
        }
    }

    private string DividerAriaOrientation => NormalizedOrientation == SplitterOrientation.Horizontal
        ? "vertical"
        : "horizontal";

    private string CurrentSizeValue => FormatSize(_currentSize);

    private string MinSizeValue => FormatSize(EffectiveMinSize);

    private string MaxSizeValue => FormatSize(EffectiveMaxSize);

    private double EffectiveMinSize => NormalizePercent(MinSize, DefaultMinSize);

    private double EffectiveMaxSize => Math.Max(EffectiveMinSize, NormalizePercent(MaxSize, DefaultMaxSize));

    private double NormalizedInitialSize => NormalizeSize(InitialSize, DefaultInitialSize);

    private int EffectiveDividerSize => DividerSize > 0 ? DividerSize : DefaultDividerSize;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var normalizedInitialSize = NormalizedInitialSize;
        if (!_hasInitializedParameters || !AreClose(_lastInitialSize, normalizedInitialSize))
        {
            _currentSize = normalizedInitialSize;
        }
        else
        {
            _currentSize = NormalizeSize(_currentSize, normalizedInitialSize);
        }

        _lastInitialSize = normalizedInitialSize;
        _hasInitializedParameters = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            if (_module is null)
            {
                var importedModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./_content/Vibe.UI/js/splitter.js");

                if (_disposed)
                {
                    // Disposal landed while the import was in flight; the component
                    // never gets to see this reference, so we own cleaning it up.
                    await DisposeModuleSafelyAsync(importedModule);
                    return;
                }

                _module = importedModule;
            }

            _dotNetReference ??= DotNetObjectReference.Create(this);

            if (_connectedOrientation != NormalizedOrientation)
            {
                if (_connectedOrientation is not null)
                {
                    await _module.InvokeVoidAsync("disconnect", _rootReference);
                }

                await _module.InvokeVoidAsync(
                    "connect",
                    _rootReference,
                    _dividerReference,
                    _dotNetReference,
                    NormalizedOrientation == SplitterOrientation.Horizontal);

                if (_disposed)
                {
                    // Disposal landed while "connect" was in flight, wiring live pointer
                    // listeners into a disposed component; tear that wiring back down.
                    await _module.InvokeVoidAsync("disconnect", _rootReference);
                    return;
                }

                _connectedOrientation = NormalizedOrientation;
            }
        }
        catch (Exception ex) when (IsRecoverableJsInteropException(ex))
        {
        }
    }

    [JSInvokable]
    public Task HandleDragMove(double size)
    {
        return SetSize(size);
    }

    public async Task SetSize(double size)
    {
        var newSize = NormalizeSize(size, _currentSize);
        if (newSize != _currentSize)
        {
            _currentSize = newSize;
            await OnSizeChanged.InvokeAsync(_currentSize);
            StateHasChanged();
        }
    }

    public void ResetSize()
    {
        _currentSize = NormalizedInitialSize;
        StateHasChanged();
    }

    private async Task HandleDividerKeyDown(KeyboardEventArgs e)
    {
        var delta = e.Key switch
        {
            "ArrowLeft" when NormalizedOrientation == SplitterOrientation.Horizontal => -KeyboardStep,
            "ArrowRight" when NormalizedOrientation == SplitterOrientation.Horizontal => KeyboardStep,
            "ArrowUp" when NormalizedOrientation == SplitterOrientation.Vertical => -KeyboardStep,
            "ArrowDown" when NormalizedOrientation == SplitterOrientation.Vertical => KeyboardStep,
            _ => 0
        };

        if (delta != 0)
        {
            await SetSize(_currentSize + delta);
        }
    }

    private double NormalizeSize(double value, double fallback)
    {
        var finiteValue = double.IsFinite(value) ? value : fallback;
        return Math.Clamp(finiteValue, EffectiveMinSize, EffectiveMaxSize);
    }

    private static double NormalizePercent(double value, double fallback)
    {
        var finiteValue = double.IsFinite(value) ? value : fallback;
        return Math.Clamp(finiteValue, 0, 100);
    }

    private static bool AreClose(double left, double right) =>
        Math.Abs(left - right) < 0.0001;

    private static string FormatSize(double value) =>
        FormattableString.Invariant($"{value:0.##}");

    private string? AdditionalClass => GetAdditionalAttributeValue("class");

    private string? AdditionalStyle => GetAdditionalAttributeValue("style")?.TrimEnd(';');

    private Dictionary<string, object>? GetUnhandledAttributes()
    {
        if (AdditionalAttributes is null || AdditionalAttributes.Count == 0)
        {
            return null;
        }

        var attributes = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
        foreach (var attribute in AdditionalAttributes)
        {
            if (IsHandledRootAttribute(attribute.Key))
            {
                continue;
            }

            attributes[attribute.Key] = attribute.Value;
        }

        return attributes.Count == 0 ? null : attributes;
    }

    private static bool IsHandledRootAttribute(string attributeName) =>
        string.Equals(attributeName, "class", StringComparison.OrdinalIgnoreCase)
        || string.Equals(attributeName, "style", StringComparison.OrdinalIgnoreCase);

    private string? GetAdditionalAttributeValue(string attributeName)
    {
        if (AdditionalAttributes is null)
        {
            return null;
        }

        foreach (var attribute in AdditionalAttributes)
        {
            if (string.Equals(attribute.Key, attributeName, StringComparison.OrdinalIgnoreCase))
            {
                return NormalizeAttributeValue(attribute.Value?.ToString());
            }
        }

        return null;
    }

    private static string? NormalizeAttributeValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disconnect", _rootReference);
                await _module.DisposeAsync();
            }
            catch (Exception ex) when (IsRecoverableJsInteropException(ex))
            {
            }
        }

        _dotNetReference?.Dispose();
    }

    private static async Task DisposeModuleSafelyAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (Exception ex) when (IsRecoverableJsInteropException(ex))
        {
        }
    }

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;

    public enum SplitterOrientation
    {
        Horizontal,
        Vertical
    }
}
