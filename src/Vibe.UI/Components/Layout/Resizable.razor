@namespace Vibe.UI.Components
@inherits Base.VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="@RootClass" style="@RootStyle" @ref="_rootReference" @attributes="RootAttributes">
    <div class="resizable-panel">
        @ChildContent
    </div>

    <div class="resizable-handle @HandleDirectionClass"
         role="separator"
         aria-orientation="@HandleAriaOrientation"
         aria-label="Resize panel"
         aria-valuenow="@CurrentSizeAriaValue"
         aria-valuemin="@CurrentMinAriaValue"
         aria-valuemax="@CurrentMaxAriaValue"
         tabindex="0"
         @onkeydown="HandleKeyDown"
         @ref="_handleReference">
        <Icon Name="@(IsHorizontal ? "grip-vertical" : "grip-horizontal")" Size="16" />
    </div>
</div>

@code {
    private const double DefaultWidthValue = 300;
    private const double DefaultHeightValue = 200;
    private const double DefaultMinWidthValue = 100;
    private const double DefaultMinHeightValue = 50;
    private const double KeyboardStep = 10;

    /// <summary>
    /// The direction in which the element can be resized.
    /// </summary>
    public enum ResizableDirection
    {
        /// <summary>
        /// Resize horizontally (left/right).
        /// </summary>
        Horizontal,

        /// <summary>
        /// Resize vertically (up/down).
        /// </summary>
        Vertical
    }

    /// <summary>
    /// Gets or sets the content of the resizable panel.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the direction in which the element can be resized.
    /// </summary>
    [Parameter]
    public ResizableDirection Direction { get; set; } = ResizableDirection.Horizontal;

    /// <summary>
    /// Gets or sets the default width (for horizontal resizing).
    /// </summary>
    [Parameter]
    public double DefaultWidth { get; set; } = 300;

    /// <summary>
    /// Gets or sets the minimum width (for horizontal resizing).
    /// </summary>
    [Parameter]
    public double MinWidth { get; set; } = 100;

    /// <summary>
    /// Gets or sets the maximum width (for horizontal resizing).
    /// </summary>
    [Parameter]
    public double MaxWidth { get; set; } = double.MaxValue;

    /// <summary>
    /// Gets or sets the default height (for vertical resizing).
    /// </summary>
    [Parameter]
    public double DefaultHeight { get; set; } = 200;

    /// <summary>
    /// Gets or sets the minimum height (for vertical resizing).
    /// </summary>
    [Parameter]
    public double MinHeight { get; set; } = 50;

    /// <summary>
    /// Gets or sets the maximum height (for vertical resizing).
    /// </summary>
    [Parameter]
    public double MaxHeight { get; set; } = double.MaxValue;

    /// <summary>
    /// Callback invoked when the size changes.
    /// </summary>
    [Parameter]
    public EventCallback<double> OnSizeChange { get; set; }

    /// <summary>
    /// Gets the current width (for horizontal resizing).
    /// </summary>
    private double Width { get; set; }

    /// <summary>
    /// Gets the current height (for vertical resizing).
    /// </summary>
    private double Height { get; set; }

    /// <summary>
    /// Reference to the handle element.
    /// </summary>
    private ElementReference _handleReference;
    private ElementReference _rootReference;

    private bool _hasInitializedParameters;
    private double _lastDefaultWidth;
    private double _lastDefaultHeight;

    /// <summary>
    /// Gets the component CSS class name.
    /// </summary>
    protected override string ComponentClass => "vibe-resizable";

    private string RootClass => CombineClasses(
        ComponentClass,
        IsHorizontal ? "resizable-horizontal" : "resizable-vertical",
        Class?.Trim(),
        AdditionalClass);

    private string? RootStyle => CombineStyles(
        AdditionalStyle,
        IsHorizontal
            ? $"width: {FormatSize(Width)}px"
            : $"height: {FormatSize(Height)}px");

    private Dictionary<string, object>? RootAttributes => GetUnhandledAttributes();

    /// <summary>
    /// Gets the handle CSS class based on direction.
    /// </summary>
    private string HandleDirectionClass => IsHorizontal
        ? "resizable-handle-horizontal"
        : "resizable-handle-vertical";

    private ResizableDirection EffectiveDirection =>
        Enum.IsDefined(typeof(ResizableDirection), Direction)
            ? Direction
            : ResizableDirection.Horizontal;

    private bool IsHorizontal => EffectiveDirection == ResizableDirection.Horizontal;

    private string HandleAriaOrientation => IsHorizontal ? "vertical" : "horizontal";

    private string CurrentSizeAriaValue => FormatSize(CurrentSize);

    private string CurrentMinAriaValue => FormatSize(CurrentMinSize);

    private string? CurrentMaxAriaValue =>
        CurrentMaxSize == double.MaxValue ? null : FormatSize(CurrentMaxSize);

    private double CurrentSize => IsHorizontal ? Width : Height;

    private double CurrentMinSize => IsHorizontal ? EffectiveMinWidth : EffectiveMinHeight;

    private double CurrentMaxSize => IsHorizontal ? EffectiveMaxWidth : EffectiveMaxHeight;

    private double EffectiveMinWidth => NormalizeMinimum(MinWidth, DefaultMinWidthValue);

    private double EffectiveMinHeight => NormalizeMinimum(MinHeight, DefaultMinHeightValue);

    private double EffectiveMaxWidth => NormalizeMaximum(MaxWidth, EffectiveMinWidth);

    private double EffectiveMaxHeight => NormalizeMaximum(MaxHeight, EffectiveMinHeight);

    /// <summary>
    /// DotNet reference for JavaScript interop.
    /// </summary>
    private DotNetObjectReference<Resizable>? _dotNetRef;

    /// <summary>
    /// JavaScript module for handling drag functionality.
    /// </summary>
    private IJSObjectReference? _dragModule;

    /// <summary>
    /// JavaScript object reference for cleanup.
    /// </summary>
    private IJSObjectReference? _dragRef;
    private bool? _connectedIsHorizontal;
    private bool _disposed;

    /// <summary>
    /// Initializes the component.
    /// </summary>
    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var defaultWidth = CoerceFinite(DefaultWidth, DefaultWidthValue);
        var defaultHeight = CoerceFinite(DefaultHeight, DefaultHeightValue);

        if (!_hasInitializedParameters || !AreClose(_lastDefaultWidth, defaultWidth))
        {
            Width = ClampWidth(defaultWidth);
        }
        else
        {
            Width = ClampWidth(Width);
        }

        if (!_hasInitializedParameters || !AreClose(_lastDefaultHeight, defaultHeight))
        {
            Height = ClampHeight(defaultHeight);
        }
        else
        {
            Height = ClampHeight(Height);
        }

        _lastDefaultWidth = defaultWidth;
        _lastDefaultHeight = defaultHeight;
        _hasInitializedParameters = true;
    }

    /// <summary>
    /// Sets up JavaScript interop after rendering.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (_disposed)
        {
            return;
        }

        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);

            if (_dragModule is null)
            {
                var importedModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Vibe.UI/js/vibe-resizable.js");

                if (_disposed)
                {
                    // Disposal landed while the import was in flight; the component
                    // never gets to see this reference, so we own cleaning it up.
                    await DisposeModuleSafelyAsync(importedModule);
                    return;
                }

                _dragModule = importedModule;
            }

            if (_dragRef is null || _connectedIsHorizontal != IsHorizontal)
            {
                await DisposeDragHandlerAsync();

                var dragRef = await _dragModule.InvokeAsync<IJSObjectReference>(
                    "createDragHandler",
                    _rootReference,
                    _handleReference,
                    _dotNetRef,
                    IsHorizontal);

                if (_disposed)
                {
                    // Disposal landed while the handler was being wired up, attaching
                    // live pointer listeners to a disposed component; tear it back down.
                    await DisposeHandlerReferenceAsync(dragRef);
                    return;
                }

                _dragRef = dragRef;
                _connectedIsHorizontal = IsHorizontal;
            }
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }
    }

    /// <summary>
    /// Callback from JavaScript when dragging moves.
    /// </summary>
    [JSInvokable]
    public void HandleDragMove(double size)
    {
        if (IsHorizontal)
        {
            Width = ClampWidth(size);
        }
        else
        {
            Height = ClampHeight(size);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Callback from JavaScript when drag ends.
    /// </summary>
    [JSInvokable]
    public async Task HandleDragEnd()
    {
        await OnSizeChange.InvokeAsync(CurrentSize);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var delta = GetKeyboardDelta(e.Key);
        if (delta == 0)
        {
            return;
        }

        await SetCurrentSize(CurrentSize + delta);
    }

    private double GetKeyboardDelta(string? key) => key switch
    {
        "ArrowLeft" when IsHorizontal => -KeyboardStep,
        "ArrowRight" when IsHorizontal => KeyboardStep,
        "ArrowUp" when !IsHorizontal => -KeyboardStep,
        "ArrowDown" when !IsHorizontal => KeyboardStep,
        _ => 0
    };

    private async Task SetCurrentSize(double size)
    {
        var oldSize = CurrentSize;
        if (IsHorizontal)
        {
            Width = ClampWidth(size);
        }
        else
        {
            Height = ClampHeight(size);
        }

        if (!AreClose(oldSize, CurrentSize))
        {
            await OnSizeChange.InvokeAsync(CurrentSize);
            StateHasChanged();
        }
    }

    private double ClampWidth(double value) =>
        Math.Clamp(CoerceFinite(value, DefaultWidthValue), EffectiveMinWidth, EffectiveMaxWidth);

    private double ClampHeight(double value) =>
        Math.Clamp(CoerceFinite(value, DefaultHeightValue), EffectiveMinHeight, EffectiveMaxHeight);

    private static double NormalizeMinimum(double value, double fallback) =>
        double.IsFinite(value) && value >= 0 ? value : fallback;

    private static double NormalizeMaximum(double value, double minimum)
    {
        if (double.IsPositiveInfinity(value) || value == double.MaxValue || !double.IsFinite(value))
        {
            return double.MaxValue;
        }

        return value >= minimum ? value : minimum;
    }

    private static double CoerceFinite(double value, double fallback) =>
        double.IsFinite(value) ? value : fallback;

    private static bool AreClose(double left, double right) =>
        Math.Abs(left - right) < 0.0001;

    private static string FormatSize(double value) =>
        FormattableString.Invariant($"{value:0.##}");

    private string? AdditionalClass => GetAdditionalAttributeValue("class");

    private string? AdditionalStyle => GetAdditionalAttributeValue("style")?.TrimEnd(';');

    private Dictionary<string, object>? GetUnhandledAttributes()
    {
        if (AdditionalAttributes is null || AdditionalAttributes.Count == 0)
        {
            return null;
        }

        var attributes = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
        foreach (var attribute in AdditionalAttributes)
        {
            if (IsHandledRootAttribute(attribute.Key))
            {
                continue;
            }

            attributes[attribute.Key] = attribute.Value;
        }

        return attributes.Count == 0 ? null : attributes;
    }

    private static bool IsHandledRootAttribute(string attributeName) =>
        string.Equals(attributeName, "class", StringComparison.OrdinalIgnoreCase)
        || string.Equals(attributeName, "style", StringComparison.OrdinalIgnoreCase);

    private string? GetAdditionalAttributeValue(string attributeName)
    {
        if (AdditionalAttributes is null)
        {
            return null;
        }

        foreach (var attribute in AdditionalAttributes)
        {
            if (string.Equals(attribute.Key, attributeName, StringComparison.OrdinalIgnoreCase))
            {
                return NormalizeAttributeValue(attribute.Value?.ToString());
            }
        }

        return null;
    }

    private static string? NormalizeAttributeValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string? CombineStyles(params string?[] styles)
    {
        var normalizedStyles = styles
            .Select(style => style?.Trim().TrimEnd(';'))
            .Where(style => !string.IsNullOrWhiteSpace(style))
            .ToArray();

        return normalizedStyles.Length == 0 ? null : string.Join("; ", normalizedStyles);
    }

    /// <summary>
    /// Disposes the component and cleans up resources.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;

        await DisposeDragHandlerAsync();

        if (_dragModule != null)
        {
            await DisposeModuleSafelyAsync(_dragModule);
        }

        _dotNetRef?.Dispose();
    }

    private async Task DisposeDragHandlerAsync()
    {
        if (_dragRef is null)
        {
            return;
        }

        await DisposeHandlerReferenceAsync(_dragRef);

        _dragRef = null;
        _connectedIsHorizontal = null;
    }

    private static async Task DisposeHandlerReferenceAsync(IJSObjectReference dragRef)
    {
        try
        {
            await dragRef.InvokeVoidAsync("dispose");
            await dragRef.DisposeAsync();
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }
    }

    private static async Task DisposeModuleSafelyAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }
    }

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;
}
