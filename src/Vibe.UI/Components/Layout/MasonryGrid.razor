@namespace Vibe.UI.Components
@inherits VibeComponent

<div class="@RootClass" style="@GridStyle" @attributes="RootAttributes">
    @for (int col = 0; col < EffectiveColumns; col++)
    {
        var columnIndex = col;
        <div class="masonry-column">
            @if (HasItems)
            {
                @foreach (var item in GetColumnItems(columnIndex))
                {
                    <div class="masonry-item" @key="item.Id">
                        @if (ItemTemplate != null)
                        {
                            @ItemTemplate(item)
                        }
                        else
                        {
                            @item.Content
                        }
                    </div>
                }
            }
        </div>
    }

    @if (!HasItems && EmptyContent != null)
    {
        <div class="masonry-empty">
            @EmptyContent
        </div>
    }
</div>

@code {
    private const int DefaultColumns = 3;
    private const int DefaultGap = 16;

    [Parameter]
    public List<MasonryItem>? Items { get; set; }

    [Parameter]
    public RenderFragment<MasonryItem>? ItemTemplate { get; set; }

    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    [Parameter]
    public int Columns { get; set; } = 3;

    [Parameter]
    public int Gap { get; set; } = 16;

    [Parameter]
    public string? CssClass { get; set; }

    protected override string ComponentClass => "vibe-masonry";

    private string RootClass => CombineClasses(ComponentClass, Class?.Trim(), CssClass?.Trim(), AdditionalClass);

    private string? GridStyle => CombineStyles(AdditionalStyle, $"gap: {EffectiveGap}px");

    private int EffectiveColumns => Columns > 0 ? Columns : DefaultColumns;

    private int EffectiveGap => Gap >= 0 ? Gap : DefaultGap;

    private bool HasItems => Items is { Count: > 0 };

    private Dictionary<string, object>? RootAttributes => GetUnhandledAttributes();

    private List<MasonryItem> GetColumnItems(int columnIndex)
    {
        var items = Items;
        if (items is null || items.Count == 0)
        {
            return new List<MasonryItem>();
        }

        return items
            .Where((item, index) => index % EffectiveColumns == columnIndex)
            .ToList();
    }

    private string? AdditionalClass => GetAdditionalAttributeValue("class");

    private string? AdditionalStyle => GetAdditionalAttributeValue("style")?.TrimEnd(';');

    private Dictionary<string, object>? GetUnhandledAttributes()
    {
        if (AdditionalAttributes is null || AdditionalAttributes.Count == 0)
        {
            return null;
        }

        var attributes = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
        foreach (var attribute in AdditionalAttributes)
        {
            if (IsHandledRootAttribute(attribute.Key))
            {
                continue;
            }

            attributes[attribute.Key] = attribute.Value;
        }

        return attributes.Count == 0 ? null : attributes;
    }

    private static bool IsHandledRootAttribute(string attributeName) =>
        string.Equals(attributeName, "class", StringComparison.OrdinalIgnoreCase)
        || string.Equals(attributeName, "style", StringComparison.OrdinalIgnoreCase);

    private string? GetAdditionalAttributeValue(string attributeName)
    {
        if (AdditionalAttributes is null)
        {
            return null;
        }

        foreach (var attribute in AdditionalAttributes)
        {
            if (string.Equals(attribute.Key, attributeName, StringComparison.OrdinalIgnoreCase))
            {
                return NormalizeAttributeValue(attribute.Value?.ToString());
            }
        }

        return null;
    }

    private static string? NormalizeAttributeValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string? CombineStyles(params string?[] styles)
    {
        var normalizedStyles = styles
            .Select(style => style?.Trim().TrimEnd(';'))
            .Where(style => !string.IsNullOrWhiteSpace(style))
            .ToArray();

        return normalizedStyles.Length == 0 ? null : string.Join("; ", normalizedStyles);
    }

    public class MasonryItem
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public RenderFragment? Content { get; set; }
        public object? Data { get; set; }
    }
}
