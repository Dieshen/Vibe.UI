@namespace Vibe.UI.Components
@inherits Vibe.UI.Base.VibeComponent

<div class="@RootClass" style="@StackStyle" @attributes="RootAttributes">
    @ChildContent
</div>

@code {
    /// <summary>
    /// Gets or sets the child content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the stack direction
    /// </summary>
    [Parameter]
    public StackDirection Direction { get; set; } = StackDirection.Vertical;

    /// <summary>
    /// Gets or sets the spacing between items
    /// </summary>
    [Parameter]
    public string Spacing { get; set; } = "1rem";

    /// <summary>
    /// Gets or sets the cross-axis alignment
    /// </summary>
    [Parameter]
    public StackAlign Align { get; set; } = StackAlign.Stretch;

    /// <summary>
    /// Gets or sets the main-axis alignment
    /// </summary>
    [Parameter]
    public StackJustify Justify { get; set; } = StackJustify.Start;

    /// <summary>
    /// Gets or sets whether items can wrap
    /// </summary>
    [Parameter]
    public bool Wrap { get; set; }

    /// <inheritdoc/>
    protected override string ComponentClass => "vibe-stack";

    private string RootClass => CombineClasses(
        ComponentClass,
        DirectionClass,
        WrapClass,
        Class?.Trim(),
        AdditionalClass);

    private Dictionary<string, object>? RootAttributes => GetUnhandledAttributes();

    private string DirectionClass => NormalizedDirection switch
    {
        StackDirection.Horizontal => "vibe-stack-horizontal",
        StackDirection.Vertical => "vibe-stack-vertical",
        _ => "vibe-stack-vertical"
    };

    private string WrapClass => Wrap ? "vibe-stack-wrap" : string.Empty;

    private string? StackStyle
    {
        get
        {
            var styles = new List<string>();

            var additionalStyle = AdditionalStyle;
            if (!string.IsNullOrWhiteSpace(additionalStyle))
            {
                styles.Add(additionalStyle);
            }

            styles.Add($"gap: {EffectiveSpacing}");

            styles.Add(NormalizedAlign switch
            {
                StackAlign.Start => "align-items: flex-start",
                StackAlign.Center => "align-items: center",
                StackAlign.End => "align-items: flex-end",
                StackAlign.Stretch => "align-items: stretch",
                _ => "align-items: stretch"
            });

            styles.Add(NormalizedJustify switch
            {
                StackJustify.Start => "justify-content: flex-start",
                StackJustify.Center => "justify-content: center",
                StackJustify.End => "justify-content: flex-end",
                StackJustify.SpaceBetween => "justify-content: space-between",
                StackJustify.SpaceAround => "justify-content: space-around",
                StackJustify.SpaceEvenly => "justify-content: space-evenly",
                _ => "justify-content: flex-start"
            });

            return string.Join("; ", styles);
        }
    }

    private StackDirection NormalizedDirection =>
        Enum.IsDefined(typeof(StackDirection), Direction) ? Direction : StackDirection.Vertical;

    private StackAlign NormalizedAlign =>
        Enum.IsDefined(typeof(StackAlign), Align) ? Align : StackAlign.Stretch;

    private StackJustify NormalizedJustify =>
        Enum.IsDefined(typeof(StackJustify), Justify) ? Justify : StackJustify.Start;

    private string EffectiveSpacing => NormalizeAttributeValue(Spacing) ?? "1rem";

    private string? AdditionalClass => GetAdditionalAttributeValue("class");

    private string? AdditionalStyle => GetAdditionalAttributeValue("style")?.TrimEnd(';');

    private Dictionary<string, object>? GetUnhandledAttributes()
    {
        if (AdditionalAttributes is null || AdditionalAttributes.Count == 0)
        {
            return null;
        }

        var attributes = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
        foreach (var attribute in AdditionalAttributes)
        {
            if (IsHandledRootAttribute(attribute.Key))
            {
                continue;
            }

            attributes[attribute.Key] = attribute.Value;
        }

        return attributes.Count == 0 ? null : attributes;
    }

    private static bool IsHandledRootAttribute(string attributeName) =>
        string.Equals(attributeName, "class", StringComparison.OrdinalIgnoreCase)
        || string.Equals(attributeName, "style", StringComparison.OrdinalIgnoreCase);

    private string? GetAdditionalAttributeValue(string attributeName)
    {
        if (AdditionalAttributes is null)
        {
            return null;
        }

        foreach (var attribute in AdditionalAttributes)
        {
            if (string.Equals(attribute.Key, attributeName, StringComparison.OrdinalIgnoreCase))
            {
                return NormalizeAttributeValue(attribute.Value?.ToString());
            }
        }

        return null;
    }

    private static string? NormalizeAttributeValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public enum StackDirection
    {
        Vertical,
        Horizontal
    }

    public enum StackAlign
    {
        Start,
        Center,
        End,
        Stretch
    }

    public enum StackJustify
    {
        Start,
        Center,
        End,
        SpaceBetween,
        SpaceAround,
        SpaceEvenly
    }
}
