{
  "name": "vibe-ui-chart",
  "version": "1.0.0",
  "description": "TypeScript source for Vibe.UI Chart.js integration",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && npm run build:chart && npm run build:confetti",
    "build:chart": "esbuild src/vibe-chart.ts --bundle --format=iife --target=es2022 --minify --sourcemap --outfile=dist/vibe-chart.js",
    "build:confetti": "esbuild src/vibe-confetti.ts --bundle --format=esm --target=es2022 --minify --sourcemap --outfile=dist/vibe-confetti.js",
    "build:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "npm run build && copyfiles -f dist/vibe-chart.js dist/vibe-chart.js.map dist/vibe-confetti.js dist/vibe-confetti.js.map ../wwwroot/js/",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "vibe-ui",
    "chart",
    "chartjs",
    "blazor"
  ],
  "author": "Vibe.UI Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "copyfiles": "^2.4.1",
    "esbuild": "0.28.1",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "canvas-confetti": "1.9.4"
  }
}
