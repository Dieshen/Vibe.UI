@code {
    private string? activeTabId = "account";

    private string BasicCode => @"<Tabs>
    <TabItem Id=""overview"" Header=""Overview"" DefaultActive=""true"">
        Overview content
    </TabItem>
    <TabItem Id=""activity"" Header=""Activity"">
        Activity content
    </TabItem>
</Tabs>";

    private string ControlledCode => @"<Tabs @bind-ActiveTabId=""@activeTabId"">
    <TabItem Id=""account"" Header=""Account"">Account content</TabItem>
    <TabItem Id=""security"" Header=""Security"">Security content</TabItem>
</Tabs>

@code {
    private string? activeTabId = ""account"";
}";

    private string DisabledCode => @"<Tabs>
    <TabItem Id=""overview"" Header=""Overview"" DefaultActive=""true"">Overview</TabItem>
    <TabItem Id=""analytics"" Header=""Analytics"" Disabled=""true"">Analytics</TabItem>
</Tabs>";

    private string EventsCode => @"<Tabs @bind-ActiveTabId=""@activeTabId""
      OnTabActivated=""@HandleTabActivated"">
    <TabItem Id=""home"" Header=""Home"">Home content</TabItem>
    <TabItem Id=""settings"" Header=""Settings"">Settings content</TabItem>
</Tabs>";
}


