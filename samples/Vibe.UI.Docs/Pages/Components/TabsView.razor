@page "/components/tabs"

<PageTitle>Tabs - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <!-- Header -->
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Components</a>
            <span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Tabs</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">Tabs</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            Organizes content into multiple panels where only one is visible at a time with tab navigation.
        </p>
    </header>

    <!-- Preview -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-p-6 vibe-rounded-xl vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-800 vibe-bg-white dark:vibe-bg-zinc-900">
            <Tabs @bind-ActiveTabId="activeTabId">
                <TabItem Id="account" Header="Account" DefaultActive="true">
                    <div class="vibe-py-2">
                        <h3 class="vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-1">Account</h3>
                        <p class="vibe-text-sm vibe-text-zinc-600 dark:vibe-text-zinc-400">Update your profile and account preferences.</p>
                    </div>
                </TabItem>
                <TabItem Id="security" Header="Security">
                    <div class="vibe-py-2">
                        <h3 class="vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-1">Security</h3>
                        <p class="vibe-text-sm vibe-text-zinc-600 dark:vibe-text-zinc-400">Manage your password and active sessions.</p>
                    </div>
                </TabItem>
                <TabItem Id="billing" Header="Billing">
                    <div class="vibe-py-2">
                        <h3 class="vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-1">Billing</h3>
                        <p class="vibe-text-sm vibe-text-zinc-600 dark:vibe-text-zinc-400">Review invoices and payment details.</p>
                    </div>
                </TabItem>
            </Tabs>
        </div>
    </section>

    <!-- Examples Section -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>

        <!-- Basic Usage -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Basic Usage</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Declare tab headers and panels together with <code>TabItem</code> children.
            </p>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>

        <!-- Controlled State -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Controlled State</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Bind the active tab ID when application state needs to control the selection.
            </p>
            <CodeBlock Code="@ControlledCode" Language="razor" />
        </div>

        <!-- Disabled Tab -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Disabled Tab</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Disabled tabs remain visible but cannot be selected with pointer or keyboard input.
            </p>
            <CodeBlock Code="@DisabledCode" Language="razor" />
        </div>

        <!-- Tab Events -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Tab Events</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Listen to tab activation events.
            </p>
            <CodeBlock Code="@EventsCode" Language="razor" />
        </div>

    </section>

    <!-- API Reference -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>

