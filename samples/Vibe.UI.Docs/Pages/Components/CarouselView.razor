@page "/components/carousel"
@using Vibe.UI.Components

<PageTitle>Carousel - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Components</a>
            <span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Carousel</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">Carousel</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            Cycle through a small set of visual panels with pointer, keyboard, and direct navigation.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700">
            <Carousel @bind-ActiveIndex="activeIndex"
                      AriaLabel="Vibe.UI release highlights"
                      Loop="false"
                      AutoPlay="true"
                      AutoPlayInterval="10000"
                      ShowNavigation="true"
                      ShowIndicators="true">
                <CarouselItem>
                    <div style="height: 18rem; display: grid; grid-template-rows: minmax(0, 1fr) auto; background: var(--vibe-background);">
                        <img src="logo.png" alt="Vibe.UI wave mark" style="width: 100%; height: 100%; min-height: 0; object-fit: cover;" />
                        <div class="vibe-p-4 vibe-border-t vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <strong>Visual system</strong>
                            <p class="vibe-text-sm vibe-text-zinc-600 dark:vibe-text-zinc-400">Consistent controls, spacing, and focus states.</p>
                        </div>
                    </div>
                </CarouselItem>
                <CarouselItem>
                    <div style="height: 18rem; display: grid; grid-template-rows: minmax(0, 1fr) auto; background: var(--vibe-background);">
                        <img src="icon-512.png" alt="Vibe.UI application icon" style="width: 100%; height: 100%; min-height: 0; object-fit: contain; padding: 1.5rem;" />
                        <div class="vibe-p-4 vibe-border-t vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <strong>Hosting coverage</strong>
                            <p class="vibe-text-sm vibe-text-zinc-600 dark:vibe-text-zinc-400">Standalone WebAssembly and every Blazor Web App render mode.</p>
                        </div>
                    </div>
                </CarouselItem>
                <CarouselItem>
                    <div style="height: 18rem; display: grid; grid-template-rows: minmax(0, 1fr) auto; background: var(--vibe-background);">
                        <img src="icon-192.png" alt="Compact Vibe.UI application icon" style="width: 100%; height: 100%; min-height: 0; object-fit: contain; padding: 2rem;" />
                        <div class="vibe-p-4 vibe-border-t vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <strong>Accessible interaction</strong>
                            <p class="vibe-text-sm vibe-text-zinc-600 dark:vibe-text-zinc-400">Named controls, direct slide selection, and arrow navigation.</p>
                        </div>
                    </div>
                </CarouselItem>
            </Carousel>
            <output class="vibe-block vibe-mt-3 vibe-text-sm vibe-text-zinc-500">Slide @(activeIndex + 1) of 3</output>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Controlled slide</h3>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>
        <div>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Automatic rotation</h3>
            <CodeBlock Code="@AutoPlayCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>
        <div class="vibe-overflow-x-auto">
            <table class="vibe-w-full vibe-text-sm">
                <thead><tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Name</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Type</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Default</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Description</th>
                </tr></thead>
                <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                    @foreach (var property in Properties)
                    {
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono">@property.Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">@property.Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">@property.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add carousel" Language="bash" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            @foreach (var item in AccessibilityItems)
            {
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Icon Name="check-circle" Size="20" CssClass="vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" />
                    @item
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private int activeIndex;

    private static readonly (string Name, string Type, string Default, string Description)[] Properties =
    [
        ("ChildContent", "RenderFragment?", "null", "CarouselItem children"),
        ("ShowNavigation", "bool", "true", "Render previous and next controls"),
        ("ShowIndicators", "bool", "true", "Render direct slide controls"),
        ("Loop", "bool", "true", "Wrap at the first and last slide"),
        ("AutoPlay", "bool", "false", "Automatically rotate slides and render a pause control"),
        ("AutoPlayInterval", "int", "3000", "Rotation interval in milliseconds; minimum 250"),
        ("EnableDrag", "bool", "true", "Enable mouse, pen, and touch swiping"),
        ("Disabled", "bool", "false", "Disable every interaction"),
        ("ActiveIndex", "int", "0", "Current slide; supports @bind-ActiveIndex"),
        ("Orientation", "CarouselOrientation", "Horizontal", "Horizontal or vertical motion"),
        ("AriaLabel", "string?", "Carousel", "Accessible region name")
    ];

    private static readonly string[] AccessibilityItems =
    [
        "Exposes carousel and slide semantics with current position text",
        "Supports arrow keys plus Home and End",
        "Provides thirty-two-pixel direct slide controls and named navigation buttons",
        "Pauses automatic rotation on hover, focus, or the visible pause control"
    ];

    private string BasicCode => @"<Carousel @bind-ActiveIndex=""activeIndex"" Loop=""false"">
    <CarouselItem><ReleaseOne /></CarouselItem>
    <CarouselItem><ReleaseTwo /></CarouselItem>
</Carousel>";

    private string AutoPlayCode => @"<Carousel AutoPlay=""true"" AutoPlayInterval=""5000"">
    <CarouselItem><ReleaseOne /></CarouselItem>
    <CarouselItem><ReleaseTwo /></CarouselItem>
</Carousel>";
}
