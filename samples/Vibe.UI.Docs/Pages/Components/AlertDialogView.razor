@page "/components/alertdialog"
@using Vibe.UI.Components

<PageTitle>Alert Dialog - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Components</a>
            <span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Alert Dialog</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">Alert Dialog</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            Interrupt a workflow for a decision that requires explicit confirmation.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700">
            <Button Variant="ButtonVariant.Destructive" OnClick="OpenDialog">Delete project</Button>
            <output class="vibe-block vibe-mt-3 vibe-text-sm vibe-text-zinc-500">@status</output>
        </div>

        <AlertDialog @bind-IsOpen="dialogOpen"
                     Title="Delete project?"
                     Description="This permanently removes the project and its deployment history.">
            <ChildContent>
                Entering this action cannot be undone.
            </ChildContent>
            <Footer>
                <Button Variant="ButtonVariant.Outline" OnClick="Cancel">Cancel</Button>
                <Button Variant="ButtonVariant.Destructive" OnClick="Confirm">Delete project</Button>
            </Footer>
        </AlertDialog>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>
        <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Explicit destructive action</h3>
        <CodeBlock Code="@BasicCode" Language="razor" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>
        <div class="vibe-overflow-x-auto">
            <table class="vibe-w-full vibe-text-sm">
                <thead><tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Name</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Type</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Default</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Description</th>
                </tr></thead>
                <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                    @foreach (var property in Properties)
                    {
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono">@property.Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">@property.Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">@property.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add alertdialog" Language="bash" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            @foreach (var item in AccessibilityItems)
            {
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Icon Name="check-circle" Size="20" CssClass="vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" />
                    @item
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private bool dialogOpen;
    private string status = "Project remains active.";

    private static readonly (string Name, string Type, string Default, string Description)[] Properties =
    [
        ("IsOpen", "bool", "false", "Open state; supports @bind-IsOpen"),
        ("Title", "string", "empty", "Accessible dialog title"),
        ("Description", "string", "empty", "Accessible consequence description"),
        ("ChildContent", "RenderFragment?", "null", "Additional decision context"),
        ("Footer", "RenderFragment?", "null", "Cancel and confirmation actions"),
        ("CloseOnBackdropClick", "bool", "false", "Allow backdrop dismissal when explicitly enabled"),
        ("ShowCloseButton", "bool", "false", "Render an optional close icon"),
        ("CloseOnEscape", "bool", "true", "Allow Escape dismissal")
    ];

    private static readonly string[] AccessibilityItems =
    [
        "Exposes alertdialog semantics with title and description relationships",
        "Traps focus, locks page scrolling, and restores the opener",
        "Requires an explicit action by default instead of closing from the backdrop",
        "Closes only the topmost modal when Escape is pressed"
    ];

    private void OpenDialog(MouseEventArgs _)
    {
        status = "Awaiting confirmation.";
        dialogOpen = true;
    }

    private void Cancel(MouseEventArgs _)
    {
        status = "Project remains active.";
        dialogOpen = false;
    }

    private void Confirm(MouseEventArgs _)
    {
        status = "Project deleted.";
        dialogOpen = false;
    }

    private string BasicCode => @"<AlertDialog @bind-IsOpen=""isOpen""
             Title=""Delete project?""
             Description=""This action cannot be undone."">
    <Footer>
        <Button OnClick=""Cancel"">Cancel</Button>
        <Button Variant=""ButtonVariant.Destructive"" OnClick=""Confirm"">Delete</Button>
    </Footer>
</AlertDialog>";
}
