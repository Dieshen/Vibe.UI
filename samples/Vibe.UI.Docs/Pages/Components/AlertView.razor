@page "/components/alert"

<PageTitle>Alert - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <!-- Header -->
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Components</a>
            <span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Alert</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">Alert</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            Displays an important message to get user's attention without interrupting their task.
        </p>
    </header>

    <!-- Preview -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-p-4 sm:vibe-p-6 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-800 vibe-bg-white dark:vibe-bg-zinc-900 vibe-space-y-3">
            <Alert Variant="AlertVariant.Success" Title="Payment successful">
                <Icon>
                    <Vibe.UI.Components.Icon Name="check-circle" Size="16" />
                </Icon>
                <ChildContent>
                    Your payment has been processed and a receipt was sent by email.
                </ChildContent>
            </Alert>
            <Alert Variant="AlertVariant.Default" Title="New feature available">
                <Icon>
                    <Vibe.UI.Components.Icon Name="info" Size="16" />
                </Icon>
                <ChildContent>
                    Dark mode is now available in your account settings.
                </ChildContent>
            </Alert>
            <Alert Variant="AlertVariant.Destructive" Title="Deployment failed">
                <Icon>
                    <Vibe.UI.Components.Icon Name="alert-circle" Size="16" />
                </Icon>
                <ChildContent>
                    Review the failed checks before trying the deployment again.
                </ChildContent>
            </Alert>
            @if (showDismissible)
            {
                <Alert Variant="AlertVariant.Warning" Dismissible="true" OnDismiss="@(() => showDismissible = false)" Title="Subscription expiring">
                    <Icon>
                        <Vibe.UI.Components.Icon Name="alert-circle" Size="16" />
                    </Icon>
                    <ChildContent>
                        Renew within three days to avoid an interruption.
                    </ChildContent>
                </Alert>
            }
            else
            {
                <Button Variant="ButtonVariant.Outline" OnClick="@(() => showDismissible = true)">Show Dismissible Alert</Button>
            }
        </div>
    </section>

    <!-- Examples Section -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>

        <!-- Variants -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Variants</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Use different variants to communicate the type and urgency of the message.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 vibe-mb-3">
                <Alert Variant="AlertVariant.Default" Title="Account updated">
                    <Icon><Vibe.UI.Components.Icon Name="info" Size="16" /></Icon>
                    <ChildContent>Your profile changes were saved.</ChildContent>
                </Alert>
                <Alert Variant="AlertVariant.Destructive" Title="Payment failed">
                    <Icon><Vibe.UI.Components.Icon Name="alert-circle" Size="16" /></Icon>
                    <ChildContent>Check your payment method and try again.</ChildContent>
                </Alert>
            </div>
            <CodeBlock Code="@VariantsCode" Language="razor" />
        </div>

        <!-- With Title -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">With Title</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Add a title for additional context and emphasis.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 vibe-mb-3">
                <Alert Title="Heads up!" Variant="AlertVariant.Default">
                    You can add components to your app using the CLI.
                </Alert>
            </div>
            <CodeBlock Code="@TitleCode" Language="razor" />
        </div>

        <!-- Dismissible -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Dismissible</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Allow users to dismiss the alert when the message is no longer needed.
            </p>
            <CodeBlock Code="@DismissibleCode" Language="razor" />
        </div>

        <!-- With Icon -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">With Icon</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Use custom icons to enhance visual communication.
            </p>
            <CodeBlock Code="@IconCode" Language="razor" />
        </div>
    </section>

    <!-- API Reference -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>

        <!-- Properties -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-4">Properties</h3>
            <div class="vibe-overflow-x-auto">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Default</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Variant</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="AlertVariant" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Visual style of the alert</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Title</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="RenderFragment" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Optional title displayed above content</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Dismissible</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">false</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Whether the alert can be dismissed</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Icon</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Custom icon to display</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">ChildContent</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="RenderFragment" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">—</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Alert message content</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Events -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-4">Events</h3>
            <div class="vibe-overflow-x-auto">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">OnDismiss</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="EventCallback" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Callback when alert is dismissed</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Installation -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
            Install the Alert component using the Vibe.UI CLI:
        </p>
        <CodeBlock Code="vibe add alert" Language="bash" />
    </section>

    <!-- Accessibility -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Uses ARIA <code class="vibe-text-sm vibe-bg-zinc-100 dark:vibe-bg-zinc-800 vibe-px-1 vibe-py-0.5 vibe-rounded">role="alert"</code> for important messages
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Screen readers announce content automatically
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Dismissible alerts are keyboard accessible
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Color is not the sole indicator (icons included)
            </li>
        </ul>
    </section>

    <!-- Related Components -->
    <section>
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Related</h2>
        <div class="vibe-grid vibe-grid-cols-1 sm:vibe-grid-cols-3 vibe-gap-4">
            <a href="components/toast" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 hover:vibe-border-brand-teal dark:hover:vibe-border-brand-teal vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100 group-hover:vibe-text-brand-teal">Toast</h4>
                <p class="vibe-text-sm vibe-text-zinc-500">Temporary notification messages</p>
            </a>
            </div>
    </section>
</div>

@code {
    private bool showDismissible = true;

    private string VariantsCode => @"<Alert Variant=""AlertVariant.Default"" Title=""Account updated"">
    <Icon><Vibe.UI.Components.Icon Name=""info"" Size=""16"" /></Icon>
    <ChildContent>Your profile changes were saved.</ChildContent>
</Alert>

<Alert Variant=""AlertVariant.Destructive"" Title=""Payment failed"">
    <Icon><Vibe.UI.Components.Icon Name=""alert-circle"" Size=""16"" /></Icon>
    <ChildContent>Check your payment method and try again.</ChildContent>
</Alert>";

    private string TitleCode => @"<Alert Title=""Heads up!"" Variant=""AlertVariant.Default"">
    You can add components to your app using the CLI.
</Alert>";

    private string DismissibleCode => @"<Alert Dismissible=""true"" OnDismiss=""@HandleDismiss"" Title=""Notice"">
    This alert can be dismissed.
</Alert>

@code {
    private void HandleDismiss()
    {
        // Handle dismiss action
    }
}";

    private string IconCode => @"<Alert Title=""Heads up!"" Variant=""AlertVariant.Default"">
    <Icon>
        <Vibe.UI.Components.Icon Name=""info"" Size=""16"" />
    </Icon>
    <ChildContent>You can add components using the Vibe.UI CLI.</ChildContent>
</Alert>";
}


