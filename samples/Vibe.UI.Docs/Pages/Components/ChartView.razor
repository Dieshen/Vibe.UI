@page "/components/chart"
@using Vibe.UI.Components
@using Vibe.UI.Services
@using static Vibe.UI.Components.Chart

<PageTitle>Chart - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Components</a>
            <span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Chart</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">Chart</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            Render Chart.js visualizations with Vibe-aware light and dark canvas styling, semantic legends, and an accessible data table.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
                <div>
                    <h3 style="margin-bottom: 1rem; font-size: 0.875rem; font-weight: 600;">Line</h3>
                    <Chart Type="ChartType.Line"
                           Data="@lineChartData"
                           Title="Monthly revenue"
                           Height="220" />
                </div>
                <div>
                    <h3 style="margin-bottom: 1rem; font-size: 0.875rem; font-weight: 600;">Bar</h3>
                    <Chart Type="ChartType.Bar"
                           Data="@barChartData"
                           Title="Quarterly sales"
                           Height="220" />
                </div>
                <div>
                    <h3 style="margin-bottom: 1rem; font-size: 0.875rem; font-weight: 600;">Pie</h3>
                    <Chart Type="ChartType.Pie"
                           Data="@pieChartData"
                           Title="Regional share"
                           Height="220" />
                </div>
            </div>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Line Chart</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Use <code>Data</code> with one or more datasets for line and area-style charts.
            </p>
            <CodeBlock Code="@LineChartCode" Language="razor" />
        </div>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Bar Chart</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Bar charts use the same data model and can reuse the builder helpers.
            </p>
            <CodeBlock Code="@BarChartCode" Language="razor" />
        </div>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Pie Chart With Slice Colors</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Keep <code>Color</code> for single-color datasets and use <code>BackgroundColors</code> or <code>BorderColors</code> for pie or doughnut slices. The HTML legend names every slice and its value.
            </p>
            <CodeBlock Code="@PieChartCode" Language="razor" />
        </div>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Area Chart</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Use <code>ChartType.Area</code> with filled datasets for trend visualizations.
            </p>
            <CodeBlock Code="@AreaChartCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>
        <div class="vibe-overflow-x-auto">
            <table class="vibe-w-full vibe-text-sm">
                <thead>
                    <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Default</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</th>
                    </tr>
                </thead>
                <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Data</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="ChartData" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">Required</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Chart labels and datasets.</td>
                    </tr>
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="ChartType" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">Line</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Chart.js visualization type.</td>
                    </tr>
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Title</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string?" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Visible chart title.</td>
                    </tr>
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string?" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Optional supporting text.</td>
                    </tr>
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">ShowLegend</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">true</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Shows the legend.</td>
                    </tr>
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">UseBuiltInLegend</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">false</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Uses the Chart.js canvas legend visually; Vibe.UI still exposes the semantic data alternative.</td>
                    </tr>
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">ShowGrid</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">true</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Shows cartesian grid lines.</td>
                    </tr>
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Height</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="int" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">300</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Chart height in pixels.</td>
                    </tr>
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">AriaLabel</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string?" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Accessible label when no visible title is present.</td>
                    </tr>
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">EmptyMessage</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string?" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">"No chart data available"</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Displayed when no datasets contain values.</td>
                    </tr>
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Options</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="ChartOptions" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Responsive, tooltip, and animation options exposed by Vibe.UI. Canvas interface colors follow Vibe theme tokens.</td>
                    </tr>
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">FooterContent</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="RenderFragment?" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Optional footer slot below the chart.</td>
                    </tr>
                    <tr>
                        <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">CssClass</td>
                        <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string?" /></td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                        <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Additional CSS classes.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Methods</h2>
        <div class="vibe-space-y-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            <div>
                <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-2">RefreshAsync()</h3>
                <p>Call after mutating the current <code>Data</code> instance in place.</p>
            </div>
            <div>
                <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-2">ExportAsImageAsync()</h3>
                <p>Returns the rendered chart as a base64 string, or <code>null</code> when the chart is unavailable.</p>
            </div>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            <li>The rendered canvas uses <code>role="img"</code>.</li>
            <li><code>Title</code> and <code>Description</code> provide <code>aria-labelledby</code> and <code>aria-describedby</code> wiring.</li>
            <li><code>AriaLabel</code> supplies an accessible name when no visible title is present.</li>
            <li>Empty charts show a status message instead of a blank canvas.</li>
            <li>Every rendered chart includes a semantic data summary and table for screen readers.</li>
            <li>Circular charts expose every slice name and value in the semantic HTML legend.</li>
            <li>Axes, ticks, tooltips, and legends update from the Vibe theme tokens when the document theme changes.</li>
        </ul>
    </section>

    <section>
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
            Add the component with the CLI, then load Chart.js and the Vibe.UI chart interop script in your app.
        </p>
        <CodeBlock Code="vibe add chart" Language="bash" />
    </section>
</div>

@code {
    private readonly ChartData lineChartData = new ChartDataBuilder()
        .WithLabels("Jan", "Feb", "Mar", "Apr", "May", "Jun")
        .AddDataset("Revenue", new[] { 12_000.0, 19_000.0, 15_000.0, 25_000.0, 22_000.0, 30_000.0 }, "#3b82f6")
        .AddDataset("Expenses", new[] { 8_000.0, 12_000.0, 10_000.0, 15_000.0, 14_000.0, 18_000.0 }, "#ef4444")
        .Build();

    private readonly ChartData barChartData = ChartDataBuilder.CreateBarChart(
        labels: ["Q1", "Q2", "Q3", "Q4"],
        datasets: new Dictionary<string, double[]>
        {
            ["Sales 2024"] = [45_000.0, 52_000.0, 48_000.0, 61_000.0],
            ["Sales 2023"] = [38_000.0, 45_000.0, 42_000.0, 55_000.0]
        });

    private readonly ChartData pieChartData = ChartDataBuilder.CreatePieChart(
        labels: ["North", "South", "West"],
        values: [35.0, 40.0, 25.0],
        colors: ["#2563eb", "#14b8a6", "#f59e0b"]);

    private string LineChartCode => """
<Chart Type="ChartType.Line" Data="@chartData" Title="Revenue" Height="320" />

@code {
    private ChartData chartData = new ChartDataBuilder()
        .WithLabels("Jan", "Feb", "Mar", "Apr")
        .AddDataset("Revenue", new[] { 12.0, 19.0, 15.0, 24.0 }, "#3b82f6")
        .AddDataset("Expenses", new[] { 8.0, 11.0, 10.0, 14.0 }, "#ef4444")
        .Build();
}
""";

    private string BarChartCode => """
<Chart Type="ChartType.Bar" Data="@barData" Title="Quarterly Sales" Height="320" />

@code {
    private ChartData barData = ChartDataBuilder.CreateBarChart(
        labels: new[] { "Q1", "Q2", "Q3", "Q4" },
        datasets: new Dictionary<string, double[]>
        {
            ["2024"] = new[] { 45.0, 52.0, 48.0, 61.0 },
            ["2023"] = new[] { 38.0, 45.0, 42.0, 55.0 }
        });
}
""";

    private string PieChartCode => """
<Chart Type="ChartType.Pie"
       Data="@pieData"
       Title="Regional Share" />

@code {
    private ChartData pieData = new()
    {
        Labels = ["North", "South", "West"],
        Datasets =
        [
            new ChartDataset
            {
                Label = "Share",
                Data = [35.0, 40.0, 25.0],
                Color = "#2563eb",
                BackgroundColors = ["#2563eb", "#14b8a6", "#f59e0b"],
                BorderColors = ["#1d4ed8", "#0f766e", "#d97706"]
            }
        ]
    };
}
""";

    private string AreaChartCode => """
<Chart Type="ChartType.Area" Data="@areaData" Title="Traffic" Height="320" />

@code {
    private ChartData areaData = ChartDataBuilder.CreateAreaChart(
        labels: new[] { "Week 1", "Week 2", "Week 3", "Week 4" },
        datasets: new Dictionary<string, double[]>
        {
            ["Desktop"] = new[] { 1200.0, 1900.0, 1500.0, 2100.0 },
            ["Mobile"] = new[] { 800.0, 1200.0, 1400.0, 1800.0 }
        });
}
""";
}
