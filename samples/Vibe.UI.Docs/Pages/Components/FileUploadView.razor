@page "/components/fileupload"
@using Vibe.UI.Components
@using static Vibe.UI.Components.FileUpload

<PageTitle>FileUpload - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Components</a>
            <span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">FileUpload</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">FileUpload</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            Select or drop files with type, size, and count validation.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700">
            <div class="vibe-max-w-lg vibe-mx-auto">
                <FileUpload @bind-Files="uploadedFiles"
                            Multiple="true"
                            Accept="image/*,.pdf,.txt"
                            MaxFiles="5"
                            DropText="Drop files here or click to browse"
                            HintText="Images, PDF, or TXT up to 10 MB each" />
            </div>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Single file</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Bind the selected file list and disable multiple selection.
            </p>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Validation</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Limit accepted MIME types or extensions, bytes per file, and total files.
            </p>
            <CodeBlock Code="@ValidationCode" Language="razor" />
        </div>

        <div>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">File callbacks</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Observe validated additions and user-initiated removals.
            </p>
            <CodeBlock Code="@CallbackCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-4">Properties</h3>
            <div class="vibe-overflow-x-auto">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Default</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                        @foreach (var property in Properties)
                        {
                            <tr>
                                <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">@property.Name</td>
                                <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                                <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">@property.Default</td>
                                <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">@property.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-4">Events</h3>
            <div class="vibe-overflow-x-auto">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                        @foreach (var eventInfo in Events)
                        {
                            <tr>
                                <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">@eventInfo.Name</td>
                                <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@eventInfo.Type" /></td>
                                <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">@eventInfo.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add fileupload" Language="bash" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            @foreach (var item in AccessibilityItems)
            {
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" CssClass="vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" />
                    @item
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private List<UploadedFile> uploadedFiles = [];

    private static readonly (string Name, string Type, string Default, string Description)[] Properties =
    [
        ("Files", "List<UploadedFile>", "[]", "Current validated files; supports @bind-Files"),
        ("Multiple", "bool", "true", "Allow more than one file"),
        ("Accept", "string?", "null", "Comma-separated MIME types, wildcards, or extensions"),
        ("MaxFileSize", "long", "10485760", "Maximum bytes read for each file"),
        ("MaxFiles", "int", "10", "Maximum number of retained files"),
        ("Disabled", "bool", "false", "Disable browse, drop, and removal controls"),
        ("DropText", "string", "Drop files...", "Primary empty-state text"),
        ("HintText", "string", "Supports...", "Supporting format or size guidance"),
        ("AriaLabel", "string", "File upload", "Accessible name for the upload group and input"),
        ("ErrorMessage", "string?", "null", "Externally supplied error message"),
        ("CssClass", "string?", "null", "Additional component class")
    ];

    private static readonly (string Name, string Type, string Description)[] Events =
    [
        ("FilesChanged", "EventCallback<List<UploadedFile>>", "Raised when the retained list changes"),
        ("OnFileAdded", "EventCallback<UploadedFile>", "Raised once for each validated file added"),
        ("OnFileRemoved", "EventCallback<UploadedFile>", "Raised after a file is removed")
    ];

    private static readonly string[] AccessibilityItems =
    [
        "Uses the native file input for browse-dialog keyboard and assistive technology support",
        "Associates hint and validation text with the active input",
        "Announces changes to the selected file list",
        "Provides named remove buttons for every selected file"
    ];

    private string BasicCode => @"<FileUpload @bind-Files=""files"" Multiple=""false"" />

@code {
    private List<FileUpload.UploadedFile> files = [];
}";

    private string ValidationCode => @"<FileUpload @bind-Files=""files""
            Accept=""image/*,.pdf""
            MaxFileSize=""@(5 * 1024 * 1024)""
            MaxFiles=""3"" />";

    private string CallbackCode => @"<FileUpload @bind-Files=""files""
            OnFileAdded=""HandleFileAdded""
            OnFileRemoved=""HandleFileRemoved"" />

@code {
    private Task HandleFileAdded(FileUpload.UploadedFile file)
    {
        // Persist file.Data or hand it to an application service.
        return Task.CompletedTask;
    }

    private Task HandleFileRemoved(FileUpload.UploadedFile file)
    {
        return Task.CompletedTask;
    }
}";
}
