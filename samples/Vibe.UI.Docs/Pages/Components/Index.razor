    private static readonly IReadOnlySet<string> NewPages =
        new HashSet<string>(StringComparer.Ordinal) { "KanbanBoard" };

    private static readonly IReadOnlyList<CategoryInfo> Categories = BuildCategories();

    private string searchQuery = string.Empty;

    private bool MatchesSearch(ComponentInfo component)
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            return true;
        }

        return component.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
               component.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<CategoryInfo> FilteredCategories =>
        Categories.Where(c => c.Components.Any(comp => MatchesSearch(comp)));

    private static IReadOnlyList<CategoryInfo> BuildCategories()
    {
        var components = DiscoverComponents();

        return CategoryDefinitions
            .Select(definition => new CategoryInfo(
                definition.Name,
                definition.Description,
                components
                    .Where(component => component.Category == definition.Name)
                    .OrderBy(component => component.Name, StringComparer.OrdinalIgnoreCase)
                    .ToArray()))
            .Where(category => category.Components.Count > 0)
            .ToArray();
    }

    private static IReadOnlyList<ComponentInfo> DiscoverComponents()
    {
        return typeof(App).Assembly.ExportedTypes
            .Where(type => !type.IsAbstract && typeof(IComponent).IsAssignableFrom(type))
            .Select(type => new
            {
                PageType = type,
                Routes = type
                    .GetCustomAttributes<RouteAttribute>(inherit: false)
                    .Select(attribute => NormalizeRoute(attribute.Template))
                    .Where(route => route.StartsWith("/components/", StringComparison.OrdinalIgnoreCase))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToArray()
            })
            .Where(page => page.Routes.Length > 0)
            .Select(page =>
            {
                var pageKey = GetPageKey(page.PageType.Name);
                var displayName = SplitPascalCase(pageKey);
                var route = SelectCanonicalRoute(page.Routes, pageKey);
                var category = CategoryByPage.GetValueOrDefault(pageKey, "Other");
                var description = DescriptionByPage.GetValueOrDefault(
                    pageKey,
                    $"{displayName} examples, usage, and API reference.");

                return new ComponentInfo(
                    displayName,
                    route,
                    description,
                    category,
                    NewPages.Contains(pageKey));
            })
            .OrderBy(component => component.Name, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static string GetPageKey(string typeName)
    {
        if (typeName.EndsWith("View", StringComparison.Ordinal))
        {
            return typeName[..^"View".Length];
        }

        return typeName switch
        {
            "TreeViewer" => "TreeView",
            _ => typeName
        };
    }

    private static string SelectCanonicalRoute(IEnumerable<string> routes, string pageKey)
    {
        var routeList = routes.ToArray();
        var matchingRoute = routeList.FirstOrDefault(route =>
            NormalizeIdentifier(route[(route.LastIndexOf('/') + 1)..]) == NormalizeIdentifier(pageKey));

        return matchingRoute ?? routeList
            .OrderBy(route => route.Length)
            .ThenBy(route => route, StringComparer.OrdinalIgnoreCase)
            .First();
    }

    private static string NormalizeRoute(string route)
    {
        return route.StartsWith('/') ? route : $"/{route}";
    }

    private static string ToBaseRelativeRoute(string route) => route.TrimStart('/');

    private static string NormalizeIdentifier(string value)
    {
        return new string(value
            .Where(char.IsLetterOrDigit)
            .Select(char.ToLowerInvariant)
            .ToArray());
    }

    private static string SplitPascalCase(string value)
    {
        var acronymBoundary = Regex.Replace(value, "([A-Z]+)([A-Z][a-z])", "$1 $2");
        return Regex.Replace(acronymBoundary, "([a-z0-9])([A-Z])", "$1 $2");
    }

    private sealed record CategoryDefinition(string Name, string Description);

    private sealed record CategoryInfo(
        string Name,
        string Description,
        IReadOnlyList<ComponentInfo> Components);

    private sealed record ComponentInfo(
        string Name,
        string Route,
        string Description,
        string Category,
        bool IsNew);
}


