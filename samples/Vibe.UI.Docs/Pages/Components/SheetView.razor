@page "/components/sheet"
@using Vibe.UI.Components

<PageTitle>Sheet - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Components</a>
            <span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Sheet</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">Sheet</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            A modal panel that enters from an edge of the viewport.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-flex vibe-flex-wrap vibe-gap-3 vibe-p-4 sm:vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700">
            <Button OnClick="@(() => OpenSheet(Sheet.SheetSide.Right, Sheet.SheetSize.Default))">Open right sheet</Button>
            <Button OnClick="@(() => OpenSheet(Sheet.SheetSide.Bottom, Sheet.SheetSize.Medium))">Open bottom sheet</Button>
        </div>

        <Sheet @bind-IsOpen="isOpen"
               Side="sheetSide"
               Size="sheetSize"
               Title="Edit project"
               Description="Update the project details below.">
            <ChildContent>
                <div class="vibe-grid vibe-gap-4">
                    <div class="vibe-grid vibe-gap-2">
                        <label for="sheet-project-name" class="vibe-text-sm vibe-font-medium">Project name</label>
                        <input id="sheet-project-name"
                               class="vibe-h-10 vibe-w-full vibe-rounded-md vibe-border vibe-border-zinc-300 dark:vibe-border-zinc-700 vibe-bg-transparent vibe-px-3 vibe-text-sm"
                               value="Design system hardening" />
                    </div>
                    <div class="vibe-grid vibe-gap-2">
                        <label for="sheet-owner" class="vibe-text-sm vibe-font-medium">Owner</label>
                        <input id="sheet-owner"
                               class="vibe-h-10 vibe-w-full vibe-rounded-md vibe-border vibe-border-zinc-300 dark:vibe-border-zinc-700 vibe-bg-transparent vibe-px-3 vibe-text-sm"
                               value="Product platform" />
                    </div>
                </div>
            </ChildContent>
            <Footer>
                <Button OnClick="CloseSheet">Save changes</Button>
            </Footer>
        </Sheet>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Controlled sheet</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Bind <code>IsOpen</code> and provide a title for the modal dialog name.
            </p>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>
        <div class="vibe-overflow-x-auto">
            <table class="vibe-w-full vibe-text-sm">
                <thead>
                    <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Default</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</th>
                    </tr>
                </thead>
                <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                    @foreach (var property in Properties)
                    {
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">@property.Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">@property.Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">@property.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add sheet" Language="bash" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            @foreach (var item in AccessibilityItems)
            {
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" CssClass="vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" />
                    @item
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private bool isOpen;
    private Sheet.SheetSide sheetSide = Sheet.SheetSide.Right;
    private Sheet.SheetSize sheetSize = Sheet.SheetSize.Default;

    private static readonly (string Name, string Type, string Default, string Description)[] Properties =
    [
        ("IsOpen", "bool", "false", "Controls whether the sheet is rendered"),
        ("IsOpenChanged", "EventCallback<bool>", "-", "Raised when dismissal requests a closed state"),
        ("Title", "string?", "null", "Visible title and accessible dialog label"),
        ("Description", "string?", "null", "Visible description associated with the dialog"),
        ("ChildContent", "RenderFragment?", "null", "Scrollable sheet body"),
        ("Footer", "RenderFragment?", "null", "Footer action content"),
        ("Side", "SheetSide", "Right", "Top, Right, Bottom, or Left"),
        ("Size", "SheetSize", "Default", "Small, Default, Medium, Large, or Full"),
        ("ShowOverlay", "bool", "true", "Render the modal backdrop"),
        ("CloseOnOverlayClick", "bool", "true", "Dismiss after a backdrop click"),
        ("CloseOnEscape", "bool", "true", "Dismiss after Escape"),
        ("ShowCloseButton", "bool", "true", "Render the named close control")
    ];

    private static readonly string[] AccessibilityItems =
    [
        "Uses modal dialog semantics associated with the title and description",
        "Moves focus into the sheet and traps Tab navigation while open",
        "Locks background scrolling while the modal is active",
        "Returns focus to the opener after dismissal"
    ];

    private void OpenSheet(Sheet.SheetSide side, Sheet.SheetSize size)
    {
        sheetSide = side;
        sheetSize = size;
        isOpen = true;
    }

    private void CloseSheet() => isOpen = false;

    private string BasicCode => @"<Button OnClick=""@(() => isOpen = true)"">Open sheet</Button>

<Sheet @bind-IsOpen=""isOpen""
       Side=""Sheet.SheetSide.Right""
       Title=""Edit project""
       Description=""Update the project details below."">
    <ChildContent>
        <ProjectForm />
    </ChildContent>
    <Footer>
        <Button OnClick=""@(() => isOpen = false)"">Save changes</Button>
    </Footer>
</Sheet>";
}
