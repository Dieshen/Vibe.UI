@code {
    private string BasicCode => @"<DropdownMenu ContentStyle=""min-width: 12rem;"">
    <TriggerContent>
        Actions
        <Icon Name=""chevron-down"" Size=""16"" />
    </TriggerContent>
    <Content>
        <button type=""button"" class=""dropdown-item"" role=""menuitem"">Edit</button>
        <button type=""button"" class=""dropdown-item"" role=""menuitem"">Duplicate</button>
        <button type=""button"" class=""dropdown-item destructive"" role=""menuitem"">Delete</button>
    </Content>
</DropdownMenu>";

    private string IconsCode => @"<DropdownMenu ContentStyle=""min-width: 12rem;"">
    <TriggerContent>Options <Icon Name=""chevron-down"" Size=""16"" /></TriggerContent>
    <Content>
        <button type=""button"" class=""dropdown-item"" role=""menuitem"">
            <Icon Name=""edit"" Size=""16"" /> Edit
        </button>
        <button type=""button"" class=""dropdown-item"" role=""menuitem"">
            <Icon Name=""copy"" Size=""16"" /> Copy
        </button>
        <button type=""button"" class=""dropdown-item destructive"" role=""menuitem"">
            <Icon Name=""trash"" Size=""16"" /> Delete
        </button>
    </Content>
</DropdownMenu>";

    private string PlacementCode => @"<DropdownMenu Position=""bottom"" Align=""end"">
    <TriggerContent>Bottom end</TriggerContent>
    <Content>
        <button type=""button"" class=""dropdown-item"" role=""menuitem"">Item 1</button>
        <button type=""button"" class=""dropdown-item"" role=""menuitem"">Item 2</button>
    </Content>
</DropdownMenu>";

    private string SectionsCode => @"<DropdownMenu ContentStyle=""min-width: 12rem;"">
    <TriggerContent>Menu <Icon Name=""chevron-down"" Size=""16"" /></TriggerContent>
    <Content>
        <div class=""dropdown-label"">Actions</div>
        <button type=""button"" class=""dropdown-item"" role=""menuitem"">New file</button>
        <button type=""button"" class=""dropdown-item"" role=""menuitem"">Open file</button>
        <div class=""dropdown-separator"" role=""separator""></div>
        <div class=""dropdown-label"">Edit</div>
        <button type=""button"" class=""dropdown-item"" role=""menuitem"">Cut</button>
        <button type=""button"" class=""dropdown-item"" role=""menuitem"">Copy</button>
        <button type=""button"" class=""dropdown-item"" role=""menuitem"">Paste</button>
    </Content>
</DropdownMenu>";
}


