@page "/components/kanbanboard"
@using Vibe.UI.Components
@using static Vibe.UI.Components.KanbanBoard

<PageTitle>KanbanBoard - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Components</a>
            <span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">KanbanBoard</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">KanbanBoard</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            Organize cards into columns with pointer and keyboard movement.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700">
            <KanbanBoard Columns="kanbanColumns"
                         AllowAddCard="false"
                         OnCardMoved="HandleCardMoved" />
            <p class="vibe-mt-3 vibe-text-sm vibe-text-zinc-500" aria-live="polite">@moveStatus</p>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Columns and cards</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Cards belong to the <code>Cards</code> list on each column.
            </p>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>

        <div>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Card template</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Replace the card contents while the board retains interaction and focus behavior.
            </p>
            <CodeBlock Code="@TemplateCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-4">Properties</h3>
            <div class="vibe-overflow-x-auto">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Default</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                        @foreach (var property in Properties)
                        {
                            <tr>
                                <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">@property.Name</td>
                                <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                                <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">@property.Default</td>
                                <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">@property.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-4">Events</h3>
            <div class="vibe-overflow-x-auto">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                        @foreach (var eventInfo in Events)
                        {
                            <tr>
                                <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">@eventInfo.Name</td>
                                <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@eventInfo.Type" /></td>
                                <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">@eventInfo.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add kanbanboard" Language="bash" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            @foreach (var item in AccessibilityItems)
            {
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" CssClass="vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" />
                    @item
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private string moveStatus = "Move a card to see the updated column.";

    private readonly List<KanbanColumn> kanbanColumns =
    [
        new()
        {
            Id = "backlog",
            Title = "Backlog",
            Cards =
            [
                new() { Id = "inventory", Title = "Map component inventory", Description = "Audit current visual states", Tags = ["Design system"] },
                new() { Id = "docs", Title = "Correct API examples", Description = "Remove stale public contracts", Tags = ["Docs"] }
            ]
        },
        new()
        {
            Id = "active",
            Title = "In progress",
            Cards =
            [
                new() { Id = "mobile", Title = "Mobile interaction pass", Description = "Verify touch-sized controls", Tags = ["UX"] }
            ]
        },
        new()
        {
            Id = "done",
            Title = "Done",
            Cards =
            [
                new() { Id = "tokens", Title = "Normalize theme tokens", Description = "Align light and dark surfaces", Tags = ["CSS"] }
            ]
        }
    ];

    private static readonly (string Name, string Type, string Default, string Description)[] Properties =
    [
        ("Columns", "List<KanbanColumn>?", "null", "Columns and their card lists"),
        ("CardTemplate", "RenderFragment<KanbanCard>?", "null", "Custom card contents"),
        ("ColumnHeaderTemplate", "RenderFragment<KanbanColumn>?", "null", "Custom column header contents"),
        ("EmptyContent", "RenderFragment?", "null", "Custom board-level empty state"),
        ("AllowDragDrop", "bool", "true", "Enable pointer and keyboard card movement"),
        ("AllowAddCard", "bool", "true", "Render add buttons in default headers"),
        ("Disabled", "bool", "false", "Block all interactions"),
        ("ReadOnly", "bool", "false", "Show content while blocking edits and clicks"),
        ("AriaLabel", "string", "Kanban board", "Accessible board name"),
        ("EmptyText", "string", "No columns", "Board-level empty text"),
        ("EmptyColumnText", "string", "No cards", "Column-level empty text"),
        ("CssClass", "string?", "null", "Additional component class")
    ];

    private static readonly (string Name, string Type, string Description)[] Events =
    [
        ("OnCardMoved", "EventCallback<CardMovedEventArgs>", "Raised after a card moves between columns"),
        ("OnCardClicked", "EventCallback<KanbanCard>", "Raised for pointer or keyboard card activation"),
        ("OnAddCardRequested", "EventCallback<string>", "Raised with the target column ID")
    ];

    private static readonly string[] AccessibilityItems =
    [
        "Exposes the board, columns, and card groups with list semantics",
        "Moves a focused card with Control+ArrowLeft or Control+ArrowRight",
        "Activates clickable cards with Enter or Space",
        "Provides a distinct focus ring, drag state, and drop-target state"
    ];

    private Task HandleCardMoved(CardMovedEventArgs args)
    {
        moveStatus = $"Moved {args.Card.Title} from {args.FromColumnId} to {args.ToColumnId}.";
        return Task.CompletedTask;
    }

    private string BasicCode => @"<KanbanBoard Columns=""columns""
             AllowAddCard=""false""
             OnCardMoved=""HandleCardMoved"" />

@code {
    private List<KanbanBoard.KanbanColumn> columns =
    [
        new()
        {
            Id = ""todo"",
            Title = ""To do"",
            Cards = [new() { Id = ""task-1"", Title = ""Review pull request"" }]
        },
        new() { Id = ""done"", Title = ""Done"" }
    ];

    private Task HandleCardMoved(KanbanBoard.CardMovedEventArgs args)
    {
        return SaveStatusAsync(args.Card.Id, args.ToColumnId);
    }
}";

    private string TemplateCode => @"<KanbanBoard Columns=""columns"">
    <CardTemplate Context=""card"">
        <h4>@card.Title</h4>
        <p>@card.Description</p>
        <Badge>@card.Tags?.FirstOrDefault()</Badge>
    </CardTemplate>
</KanbanBoard>";
}
