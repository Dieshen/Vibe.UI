@page "/components/avatar"
@using Vibe.UI.Components

<PageTitle>Avatar - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <!-- Header -->
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Components</a>
            <span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Avatar</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">Avatar</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            An image element with fallback for displaying user profile pictures or identifiers.
        </p>
    </header>

    <!-- Preview -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-flex vibe-items-center vibe-gap-4 vibe-flex-wrap vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700">
            <Avatar ImageUrl="logo.png" Alt="Vibe.UI" Size="40" />
            <Avatar Initials="JD" Alt="Jordan Diaz" Size="40" />
            <Avatar Initials="AS" Alt="Avery Singh" Size="48" />
            <Avatar Initials="MK" Alt="Morgan Kim" Size="56" />
            <Avatar Alt="Default profile" Size="48">
                <FallbackContent>
                    <Vibe.UI.Components.Icon Name="user" Size="20" />
                </FallbackContent>
            </Avatar>
            <Avatar ImageUrl="favicon.png" Alt="Square Vibe.UI avatar" Shape="square" Size="48" />
        </div>
    </section>

    <!-- Examples Section -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>

        <!-- Basic Usage -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Basic Usage</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Display a user avatar with an image source.
            </p>
            <div class="vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 vibe-mb-3">
                <Avatar ImageUrl="logo.png" Alt="Vibe.UI profile" />
            </div>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>

        <!-- Sizes -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Sizes</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Avatars come in multiple sizes to fit different contexts.
            </p>
            <div class="vibe-flex vibe-items-center vibe-gap-4 vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 vibe-mb-3">
                <Avatar Size="24" Initials="CN" Alt="Casey Nguyen" />
                <Avatar Size="32" Initials="JD" Alt="Jordan Diaz" />
                <Avatar Size="48" Initials="AS" Alt="Avery Singh" />
                <Avatar Size="64" Initials="MK" Alt="Morgan Kim" />
            </div>
            <CodeBlock Code="@SizesCode" Language="razor" />
        </div>

        <!-- With Initials Fallback -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">With Initials Fallback</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Display user initials when no image is available.
            </p>
            <div class="vibe-flex vibe-items-center vibe-gap-4 vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 vibe-mb-3">
                <Avatar Initials="JD" />
                <Avatar Initials="AS" />
                <Avatar Initials="MK" />
            </div>
            <CodeBlock Code="@InitialsCode" Language="razor" />
        </div>

        <!-- With Icon Fallback -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">With Icon Fallback</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Use an icon as fallback content when no image or initials are provided.
            </p>
            <div class="vibe-flex vibe-items-center vibe-gap-4 vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 vibe-mb-3">
                <Avatar Alt="Default profile">
                    <FallbackContent>
                        <Vibe.UI.Components.Icon Name="user" Size="18" />
                    </FallbackContent>
                </Avatar>
            </div>
            <CodeBlock Code="@IconCode" Language="razor" />
        </div>

        <!-- Avatar Group -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Avatar Group</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Group multiple avatars together with a maximum display count.
            </p>
            <div class="vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 vibe-mb-3">
                <div class="vibe-flex vibe-items-center vibe-gap-2" role="group" aria-label="Release team">
                    <Avatar ImageUrl="logo.png" Alt="Vibe.UI" />
                    <Avatar Initials="JD" Alt="Jordan Diaz" />
                    <Avatar Initials="AS" Alt="Avery Singh" />
                    <Avatar Initials="MK" Alt="Morgan Kim" />
                </div>
            </div>
            <CodeBlock Code="@GroupCode" Language="razor" />
        </div>
    </section>

    <!-- API Reference -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>

        <!-- Properties -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-4">Properties</h3>
            <div class="vibe-overflow-x-auto">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Default</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">ImageUrl</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Image source URL</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Alt</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Accessible name for the avatar</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Size</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="int" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">40</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Avatar width and height in pixels</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Initials</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Initials to display if image fails to load</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Shape</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">"circle"</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Avatar shape: circle or square</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">FallbackContent</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="RenderFragment" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Custom fallback rendered after image and initials</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Installation -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
            Install the Avatar component using the Vibe.UI CLI:
        </p>
        <CodeBlock Code="vibe add avatar" Language="bash" />
    </section>

    <!-- Accessibility -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <div class="vibe-prose dark:vibe-prose-invert vibe-max-w-none">
            <ul class="vibe-space-y-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                    The root uses <code class="vibe-text-sm vibe-bg-zinc-100 dark:vibe-bg-zinc-800 vibe-px-1 vibe-py-0.5 vibe-rounded">role="img"</code> with a name from Alt or Initials
                </li>
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                    The nested image and visual fallback are decorative so the accessible name is announced once
                </li>
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                    Failed image loads automatically switch to initials, custom fallback content, or the empty state
                </li>
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                    Caller-provided aria-label, aria-labelledby, and role attributes are preserved
                </li>
            </ul>
        </div>
    </section>

    <!-- Related Components -->
    <section>
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Related</h2>
        <div class="vibe-grid vibe-grid-cols-1 sm:vibe-grid-cols-3 vibe-gap-4">
            <a href="components/badge" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 hover:vibe-border-brand-teal dark:hover:vibe-border-brand-teal vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100 group-hover:vibe-text-brand-teal">Badge</h4>
                <p class="vibe-text-sm vibe-text-zinc-500">Status and notification badges</p>
            </a>
            <a href="components/card" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 hover:vibe-border-brand-teal dark:hover:vibe-border-brand-teal vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100 group-hover:vibe-text-brand-teal">Card</h4>
                <p class="vibe-text-sm vibe-text-zinc-500">Container for content and actions</p>
            </a>
            </div>
    </section>
</div>

@code {
    private string BasicCode => @"<Avatar ImageUrl=""logo.png"" Alt=""Vibe.UI profile"" />";

    private string SizesCode => @"<Avatar Size=""24"" Initials=""CN"" Alt=""Casey Nguyen"" />
<Avatar Size=""32"" Initials=""JD"" Alt=""Jordan Diaz"" />
<Avatar Size=""48"" Initials=""AS"" Alt=""Avery Singh"" />
<Avatar Size=""64"" Initials=""MK"" Alt=""Morgan Kim"" />";

    private string InitialsCode => @"<Avatar Initials=""JD"" />
<Avatar Initials=""AS"" />
<Avatar Initials=""MK"" />";

    private string IconCode => @"<Avatar Alt=""Default profile"">
    <FallbackContent>
        <Vibe.UI.Components.Icon Name=""user"" Size=""18"" />
    </FallbackContent>
</Avatar>";

    private string GroupCode => @"<div class=""vibe-flex vibe-items-center vibe-gap-2"" role=""group"" aria-label=""Release team"">
    <Avatar ImageUrl=""logo.png"" Alt=""Vibe.UI"" />
    <Avatar Initials=""JD"" Alt=""Jordan Diaz"" />
    <Avatar Initials=""AS"" Alt=""Avery Singh"" />
    <Avatar Initials=""MK"" Alt=""Morgan Kim"" />
</div>";
}


