@page "/components/switch"

<PageTitle>Switch - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <!-- Header -->
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Components</a>
            <span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Switch</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">Switch</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            A toggle switch control for on/off or true/false values with smooth animations.
        </p>
    </header>

    <!-- Preview -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-p-6 vibe-rounded-xl vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-800 vibe-bg-white dark:vibe-bg-zinc-900">
            <div class="vibe-space-y-4 vibe-max-w-md">
                <div class="vibe-flex vibe-items-center vibe-justify-between">
                    <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Default (off)</span>
                    <Switch Label="Default off" />
                </div>
                <div class="vibe-flex vibe-items-center vibe-justify-between">
                    <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Default (on)</span>
                    <Switch Label="Default on" Checked="true" />
                </div>
                <div class="vibe-flex vibe-items-center vibe-justify-between">
                    <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Enable notifications</span>
                    <Switch Label="Enable notifications" Checked="@notificationsEnabled" CheckedChanged="@OnNotificationsChanged" />
                </div>
                @if (notificationsEnabled)
                {
                    <div class="vibe-flex vibe-justify-end">
                        <Badge Variant="success"><Vibe.UI.Components.Icon Name="check" />Notifications enabled</Badge>
                    </div>
                }
                <div class="vibe-flex vibe-items-center vibe-justify-between">
                    <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Dark mode</span>
                    <Switch Label="Dark mode" Checked="@darkModeEnabled" CheckedChanged="@((bool val) => darkModeEnabled = val)" />
                </div>
                <div class="vibe-flex vibe-items-center vibe-justify-between vibe-opacity-50">
                    <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Disabled (off)</span>
                    <Switch Label="Disabled off" Disabled="true" />
                </div>
                <div class="vibe-flex vibe-items-center vibe-justify-between vibe-opacity-50">
                    <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Disabled (on)</span>
                    <Switch Label="Disabled on" Checked="true" Disabled="true" />
                </div>
            </div>
        </div>
    </section>

    <!-- Examples Section -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>

        <!-- Basic Usage -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Basic Usage</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Simple toggle switch with on and off states.
            </p>
            <div class="vibe-flex vibe-items-center vibe-gap-4 vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 vibe-mb-3">
                <Switch Label="Feature disabled" />
                <Switch Label="Feature enabled" Checked="true" />
            </div>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>

        <!-- With Label -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">With Label</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Add a label to provide context for the switch control.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 vibe-mb-3">
                <div class="vibe-flex vibe-items-center vibe-justify-between vibe-max-w-md">
                    <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Enable notifications</span>
                    <Switch Label="Enable notifications" />
                </div>
                <div class="vibe-flex vibe-items-center vibe-justify-between vibe-max-w-md">
                    <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Dark mode</span>
                    <Switch Label="Dark mode" Checked="true" />
                </div>
            </div>
            <CodeBlock Code="@LabelCode" Language="razor" />
        </div>

        <!-- Sizes -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Sizes</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Available in three sizes to fit different layouts and use cases.
            </p>
            <div class="vibe-flex vibe-items-center vibe-gap-6 vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 vibe-mb-3">
                <div class="vibe-flex vibe-flex-col vibe-items-center vibe-gap-2">
                    <Switch Size="sm" Label="Small switch" Checked="true" />
                    <span class="vibe-text-xs vibe-text-zinc-500">Small</span>
                </div>
                <div class="vibe-flex vibe-flex-col vibe-items-center vibe-gap-2">
                    <Switch Label="Default switch" Checked="true" />
                    <span class="vibe-text-xs vibe-text-zinc-500">Medium</span>
                </div>
                <div class="vibe-flex vibe-flex-col vibe-items-center vibe-gap-2">
                    <Switch Size="lg" Label="Large switch" Checked="true" />
                    <span class="vibe-text-xs vibe-text-zinc-500">Large</span>
                </div>
            </div>
            <CodeBlock Code="@SizesCode" Language="razor" />
        </div>

        <!-- Disabled State -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Disabled State</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Prevent user interaction with the disabled state.
            </p>
            <div class="vibe-flex vibe-items-center vibe-gap-4 vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 vibe-mb-3">
                <Switch Label="Disabled off" Disabled="true" />
                <Switch Label="Disabled on" Checked="true" Disabled="true" />
            </div>
            <CodeBlock Code="@DisabledCode" Language="razor" />
        </div>

        <!-- With Change Handler -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">With Change Handler</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Handle switch state changes with event callbacks to implement custom logic.
            </p>
            <CodeBlock Code="@ChangeHandlerCode" Language="razor" />
        </div>
    </section>

    <!-- API Reference -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>

        <!-- Properties -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-4">Properties</h3>
            <div class="vibe-overflow-x-auto">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Default</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Checked</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">false</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Whether the switch is checked</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Disabled</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">false</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Whether the switch is disabled</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Label</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Label text for the switch</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">AriaLabel</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Accessible name that takes precedence over Label</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Size</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">"default"</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Switch size: sm, default, or lg</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Name attribute of the input</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Events -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-4">Events</h3>
            <div class="vibe-overflow-x-auto">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">CheckedChanged</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="EventCallback<bool>" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">Callback when checked state changes</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Installation -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
            Install the Switch component using the Vibe.UI CLI:
        </p>
        <CodeBlock Code="vibe add switch" Language="bash" />
    </section>

    <!-- Accessibility -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Uses semantic switch role with proper ARIA attributes
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Keyboard accessible (Space to toggle)
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Label or AriaLabel provides the switch's accessible name
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Focus visible styles for keyboard navigation
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Screen reader announces state changes
            </li>
        </ul>
    </section>

    <!-- Related Components -->
    <section>
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Related</h2>
        <div class="vibe-grid vibe-grid-cols-1 sm:vibe-grid-cols-3 vibe-gap-4">
            <a href="components/checkbox" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 hover:vibe-border-brand-teal dark:hover:vibe-border-brand-teal vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100 group-hover:vibe-text-brand-teal">Checkbox</h4>
                <p class="vibe-text-sm vibe-text-zinc-500">Multiple selection control</p>
            </a>
            <a href="components/radiogroup" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 hover:vibe-border-brand-teal dark:hover:vibe-border-brand-teal vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100 group-hover:vibe-text-brand-teal">Radio Group</h4>
                <p class="vibe-text-sm vibe-text-zinc-500">Single selection from options</p>
            </a>
            </div>
    </section>
</div>

@code {
    private bool notificationsEnabled = false;
    private bool darkModeEnabled = false;

    private void OnNotificationsChanged(bool value)
    {
        notificationsEnabled = value;
    }

    private string BasicCode => @"<Switch Label=""Feature disabled"" />
<Switch Label=""Feature enabled"" Checked=""true"" />";

    private string LabelCode => @"<Switch Label=""Enable notifications"" />
<Switch Label=""Dark mode"" Checked=""true"" />";

    private string SizesCode => @"<Switch Size=""sm"" Label=""Small switch"" />
<Switch Label=""Default switch"" />
<Switch Size=""lg"" Label=""Large switch"" />";

    private string DisabledCode => @"<Switch Label=""Disabled off"" Disabled=""true"" />
<Switch Label=""Disabled on"" Checked=""true"" Disabled=""true"" />";

    private string ChangeHandlerCode => @"<Switch Label=""Notifications"" @bind-Checked=""@notificationsEnabled"" />
<p>Notifications: @(notificationsEnabled ? ""Enabled"" : ""Disabled"")</p>

@code {
    private bool notificationsEnabled = false;
}";
}


