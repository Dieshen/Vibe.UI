@page "/components/select"
@using Vibe.UI.Components

<PageTitle>Select - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./">Docs</a><span>/</span><a href="components">Components</a><span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Select</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">Select</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            A styled native select for choosing one value from a fixed set of options.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700">
            <div class="vibe-max-w-md">
                <Select Id="country"
                        Label="Country"
                        Placeholder="Choose a country"
                        HelperText="Used for billing and regional settings"
                        @bind-Value="selectedCountry">
                    <option value="us">United States</option>
                    <option value="ca">Canada</option>
                    <option value="gb">United Kingdom</option>
                </Select>
                <output class="vibe-block vibe-mt-3 vibe-text-sm vibe-text-zinc-500">
                    Selected: @(string.IsNullOrEmpty(selectedCountry) ? "None" : selectedCountry)
                </output>
            </div>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Bound value</h3>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>
        <div>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Inside FormField</h3>
            <CodeBlock Code="@FormFieldCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>
        <div class="vibe-overflow-x-auto">
            <table class="vibe-w-full vibe-text-sm">
                <thead><tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Name</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Type</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Default</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Description</th>
                </tr></thead>
                <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                    @foreach (var property in Properties)
                    {
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono">@property.Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">@property.Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">@property.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add select" Language="bash" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            @foreach (var item in AccessibilityItems)
            {
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Icon Name="check-circle" Size="20" CssClass="vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" />
                    @item
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private string? selectedCountry;

    private static readonly (string Name, string Type, string Default, string Description)[] Properties =
    [
        ("Id", "string?", "generated", "ID for the native select and label"),
        ("Label", "string?", "null", "Optional floating label"),
        ("Placeholder", "string?", "null", "Disabled empty option shown before selection"),
        ("HelperText", "string?", "null", "Visible help linked with aria-describedby"),
        ("Disabled", "bool", "false", "Disable selection"),
        ("Value", "string?", "null", "Current selected value; supports @bind-Value"),
        ("ValueChanged", "EventCallback<string?>", "none", "Called when the value changes"),
        ("OnChange", "EventCallback<ChangeEventArgs>", "none", "Called with the native change event"),
        ("ChildContent", "RenderFragment?", "null", "Native option and optgroup elements")
    ];

    private static readonly string[] AccessibilityItems =
    [
        "Uses native select keyboard and screen-reader behavior",
        "Associates the optional label with the select ID",
        "Links helper, FormField description, and validation messages to the control",
        "Uses the shared focus ring without changing control dimensions"
    ];

    private string BasicCode => @"<Select Id=""country"" Label=""Country"" Placeholder=""Choose a country"" @bind-Value=""selectedCountry"">
    <option value=""us"">United States</option>
    <option value=""ca"">Canada</option>
</Select>";

    private string FormFieldCode => @"<FormField TValue=""string"" Id=""country"" Label=""Country"" Description=""Used for billing"" Required=""true"">
    <Select @bind-Value=""model.Country"">
        <option value=""us"">United States</option>
        <option value=""ca"">Canada</option>
    </Select>
</FormField>";
}
