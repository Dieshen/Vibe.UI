@code {
    private string BasicCode => @"<Popover AriaLabel=""Quick actions"">
    <TriggerContent>
        Open popover
        <Icon Name=""chevron-down"" Size=""16"" />
    </TriggerContent>
    <Content>
        <h4>Quick actions</h4>
        <p>This is the popover content.</p>
    </Content>
</Popover>";

    private string PlacementCode => @"<Popover Position=""top"" Align=""start"">
    <TriggerContent>Top start</TriggerContent>
    <Content><p>Top placement</p></Content>
</Popover>

<Popover Position=""bottom"" Align=""end"">
    <TriggerContent>Bottom end</TriggerContent>
    <Content><p>Bottom placement</p></Content>
</Popover>";

    private string ControlledCode => @"<Popover @bind-IsOpen=""isOpen"">
    <TriggerContent>Toggle details</TriggerContent>
    <Content><p>Controlled popover content.</p></Content>
</Popover>

@code {
    private bool isOpen;
}";

    private string DisabledCode => @"<Popover Disabled=""true"">
    <TriggerContent>Unavailable</TriggerContent>
    <Content><p>This content cannot be opened.</p></Content>
</Popover>";
}


