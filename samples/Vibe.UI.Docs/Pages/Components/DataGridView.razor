@page "/components/datatable"
@page "/components/datagrid"
@using Vibe.UI.Components

<PageTitle>DataTable - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Components</a>
            <span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">DataTable</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">DataTable</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            A searchable, sortable, and paginated table with templated cells and accessible overflow behavior.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700">
            <DataTable TItem="ProductData"
                       Items="@SampleProducts"
                       Columns="@ProductColumns"
                       Caption="Product inventory"
                       SearchLabel="Search products"
                       SearchPlaceholder="Search products..."
                       PageSize="5" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Basic table</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Define columns in code and pass a concrete list of items.
            </p>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Search and pagination</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Search checks the string value of each configured property. Pagination is managed by the table.
            </p>
            <CodeBlock Code="@SearchCode" Language="razor" />
        </div>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Templated cells</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Supply a column template when a property needs custom formatting or composed content.
            </p>
            <CodeBlock Code="@TemplateCode" Language="razor" />
        </div>

        <div>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Custom toolbar content</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Add content beside the built-in search field with the named toolbar fragment.
            </p>
            <CodeBlock Code="@ToolbarCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-4">DataTable parameters</h3>
            <div class="vibe-overflow-x-auto">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Default</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                        @foreach (var row in ParameterRows)
                        {
                            <tr>
                                <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-zinc-900 dark:vibe-text-zinc-100">@row.Name</td>
                                <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@row.Type" /></td>
                                <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">@row.DefaultValue</td>
                                <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">@row.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-4">DataTableColumn properties</h3>
            <div class="vibe-overflow-x-auto">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Default</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                        @foreach (var row in ColumnRows)
                        {
                            <tr>
                                <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-zinc-900 dark:vibe-text-zinc-100">@row.Name</td>
                                <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@row.Type" /></td>
                                <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">@row.DefaultValue</td>
                                <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">@row.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <ul class="vibe-flex vibe-flex-col vibe-gap-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            <li>Uses native table, header, row, and cell semantics.</li>
            <li>Supports a visible <code>Caption</code> or an accessible <code>AriaLabel</code>.</li>
            <li>Exposes sortable headers as buttons with <code>aria-sort</code> state.</li>
            <li>Makes the labeled horizontal overflow region keyboard focusable.</li>
            <li>Announces filtered result counts and labels the pagination navigation.</li>
        </ul>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add datatable" Language="bash" />
    </section>

    <section>
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Related</h2>
        <div class="vibe-grid vibe-grid-cols-1 sm:vibe-grid-cols-3 vibe-gap-4">
            <a href="components/table" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 hover:vibe-border-brand-teal dark:hover:vibe-border-brand-teal vibe-transition-colors">
                <h3 class="vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100 group-hover:vibe-text-brand-teal">Table</h3>
                <p class="vibe-text-sm vibe-text-zinc-500">Composable semantic tables</p>
            </a>
            <a href="components/pagination" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 hover:vibe-border-brand-teal dark:hover:vibe-border-brand-teal vibe-transition-colors">
                <h3 class="vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100 group-hover:vibe-text-brand-teal">Pagination</h3>
                <p class="vibe-text-sm vibe-text-zinc-500">Standalone page navigation</p>
            </a>
            <a href="components/virtualscroll" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700 hover:vibe-border-brand-teal dark:hover:vibe-border-brand-teal vibe-transition-colors">
                <h3 class="vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100 group-hover:vibe-text-brand-teal">VirtualScroll</h3>
                <p class="vibe-text-sm vibe-text-zinc-500">Large virtualized collections</p>
            </a>
        </div>
    </section>
</div>

@code {
    private sealed record ProductData(string Name, decimal Price, int Stock, string Category);

    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);

    private static readonly List<ProductData> SampleProducts =
    [
        new("Laptop Pro", 1299.99m, 15, "Electronics"),
        new("Wireless Mouse", 29.99m, 87, "Accessories"),
        new("Mechanical Keyboard", 89.99m, 42, "Accessories"),
        new("USB-C Hub", 49.99m, 63, "Accessories"),
        new("27-inch Monitor", 399.99m, 28, "Electronics"),
        new("HD Webcam", 79.99m, 54, "Electronics"),
        new("Desk Lamp", 34.99m, 96, "Office"),
        new("Office Chair", 249.99m, 12, "Furniture")
    ];

    private static readonly List<DataTable<ProductData>.DataTableColumn<ProductData>> ProductColumns =
    [
        new() { Title = "Product", PropertyName = nameof(ProductData.Name) },
        new()
        {
            Title = "Price",
            PropertyName = nameof(ProductData.Price),
            Template = product => @<text>@product.Price.ToString("C")</text>
        },
        new() { Title = "Stock", PropertyName = nameof(ProductData.Stock) },
        new() { Title = "Category", PropertyName = nameof(ProductData.Category) }
    ];

    private static readonly ApiRow[] ParameterRows =
    [
        new("Items", "List<TItem>", "empty", "Items displayed by the table."),
        new("Columns", "List<DataTableColumn<TItem>>", "empty", "Column definitions used for headers, values, sorting, and templates."),
        new("ToolbarContent", "RenderFragment?", "null", "Optional content rendered beside the search field."),
        new("ShowToolbar", "bool", "true", "Shows or hides the toolbar."),
        new("ShowSearch", "bool", "true", "Shows or hides the search input within the toolbar."),
        new("SearchPlaceholder", "string", "Search...", "Placeholder displayed in the search input."),
        new("SearchLabel", "string", "Search table", "Accessible label for the search input."),
        new("Caption", "string?", "null", "Visible caption that names the table."),
        new("AriaLabel", "string?", "null", "Accessible table name used when Caption is not set."),
        new("ShowPagination", "bool", "true", "Shows pagination and limits rendered rows to the current page."),
        new("PageSize", "int", "10", "Rows per page. Values below one are treated as one."),
        new("EmptyMessage", "string", "No data available", "Message shown when no rows match."),
        new("RowClass", "Func<TItem, string>?", "null", "Returns an optional CSS class for each row.")
    ];

    private static readonly ApiRow[] ColumnRows =
    [
        new("Title", "string", "empty", "Text displayed in the column header."),
        new("PropertyName", "string", "empty", "Public property used for display, search, and sorting."),
        new("IsSortable", "bool", "true", "Renders the header as a sortable button."),
        new("Template", "RenderFragment<TItem>?", "null", "Optional cell template for custom rendering.")
    ];

    private const string BasicCode = """
<DataTable TItem="Product"
           Items="@products"
           Columns="@columns"
           Caption="Product inventory" />

@code {
    private readonly List<DataTable<Product>.DataTableColumn<Product>> columns =
    [
        new() { Title = "Product", PropertyName = nameof(Product.Name) },
        new() { Title = "Price", PropertyName = nameof(Product.Price) }
    ];
}
""";

    private const string SearchCode = """
<DataTable TItem="Product"
           Items="@products"
           Columns="@columns"
           SearchLabel="Search products"
           SearchPlaceholder="Search products..."
           ShowSearch="true"
           ShowPagination="true"
           PageSize="20" />
""";

    private const string TemplateCode = """
private readonly List<DataTable<Product>.DataTableColumn<Product>> columns =
[
    new() { Title = "Product", PropertyName = nameof(Product.Name) },
    new()
    {
        Title = "Price",
        PropertyName = nameof(Product.Price),
        Template = product => @<span>@product.Price.ToString("C")</span>
    }
];
""";

    private const string ToolbarCode = """
<DataTable TItem="Product" Items="@products" Columns="@columns">
    <ToolbarContent>
        <Button Variant="ButtonVariant.Outline" OnClick="ExportProducts">
            Export
        </Button>
    </ToolbarContent>
</DataTable>
""";
}
