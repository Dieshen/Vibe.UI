@page "/components/confetti"
@using Vibe.UI.Components

<PageTitle>Confetti - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-zinc-700 dark:hover:vibe-text-zinc-300">Components</a>
            <span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Confetti</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">Confetti</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            A canvas-based celebration effect for successful moments.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-flex vibe-items-center vibe-justify-between vibe-gap-4 vibe-p-4 sm:vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700">
            <div>
                <h3 class="vibe-font-semibold">Release published</h3>
                <p class="vibe-text-sm vibe-text-zinc-500">Mark the successful action without blocking the interface.</p>
            </div>
            <Button OnClick="TriggerConfetti">Celebrate</Button>
            <Confetti @ref="previewConfetti"
                      ParticleCount="90"
                      Duration="1800"
                      OnComplete="HandleComplete" />
        </div>
        <p class="vibe-mt-3 vibe-text-sm vibe-text-zinc-500" aria-live="polite">@statusText</p>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Imperative trigger</h3>
            <p class="vibe-text-zinc-600 dark:vibe-text-zinc-400 vibe-mb-4">
                Keep a component reference and trigger the effect after a confirmed success.
            </p>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>
        <div class="vibe-overflow-x-auto">
            <table class="vibe-w-full vibe-text-sm">
                <thead>
                    <tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Name</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Type</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Default</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-zinc-900 dark:vibe-text-zinc-100">Description</th>
                    </tr>
                </thead>
                <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                    @foreach (var property in Properties)
                    {
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-zinc-900 dark:vibe-text-zinc-100">@property.Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">@property.Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">@property.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add confetti" Language="bash" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            @foreach (var item in AccessibilityItems)
            {
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" CssClass="vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" />
                    @item
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private Confetti? previewConfetti;
    private string statusText = "Ready to celebrate.";

    private static readonly (string Name, string Type, string Default, string Description)[] Properties =
    [
        ("Active", "bool", "false", "Triggers on a false-to-true parameter transition"),
        ("ParticleCount", "int", "50", "Number of canvas particles, clamped to 500"),
        ("Duration", "int", "3000", "Approximate effect duration in milliseconds"),
        ("Colors", "List<string>", "8 colors", "Validated CSS color values"),
        ("Origin", "ConfettiOrigin", "Center", "Viewport launch origin"),
        ("Pattern", "ConfettiPattern", "Explosion", "Explosion, Fountain, Rain, or Fireworks"),
        ("OnComplete", "EventCallback", "-", "Raised after the effect completes"),
        ("Announce", "bool", "false", "Expose a polite status region when the effect has meaning"),
        ("AriaLabel", "string?", "Celebration", "Status text used when Announce is true"),
        ("CssClass", "string?", "null", "Additional component class")
    ];

    private static readonly string[] AccessibilityItems =
    [
        "Remains decorative and hidden from assistive technology by default",
        "Supports an opt-in polite announcement for meaningful completion states",
        "Disables particle animation when the user prefers reduced motion",
        "Uses a pointer-events-none canvas so the effect never blocks controls"
    ];

    private async Task TriggerConfetti()
    {
        statusText = "Celebrating...";
        if (previewConfetti is not null)
        {
            await previewConfetti.Trigger();
        }
    }

    private void HandleComplete() => statusText = "Celebration complete.";

    private string BasicCode => @"<Button OnClick=""Publish"">Publish</Button>
<Confetti @ref=""confetti"" ParticleCount=""80"" Duration=""1800"" />

@code {
    private Confetti? confetti;

    private async Task Publish()
    {
        await ReleaseService.PublishAsync();
        if (confetti is not null)
        {
            await confetti.Trigger();
        }
    }
}";
}
