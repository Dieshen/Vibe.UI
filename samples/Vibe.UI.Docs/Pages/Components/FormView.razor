@page "/components/form"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Vibe.UI.Components

<PageTitle>Form - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-zinc-500 vibe-mb-2">
            <a href="./">Docs</a><span>/</span><a href="components">Components</a><span>/</span>
            <span class="vibe-text-zinc-900 dark:vibe-text-zinc-100">Form</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-3">Form</h1>
        <p class="vibe-text-lg vibe-text-zinc-600 dark:vibe-text-zinc-400">
            A typed EditForm wrapper with data-annotation validation and explicit valid and invalid submit callbacks.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Preview</h2>
        <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-zinc-50 dark:vibe-bg-zinc-800/50 vibe-rounded-lg vibe-border vibe-border-zinc-200 dark:vibe-border-zinc-700">
            <div class="vibe-max-w-md">
                <Form Model="@model" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
                    <div class="vibe-space-y-4">
                        <FormField TValue="string" Id="name" Label="Name" ValidationFor="@(() => model.Name)" Required="true">
                            <Input @bind-Value="model.Name" />
                        </FormField>
                        <FormField TValue="string" Id="email" Label="Email" ValidationFor="@(() => model.Email)" Required="true">
                            <Input Type="email" @bind-Value="model.Email" />
                        </FormField>
                        <Button Type="submit">Create account</Button>
                    </div>
                </Form>
                @if (!string.IsNullOrEmpty(submitStatus))
                {
                    <output class="vibe-block vibe-mt-3 vibe-text-sm vibe-text-zinc-600 dark:vibe-text-zinc-400">@submitStatus</output>
                }
            </div>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">Examples</h2>
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Validated model</h3>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>
        <div>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-zinc-800 dark:vibe-text-zinc-200 vibe-mb-3">Explicit EditContext</h3>
            <CodeBlock Code="@EditContextCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-6">API Reference</h2>
        <div class="vibe-overflow-x-auto">
            <table class="vibe-w-full vibe-text-sm">
                <thead><tr class="vibe-border-b vibe-border-zinc-200 dark:vibe-border-zinc-700">
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Name</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Type</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Default</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Description</th>
                </tr></thead>
                <tbody class="vibe-divide-y vibe-divide-zinc-100 dark:vibe-divide-zinc-800">
                    @foreach (var property in Properties)
                    {
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono">@property.Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-500">@property.Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-zinc-600 dark:vibe-text-zinc-400">@property.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add form" Language="bash" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-zinc-900 dark:vibe-text-zinc-100 vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-zinc-600 dark:vibe-text-zinc-400">
            @foreach (var item in AccessibilityItems)
            {
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Icon Name="check-circle" Size="20" CssClass="vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" />
                    @item
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private readonly AccountModel model = new();
    private string submitStatus = string.Empty;

    private void HandleValidSubmit(EditContext _) => submitStatus = "Account details are valid.";
    private void HandleInvalidSubmit(EditContext _) => submitStatus = "Review the highlighted fields.";

    private static readonly (string Name, string Type, string Default, string Description)[] Properties =
    [
        ("Model", "TForm", "new TForm()", "Typed model used to create an EditContext"),
        ("EditContext", "EditContext?", "null", "Optional explicit context used instead of Model"),
        ("FormName", "string?", "null", "Name used by Blazor form handling"),
        ("EnableDataAnnotationsValidator", "bool", "true", "Render DataAnnotationsValidator"),
        ("ShowValidationSummary", "bool", "true", "Render ValidationSummary"),
        ("ValidationSummaryClass", "string", "validation-summary", "CSS class for the summary"),
        ("Enhance", "bool", "false", "Enable enhanced form posts"),
        ("OnSubmit", "EventCallback<EditContext>", "none", "Called for valid submissions before OnValidSubmit"),
        ("OnValidSubmit", "EventCallback<EditContext>", "none", "Called after successful validation"),
        ("OnInvalidSubmit", "EventCallback<EditContext>", "none", "Called after failed validation"),
        ("ChildContent", "RenderFragment?", "null", "Form fields and actions")
    ];

    private static readonly string[] AccessibilityItems =
    [
        "Renders Blazor's semantic form element",
        "Uses native submit behavior and validation callbacks",
        "Can render a validation summary for invalid fields",
        "Works with FormField control-level labels and messages"
    ];

    private string BasicCode => @"<Form Model=""model"" OnValidSubmit=""HandleValidSubmit"" OnInvalidSubmit=""HandleInvalidSubmit"">
    <FormField TValue=""string"" Id=""email"" Label=""Email"" ValidationFor=""@(() => model.Email)"">
        <Input Type=""email"" @bind-Value=""model.Email"" />
    </FormField>
    <Button Type=""submit"">Save</Button>
</Form>";

    private string EditContextCode => @"<Form EditContext=""editContext"" ShowValidationSummary=""false"">
    ...
</Form>";

    private sealed class AccountModel
    {
        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Enter a valid email")]
        public string Email { get; set; } = string.Empty;
    }
}
