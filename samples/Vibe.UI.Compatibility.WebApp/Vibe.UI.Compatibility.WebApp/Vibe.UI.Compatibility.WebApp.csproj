<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VibePackageVersion Condition="'$(VibePackageVersion)' == ''">1.0.0-beta</VibePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vibe.UI.Compatibility.WebApp.Client\Vibe.UI.Compatibility.WebApp.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.17" />
  </ItemGroup>

  <ItemGroup Condition="'$(VibeUsePackageReferences)' != 'true'">
    <ProjectReference Include="..\..\..\src\Vibe.UI\Vibe.UI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(VibeUsePackageReferences)' == 'true'">
    <PackageReference Include="Vibe.UI" Version="$(VibePackageVersion)" />
    <PackageReference Include="Vibe.UI.CSS" Version="$(VibePackageVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
